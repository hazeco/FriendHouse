@model Khetsophon_CSI402_8456.ViewModels.PromotionCatalogViewModel
@{
    // กำหนดชื่อหน้าเว็บสำหรับแสดงผลบนแถบเบราว์เซอร์เป็นภาษาไทยล้วน
    ViewData["Title"] = "โปรโมชั่นและสิทธิพิเศษ — ร้านบ้านเพื่อน";

    // READ: การตั้งค่าข้อมูลเนื้อหา ข้อความ ตัวเลือกการค้นหา และไอคอน SVG ที่ส่วนบนสุดของไฟล์ (Top-of-file Configuration)
    // WHY: เพื่อให้แก้ไขข้อความและไอคอนได้จากจุดเดียวตามกฎการพัฒนาของโปรเจกต์
    var pageHeader = new {
        Title = "โปรโมชั่นและสิทธิพิเศษสำหรับสมาชิก",
        Subtitle = "รวบรวมแคมเปญส่วนลดและสิทธิประโยชน์สุดคุ้มสำหรับลูกค้าสมาชิกเพื่อใช้ลดราคาสินค้าและรับแต้มสะสมเพิ่ม",
        Badge = "ข้อเสนอพิเศษประจำเดือน",
        SearchPlaceholder = "ค้นหาชื่อแคมเปญ หรือรหัสคูปองส่วนลด...",
        SearchBtnText = "ค้นหาโปรโมชั่น",
        ResetBtnText = "ล้างตัวกรอง",
        EmptyTitle = "ไม่พบรายการโปรโมชั่นที่ค้นหา",
        EmptySubtitle = "กรุณาลองเปลี่ยนคำค้นหาหรือเลือกดูโปรโมชั่นทุกประเภท"
    };

    // ตัวเลือกประเภทโปรโมชั่นสำหรับการกรองข้อมูลด้วยภาษาไทยล้วน
    var promoTypes = new[] {
        new { Value = "all", Label = "ทุกประเภทโปรโมชั่น" },
        new { Value = "percent", Label = "ส่วนลดเปอร์เซ็นต์" },
        new { Value = "fixed", Label = "ส่วนลดท้ายบิล" },
        new { Value = "bogo", Label = "ซื้อ 1 แถม 1" },
        new { Value = "bundle", Label = "จัดเซ็ตสุดคุ้ม" },
        new { Value = "double_points", Label = "แต้มสะสมคูณสอง" }
    };

    // ไอคอน SVG มาตรฐานที่ใช้ในหน้าโปรโมชั่น
    var svgIcons = new {
        Tag = "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z",
        Search = "M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z",
        ChevronRight = "M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z",
        Ticket = "M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
    };

    // ดึงรายการโปรโมชั่นจาก ViewModel ที่ผ่านการแปลงข้อความเป็นภาษาไทยจาก Controller แล้ว
    var promoCards = Model?.PromotionCards ?? new List<Khetsophon_CSI402_8456.ViewModels.PromotionCardItemViewModel>();
    var currentSearch = Model?.SearchTerm ?? string.Empty;
    var currentType = Model?.SelectedType ?? "all";
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-8 bg-white">
    <!-- แถบนำทางบอกตำแหน่งหน้าปัจจุบัน -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">หน้าแรก</a>
        <span>/</span>
        <span class="text-text font-semibold">โปรโมชั่นและสิทธิพิเศษ</span>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-2.5">
                <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <a asp-controller="Home" asp-action="Cart" class="shrink-0 rounded-lg bg-emerald-600 px-3 py-1.5 text-[11px] font-bold text-white hover:bg-emerald-700 transition-colors">
                ไปใช้โค้ดที่ตะกร้าสินค้า
            </a>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2.5 shadow-xs">
            <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- ส่วนหัวของหน้าโปรโมชั่น -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="space-y-2">
            <div class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-3.5 py-1 text-xs font-bold text-accent">
                <span class="size-2 rounded-full bg-accent"></span>
                <span>@pageHeader.Badge</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">@pageHeader.Title</h1>
            <p class="text-xs sm:text-sm text-slate-500 max-w-2xl leading-relaxed">@pageHeader.Subtitle</p>
        </div>
        <div class="inline-flex items-center gap-2 rounded-2xl border border-slate-200/80 bg-slate-50 px-4 py-2.5 text-xs font-bold text-slate-700 self-start md:self-auto">
            <svg class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="@svgIcons.Ticket" />
            </svg>
            <span>แคมเปญที่เปิดใช้งาน: <strong class="text-primary">@promoCards.Count รายการ</strong></span>
        </div>
    </div>

    <!-- READ: ฟอร์มค้นหาและกรองประเภทโปรโมชั่นตามมาตรฐาน MVC (ไม่มีแอตทริบิวต์ method) -->
    <form asp-controller="Home" asp-action="Promotion" class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-4 sm:p-5 shadow-2xs">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
            <!-- ช่องกรอกคำค้นหาชื่อโปรโมชั่นหรือรหัสคูปอง -->
            <div class="sm:col-span-6 relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="@svgIcons.Search" />
                    </svg>
                </span>
                <input type="text"
                       name="searchTerm"
                       value="@currentSearch"
                       placeholder="@pageHeader.SearchPlaceholder"
                       class="w-full rounded-xl border border-slate-200 bg-white pl-10 pr-4 py-2.5 text-xs sm:text-sm text-text placeholder:text-slate-400 focus:border-primary focus:outline-hidden" />
            </div>

            <!-- ตัวเลือกกรองประเภทโปรโมชั่น -->
            <div class="sm:col-span-4">
                <select name="promoType" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs sm:text-sm font-medium text-text focus:border-primary focus:outline-hidden">
                    @foreach (var item in promoTypes)
                    {
                        if (string.Equals(currentType, item.Value, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item.Value" selected>@item.Label</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Label</option>
                        }
                    }
                </select>
            </div>

            <!-- ปุ่มกดค้นหาและล้างค่า -->
            <div class="sm:col-span-2 flex items-center gap-2">
                <button type="submit" class="w-full rounded-xl bg-primary px-4 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs hover:bg-accent transition-colors cursor-pointer">
                    @pageHeader.SearchBtnText
                </button>
                @if (!string.IsNullOrWhiteSpace(currentSearch) || (!string.IsNullOrWhiteSpace(currentType) && currentType != "all"))
                {
                    <a asp-controller="Home" asp-action="Promotion" class="shrink-0 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        @pageHeader.ResetBtnText
                    </a>
                }
            </div>
        </div>
    </form>

    <!-- แสดงรายการการ์ดโปรโมชั่น -->
    @if (promoCards.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var promo in promoCards)
            {
                <div class="flex flex-col justify-between rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs transition-all hover:-translate-y-1 hover:shadow-md">
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="rounded-xl bg-primary/15 px-3 py-1 text-xs font-bold text-primary">
                                @promo.Tag
                            </span>
                            <div class="flex size-10 items-center justify-center rounded-xl bg-primary/10 text-primary shadow-xs">
                                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="@svgIcons.Tag"></path>
                                </svg>
                            </div>
                        </div>

                        <div>
                            <h2 class="text-base sm:text-lg font-bold text-text leading-snug">@promo.Title</h2>
                            <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">@promo.Description</p>
                        </div>

                        <!-- กล่องแสดงรหัสคูปอง ปุ่มคัดลอก ปุ่มเก็บโค้ด และระยะเวลา -->
                        <div class="space-y-2.5 pt-3 border-t border-slate-200/60 text-xs">
                            <div class="flex items-center justify-between gap-2 rounded-xl bg-slate-50 px-3 py-2 border border-dashed border-primary/30">
                                <div class="min-w-0">
                                    <span class="text-slate-500 font-medium block text-[11px]">รหัสคูปองส่วนลด:</span>
                                    <span class="font-mono font-extrabold text-primary tracking-wider text-sm">@promo.VoucherCode</span>
                                </div>
                                <div class="flex items-center gap-1.5 shrink-0">
                                    <button type="button"
                                            onclick="copyVoucherCode('@promo.VoucherCode', this)"
                                            class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-bold text-slate-700 hover:border-primary/40 hover:text-primary transition-colors cursor-pointer">
                                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                                        </svg>
                                        <span>คัดลอก</span>
                                    </button>
                                    @if (promo.IsCollected)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-100 px-2.5 py-1.5 text-[11px] font-bold text-emerald-800">
                                            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            <span>เก็บโค้ดแล้ว</span>
                                        </span>
                                    }
                                    else
                                    {
                                        @* ฟอร์มกดเก็บคูปองลง Session (ไม่มี method attribute) *@
                                        <form asp-controller="Home" asp-action="CollectPromoCode" class="inline">
                                            <input type="hidden" name="voucherCode" value="@promo.VoucherCode" />
                                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1 rounded-lg bg-primary px-2.5 py-1.5 text-[11px] font-bold text-white hover:bg-accent transition-colors cursor-pointer">
                                                <span>เก็บโค้ด</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                            <div class="text-slate-500">
                                <strong class="text-text">ระยะเวลาจัดรายการ:</strong> @promo.Period
                            </div>
                            <div class="text-slate-500 font-medium">
                                @promo.Condition
                            </div>
                            <div class="text-[11px] text-slate-400">
                                ใช้ได้กับสินค้าที่ร่วมรายการในหน้าตะกร้าเท่านั้น (ไม่ร่วมกับการแลกของรางวัลด้วยแต้ม)
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 pt-3 flex items-center justify-between border-t border-slate-100">
                        <a asp-controller="Home" asp-action="Collection"
                           asp-route-promoCode="@promo.VoucherCode"
                           asp-route-promoScope="@promo.ApplicableScope"
                           class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline">
                            <span>เลือกชมสินค้าที่ร่วมรายการ</span>
                            <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="@svgIcons.ChevronRight" clip-rule="evenodd"></path>
                            </svg>
                        </a>
                        <a asp-controller="Home" asp-action="Cart"
                           class="rounded-lg bg-secondary/30 px-2.5 py-1 text-[11px] font-bold text-primary hover:bg-secondary/50 transition-colors">
                            ไปยังตะกร้าสินค้า
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- กรณีไม่พบโปรโมชั่นที่ตรงกับคำค้นหา -->
        <div class="rounded-3xl border border-slate-200/80 bg-slate-50/50 py-14 px-6 text-center space-y-3">
            <div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="@svgIcons.Search" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-text">@pageHeader.EmptyTitle</h3>
            <p class="text-xs sm:text-sm text-slate-500">@pageHeader.EmptySubtitle</p>
            <div class="pt-2">
                <a asp-controller="Home" asp-action="Promotion" class="inline-flex items-center rounded-xl bg-primary px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-accent transition-colors">
                    แสดงโปรโมชั่นทั้งหมด
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function copyVoucherCode(code, btn) {
        const done = () => {
            const label = btn.querySelector('span');
            if (!label) return;
            const original = label.textContent;
            label.textContent = 'คัดลอกแล้ว';
            btn.classList.add('border-emerald-300', 'bg-emerald-50', 'text-emerald-700');
            setTimeout(() => {
                label.textContent = original;
                btn.classList.remove('border-emerald-300', 'bg-emerald-50', 'text-emerald-700');
            }, 1800);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(done).catch(() => {
                fallbackCopy(code, done);
            });
        } else {
            fallbackCopy(code, done);
        }
    }

    function fallbackCopy(code, cb) {
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        cb();
    }
</script>
}
