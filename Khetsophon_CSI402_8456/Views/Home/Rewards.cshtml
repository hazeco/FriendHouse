@model IEnumerable<Khetsophon_CSI402_8456.Models.Reward>
@{
    ViewData["Title"] = "แคตตาล็อกแลกแต้มสะสม — FriendHouse";

    // Top-of-file Media & Content Configuration
    var userPoints = (int)(ViewBag.UserPoints ?? 0);
    var redemptionsList = ViewBag.UserRedemptions as IEnumerable<Khetsophon_CSI402_8456.Models.Rewardredemption> 
                          ?? Enumerable.Empty<Khetsophon_CSI402_8456.Models.Rewardredemption>();

    var rewardCategories = new[] {
        new { Label = "ทั้งหมด", IsActive = true },
        new { Label = "ฟิกเกอร์ (Figures)", IsActive = false },
        new { Label = "พรีเมียมกิ๊ฟ (Merchandise)", IsActive = false },
        new { Label = "แลกได้ทันที", IsActive = false }
    };

    var rewards = (Model != null && Model.Any())
        ? Model.Select(r => new {
            Id = r.RewardId,
            Title = r.Title,
            Brand = r.Brand ?? "FriendHouse Exclusive",
            Points = r.PointsRequired,
            PointsText = $"{r.PointsRequired:N0} แต้ม",
            Tag = !string.IsNullOrEmpty(r.CategoryTag) ? r.CategoryTag : "พิเศษ",
            Available = (r.IsAvailable ?? true) && r.StockQuantity > 0,
            Stock = r.StockQuantity,
            ImageUrl = !string.IsNullOrEmpty(r.ImageUrl) ? r.ImageUrl : "~/media/images/naruto_hero_fig.png"
        }).ToArray()
        : Array.Empty<dynamic>();

    var sessionRole = Context.Session.GetString("Role");
    var customerUserId = Context.Session.GetInt32("CustomerUserId") ?? Context.Session.GetInt32("UserId");
    bool isCustomer = (ViewBag.IsLoggedIn == true) || customerUserId.HasValue ||
                      string.Equals(sessionRole, "customer", StringComparison.OrdinalIgnoreCase);
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-8 bg-white">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">หน้าแรก</a>
        <span>/</span>
        <span class="text-text font-semibold">แคตตาล็อกแลกแต้มสะสม</span>
    </nav>

    @if (!isCustomer)
    {
        <!-- Guest Gate / Member-only Notification -->
        <div class="rounded-3xl border border-slate-200/80 bg-white p-8 sm:p-12 text-center shadow-xs max-w-2xl mx-auto space-y-6">
            <div class="mx-auto flex size-20 items-center justify-center rounded-3xl bg-secondary/30 text-primary shadow-sm">
                <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div class="space-y-2">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-text">สิทธิพิเศษสำหรับสมาชิก FriendHouse</h1>
                <p class="text-sm text-slate-500 leading-relaxed max-w-md mx-auto">
                    หน้าแคตตาล็อกแลกแต้มสะสมเปิดให้เฉพาะสมาชิกเท่านั้น กรุณาเข้าสู่ระบบเพื่อตรวจสอบแต้มสะสมและแลกรับของรางวัลพรีเมียมลิขสิทธิ์แท้
                </p>
            </div>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                <a asp-controller="Account" asp-action="Login"
                   class="w-full sm:w-auto rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white shadow-xs hover:opacity-90 transition-opacity text-center">
                    เข้าสู่ระบบเพื่อแลกแต้ม
                </a>
                <a asp-controller="Account" asp-action="Register"
                   class="w-full sm:w-auto rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors text-center">
                    สมัครสมาชิกใหม่
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Points Summary Card Banner -->
        <div class="relative overflow-hidden rounded-3xl border border-primary/15 bg-gradient-to-r from-blue-50 via-indigo-50/70 to-secondary/15 p-6 sm:p-8 shadow-xs">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
                <!-- Points Info -->
                <div class="space-y-2">
                    <div class="flex items-center gap-2 text-primary font-bold text-sm">
                        <div class="flex size-7 items-center justify-center rounded-full bg-primary text-white">
                            <svg class="size-4 fill-current" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                            </svg>
                        </div>
                        <span>คะแนนสะสมของคุณ</span>
                    </div>
                    <div class="flex items-baseline gap-2">
                        <span id="currentPointsDisplay" class="text-4xl sm:text-5xl font-extrabold text-primary">@userPoints.ToString("N0")</span>
                        <span class="text-sm sm:text-base font-bold text-primary/70 uppercase">Points</span>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-600">คุณสามารถใช้แต้มเพื่อแลกรับสินค้าสุดพิเศษและของพรีเมียมได้ที่นี่ โดยไม่มีค่าใช้จ่าย</p>
                </div>

                <!-- History Button -->
                <div>
                    <button type="button" onclick="openHistoryModal()" class="rounded-xl border border-primary/30 bg-white px-5 py-3 text-xs sm:text-sm font-bold text-primary shadow-xs transition-colors hover:bg-slate-50 cursor-pointer flex items-center gap-2">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>ประวัติการแลกแต้ม (@redemptionsList.Count() รายการ)</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Category Filters -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-4">
            <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0">
                @foreach (var cat in rewardCategories)
                {
                    <button type="button" class="rounded-xl @(cat.IsActive ? "bg-primary text-white" : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50") px-4 py-2 text-xs font-semibold shadow-xs cursor-pointer whitespace-nowrap">
                        @cat.Label
                    </button>
                }
            </div>
            <div class="text-xs text-slate-500">
                แสดงของรางวัลจริงจากฐานข้อมูลทั้งหมด @rewards.Length รายการ
            </div>
        </div>

        <!-- Rewards Grid (Real Database Rows) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var item in rewards)
            {
                <div class="group flex flex-col justify-between rounded-3xl border border-slate-200/80 bg-white p-5 shadow-xs transition-all hover:-translate-y-1 hover:shadow-lg">
                    <div>
                        <!-- Thumbnail with Tag -->
                        <div class="relative block aspect-square w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-100">
                            <span class="absolute top-3 left-3 z-10 rounded-md bg-primary px-2.5 py-1 text-[10px] font-bold text-white shadow-xs backdrop-blur-xs">
                                @item.Tag
                            </span>
                            <span class="absolute top-3 right-3 z-10 rounded-md @(item.Available ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800") px-2 py-0.5 text-[10px] font-bold shadow-xs">
                                @(item.Available ? $"คงเหลือ {item.Stock} ชิ้น" : "หมดชั่วคราว")
                            </span>

                            <img src="@Url.Content(item.ImageUrl)" alt="@item.Title"
                                 class="size-full object-cover"
                                 loading="lazy" />
                        </div>

                        <!-- Details -->
                        <div class="mt-4 space-y-1">
                            <span class="text-[11px] font-semibold text-primary">@item.Brand</span>
                            <h3 class="text-sm font-bold text-text leading-snug line-clamp-2">
                                @item.Title
                            </h3>
                        </div>
                    </div>

                    <!-- Points & Action Buttons -->
                    <div class="mt-5 pt-3 border-t border-slate-100 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-semibold text-slate-400">แต้มที่ต้องใช้</span>
                            <span class="text-base font-extrabold text-primary">@item.PointsText</span>
                        </div>

                        <div class="w-full">
                            @if (item.Available)
                            {
                                bool canAfford = userPoints >= item.Points;
                                <button type="button" onclick="openRedeemModal(@item.Id, '@item.Title', @item.Points, '@Url.Content(item.ImageUrl)', @userPoints)"
                                   class="w-full flex items-center justify-center rounded-xl @(canAfford ? "bg-accent text-white hover:opacity-90 shadow-accent/20" : "bg-slate-100 text-slate-600 border border-slate-200") py-2.5 px-3 text-xs font-bold shadow-xs transition-all cursor-pointer">
                                    @(canAfford ? "แลกของรางวัลนี้" : "แต้มสะสมไม่เพียงพอ")
                                </button>
                            }
                            else
                            {
                                <button type="button" disabled
                                   class="w-full flex items-center justify-center rounded-xl bg-slate-200 py-2.5 px-3 text-xs font-bold text-slate-400 cursor-not-allowed">
                                    ของรางวัลหมดชั่วคราว
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ================= MODALS ================= -->

<!-- 1. Redeem Confirmation Modal -->
<div id="redeemConfirmModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl space-y-5 animate-scale-up">
        <div class="text-center space-y-1">
            <h3 class="text-xl font-extrabold text-text">ยืนยันการแลกของรางวัล</h3>
            <p class="text-xs text-slate-500">แต้มสะสมจะถูกหักออกจากบัญชีของคุณทันทีเมื่อยืนยัน</p>
        </div>

        <!-- Reward Preview Card -->
        <div class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
            <img id="modalRewardImage" src="" alt="Reward" class="size-16 rounded-xl object-cover border border-slate-200 shrink-0" />
            <div class="min-w-0 flex-1">
                <h4 id="modalRewardTitle" class="text-sm font-bold text-text truncate">ชื่อของรางวัล</h4>
                <div class="text-xs font-semibold text-primary mt-1">ใช้แต้ม: <span id="modalRewardPoints" class="font-extrabold">0</span> แต้ม</div>
            </div>
        </div>

        <div class="rounded-2xl bg-blue-50 border border-blue-100 p-3.5 text-xs text-blue-900 space-y-1">
            <div class="flex justify-between">
                <span>แต้มปัจจุบัน:</span>
                <span class="font-bold">@userPoints.ToString("N0") แต้ม</span>
            </div>
            <div class="flex justify-between border-t border-blue-200/60 pt-1 text-primary">
                <span>แต้มคงเหลือหลังแลก:</span>
                <span id="modalRemainingPoints" class="font-extrabold">0 แต้ม</span>
            </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
            <button type="button" onclick="closeRedeemModal()" class="flex-1 rounded-xl border border-slate-200 px-4 py-3 text-xs font-bold text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer">
                ยกเลิก
            </button>
            <button type="button" id="btnConfirmRedeem" onclick="submitRedeem()" class="flex-1 rounded-xl bg-accent px-4 py-3 text-xs font-bold text-white shadow-lg shadow-accent/25 hover:opacity-90 transition-opacity cursor-pointer">
                ยืนยันการแลกแต้ม
            </button>
        </div>
    </div>
</div>

<!-- 2. Redeem Success Modal with Real Redemption Code -->
<div id="redeemSuccessModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 text-center shadow-2xl space-y-5 animate-scale-up">
        <div class="size-16 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center shadow-xs">
            <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>
        <div>
            <h3 class="text-xl font-extrabold text-text">แลกของรางวัลสำเร็จ!</h3>
            <p id="successRewardTitle" class="text-sm font-semibold text-slate-700 mt-1">ชื่อของรางวัล</p>
        </div>

        <!-- Redemption Code Box -->
        <div class="rounded-2xl border-2 border-dashed border-primary/30 bg-primary/5 p-4 space-y-1">
            <span class="text-xs font-bold text-primary uppercase tracking-wider block">รหัสสำหรับรับของรางวัลที่หน้าร้าน</span>
            <div id="successRedemptionCode" class="text-2xl sm:text-3xl font-black font-mono text-primary tracking-widest">RWD-2026-XXXX</div>
            <p class="text-[11px] text-slate-500 pt-1">กรุณาแจ้งรหัสนี้หรือเบอร์โทรศัพท์ของคุณที่เคาน์เตอร์ FriendHouse เพื่อรับของรางวัล</p>
        </div>

        <button type="button" onclick="window.location.reload()" class="w-full rounded-xl bg-primary py-3 text-sm font-bold text-white shadow-xs hover:opacity-90 transition-opacity cursor-pointer">
            เสร็จสิ้น
        </button>
    </div>
</div>

<!-- 3. Redemptions History Modal -->
<div id="historyModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-xl w-full p-6 sm:p-8 shadow-2xl space-y-5 max-h-[85vh] overflow-y-auto animate-scale-up">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div>
                <h3 class="text-lg font-bold text-text">ประวัติการแลกของรางวัล</h3>
                <p class="text-xs text-slate-500">รายการรหัสแลกของรางวัลของคุณที่บันทึกในระบบฐานข้อมูลจริง</p>
            </div>
            <button type="button" onclick="closeHistoryModal()" class="text-slate-400 hover:text-slate-600 cursor-pointer">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="space-y-3">
            @if (redemptionsList.Any())
            {
                foreach (var red in redemptionsList)
                {
                    bool isDone = red.Status == "Completed";
                    <div class="flex items-center justify-between p-4 rounded-2xl border border-slate-200/80 bg-slate-50/60">
                        <div class="space-y-0.5">
                            <span class="text-xs font-mono font-bold text-primary">@red.RedemptionCode</span>
                            <h4 class="text-sm font-bold text-text">@(red.Reward?.Title ?? "ของรางวัลพรีเมียม")</h4>
                            <div class="text-[11px] text-slate-400">แลกเมื่อ: @red.RedeemedAt.ToString("dd MMM yyyy HH:mm น.") · ใช้ @red.PointsSpent แต้ม</div>
                        </div>
                        <div>
                            @if (isDone)
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                                    รับของแล้ว
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-[#2F39A9]">
                                    รอรับที่ร้าน
                                </span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8 text-slate-400 text-xs">
                    ยังไม่มีประวัติการแลกของรางวัล
                </div>
            }
        </div>

        <button type="button" onclick="closeHistoryModal()" class="w-full rounded-xl border border-slate-200 bg-white py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
            ปิด
        </button>
    </div>
</div>

@section Scripts {
<script>
    let activeRewardId = 0;

    function openRedeemModal(id, title, points, imageUrl, currentPoints) {
        if (currentPoints < points) {
            alert('แต้มสะสมของคุณไม่เพียงพอสำหรับการแลกของรางวัลนี้');
            return;
        }

        activeRewardId = id;
        document.getElementById('modalRewardTitle').innerText = title;
        document.getElementById('modalRewardPoints').innerText = points.toLocaleString();
        document.getElementById('modalRewardImage').src = imageUrl;
        document.getElementById('modalRemainingPoints').innerText = (currentPoints - points).toLocaleString() + ' แต้ม';

        const modal = document.getElementById('redeemConfirmModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeRedeemModal() {
        const modal = document.getElementById('redeemConfirmModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function submitRedeem() {
        if (!activeRewardId) return;

        const btn = document.getElementById('btnConfirmRedeem');
        btn.disabled = true;
        btn.innerText = 'กำลังดำเนินการ...';

        const params = new URLSearchParams();
        params.append('rewardId', activeRewardId);

        fetch('/Home/RedeemReward', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerText = 'ยืนยันการแลกแต้ม';
            closeRedeemModal();

            if (data.requireLogin) {
                alert(data.message || 'กรุณาเข้าสู่ระบบก่อน');
                window.location.href = data.redirectUrl || '/Account/Login';
                return;
            }

            if (data.success) {
                document.getElementById('successRewardTitle').innerText = data.rewardTitle;
                document.getElementById('successRedemptionCode').innerText = data.redemptionCode;
                document.getElementById('currentPointsDisplay').innerText = Number(data.remainingPoints).toLocaleString();

                const successModal = document.getElementById('redeemSuccessModal');
                successModal.classList.remove('hidden');
                successModal.classList.add('flex');
            } else {
                alert(data.message || 'เกิดข้อผิดพลาดในการทำรายการ');
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerText = 'ยืนยันการแลกแต้ม';
            alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
        });
    }

    function openHistoryModal() {
        const modal = document.getElementById('historyModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeHistoryModal() {
        const modal = document.getElementById('historyModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>
}
