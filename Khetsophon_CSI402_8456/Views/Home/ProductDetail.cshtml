@model Khetsophon_CSI402_8456.ViewModels.ProductDetailViewModel
@{
    // กำหนดชื่อหัวข้อของหน้าเว็บรายละเอียดสินค้า
    ViewData["Title"] = $"{Model.Name} — FriendHouse";

    // การกำหนดค่าข้อความ สื่อ รูปภาพ และปุ่มกดไว้ที่ส่วนบนสุดของไฟล์ตามกฎ AGENTS.md
    var pageConfig = new
    {
        BreadcrumbHome = "หน้าแรก",
        BreadcrumbCollection = "สินค้าทั้งหมด",
        FallbackImage = "~/media/images/naruto_hero_fig.png",
        AddCartText = "เพิ่มลงตะกร้า",
        BuyNowText = "ซื้อเลย",
        OutOfStockText = "สินค้าหมดชั่วคราว",
        RelatedTitle = "สินค้าแนะนำเพิ่มเติม",
        ViewAllText = "ดูทั้งหมด",
        PriceLabel = "ราคา"
    };

    // ตรวจสอบว่าสินค้านี้มีไฟล์โมเดล 3 มิติ (.glb) พร้อมสำหรับแสดงผลหรือไม่
    bool hasModel3D = !string.IsNullOrWhiteSpace(Model.Model3DPath);
    // ตรวจสอบสถานะสต็อกสินค้าคงเหลือว่าหมดแล้วหรือไม่
    bool isOutOfStock = Model.AvailableStock <= 0;
    // กำหนดจำนวนสั่งซื้อสูงสุดไม่เกินจำนวนสินค้าคงเหลือในคลัง
    int maxOrderQty = Math.Max(1, Model.AvailableStock);
    // กำหนดพาธรูปภาพหลักของสินค้า หากไม่มีให้ใช้รูปภาพสำรองตามคอนฟิก
    string displayImage = !string.IsNullOrWhiteSpace(Model.ImageUrl) ? Model.ImageUrl : pageConfig.FallbackImage;
    // ข้อความแสดงสถานะบนป้ายกำกับสต็อก
    string statusBadgeText = isOutOfStock
        ? pageConfig.OutOfStockText
        : $"มีสินค้าพร้อมส่ง ({Model.AvailableStock} ชิ้น)";
    // คลาสสีของป้ายกำกับสถานะสต็อกสินค้า
    string statusBadgeClass = isOutOfStock
        ? "bg-rose-100 text-rose-800"
        : "bg-emerald-100 text-emerald-800";
    // ข้อความแจ้งเตือนเงื่อนไขการรับสินค้าและชำระเงินที่หน้าร้าน
    string notice = isOutOfStock
        ? "สินค้าชิ้นนี้หมดชั่วคราว กรุณาตรวจสอบอีกครั้งเมื่อสินค้าเข้าสาขา"
        : $"มีสินค้าพร้อมส่งมอบหน้าร้าน ({Model.AvailableStock} ชิ้น) กดซื้อหรือใส่ตะกร้าเพื่อเลือกวันนัดรับที่สาขาสยามสแควร์";
}

@* กรอบคอนเทนเนอร์หลักของหน้ารายละเอียดสินค้า *@
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 pb-10 space-y-8 bg-white">
    @* แถบนำทางแสดงเส้นทาง Breadcrumb เพื่อให้ผู้ใช้ย้อนกลับหน้าก่อนหน้าได้สะดวก *@
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        @* ลิงก์ย้อนกลับไปยังหน้าแรก *@
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">@pageConfig.BreadcrumbHome</a>
        @* สัญลักษณ์คั่นเส้นทาง *@
        <span>/</span>
        @* ลิงก์ย้อนกลับไปยังหน้ารวมคอลเลกชันสินค้าทั้งหมด *@
        <a asp-controller="Home" asp-action="Collection" class="hover:text-primary transition-colors">@pageConfig.BreadcrumbCollection</a>
        @* สัญลักษณ์คั่นเส้นทาง *@
        <span>/</span>
        @* ชื่อสินค้าปัจจุบันที่กำลังเปิดดู *@
        <span class="text-text font-semibold truncate">@Model.Name</span>
    </nav>

    @* กล่องข้อความแจ้งเตือนเมื่อการทำรายการสำเร็จ เช่น เพิ่มสินค้าลงตะกร้าเรียบร้อย *@
    @if (TempData["SuccessMessage"] != null)
    {
        @* การ์ดสีเขียวแสดงผลข้อความความสำเร็จพร้อมไอคอนเครื่องหมายถูก *@
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2">
            @* ไอคอนเครื่องหมายถูกแบบ SVG *@
            <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            @* ข้อความแจ้งความสำเร็จจากระบบ *@
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @* กล่องข้อความแจ้งเตือนเมื่อเกิดข้อผิดพลาดในการทำรายการ *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* การ์ดสีแดงแสดงผลข้อผิดพลาดพร้อมไอคอนเครื่องหมายตกใจ *@
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2">
            @* ไอคอนเครื่องหมายแจ้งเตือนข้อผิดพลาดแบบ SVG *@
            <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            @* ข้อความแจ้งข้อผิดพลาดจากระบบ *@
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @* โครงสร้างสองคอลัมน์หลัก: ด้านซ้ายแสดงสื่อรูปภาพ/โมเดล 3D และด้านขวาแสดงข้อมูลสินค้า *@
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        @* คอลัมน์ด้านซ้าย: กรอบแสดงสื่อรูปภาพสินค้าและโมเดล 3 มิติ *@
        <div class="lg:col-span-6">
            @* กรอบรูปภาพขอบมนสีขาวพร้อมเส้นขอบสวยงาม *@
            <div class="relative w-full rounded-2xl border border-slate-200 bg-white overflow-hidden">
                @* กรณีสินค้ามีไฟล์โมเดล 3 มิติ แสดงตัวแสดงโมเดล 3D พร้อมปุ่มสลับมุมมองรูปภาพ *@
                @if (hasModel3D)
                {
                    @* ปุ่มกดสลับมุมมองระหว่างรูปภาพสินค้าปกติและโมเดล 3 มิติ *@
                    <button type="button" onclick="toggleProductMediaMode()" id="btnToggle3DView"
                            class="absolute top-3.5 right-3.5 z-20 rounded-full border border-slate-200 bg-white/95 px-3.5 py-1.5 text-xs font-bold text-[#2F39A9] shadow-xs hover:border-[#2F39A9] transition cursor-pointer">
                        <span id="btnToggle3DLabel">ดูรูปภาพสินค้า</span>
                    </button>
                    @* องค์ประกอบเว็บคอมโพเนนต์ model-viewer สำหรับเรนเดอร์โมเดล 3 มิติแบบหมุนได้ *@
                    <model-viewer id="detailModelViewer"
                                  src="@Url.Content(Model.Model3DPath!)"
                                  alt="โมเดล 3 มิติ @Model.Name"
                                  camera-controls
                                  auto-rotate
                                  auto-rotate-delay="600"
                                  shadow-intensity="1"
                                  class="w-full h-[360px] sm:h-[440px] lg:h-[500px] bg-white">
                    </model-viewer>
                    @* รูปภาพสินค้าปกติ ซ่อนไว้เป็นค่าเริ่มต้นเมื่อมีโมเดล 3D *@
                    <img id="detailProductImage" src="@Url.Content(displayImage)" alt="@Model.Name"
                         class="hidden block w-full h-auto" />
                }
                else
                {
                    @* กรณีไม่มีโมเดล 3 มิติ แสดงรูปภาพสินค้าปกติโดยตรง *@
                    <img id="detailProductImage" src="@Url.Content(displayImage)" alt="@Model.Name"
                         class="block w-full h-auto" />
                }
            </div>
        </div>

        @* คอลัมน์ด้านขวา: ข้อมูลรายละเอียดสินค้า สเปก และแบบฟอร์มการสั่งซื้อ *@
        <div class="lg:col-span-6 space-y-6">
            @* กลุ่มข้อความส่วนหัว: ป้ายสถานะ ซีรีส์ ชื่อสินค้า รหัส และราคา *@
            <div class="space-y-2">
                @* แถวป้ายสถานะสินค้าและหมวดหมู่/ซีรีส์ *@
                <div class="flex flex-wrap items-center gap-2">
                    @* ป้ายกำกับสถานะสต็อกสินค้า เช่น มีสินค้าพร้อมส่ง หรือ สินค้าหมด *@
                    <span class="rounded-md @statusBadgeClass px-2.5 py-1 text-xs font-bold">
                        @statusBadgeText
                    </span>
                    @* ป้ายกำกับชื่อซีรีส์และหมวดหมู่สินค้า *@
                    <span class="text-xs font-semibold text-primary uppercase tracking-wide">
                        @(string.IsNullOrWhiteSpace(Model.SeriesName) ? Model.CategoryName : Model.SeriesName) • @Model.CategoryName
                    </span>
                </div>
                @* หัวข้อชื่อสินค้าฟิกเกอร์ขนาดใหญ่ *@
                <h1 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">@Model.Name</h1>
                @* แสดงรหัสสินค้าประจำชิ้น SKU *@
                <div class="text-xs text-slate-400">รหัสสินค้า: <span class="font-mono font-semibold text-slate-600">@Model.Sku</span></div>
                @* แสดงราคาขายปลีกจัดรูปแบบเงินบาทไทย *@
                <div class="pt-1 text-3xl font-extrabold text-primary">@Model.PriceFormatted</div>
            </div>

            @* ย่อหน้าคำอธิบายรายละเอียดสินค้าอย่างครบถ้วน *@
            <p class="text-sm sm:text-base leading-relaxed text-slate-600">
                @Model.Description
            </p>

            @* ตารางข้อมูลจำเพาะเชิงเทคนิคของฟิกเกอร์ (Specs Table) *@
            <div class="rounded-2xl border border-slate-200 bg-white p-4 space-y-2.5">
                @* วนลูปแสดงข้อมูลจำเพาะแต่ละรายการจาก ViewModel *@
                @foreach (var spec in Model.Specs)
                {
                    @* แถวข้อมูลจำเพาะคู่คีย์-ค่า *@
                    <div class="flex items-center justify-between text-xs sm:text-sm py-1.5 border-b border-slate-100 last:border-0">
                        @* ชื่อคุณสมบัติ เช่น หมวดหมู่ ซีรีส์ ผู้ผลิต สเกล หรือวัสดุ *@
                        <span class="font-medium text-slate-500">@spec.Key</span>
                        @* ค่าของคุณสมบัติที่ระบุ *@
                        <span class="font-semibold text-text">@spec.Value</span>
                    </div>
                }
                @* กรณีมีการระบุความสูงของโมเดลเป็นเซนติเมตร *@
                @if (Model.HeightCm.HasValue)
                {
                    @* แถวแสดงความสูงโดยประมาณของฟิกเกอร์ *@
                    <div class="flex items-center justify-between text-xs sm:text-sm py-1.5 border-t border-slate-100">
                        <span class="font-medium text-slate-500">ความสูงโดยประมาณ</span>
                        <span class="font-semibold text-text">@Model.HeightCm.Value.ToString("0.#") ซม.</span>
                    </div>
                }
            </div>

            @* ส่วนเลือกจำนวนสินค้าและปุ่มสั่งซื้อ / เพิ่มลงตะกร้า *@
            <div class="pt-1 space-y-3">
                @* กรณีสินค้าหมดสต็อก แสดงปุ่มแจ้งเตือนและลิงก์กลับหน้ารวมสินค้า *@
                @if (isOutOfStock)
                {
                    <div class="flex flex-col sm:flex-row gap-3">
                        @* ปุ่มปิดการใช้งานแจ้งสินค้าหมด *@
                        <button type="button" disabled
                                class="flex-1 rounded-xl bg-slate-200 px-6 py-3.5 text-center text-sm font-bold text-slate-500 cursor-not-allowed">
                            @pageConfig.OutOfStockText
                        </button>
                        @* ลิงก์กลับไปยังหน้าคอลเลกชันรวมสินค้าทั้งหมด *@
                        <a asp-controller="Home" asp-action="Collection"
                           class="rounded-xl border border-slate-200 bg-white px-5 py-3.5 text-center text-sm font-semibold text-text hover:bg-slate-50 transition-colors">
                            กลับไปหน้ารวมสินค้า
                        </a>
                    </div>
                }
                else
                {
                    @* แถบเลือกจำนวนชิ้นที่ต้องการสั่งซื้อ พร้อมปุ่มบวกและลบจำนวน *@
                    <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50/70 px-4 py-2.5">
                        @* ป้ายบอกจำนวนสต็อกพร้อมส่งมอบ *@
                        <span class="text-xs font-bold text-slate-700">จำนวนที่ต้องการ (คงเหลือ @Model.AvailableStock ชิ้น)</span>
                        @* ตัวควบคุมการปรับเพิ่มลดจำนวนชิ้น *@
                        <div class="inline-flex items-center rounded-xl border border-slate-200 bg-white overflow-hidden">
                            @* ปุ่มกดลดจำนวนสินค้า *@
                            <button type="button" onclick="adjustDetailQty(-1, @maxOrderQty)" class="px-3 py-1.5 text-sm font-bold text-slate-600 hover:bg-slate-100 cursor-pointer" aria-label="ลดจำนวน">-</button>
                            @* ช่องกรอกตัวเลขจำนวนชิ้นที่ต้องการสั่งซื้อ *@
                            <input type="number" id="detailQtyPicker" value="1" min="1" max="@maxOrderQty" onchange="syncDetailQty(this.value, @maxOrderQty)"
                                   class="w-12 text-center text-sm font-bold text-text focus:outline-none" aria-label="จำนวนสินค้า" />
                            @* ปุ่มกดเพิ่มจำนวนสินค้า *@
                            <button type="button" onclick="adjustDetailQty(1, @maxOrderQty)" class="px-3 py-1.5 text-sm font-bold text-slate-600 hover:bg-slate-100 cursor-pointer" aria-label="เพิ่มจำนวน">+</button>
                        </div>
                    </div>

                    @* กลุ่มปุ่มกดสั่งซื้อ "ซื้อเลย" และ "เพิ่มลงตะกร้า" โดยไม่ใส่ method attribute ตามกฎโครงการ *@
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                        @* แบบฟอร์มสั่งซื้อทันทีเพื่อนำทางไปยังหน้าตะกร้าสินค้า (goToCart=true) *@
                        <form asp-controller="Home" asp-action="AddToCart" class="flex-1 w-full sm:w-auto">
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden" name="quantity" id="buyNowQtyInput" value="1" />
                            <input type="hidden" name="goToCart" value="true" />
                            @* ปุ่มสั่งซื้อทันที "ซื้อเลย" สี Accent ตามชุดสีหลักของโครงการ *@
                            <button type="submit"
                                    class="w-full rounded-xl bg-accent px-6 py-3.5 text-center text-sm font-bold text-white transition-opacity hover:opacity-90 cursor-pointer">
                                @pageConfig.BuyNowText
                            </button>
                        </form>

                        @* แบบฟอร์มเพิ่มสินค้าลงตะกร้าแล้วคงอยู่หน้าเดิม (ส่งค่า returnUrl) *@
                        <form asp-controller="Home" asp-action="AddToCart" class="w-full sm:w-auto">
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden" name="quantity" id="addCartQtyInput" value="1" />
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            @* ปุ่มกดเพิ่มสินค้าลงตะกร้า *@
                            <button type="submit"
                                    class="w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-semibold text-text transition-colors hover:bg-slate-50 cursor-pointer">
                                @pageConfig.AddCartText
                            </button>
                        </form>
                    </div>
                }
            </div>

            @* กล่องข้อความแจ้งเตือนเงื่อนไขการรับสินค้าและชำระเงินที่หน้าร้านสยามสแควร์ *@
            <div class="rounded-2xl border border-primary/15 bg-primary/5 p-4 flex gap-3 items-start">
                @* กรอบไอคอนข้อมูลสีน้ำเงิน *@
                <div class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-primary text-white mt-0.5">
                    @* ไอคอนข้อมูลแบบ SVG *@
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                </div>
                @* ข้อความรายละเอียดเงื่อนไขการรับและชำระเงิน *@
                <p class="text-xs sm:text-sm leading-relaxed text-slate-600">@notice</p>
            </div>
        </div>
    </div>

    @* ส่วนแสดงสินค้าแนะนำเพิ่มเติม (Related Products) แสดงสูงสุด 5 รายการในกริด 5 คอลัมน์บนหน้าจอเดสก์ท็อป *@
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        @* คอนเทนเนอร์ส่วนสินค้าแนะนำเพิ่มเติมพร้อมเส้นคั่นด้านบน *@
        <div class="pt-8 border-t border-slate-100 space-y-5">
            @* แถบหัวข้อส่วนสินค้าแนะนำเพิ่มเติมและลิงก์ดูสินค้าทั้งหมด *@
            <div class="flex items-center justify-between">
                <div>
                    @* หัวข้อ "สินค้าแนะนำเพิ่มเติม" *@
                    <h2 class="text-xl sm:text-2xl font-extrabold text-text tracking-tight">@pageConfig.RelatedTitle</h2>
                    @* คำอธิบายการจัดอันดับสินค้าแนะนำตามซีรีส์และหมวดหมู่ *@
                    <p class="text-xs sm:text-sm text-slate-400 mt-0.5">สินค้าในซีรีส์เดียวกันและหมวดหมู่ยอดนิยมที่มีสินค้าพร้อมส่ง</p>
                </div>
                @* ลิงก์นำทางไปยังหน้ารวมคอลเลกชันสินค้าทั้งหมด "ดูทั้งหมด" *@
                <a asp-controller="Home" asp-action="Collection"
                   class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:text-accent transition-colors">
                    <span>@pageConfig.ViewAllText</span>
                    @* ไอคอนลูกศรชี้ขวาแบบ SVG *@
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>

            @* กริดแสดงการ์ดสินค้าแนะนำ 5 คอลัมน์บนเดสก์ท็อป และ 1-3 คอลัมน์บนจอมือถือ/แท็บเล็ตตามข้อกำหนด R1 *@
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                @* วนลูปแสดงการ์ดสินค้าแนะนำแต่ละรายการจาก RelatedProducts *@
                @foreach (var item in Model.RelatedProducts)
                {
                    @* การ์ดสินค้าฟิกเกอร์สไตล์เดียวกับหน้าแรกและหน้าคอลเลกชัน *@
                    <div class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white transition-colors hover:border-primary/40">
                        <div>
                            @* ลิงก์ครอบรูปภาพสินค้าสัดส่วน 1:1 เชื่อมโยงไปยังหน้ารายละเอียดสินค้า *@
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId"
                               class="block aspect-square w-full bg-white border-b border-slate-100 overflow-hidden">
                                @* รูปภาพสินค้า 1:1 ขนาดเต็มช่องพร้อม object-cover และ object-top *@
                                <img src="@Url.Content(PromoAndRedemptionHelper.ResolveCardImageUrl(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : pageConfig.FallbackImage))"
                                     alt="@item.Name" class="size-full object-cover object-top" loading="lazy" />
                            </a>

                            @* กล่องข้อมูลข้อความในการ์ดสินค้า *@
                            <div class="px-3.5 pt-3 space-y-1.5">
                                @* แถวป้ายสถานะสต็อกสินค้าและสเกลโมเดล *@
                                <div class="flex items-center justify-between gap-1.5">
                                    @* ป้ายสถานะสต็อก เช่น มีสินค้าพร้อมส่ง หรือ สินค้าหมด *@
                                    <span class="rounded-md @item.BadgeClass px-2 py-0.5 text-[10px] font-bold">
                                        @item.StatusText
                                    </span>
                                    @* แสดงอัตราส่วนสเกลของโมเดล *@
                                    <span class="text-[10px] text-slate-400 shrink-0 truncate">@item.Scale</span>
                                </div>
                                @* แสดงชื่อซีรีส์หรือหมวดหมู่สินค้า *@
                                <div class="text-[10px] font-bold text-primary uppercase tracking-wide truncate">
                                    @(string.IsNullOrEmpty(item.SeriesName) ? item.CategoryName : item.SeriesName)
                                </div>
                                @* ลิงก์ชื่อสินค้าฟิกเกอร์ เชื่อมโยงไปยังหน้ารายละเอียดสินค้า *@
                                <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId" class="block">
                                    <h3 class="text-xs font-bold text-text leading-snug group-hover:text-primary transition-colors line-clamp-2">
                                        @item.Name
                                    </h3>
                                </a>
                            </div>
                        </div>

                        @* ส่วนท้ายการ์ด: แสดงราคา และปุ่มหยิบใส่ตะกร้า / ซื้อเลย *@
                        <div class="px-3.5 pb-3.5 mt-3 pt-2.5 border-t border-slate-100 space-y-2.5">
                            @* แถวแสดงป้ายราคาและจำนวนเงินบาท *@
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] text-slate-400">@pageConfig.PriceLabel</span>
                                <span class="text-base font-extrabold text-primary">@item.PriceFormatted</span>
                            </div>

                            @* ตรวจสอบว่าสินค้ามีสต็อกพร้อมสั่งซื้อหรือไม่ *@
                            @if (item.InStock)
                            {
                                @* กริดสองช่องสำหรับปุ่ม "เพิ่มลงตะกร้า" และ "ซื้อเลย" *@
                                <div class="grid grid-cols-2 gap-1.5">
                                    @* แบบฟอร์มเพิ่มสินค้าลงตะกร้าแล้วคงอยู่หน้าเดิม (ไม่ระบุ method attribute) *@
                                    <form asp-controller="Home" asp-action="AddToCart" class="w-full">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                        @* ปุ่มกดเพิ่มสินค้าลงตะกร้าพร้อมไอคอนตะกร้า SVG *@
                                        <button type="submit"
                                                class="w-full flex items-center justify-center gap-1 rounded-xl border border-primary/25 bg-primary/5 py-2 text-[11px] font-bold text-primary transition-colors hover:bg-primary/15 cursor-pointer">
                                            @* ไอคอนรถเข็นสินค้าแบบ SVG *@
                                            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="9" cy="21" r="1"></circle>
                                                <circle cx="20" cy="21" r="1"></circle>
                                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                            </svg>
                                            <span>@pageConfig.AddCartText</span>
                                        </button>
                                    </form>

                                    @* แบบฟอร์มสั่งซื้อทันทีเพื่อนำทางไปยังหน้าตะกร้าสินค้า goToCart=true (ไม่ระบุ method attribute) *@
                                    <form asp-controller="Home" asp-action="AddToCart" class="w-full">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <input type="hidden" name="goToCart" value="true" />
                                        @* ปุ่มกด "ซื้อเลย" สี Accent เพื่อเปิดหน้าตะกร้าทันที *@
                                        <button type="submit"
                                                class="w-full flex items-center justify-center rounded-xl bg-accent py-2 px-1 text-[11px] font-bold text-white transition-opacity hover:opacity-90 cursor-pointer text-center leading-tight">
                                            @pageConfig.BuyNowText
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                @* กรณีสินค้าหมดสต็อก แสดงปุ่มดูรายละเอียดและป้ายสินค้าหมด *@
                                <div class="grid grid-cols-2 gap-1.5">
                                    @* ลิงก์ไปหน้ารายละเอียดสินค้าเพื่อดูข้อมูล *@
                                    <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId"
                                       class="flex items-center justify-center rounded-xl border border-slate-200 bg-white py-2 px-1 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 transition-colors">
                                        ดูรายละเอียด
                                    </a>
                                    @* ปุ่มแจ้งสินค้าหมดชั่วคราว *@
                                    <button type="button" disabled
                                            class="rounded-xl bg-slate-100 py-2 px-1 text-[11px] font-bold text-slate-400 cursor-not-allowed">
                                        @pageConfig.OutOfStockText
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ส่วนสคริปต์ JavaScript สำหรับจัดการการสลับมุมมองโมเดล 3D และตัวนับจำนวนชิ้น *@
@section Scripts {
<script>
    // ดักฟังเหตุการณ์เมื่อเอกสาร DOM โหลดเสร็จสมบูรณ์เพื่อตั้งค่าการทำงานเริ่มต้น
    // เมื่อโหลดหน้าเสร็จ ตรวจสอบสถานะการโหลดโมเดล 3D หากเกิดข้อผิดพลาดให้สลับกลับไปแสดงรูปภาพสินค้าอัตโนมัติ
    document.addEventListener('DOMContentLoaded', function () {
        // อ้างอิงอิลิเมนต์โมเดลวิวเวอร์ รูปภาพสินค้า และปุ่มสลับมุมมอง
        var modelViewerEl = document.getElementById('detailModelViewer');
        var productImgEl = document.getElementById('detailProductImage');
        var toggleBtnEl = document.getElementById('btnToggle3DView');
        // กรณีตัวแสดงผลโมเดล 3 มิติเกิดข้อผิดพลาดในการโหลดไฟล์ ให้สลับกลับมาแสดงรูปภาพปกติแทน
        if (modelViewerEl) {
            modelViewerEl.addEventListener('error', function () {
                modelViewerEl.classList.add('hidden');
                if (productImgEl) productImgEl.classList.remove('hidden');
                if (toggleBtnEl) toggleBtnEl.classList.add('hidden');
            });
        }
    });

    // ฟังก์ชันสลับการแสดงผลระหว่างโมเดล 3 มิติ และรูปภาพสินค้า 2 มิติ
    // สลับโหมดการแสดงผลระหว่างภาพสินค้าปกติกับโมเดล 3 มิติ พร้อมเปลี่ยนข้อความบนปุ่มสลับโหมด
    function toggleProductMediaMode() {
        // ดึงอิลิเมนต์โมเดลวิวเวอร์ รูปภาพสินค้า และป้ายข้อความบนปุ่มสลับ
        var modelViewerEl = document.getElementById('detailModelViewer');
        var productImgEl = document.getElementById('detailProductImage');
        var labelEl = document.getElementById('btnToggle3DLabel');
        if (!modelViewerEl || !productImgEl) return;

        // ตรวจสอบว่าปัจจุบันกำลังแสดงโมเดล 3 มิติอยู่หรือไม่
        // ตรวจสอบสถานะปัจจุบันของหน้าต่างโมเดล 3D เพื่อสลับซ่อน/แสดงผล
        var showing3D = !modelViewerEl.classList.contains('hidden');
        if (showing3D) {
            // ซ่อนโมเดล 3D และแสดงรูปภาพสินค้าปกติแทน
            modelViewerEl.classList.add('hidden');
            productImgEl.classList.remove('hidden');
            if (labelEl) labelEl.textContent = 'ดูโมเดล 3D';
        } else {
            // ซ่อนรูปภาพสินค้าและแสดงโมเดล 3D แทน
            productImgEl.classList.add('hidden');
            modelViewerEl.classList.remove('hidden');
            if (labelEl) labelEl.textContent = 'ดูรูปภาพสินค้า';
        }
    }

    // ฟังก์ชันซิงค์ค่าจำนวนสินค้าในกล่องข้อความและแบบฟอร์มสั่งซื้อทั้งสอง
    // ปรับและซิงค์จำนวนสินค้าที่เลือกไปยังช่อง input ซ่อนของฟอร์มสั่งซื้อทันทีและเพิ่มลงตะกร้า
    function syncDetailQty(val, maxQty) {
        // แปลงค่าสตริงเป็นตัวเลขจำนวนเต็ม
        var parsed = parseInt(val, 10);
        if (isNaN(parsed) || parsed < 1) parsed = 1;
        var limit = parseInt(maxQty, 10);
        if (!isNaN(limit) && limit > 0 && parsed > limit) parsed = limit;

        // อัปเดตค่าตัวเลขลงในอินพุตของตัวเลือกจำนวนและแบบฟอร์มสั่งซื้อทั้งสอง
        // อัปเดตค่าจำนวนล่าสุดให้ตรงกันทุกองค์ประกอบฟอร์ม
        var picker = document.getElementById('detailQtyPicker');
        var buyNowInput = document.getElementById('buyNowQtyInput');
        var addCartInput = document.getElementById('addCartQtyInput');
        if (picker) picker.value = parsed;
        if (buyNowInput) buyNowInput.value = parsed;
        if (addCartInput) addCartInput.value = parsed;
    }

    // ฟังก์ชันปรับเพิ่มหรือลดจำนวนสินค้าตามค่า delta (+1 หรือ -1)
    // เพิ่มหรือลดจำนวนสินค้าเมื่อกดปุ่ม + หรือ - แล้วส่งต่อให้ฟังก์ชันซิงค์ค่า
    function adjustDetailQty(delta, maxQty) {
        // ดึงค่าจำนวนปัจจุบันจากกล่องข้อความ
        var picker = document.getElementById('detailQtyPicker');
        var current = picker ? parseInt(picker.value, 10) : 1;
        if (isNaN(current)) current = 1;
        // เรียกใช้ฟังก์ชันซิงค์ค่าด้วยจำนวนที่คำนวณใหม่
        syncDetailQty(current + delta, maxQty);
    }
</script>
}
