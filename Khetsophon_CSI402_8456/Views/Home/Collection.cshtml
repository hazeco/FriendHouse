@model Khetsophon_CSI402_8456.ViewModels.ProductCatalogViewModel
@{
    ViewData["Title"] = "คอลเลกชันฟิกเกอร์ทั้งหมด — FriendHouse";

    // READ: การกำหนดค่าทรัพยากรข้อความและสื่อมีเดียที่ส่วนบนสุดของไฟล์ตามกฎ Media & Content Configuration
    // WHY: รวมศูนย์ข้อความและพาธสื่อทั้งหมดไว้ที่ส่วนบนสุดของไฟล์ ป้องกันการฮาร์ดโค้ดลึกในแท็ก HTML
    var pageConfig = new
    {
        BreadcrumbHome = "หน้าแรก",
        BreadcrumbCollection = "สินค้าทั้งหมด",
        SearchPlaceholder = "ค้นหาชื่อฟิกเกอร์ ซีรีส์ หรือแบรนด์...",
        SearchButtonText = "ค้นหา",
        ClearFilterText = "ล้างตัวกรอง",
        CategoryLabel = "หมวดหมู่:",
        SeriesLabel = "ซีรีส์:",
        StatusLabel = "สถานะ:",
        PriceRangeLabel = "ช่วงราคา:",
        TotalCountText = $"แสดงสินค้าทั้งหมด {Model.TotalItems:N0} รายการ",
        EmptyStateTitle = "ไม่พบสินค้าฟิกเกอร์ที่ตรงกับเงื่อนไข",
        EmptyStateDescription = "กรุณาลองเปลี่ยนคำค้นหาหรือกดล้างตัวกรองเพื่อดูสินค้าทั้งหมดในร้าน FriendHouse",
        FallbackImage = "~/media/images/naruto_hero_fig.png",
        CartButtonText = "ตะกร้า",
        BuyNowButtonText = "ซื้อตอนนี้",
        PaginationPrev = "ก่อนหน้า",
        PaginationNext = "ถัดไป",
        Statuses = new[] { "ทั้งหมด", "มีสินค้า" }
    };

    // ตรวจสอบว่ามีการระบุเงื่อนไขค้นหาหรือตัวกรองใดๆ อยู่หรือไม่ เพื่อควบคุมการแสดงปุ่ม "ล้างตัวกรอง"
    bool isFilterActive = !string.IsNullOrWhiteSpace(Model.SearchTerm) ||
                          (!string.IsNullOrWhiteSpace(Model.SelectedCategory) && Model.SelectedCategory != "ทั้งหมด") ||
                          (!string.IsNullOrWhiteSpace(Model.SelectedSeries) && Model.SelectedSeries != "ทั้งหมด") ||
                          (!string.IsNullOrWhiteSpace(Model.SelectedStatus) && Model.SelectedStatus != "ทั้งหมด") ||
                          (!string.IsNullOrWhiteSpace(Model.SelectedPriceRange) && Model.SelectedPriceRange != "ทั้งหมด") ||
                          !string.IsNullOrWhiteSpace(Model.SelectedPromoScope) ||
                          !string.IsNullOrWhiteSpace(Model.SelectedPromoCode);
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-4 bg-white">
    <!-- แถบนำทาง -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">@pageConfig.BreadcrumbHome</a>
        <span>/</span>
        <span class="text-text font-semibold">@pageConfig.BreadcrumbCollection</span>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2 shadow-xs">
            <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2 shadow-xs">
            <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.PromoBannerTitle))
    {
        <div class="p-4 rounded-2xl bg-primary/5 border border-primary/20 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-start gap-3">
                <div class="size-9 rounded-xl bg-primary text-white flex items-center justify-center shrink-0">
                    <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                </div>
                <div>
                    <div class="text-xs font-extrabold text-primary">กำลังแสดงสินค้าที่ร่วมรายการ: @Model.PromoBannerTitle</div>
                    @if (!string.IsNullOrWhiteSpace(Model.PromoBannerCondition))
                    {
                        <div class="text-xs text-slate-600 mt-0.5">@Model.PromoBannerCondition</div>
                    }
                </div>
            </div>
            <a asp-controller="Home" asp-action="Collection"
               class="inline-flex items-center justify-center rounded-xl border border-primary/30 bg-white px-3.5 py-2 text-xs font-bold text-primary hover:bg-primary/10 transition-colors shrink-0">
                ดูสินค้าทั้งหมด
            </a>
        </div>
    }

    <!-- แบบฟอร์มค้นหาและตัวกรองสินค้า ส่งข้อมูลไปยัง HomeController แอ็กชัน Collection (ตามมาตรฐาน MVC ไม่มี method attribute) -->
    <form asp-controller="Home" asp-action="Collection" class="space-y-3">
        @if (!string.IsNullOrWhiteSpace(Model.SelectedPromoCode))
        {
            <input type="hidden" name="promoCode" value="@Model.SelectedPromoCode" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.SelectedPromoScope))
        {
            <input type="hidden" name="promoScope" value="@Model.SelectedPromoScope" />
        }
        <!-- แถวที่ 1: ช่องค้นหาคำค้นหา, ปุ่มค้นหา, ปุ่มล้างตัวกรอง และจำนวนผลลัพธ์ -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2 flex-1 max-w-2xl">
                @* ช่องกรอกคำค้นหาชื่อฟิกเกอร์ ซีรีส์ หรือแบรนด์ *@
                <div class="relative flex-1 min-w-[220px]">
                    <input type="text" name="searchTerm" value="@Model.SearchTerm"
                           placeholder="@pageConfig.SearchPlaceholder"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/70 py-2.5 pl-9 pr-3 text-xs font-medium text-text placeholder:text-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary/20 transition-all" />
                    <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>

                @* ปุ่มกดส่งคำค้นหา *@
                <button type="submit"
                        class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-primary px-4 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-primary/90 transition-colors cursor-pointer shrink-0">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <span>@pageConfig.SearchButtonText</span>
                </button>

                @* ลิงก์ล้างตัวกรองทั้งหมด จะแสดงเมื่อมีคำค้นหาหรือตัวกรองเปิดใช้งานอยู่ *@
                @if (isFilterActive)
                {
                    <a asp-controller="Home" asp-action="Collection"
                       class="inline-flex items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 hover:border-rose-200 transition-colors cursor-pointer shrink-0">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                        <span>@pageConfig.ClearFilterText</span>
                    </a>
                }
            </div>

            @* ข้อความสรุปจำนวนรายการสินค้าทั้งหมดที่พบ *@
            <div class="text-xs font-medium text-slate-400 px-1 text-right sm:text-left shrink-0">
                @pageConfig.TotalCountText
            </div>
        </div>

        <!-- แถวที่ 2: เมนูดรอปดาวน์ 4 รายการ (หมวดหมู่, ซีรีส์, สถานะ, ช่วงราคา) ที่จะส่งค่าอัตโนมัติเมื่อผู้ใช้เปลี่ยนค่า -->
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 sm:gap-3 w-full sm:w-auto">
            <!-- ตัวกรองที่ 1: หมวดหมู่สินค้า -->
            <div class="relative flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs font-semibold text-text shadow-2xs hover:border-primary/40 transition-colors">
                <span class="text-slate-400 font-medium shrink-0">@pageConfig.CategoryLabel</span>
                <select name="category" onchange="this.form.submit()"
                        class="bg-transparent font-bold text-text focus:outline-none cursor-pointer pr-4 appearance-none w-full truncate">
                    @foreach (var c in Model.AvailableCategories)
                    {
                        if (string.Equals(c, Model.SelectedCategory, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@c" selected>@c</option>
                        }
                        else
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
                <svg class="pointer-events-none absolute right-2.5 size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>

            <!-- ตัวกรองที่ 2: ซีรีส์อนิเมะ -->
            <div class="relative flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs font-semibold text-text shadow-2xs hover:border-primary/40 transition-colors">
                <span class="text-slate-400 font-medium shrink-0">@pageConfig.SeriesLabel</span>
                <select name="series" onchange="this.form.submit()"
                        class="bg-transparent font-bold text-text focus:outline-none cursor-pointer pr-4 appearance-none w-full truncate">
                    @foreach (var s in Model.AvailableSeries)
                    {
                        if (string.Equals(s, Model.SelectedSeries, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
                <svg class="pointer-events-none absolute right-2.5 size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>

            <!-- ตัวกรองที่ 3: สถานะสินค้าคงเหลือ -->
            <div class="relative flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs font-semibold text-text shadow-2xs hover:border-primary/40 transition-colors">
                <span class="text-slate-400 font-medium shrink-0">@pageConfig.StatusLabel</span>
                <select name="status" onchange="this.form.submit()"
                        class="bg-transparent font-bold text-emerald-700 focus:outline-none cursor-pointer pr-4 appearance-none w-full truncate">
                    @foreach (var st in pageConfig.Statuses)
                    {
                        if (string.Equals(st, Model.SelectedStatus, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@st" selected>@st</option>
                        }
                        else
                        {
                            <option value="@st">@st</option>
                        }
                    }
                </select>
                <svg class="pointer-events-none absolute right-2.5 size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>

            <!-- ตัวกรองที่ 4: ช่วงราคา -->
            <div class="relative flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs font-semibold text-text shadow-2xs hover:border-primary/40 transition-colors">
                <span class="text-slate-400 font-medium shrink-0">@pageConfig.PriceRangeLabel</span>
                <select name="priceRange" onchange="this.form.submit()"
                        class="bg-transparent font-bold text-text focus:outline-none cursor-pointer pr-4 appearance-none w-full truncate">
                    @foreach (var p in Model.AvailablePriceRanges)
                    {
                        if (string.Equals(p, Model.SelectedPriceRange, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
                <svg class="pointer-events-none absolute right-2.5 size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>
        </div>
    </form>

    <!-- ตารางแสดงการ์ดสินค้าฟิกเกอร์ หรือสถานะว่างเปล่ากรณีไม่พบสินค้า -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        @if (Model.Products != null && Model.Products.Any())
        {
            @foreach (var item in Model.Products)
            {
                <div class="group flex flex-col justify-between rounded-3xl border border-slate-200/80 bg-white p-4 shadow-xs transition-all hover:-translate-y-1 hover:shadow-lg">
                    <div>
                        <!-- รูปภาพสินค้าฟิกเกอร์ พร้อม Badge แสดงสถานะสต็อก -->
                        <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId"
                           class="relative block aspect-square w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-100">
                            <span class="absolute top-2.5 left-2.5 z-10 rounded-md @item.BadgeClass px-2 py-0.5 text-[10px] font-bold shadow-xs backdrop-blur-xs">
                                @item.StatusText
                            </span>

                            <img src="@Url.Content(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : pageConfig.FallbackImage)"
                                 alt="@item.Name" class="size-full object-cover" loading="lazy" />
                        </a>

                        <!-- ข้อมูลสินค้า: ซีรีส์, สเกล, ชื่อสินค้า -->
                        <div class="mt-3 space-y-1">
                            <div class="flex items-center justify-between text-[10px]">
                                <span class="font-bold text-primary uppercase tracking-wide truncate">
                                    @(string.IsNullOrEmpty(item.SeriesName) ? item.CategoryName : item.SeriesName)
                                </span>
                                <span class="text-slate-400 shrink-0">@item.Scale</span>
                            </div>
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId" class="block">
                                <h3 class="text-xs font-bold text-text leading-snug group-hover:text-primary transition-colors line-clamp-2">
                                    @item.Name
                                </h3>
                            </a>
                        </div>
                    </div>

                    <!-- แถวด้านล่าง: แสดงราคา และปุ่มกด 2 ปุ่ม (ตะกร้า + ซื้อตอนนี้) -->
                    <div class="mt-4 pt-2.5 border-t border-slate-100 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] text-slate-400">ราคา</span>
                            <span class="text-base font-extrabold text-primary">@item.PriceFormatted</span>
                        </div>

                        <div class="grid grid-cols-2 gap-1.5">
                            @* ฟอร์มเพิ่มสินค้าลงตะกร้าแล้วอยู่หน้าเดิม (ไม่มี method attribute) *@
                            <form asp-controller="Home" asp-action="AddToCart" class="w-full">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit"
                                        class="w-full flex items-center justify-center gap-1 rounded-xl border border-primary/20 bg-primary/5 py-2 text-[11px] font-bold text-primary transition-colors hover:bg-primary/15 cursor-pointer">
                                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                    <span>@pageConfig.CartButtonText</span>
                                </button>
                            </form>

                            @* ฟอร์มกด "ซื้อตอนนี้" เพื่อเพิ่มลงตะกร้าแล้วพาไปหน้าตะกร้าทันที *@
                            <form asp-controller="Home" asp-action="AddToCart" class="w-full">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <input type="hidden" name="goToCart" value="true" />
                                <button type="submit"
                                        class="w-full flex items-center justify-center rounded-xl bg-accent py-2 px-1 text-[11px] font-bold text-white shadow-xs transition-opacity hover:opacity-90 cursor-pointer text-center leading-tight">
                                    @pageConfig.BuyNowButtonText
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            @* กล่องแสดงข้อความกรณีไม่พบสินค้าที่ตรงกับเงื่อนไขการค้นหาหรือตัวกรอง *@
            <div class="col-span-full py-16 px-4 text-center rounded-3xl border border-dashed border-slate-200 bg-slate-50/50">
                <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-white shadow-xs border border-slate-200 text-slate-400 mb-4">
                    <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                </div>
                <h3 class="text-base font-bold text-text">@pageConfig.EmptyStateTitle</h3>
                <p class="mt-1 text-xs text-slate-500 max-w-md mx-auto">@pageConfig.EmptyStateDescription</p>
                @if (isFilterActive)
                {
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Collection"
                           class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-primary/90 transition-colors cursor-pointer">
                            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"></polyline>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                            </svg>
                            <span>@pageConfig.ClearFilterText</span>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    <!-- แถบแบ่งหน้า แสดงผลเป็นภาษาไทยล้วน ปราศจากภาษาอังกฤษ และเชื่อมโยงกับตัวกรองของระบบจริง -->
    @{
        // คำนวณลำดับรายการเริ่มต้นและสิ้นสุดที่แสดงอยู่ในหน้านี้
        var startItem = Model.TotalItems == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
        var endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
    }
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 pb-2 border-t border-slate-100">
        <!-- แสดงช่วงรายการสินค้าและจำนวนสินค้าทั้งหมด -->
        <div class="text-xs font-medium text-slate-500">
            แสดงรายการที่ <span class="font-bold text-text">@startItem–@endItem</span> จากทั้งหมด <span class="font-bold text-text">@Model.TotalItems</span> รายการ (หน้า @Model.CurrentPage / @Model.TotalPages)
        </div>

        <!-- ปุ่มควบคุมการเปลี่ยนหน้า (ก่อนหน้า / หมายเลขหน้า / ถัดไป) -->
        <div class="flex items-center justify-center gap-2">
            @if (Model.CurrentPage > 1)
            {
                <a asp-controller="Home" asp-action="Collection"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-category="@Model.SelectedCategory"
                   asp-route-series="@Model.SelectedSeries"
                   asp-route-status="@Model.SelectedStatus"
                   asp-route-priceRange="@Model.SelectedPriceRange"
                   asp-route-promoCode="@Model.SelectedPromoCode"
                   asp-route-promoScope="@Model.SelectedPromoScope"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   class="flex h-10 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
                    @pageConfig.PaginationPrev
                </a>
            }
            else
            {
                <span class="flex h-10 items-center justify-center rounded-xl border border-slate-100 bg-slate-50 px-4 text-xs font-semibold text-slate-300 cursor-not-allowed">
                    @pageConfig.PaginationPrev
                </span>
            }

            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                if (p == Model.CurrentPage)
                {
                    <span class="flex size-10 items-center justify-center rounded-xl bg-primary text-xs font-bold text-white shadow-xs">
                        @p
                    </span>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Collection"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-category="@Model.SelectedCategory"
                       asp-route-series="@Model.SelectedSeries"
                       asp-route-status="@Model.SelectedStatus"
                       asp-route-priceRange="@Model.SelectedPriceRange"
                       asp-route-promoCode="@Model.SelectedPromoCode"
                       asp-route-promoScope="@Model.SelectedPromoScope"
                       asp-route-page="@p"
                       class="flex size-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
                        @p
                    </a>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-controller="Home" asp-action="Collection"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-category="@Model.SelectedCategory"
                   asp-route-series="@Model.SelectedSeries"
                   asp-route-status="@Model.SelectedStatus"
                   asp-route-priceRange="@Model.SelectedPriceRange"
                   asp-route-promoCode="@Model.SelectedPromoCode"
                   asp-route-promoScope="@Model.SelectedPromoScope"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   class="flex h-10 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
                    @pageConfig.PaginationNext
                </a>
            }
            else
            {
                <span class="flex h-10 items-center justify-center rounded-xl border border-slate-100 bg-slate-50 px-4 text-xs font-semibold text-slate-300 cursor-not-allowed">
                    @pageConfig.PaginationNext
                </span>
            }
        </div>
    </div>
</div>
