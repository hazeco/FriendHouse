@model IEnumerable<Khetsophon_CSI402_8456.Models.Cartitem>?
@{
    ViewData["Title"] = "ตะกร้าสินค้าพรีออเดอร์ — FriendHouse";

    // Top-of-file Media & Content Configuration
    var cartMedia = new {
        EmptyCartSvg = "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
    };

    // ตรวจสอบข้อมูลจริงจาก Database
    var displayItems = new List<dynamic>();
    if (Model != null && Model.Any())
    {
        foreach (var c in Model)
        {
            displayItems.Add(new {
                Id = c.ProductId,
                CartItemId = c.CartItemId,
                Title = c.Product?.Name ?? "สินค้าไม่มีชื่อ",
                Schedule = "กำหนดเข้าร้าน: สินค้าพร้อมส่งมอบตามรอบพรีออเดอร์",
                PricePerUnit = $"฿{(c.Product?.RetailPrice ?? 0):N0}",
                RawPrice = c.Product?.RetailPrice ?? 0m,
                Quantity = c.Quantity,
                Total = $"฿{((c.Product?.RetailPrice ?? 0) * c.Quantity):N0}",
                ImageUrl = !string.IsNullOrEmpty(c.Product?.ImageUrl) ? c.Product.ImageUrl : "~/media/images/naruto_hero_fig.png"
            });
        }
    }

    int totalItemCount = displayItems.Sum(i => (int)i.Quantity);
    decimal subtotalAmount = displayItems.Sum(i => (decimal)i.RawPrice * (int)i.Quantity);

    var summary = new {
        Subtotal = $"฿{subtotalAmount:N0}",
        TotalItems = totalItemCount,
        PlatformFee = "ฟรี (฿0)",
        EstimatedTotal = $"฿{subtotalAmount:N0}",
        StoreNoticeTitle = "รับและชำระเงินที่หน้าร้านเท่านั้น",
        StoreNoticeDesc = "การสั่งจองพรีออเดอร์ไม่ต้องชำระเงินออนไลน์ ชำระยอดเต็มหรือมัดจำเมื่อมารับสินค้าที่สาขา FriendHouse HQ"
    };
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-8 bg-white">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">หน้าแรก</a>
        <span>/</span>
        <span class="text-text font-semibold">ตะกร้าสินค้าพรีออเดอร์</span>
    </nav>

    <!-- Page Title -->
    <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">ตะกร้าสั่งจองสินค้าพรีออเดอร์</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">ตรวจสอบรายการฟิกเกอร์ที่ท่านต้องการสั่งจองล่วงหน้า</p>
    </div>

    <!-- Main Cart Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Column: Item List -->
        <div class="lg:col-span-8 space-y-4">
            <!-- Header Bar (Select All & Clear) -->
            <div class="flex items-center justify-between border-b border-slate-200/80 pb-3">
                <label class="flex items-center gap-2.5 cursor-pointer text-sm font-semibold text-text">
                    <input type="checkbox" checked class="size-4.5 rounded-md border-slate-300 text-primary focus:ring-primary" />
                    <span>เลือกทั้งหมด (@displayItems.Count รายการ / @summary.TotalItems ชิ้น)</span>
                </label>
                <button type="button" onclick="clearCart()" class="text-xs font-semibold text-rose-500 hover:text-rose-600 transition-colors cursor-pointer">
                    ล้างตะกร้า
                </button>
            </div>

            <!-- Cart Items Loop -->
            <div class="space-y-4">
                @if (displayItems.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-slate-300 p-12 text-center bg-slate-50/50">
                        <svg class="size-12 mx-auto text-slate-300 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                        </svg>
                        <p class="text-sm font-bold text-slate-600">ไม่มีสินค้าในตะกร้า</p>
                        <p class="text-xs text-slate-400 mt-1 mb-4">ยังไม่มีสินค้าในตะกร้าของคุณ ไปเลือกดูฟิกเกอร์ที่คุณสนใจได้เลย</p>
                        <a asp-controller="Home" asp-action="Collection" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-primary/90 transition-all cursor-pointer">
                            เลือกดูสินค้าในร้าน
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var item in displayItems)
                    {
                        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-2xl border border-slate-200/80 bg-white p-4 sm:p-5 shadow-xs transition-all hover:border-primary/30" id="cart-item-row-@item.CartItemId">
                            <!-- Checkbox -->
                            <input type="checkbox" checked class="size-4.5 rounded-md border-slate-300 text-primary focus:ring-primary self-center sm:self-auto shrink-0" />

                            <!-- Thumbnail with Real Image -->
                            <div class="size-20 sm:size-24 shrink-0 rounded-2xl border border-slate-200/80 overflow-hidden bg-slate-100 shadow-xs">
                                <img src="@Url.Content(item.ImageUrl)" alt="@item.Title" class="size-full object-cover" loading="lazy" />
                            </div>

                            <!-- Item Details -->
                            <div class="flex-1 min-w-0 space-y-1">
                                <h3 class="text-sm sm:text-base font-bold text-text leading-snug truncate">
                                    @item.Title
                                </h3>
                                <span class="inline-block text-[11px] font-semibold text-primary bg-primary/10 rounded-md px-2 py-0.5">
                                    @item.Schedule
                                </span>
                                <div class="text-xs text-slate-500">
                                    ราคาต่อชิ้น: <span class="font-medium text-text">@item.PricePerUnit</span>
                                </div>
                            </div>

                            <!-- Quantity and Subtotal Controls -->
                            <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100">
                                <!-- Quantity Counter -->
                                <div class="flex items-center rounded-lg border border-slate-200 bg-white">
                                    <button type="button" onclick="updateQty(@item.CartItemId, @(item.Quantity - 1))" class="flex size-7 items-center justify-center text-slate-500 hover:bg-slate-100 cursor-pointer rounded-l-lg" aria-label="ลดจำนวน">
                                        -
                                    </button>
                                    <span class="w-8 text-center text-xs font-bold text-text">@item.Quantity</span>
                                    <button type="button" onclick="updateQty(@item.CartItemId, @(item.Quantity + 1))" class="flex size-7 items-center justify-center text-slate-500 hover:bg-slate-100 cursor-pointer rounded-r-lg" aria-label="เพิ่มจำนวน">
                                        +
                                    </button>
                                </div>

                                <!-- Total -->
                                <div class="text-right">
                                    <span class="text-base sm:text-lg font-extrabold text-primary">@item.Total</span>
                                </div>

                                <!-- Remove Button -->
                                <button type="button" onclick="removeItem(@item.CartItemId)" class="text-slate-400 hover:text-rose-500 transition-colors cursor-pointer" aria-label="ลบรายการ">
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Back to Browsing -->
            <div class="pt-4">
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
                    <svg class="size-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span>เลือกดูสินค้าอื่นเพิ่มเติม</span>
                </a>
            </div>
        </div>

        <!-- Right Column: Summary Card -->
        <div class="lg:col-span-4">
            <div class="sticky top-24 rounded-3xl border border-slate-200/80 bg-white p-6 shadow-sm space-y-6">
                <h2 class="text-lg font-bold text-text border-b border-slate-100 pb-3">สรุปคำสั่งจองพรีออเดอร์</h2>

                <!-- Subtotals -->
                <div class="space-y-3 text-sm">
                    <div class="flex items-center justify-between text-slate-500">
                        <span>ยอดรวมสินค้า (@summary.TotalItems ชิ้น)</span>
                        <span class="font-bold text-text">@summary.Subtotal</span>
                    </div>
                    <div class="flex items-center justify-between text-slate-500">
                        <span>ค่าธรรมเนียมบริการ</span>
                        <span class="font-bold text-emerald-600">@summary.PlatformFee</span>
                    </div>
                    <div class="border-t border-slate-100 pt-3 flex items-center justify-between">
                        <span class="text-base font-bold text-text">ยอดรวมที่ต้องชำระหน้าร้าน</span>
                        <span class="text-2xl font-extrabold text-primary">@summary.EstimatedTotal</span>
                    </div>
                </div>

                <!-- Store Pickup Notice -->
                <div class="rounded-2xl border border-primary/15 bg-primary/5 p-4 flex gap-3 items-start text-xs text-slate-600">
                    <svg class="size-5 shrink-0 text-primary mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <div>
                        <span class="font-bold text-text block text-xs">@summary.StoreNoticeTitle</span>
                        <span class="leading-relaxed mt-0.5 block">@summary.StoreNoticeDesc</span>
                    </div>
                </div>

                <!-- Confirm Order Action (No method attribute as per rule) -->
                @if (displayItems.Count > 0)
                {
                    <form asp-controller="Home" asp-action="ConfirmPreorder" class="space-y-3">
                        <input type="hidden" name="pickupBranch" value="FriendHouse HQ สาขาสยามสแควร์" />
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">เบอร์โทรศัพท์สำหรับรับ SMS / สะสมแต้ม</label>
                            <input type="tel" name="contactPhone" value="@ViewBag.UserPhone" placeholder="08x-xxx-xxxx" required
                                   class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-xs font-semibold text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary/20" />
                        </div>
                        <button type="submit"
                           class="block w-full rounded-xl bg-accent py-3.5 text-center text-sm font-bold text-white shadow-lg shadow-accent/25 transition-all hover:bg-accent/90 hover:-translate-y-0.5 cursor-pointer">
                            ดำเนินการยืนยันการจองสินค้า
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Collection"
                       class="block w-full rounded-xl bg-slate-100 py-3.5 text-center text-sm font-bold text-slate-400 cursor-pointer hover:bg-slate-200 transition-colors">
                        เลือกสินค้าก่อนยืนยันการจอง
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function updateQty(cartItemId, newQty) {
        if (cartItemId <= 0) {
            location.reload();
            return;
        }
        var formData = new URLSearchParams();
        formData.append('cartItemId', cartItemId);
        formData.append('quantity', newQty);

        fetch('/Home/UpdateCartQuantity', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                location.reload();
            }
        });
    }

    function removeItem(cartItemId) {
        if (cartItemId <= 0) {
            location.reload();
            return;
        }
        var formData = new URLSearchParams();
        formData.append('cartItemId', cartItemId);

        fetch('/Home/RemoveFromCart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                location.reload();
            }
        });
    }

    function clearCart() {
        fetch('/Home/ClearCart', {
            method: 'POST'
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                location.reload();
            }
        });
    }
</script>
}
