@* กำหนดโมเดลข้อมูลรายการพรีออเดอร์ของสมาชิก *@
@model Khetsophon_CSI402_8456.ViewModels.PreorderListViewModel?
@* กำหนดฟังก์ชันช่วยเหลือและการตั้งค่าข้อมูลหน้าติดตามสถานะพรีออเดอร์ *@
@{

    // ฟังก์ชันตรวจสอบและคืนค่าพาธรูปภาพสำหรับแสดงในการ์ดสินค้า
    string ResolveCardImageUrl(string? imageUrl)
    {
        // กรณีไม่มีรูปภาพให้ใช้รูปภาพสำรองตั้งต้นของระบบ
        if (string.IsNullOrWhiteSpace(imageUrl)) return "~/media/images/naruto_hero_fig.png";
        // ตัดช่องว่างส่วนหัวและท้ายของพาธรูปภาพ
        string trimmed = imageUrl.Trim();
        // ปรับรูปแบบพาธโดยตัดเครื่องหมาย tilde หากมี
        string normalized = trimmed.StartsWith("~/") ? trimmed[1..] : trimmed;
        // ตรวจสอบความถูกต้องของโฟลเดอร์มีเดียและป้องกัน path traversal
        if (!normalized.StartsWith("/media/images/", StringComparison.OrdinalIgnoreCase) || normalized.Contains("..")) return trimmed;
        // ดึงชื่อไฟล์โดยไม่รวมนามสกุล
        string? fileNameNoExt = System.IO.Path.GetFileNameWithoutExtension(normalized);
        // หากไม่มีชื่อไฟล์หรือลงท้ายด้วย _card อยู่แล้วให้คืนค่าพาธเดิม
        if (string.IsNullOrWhiteSpace(fileNameNoExt) || fileNameNoExt.EndsWith("_card", StringComparison.OrdinalIgnoreCase)) return trimmed;
        // กำหนดชื่อไฟล์รูปภาพขนาดการ์ด
        string cardFileName = fileNameNoExt + "_card.png";
        // กำหนดพาธแบบสัมพัทธ์ของรูปภาพการ์ด
        string cardRelative = "/media/images/" + cardFileName;
        // ตรวจสอบพาธไฟล์จริงบนระบบปฏิบัติการ
        string physicalPath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "media", "images", cardFileName);
        // หากมีไฟล์รูปภาพการ์ดอยู่จริงให้ใช้ไฟล์การ์ด มิฉะนั้นใช้พาธเดิม
        if (System.IO.File.Exists(physicalPath)) return trimmed.StartsWith("~/") ? "~" + cardRelative : cardRelative;
        // ส่งคืนพาธรูปภาพเดิมหากไม่พบไฟล์การ์ด
        return trimmed;
    }

    // ฟังก์ชันสกัดข้อมูลสถานะและเหตุผลการไม่รับสินค้า/ไม่มารับสินค้า/ยกเลิกคำสั่งจองจากตาราง Systemlogs
    (string BadgeTitle, string StepTitle, string NoticeText, string ReasonDetail) ResolveOrderCancelMeta(
        IEnumerable<Systemlog>? logs,
        string? referenceCode,
        bool isReward = false)
    {
        // กำหนดหัวข้อเริ่มต้นตามประเภทรายการ
        string defaultTitle = isReward ? "ยกเลิกการแลกของรางวัล" : "ยกเลิกคำสั่งจอง";
        // กำหนดข้อความแจ้งเตือนเริ่มต้นสำหรับของรางวัลหรือสินค้าพรีออเดอร์
        string defaultNotice = isReward
            ? "รายการแลกของรางวัลนี้ถูกยกเลิกแล้ว ระบบได้คืนแต้มสะสมและคืนสต็อกของรางวัลเรียบร้อยแล้ว"
            : "รายการนี้ถูกยกเลิกตามคำขอของลูกค้า และระบบได้คืนสิทธิ์สต็อกสินค้าเรียบร้อยแล้ว";
        // หากไม่มีข้อมูลประวัติการทำงานหรือไม่มีรหัสอ้างอิง ให้ส่งคืนค่าเริ่มต้น
        if (logs == null || string.IsNullOrWhiteSpace(referenceCode))
            return (defaultTitle, defaultTitle, defaultNotice, "ลูกค้าแจ้งยกเลิกรายการ");
        // ตัดช่องว่างของรหัสอ้างอิงเพื่อใช้เปรียบเทียบ
        string cleanCode = referenceCode.Trim();
        // ค้นหาบันทึกประวัติการยกเลิกหรือปฏิเสธรับสินค้าที่ตรงกับรหัสอ้างอิง
        var matchedLog = logs
            .Where(l => !string.IsNullOrEmpty(l.Message) &&
                        l.Message.Contains(cleanCode, StringComparison.OrdinalIgnoreCase) &&
                        (l.Module == "CounterPreorder" || l.Module == "preorder.cancel" || l.Module == "reward.cancel" ||
                         l.LogCode.StartsWith("REJECT", StringComparison.OrdinalIgnoreCase) ||
                         l.LogCode.StartsWith("NOSHOW", StringComparison.OrdinalIgnoreCase) ||
                         l.LogCode.StartsWith("PO-CAN", StringComparison.OrdinalIgnoreCase) ||
                         l.LogCode.StartsWith("RWD-CAN", StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(l => l.Timestamp)
            .FirstOrDefault();
        // หากไม่พบบันทึกประวัติที่ตรงกัน ให้ส่งคืนค่าเริ่มต้น
        if (matchedLog == null)
            return (defaultTitle, defaultTitle, defaultNotice, "ลูกค้าแจ้งยกเลิกรายการ");
        // ข้อความรายละเอียดในบันทึกระบบ
        string msg = matchedLog.Message ?? string.Empty;
        // ตัวแปรเก็บข้อความสาเหตุการยกเลิก
        string reasonPart = string.Empty;
        // ค้นหาตำแหน่งคำว่า สาเหตุ: ในข้อความ
        int reasonIdx = msg.IndexOf("สาเหตุ:", StringComparison.OrdinalIgnoreCase);
        // สกัดข้อความสาเหตุหากพบในบันทึก
        if (reasonIdx >= 0)
        {
            // ดึงข้อความตั้งแต่ตำแหน่งคำว่า สาเหตุ:
            reasonPart = msg[reasonIdx..].Trim();
            // ค้นหาตำแหน่งข้อความการคืนเงินหรือคืนแต้มเพื่อตัดออก
            int refundIdx = reasonPart.IndexOf("| คืน", StringComparison.OrdinalIgnoreCase);
            // ตัดข้อความส่วนเกินออกให้เหลือเฉพาะสาเหตุหลัก
            if (refundIdx > 0) reasonPart = reasonPart[..refundIdx].Trim();
            // ลบข้อความที่ระบุว่า ไม่มี ออกเพื่อให้กระชับ
            reasonPart = reasonPart.Replace("| รายละเอียด: ไม่มี", "").Replace("| หมายเหตุ: ไม่มี", "").Trim();
        }
        // ตรวจสอบกรณีลูกค้าปฏิเสธไม่รับสินค้าที่หน้าร้าน
        if (matchedLog.LogCode.StartsWith("REJECT", StringComparison.OrdinalIgnoreCase) ||
            msg.Contains("ลูกค้าไม่รับ", StringComparison.OrdinalIgnoreCase))
        {
            // กำหนดหัวข้อตามประเภทของรางวัลหรือสินค้า
            string title = isReward ? "ลูกค้าไม่รับของรางวัล" : "ลูกค้าไม่รับสินค้า";
            // กำหนดรายละเอียดสาเหตุการปฏิเสธ
            string detail = !string.IsNullOrWhiteSpace(reasonPart) ? reasonPart : "สาเหตุ: ลูกค้าปฏิเสธไม่รับสินค้าที่เคาน์เตอร์หน้าร้าน";
            // ส่งคืนข้อมูลสถานะและข้อความแจ้งเตือนกรณีไม่รับสินค้า
            return (title, title, $"รายการนี้{title}ที่หน้าร้าน — {detail} (คืนสต็อกเรียบร้อยแล้ว)", detail);
        }
        // ตรวจสอบกรณีลูกค้าไม่มารับสินค้าตามกำหนดนัดหมาย
        if (matchedLog.LogCode.StartsWith("NOSHOW", StringComparison.OrdinalIgnoreCase) ||
            msg.Contains("ลูกค้าไม่มารับ", StringComparison.OrdinalIgnoreCase))
        {
            // กำหนดหัวข้อตามประเภทของรางวัลหรือสินค้า
            string title = isReward ? "ลูกค้าไม่มารับของรางวัล" : "ลูกค้าไม่มารับสินค้า";
            // กำหนดรายละเอียดสาเหตุที่ไม่มารับตามนัด
            string detail = !string.IsNullOrWhiteSpace(reasonPart) ? reasonPart : "สาเหตุ: ลูกค้าไม่มารับตามกำหนดนัดหมาย";
            // ส่งคืนข้อมูลสถานะและข้อความแจ้งเตือนกรณีไม่มารับสินค้า
            return (title, title, $"รายการนี้ถูกยกเลิกเนื่องจาก{title}ตามกำหนด — {detail} (คืนสต็อกเรียบร้อยแล้ว)", detail);
        }
        // กรณีลูกค้ากดยกเลิกรายการด้วยตนเอง
        string cancelDetail = !string.IsNullOrWhiteSpace(reasonPart) ? reasonPart : "สาเหตุ: ลูกค้ากดยกเลิกคำสั่งจองด้วยตนเอง";
        // ส่งคืนข้อมูลสถานะและข้อความแจ้งเตือนกรณีลูกค้ายกเลิก
        return (defaultTitle, defaultTitle, $"รายการนี้ถูกยกเลิกตามคำขอของลูกค้า — {cancelDetail} (คืนสิทธิ์สต็อกเรียบร้อยแล้ว)", cancelDetail);
    }
    ViewData["Title"] = "สถานะพรีออเดอร์ของฉัน — FriendHouse";

    // การตั้งค่าเนื้อหาและไอคอนส่วนหัวของไฟล์ตามมาตรฐานโปรเจกต์
    var pageConfig = new
    {
        BreadcrumbHome = "หน้าแรก",
        BreadcrumbCurrent = "พรีออเดอร์ของฉัน",
        Title = "สถานะพรีออเดอร์และรายการจองของฉัน",
        AddMoreText = "สั่งจองสินค้าเพิ่ม",
        SearchPlaceholder = "ค้นหาด้วยเลขใบจอง/รหัสแลกแต้ม (เช่น PO-2026-0001, RWD-2026-0001) เบอร์โทร หรือชื่อสินค้า...",
        SearchBtnText = "ค้นหา",
        ClearBtnText = "ล้างตัวกรอง",
        EmptyTitle = "ยังไม่มีรายการสั่งจองหรือแลกของรางวัล",
        EmptySubtitle = "เลือกฟิกเกอร์ที่คุณชื่นชอบหรือนำแต้มสะสมไปจองแลกของรางวัลได้ที่หน้าร้าน",
        EmptyActionText = "เลือกดูสินค้าในร้าน",
        CancelBtnText = "ยกเลิกคำสั่งจอง"
    };

    var preordersList = Model?.ToList() ?? new List<Khetsophon_CSI402_8456.Models.Preorder>();
    var redemptionsList = Model?.Redemptions ?? new List<Khetsophon_CSI402_8456.ViewModels.RewardRedemptionViewModel>();
    var selectedStatus = Model?.StatusFilter ?? "all";
    bool isLoggedIn = ViewBag.IsLoggedIn as bool? ?? false;
    var cancelLogs = ViewBag.CancelLogs as IEnumerable<Khetsophon_CSI402_8456.Models.Systemlog>;
    var cancelReasonOptions = new[]
    {
        "เปลี่ยนใจ / ต้องการเปลี่ยนรุ่นสินค้า",
        "ไม่สะดวกเดินทางมารับสินค้าตามวันนัดหมาย",
        "ต้องการใช้โค้ดส่วนลดหรือสั่งจองใหม่",
        "เหตุผลอื่นๆ"
    };
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 space-y-8 bg-white">
    @* แถบนำทางระบุตำแหน่งหน้าเว็บ (Breadcrumb) *@
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">@pageConfig.BreadcrumbHome</a>
        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
        <span>/</span>
        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
        <span class="text-text font-semibold">@pageConfig.BreadcrumbCurrent</span>
    </nav>

    @* แสดงข้อความแจ้งเตือนผลการทำงานสำเร็จ *@
    @if (TempData["SuccessMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2.5 shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @* แสดงข้อความแจ้งเตือนข้อผิดพลาด *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2.5 shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @* ส่วนหัวของหน้าแสดงสถานะพรีออเดอร์ *@
    <div class="flex items-center justify-between flex-wrap gap-4">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div>
            @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
            <h1 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">@pageConfig.Title</h1>
            @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
            <p class="text-xs sm:text-sm text-slate-500 mt-1">รายการพรีออเดอร์ @preordersList.Count รายการ · รายการจองแลกของรางวัล @redemptionsList.Count รายการ</p>
        </div>
        @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
        <a asp-controller="Home" asp-action="Collection" class="inline-flex items-center gap-1.5 rounded-xl border border-primary/20 bg-primary/5 px-4 py-2 text-xs font-bold text-primary hover:bg-primary/10 transition-colors">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span>@pageConfig.AddMoreText</span>
        </a>
    </div>

    @* ฟอร์มค้นหาและกรองสถานะพรีออเดอร์ ส่งไปยัง HomeController แอ็กชัน PreorderStatus *@
    <form asp-controller="Home" asp-action="PreorderStatus" class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="relative flex-1">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
            <input type="text" name="searchTerm" value="@Model?.SearchTerm" placeholder="@pageConfig.SearchPlaceholder"
                   class="w-full rounded-xl border border-slate-200 bg-white pl-10 pr-4 py-2.5 text-xs sm:text-sm text-text focus:border-primary focus:outline-none" />
        </div>
        @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
        <select name="statusFilter" class="rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs sm:text-sm font-medium text-slate-700 focus:border-primary focus:outline-none">
            <option value="all" selected="@(selectedStatus == "all")">สถานะทั้งหมด</option>
            <option value="active" selected="@(selectedStatus == "active")">กำลังดำเนินการ / พร้อมรับสินค้า</option>
            <option value="completed" selected="@(selectedStatus == "completed")">รับสินค้าสำเร็จเรียบร้อย</option>
            <option value="cancelled" selected="@(selectedStatus == "cancelled")">ยกเลิกคำสั่งจอง</option>
        </select>
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="flex items-center gap-2">
            @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
            <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs hover:opacity-90 transition-opacity cursor-pointer">
                @pageConfig.SearchBtnText
            </button>
            @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
            @if (!string.IsNullOrWhiteSpace(Model?.SearchTerm) || (selectedStatus != "all"))
            {
                @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                <a asp-controller="Home" asp-action="PreorderStatus" class="rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                    @pageConfig.ClearBtnText
                </a>
            }
        </div>
    </form>

    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (!isLoggedIn)
    {
        @* กล่องแจ้งเตือนกรณีผู้เยี่ยมชมยังไม่ได้เข้าสู่ระบบ *@
        <div class="rounded-3xl border border-slate-200 bg-slate-50/60 p-10 text-center space-y-4">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>
                @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
                <h3 class="text-base font-bold text-text">กรุณาเข้าสู่ระบบเพื่อดูสถานะคำสั่งจอง</h3>
                @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
                <p class="text-xs text-slate-500 mt-1">เข้าสู่ระบบด้วยบัญชีสมาชิก FriendHouse ของคุณเพื่อติดตามใบสั่งจองและรายการแลกของรางวัล</p>
            </div>
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
            <a asp-controller="Account" asp-action="Login" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-white hover:bg-accent transition-colors">
                เข้าสู่ระบบเพื่อดูคำสั่งจองของฉัน
            </a>
        </div>
    }
    else if (!preordersList.Any() && !redemptionsList.Any())
    {
        @* กล่องแสดงกรณีไม่พบรายการพรีออเดอร์และรายการจองแลกของรางวัล *@
        <div class="rounded-3xl border border-dashed border-slate-200 p-12 text-center space-y-4">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-slate-50 text-slate-400">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>
                @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
                <h3 class="text-base font-bold text-text">@pageConfig.EmptyTitle</h3>
                @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
                <p class="text-xs text-slate-400 mt-1">@pageConfig.EmptySubtitle</p>
            </div>
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
            <a asp-controller="Home" asp-action="Collection" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-white hover:opacity-90">
                @pageConfig.EmptyActionText
            </a>
        </div>
    }
    else
    {
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="space-y-6">
            @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
            @foreach (var po in preordersList)
            {
                var firstItem = po.Preorderitems.FirstOrDefault();
                string imageUrl = !string.IsNullOrEmpty(firstItem?.Product?.ImageUrl) ? firstItem.Product.ImageUrl : "~/media/images/naruto_hero_fig.png";
                string productName = firstItem?.Product?.Name ?? "รายการฟิกเกอร์พรีออเดอร์";
                int totalQty = po.Preorderitems.Sum(pi => pi.Quantity);

                string statusBadgeText = "รอดำเนินการ";
                string statusBadgeClass = "bg-amber-50/80 border-amber-200/80 text-amber-800";
                string noticeText = "รายการนี้จะแสดงสถานะอัปเดตแบบเรียลไทม์จากหน้าร้าน เมื่อมารับสินค้าแล้วสามารถแจ้งรหัสใบจองนี้ที่เคาน์เตอร์ได้ทันที";
                var steps = new List<dynamic>();
                bool canCancel = false;

                if (po.CurrentStatus == "PendingConfirm" || po.CurrentStatus == "WaitingStock" || po.CurrentStatus == "ReadyForPickup" || po.CurrentStatus == "Reserved")
                {
                    canCancel = true;
                    statusBadgeText = po.CurrentStatus == "ReadyForPickup" ? "สินค้าพร้อมรับแล้ว" : "รอดำเนินการ";
                    steps.Add(new { StepNumber = 1, Title = "แจ้งจองออเดอร์", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 2, Title = "รอชำระเงินและรับสินค้า", IsCompleted = false, IsActive = true, IsCancelled = false });
                }
                else if (po.CurrentStatus == "Completed")
                {
                    statusBadgeText = "สำเร็จเรียบร้อย";
                    statusBadgeClass = "bg-emerald-50/80 border-emerald-200/80 text-emerald-800";
                    noticeText = "รายการพรีออเดอร์นี้เสร็จสมบูรณ์เรียบร้อย ลูกค้าชำระเงินและรับสินค้าแล้ว ขอขอบคุณที่เลือกซื้อสินค้ากับ FriendHouse";
                    steps.Add(new { StepNumber = 1, Title = "แจ้งจองออเดอร์", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 2, Title = "ชำระเงินและรับสินค้าแล้ว", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 3, Title = "สำเร็จ", IsCompleted = true, IsActive = true, IsCancelled = false });
                }
                else if (po.CurrentStatus == "Cancelled")
                {
                    var cancelMeta = ResolveOrderCancelMeta(cancelLogs, po.ReservationNumber, isReward: false);
                    statusBadgeText = cancelMeta.BadgeTitle;
                    statusBadgeClass = "bg-rose-50/80 border-rose-200/80 text-rose-800";
                    noticeText = cancelMeta.NoticeText;
                    steps.Add(new { StepNumber = 1, Title = "แจ้งจองออเดอร์", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 2, Title = cancelMeta.StepTitle, IsCompleted = false, IsActive = false, IsCancelled = true });
                }

                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="rounded-3xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-all hover:border-primary/30">
                    @* แถบแสดงสถานะและหมายเลขใบสั่งจองด้านบน *@
                    <div class="flex items-center justify-between border-b @statusBadgeClass px-6 py-3.5">
                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                        <div class="flex items-center gap-2 text-xs sm:text-sm font-bold">
                            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                            <span>@statusBadgeText</span>
                        </div>
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="text-xs font-semibold opacity-80">อ้างอิง @po.ReservationNumber</span>
                    </div>

                    @* รายละเอียดสินค้าฟิกเกอร์ในใบสั่งจอง *@
                    <div class="p-6 sm:p-8 space-y-6">
                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                        <div class="space-y-3">
                            @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                            @foreach (var item in po.Preorderitems)
                            {
                                string itemImage = !string.IsNullOrEmpty(item.Product?.ImageUrl) ? item.Product.ImageUrl : "~/media/images/naruto_hero_fig.png";
                                @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                <div class="flex items-center gap-4 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="size-16 shrink-0 rounded-xl border border-slate-200 overflow-hidden bg-white">
                                        @* รูปภาพประกอบรายการพร้อมกำหนดคลาสจัดสัดส่วนการแสดงผล *@
                                        <img src="@Url.Content(ResolveCardImageUrl(itemImage))" alt="@(item.Product?.Name ?? "สินค้า")" class="size-full object-cover object-top" />
                                    </div>
                                    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                    <div class="flex-1 min-w-0">
                                        @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
                                        <h3 class="text-sm font-bold text-text truncate">@(item.Product?.Name ?? "สินค้าไม่มีชื่อ")</h3>
                                        @if (item.UnitPrice <= 0m)
                                        {
                                            @* ป้ายกำกับกรณีเป็นสินค้าของแถมฟรีจากโปรโมชั่น ซื้อ 1 แถม 1 *@
                                            <div class="text-xs font-bold text-emerald-700 mt-0.5">แถมฟรี (โปรโมชั่น ซื้อ 1 แถม 1) • จำนวน @item.Quantity ชิ้น</div>
                                        }
                                        else
                                        {
                                            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                            <div class="text-xs font-semibold text-primary mt-0.5">฿@item.UnitPrice.ToString("N0") • จำนวน @item.Quantity ชิ้น</div>
                                        }
                                    </div>
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="text-right">
                                        @if (item.UnitPrice <= 0m)
                                        {
                                            @* ป้ายราคาฟรี 0 บาท *@
                                            <span class="rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-extrabold text-emerald-800">ฟรี ฿0</span>
                                        }
                                        else
                                        {
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span class="text-sm font-extrabold text-text">฿@((item.UnitPrice * item.Quantity).ToString("N0"))</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @* ข้อมูลสรุปวันที่ทำรายการ กำหนดรับสินค้า และยอดรวม *@
                        <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-slate-100 text-xs">
                            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                            <div class="flex items-center gap-6">
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="text-slate-400 block">วันที่ทำรายการ</span>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="font-bold text-text">@po.CreatedAt.ToString("d MMM yyyy")</span>
                                </div>
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="text-slate-400 block">กรุณามารับภายใน</span>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="font-bold text-text">@po.EstimatedPickupDate.ToString("d MMM yyyy")</span>
                                </div>
                            </div>
                            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                            <div class="flex items-center gap-4">
                                @{
                                    var promoMeta = Model?.Preorders?.FirstOrDefault(x => x.PreorderId == po.PreorderId);
                                }
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div class="text-right">
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="text-slate-400 block">ยอดรวมทั้งสิ้น จำนวน @totalQty ชิ้น</span>
                                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                    @if (promoMeta != null && !string.IsNullOrEmpty(promoMeta.AppliedPromoCode))
                                    {
                                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                        <div class="flex items-center justify-end gap-1.5 mt-0.5">
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800">
                                                โค้ด @promoMeta.AppliedPromoCode
                                            </span>
                                            @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                            @if (promoMeta.DiscountAmount > 0m)
                                            {
                                                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                <span class="text-xs text-slate-400 line-through">฿@promoMeta.OriginalSubtotal.ToString("N0")</span>
                                            }
                                            else if (promoMeta.IsDoublePoints)
                                            {
                                                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                <span class="text-[11px] font-bold text-primary">แต้ม x2</span>
                                            }
                                        </div>
                                    }
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="text-base font-extrabold text-primary">฿@po.TotalFinalPrice.ToString("N0")</span>
                                </div>

                                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                @if (canCancel)
                                {
                                    @* ปุ่มเปิดหน้าต่างยืนยันยกเลิกคำสั่งจองพร้อมเลือกเหตุผล *@
                                    <button type="button"
                                            onclick="openCancelPreorderStatusModal(this)"
                                            data-preorder-id="@po.PreorderId"
                                            data-reservation-no="@po.ReservationNumber"
                                            data-product-name="@productName"
                                            class="rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2 text-xs font-bold text-rose-600 hover:bg-rose-100 transition-colors cursor-pointer">
                                        @pageConfig.CancelBtnText
                                    </button>
                                }
                            </div>
                        </div>

                        @* แถบแสดงขั้นตอนความคืบหน้าของสถานะใบสั่งจอง *@
                        <div class="border-t border-slate-100 pt-6">
                            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                            <div class="relative max-w-md mx-auto">
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div class="absolute top-4.5 left-8 right-8 h-0.5 bg-slate-200 -z-0">
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="h-full bg-primary w-full"></div>
                                </div>

                                @* คอนเทนเนอร์จัดวางโครงสร้างแบบ Grid รองรับ Responsive ทุกขนาดหน้าจอ *@
                                <div class="relative z-10 grid @(steps.Count == 3 ? "grid-cols-3" : "grid-cols-2") gap-4 sm:gap-8">
                                    @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                                    @foreach (var step in steps)
                                    {
                                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                        <div class="flex flex-col items-center text-center space-y-2">
                                            @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
