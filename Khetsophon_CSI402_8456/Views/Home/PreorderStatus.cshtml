                                            else if (red.IsCompleted)
                                            {
                                                @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                                <div class="flex size-9 items-center justify-center rounded-full bg-emerald-600 text-white shadow-xs">
                                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                                    <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                </div>
                                                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                <span class="text-xs font-bold text-emerald-700">รับของรางวัลแล้ว</span>
                                            }
                                            else
                                            {
                                                @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                                <div class="flex size-9 items-center justify-center rounded-full bg-primary text-white ring-4 ring-primary/20 shadow-xs">
                                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                    <span class="size-2.5 rounded-full bg-white animate-pulse"></span>
                                                </div>
                                                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                <span class="text-xs font-bold text-primary">รอรับที่เคาน์เตอร์หน้าร้าน</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                            <div class="rounded-2xl border border-primary/15 bg-primary/5 p-4 flex gap-3 text-xs text-slate-600 leading-relaxed">
                                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                <svg class="size-5 shrink-0 text-primary mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                <span>@rNotice</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* หน้าต่างโมดัลยืนยันยกเลิกคำสั่งจองพรีออเดอร์พร้อมระบุเหตุผล *@
<div id="cancelPreorderStatusModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs items-center justify-center p-4">
    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4">
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="flex items-start gap-3">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="size-10 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>
                @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
                <h3 class="text-base font-extrabold text-text">ยืนยันยกเลิกคำสั่งจอง</h3>
                @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
                <p id="statusCancelPreorderCode" class="text-xs font-mono text-primary font-bold mt-0.5"></p>
            </div>
        </div>
        @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
        <p class="text-xs text-slate-600 leading-relaxed">
            ต้องการยกเลิกคำสั่งจอง "<span id="statusCancelPreorderName" class="font-bold text-text"></span>" ใช่หรือไม่? กรุณาเลือกเหตุผลการยกเลิก:
        </p>

        @* ฟอร์มยกเลิกคำสั่งจองพรีออเดอร์ ส่งไปยัง HomeController แอ็กชัน CancelPreorder *@
        <form asp-controller="Home" asp-action="CancelPreorder" class="space-y-3">
            @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
            <input type="hidden" id="statusCancelPreorderId" name="preorderId" value="" />
            @* ตัวเลือกเหตุผลการยกเลิก *@
            <div class="space-y-2">
                @for (int i = 0; i < cancelReasonOptions.Length; i++)
                {
                    var opt = cancelReasonOptions[i];
                    <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer text-xs font-semibold text-text">
                        <input type="radio" name="reason" value="@opt" @(i == 0 ? "checked" : "") class="accent-rose-600" />
                        <span>@opt</span>
                    </label>
                }
            </div>
            @* ช่องกรอกหมายเหตุเพิ่มเติม *@
            <div>
                <input type="text" name="remark" placeholder="ระบุรายละเอียดเพิ่มเติม (ถ้ามี)..." class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-xs text-text focus:border-primary focus:outline-none" />
            </div>
            @* แถวปุ่มดำเนินการ *@
            <div class="flex items-center gap-2.5 pt-1">
                @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
                <button type="button" onclick="closeCancelPreorderStatusModal()" class="flex-1 rounded-xl border border-slate-200 bg-white py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50 cursor-pointer">
                    ย้อนกลับ
                </button>
                @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
                <button type="submit" class="flex-1 rounded-xl bg-rose-600 py-2.5 text-xs font-bold text-white hover:bg-rose-700 cursor-pointer shadow-xs">
                    ยืนยันยกเลิกคำสั่งจอง
                </button>
            </div>
        </form>
    </div>
</div>

@* หน้าต่างโมดัลยืนยันยกเลิกการจองแลกของรางวัล *@
