@model Khetsophon_CSI402_8456.ViewModels.PreorderListViewModel?
@{
    ViewData["Title"] = "สถานะพรีออเดอร์ของฉัน — FriendHouse";

    // การตั้งค่าเนื้อหาและไอคอนส่วนหัวของไฟล์ตามมาตรฐานโปรเจกต์
    var pageConfig = new
    {
        BreadcrumbHome = "หน้าแรก",
        BreadcrumbCurrent = "พรีออเดอร์ของฉัน",
        Title = "สถานะพรีออเดอร์ของฉัน",
        AddMoreText = "สั่งจองสินค้าเพิ่ม",
        SearchPlaceholder = "ค้นหาด้วยหมายเลขใบจอง เบอร์โทรศัพท์ หรือชื่อฟิกเกอร์...",
        SearchBtnText = "ค้นหา",
        ClearBtnText = "ล้างตัวกรอง",
        EmptyTitle = "ยังไม่มีรายการสั่งจองพรีออเดอร์",
        EmptySubtitle = "เลือกฟิกเกอร์ที่คุณชื่นชอบแล้วสั่งจองล่วงหน้าได้ทันที",
        EmptyActionText = "เลือกดูสินค้าในร้าน",
        CancelBtnText = "ยกเลิกคำสั่งจอง"
    };

    var preordersList = Model?.ToList() ?? new List<Khetsophon_CSI402_8456.Models.Preorder>();
    var selectedStatus = Model?.StatusFilter ?? "all";
}

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 space-y-8 bg-white">
    <!-- แถบนำทาง Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="แถบนำทาง">
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">@pageConfig.BreadcrumbHome</a>
        <span>/</span>
        <span class="text-text font-semibold">@pageConfig.BreadcrumbCurrent</span>
    </nav>

    @* แสดงข้อความแจ้งเตือนผลการทำงานสำเร็จ *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2.5 shadow-xs">
            <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @* แสดงข้อความแจ้งเตือนข้อผิดพลาด *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2.5 shadow-xs">
            <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- ส่วนหัวของหน้าแสดงสถานะพรีออเดอร์ -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">@pageConfig.Title</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">รายการพรีออเดอร์ทั้งหมดของคุณ จำนวน @preordersList.Count รายการ</p>
        </div>
        <a asp-controller="Home" asp-action="Collection" class="inline-flex items-center gap-1.5 rounded-xl border border-primary/20 bg-primary/5 px-4 py-2 text-xs font-bold text-primary hover:bg-primary/10 transition-colors">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>@pageConfig.AddMoreText</span>
        </a>
    </div>

    @* ฟอร์มค้นหาและกรองสถานะพรีออเดอร์ ส่งไปยัง HomeController แอ็กชัน PreorderStatus *@
    <form asp-controller="Home" asp-action="PreorderStatus" class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="relative flex-1">
            <svg class="size-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" name="searchTerm" value="@Model?.SearchTerm" placeholder="@pageConfig.SearchPlaceholder"
                   class="w-full rounded-xl border border-slate-200 bg-white pl-10 pr-4 py-2.5 text-xs sm:text-sm text-text focus:border-primary focus:outline-none" />
        </div>
        <select name="statusFilter" class="rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs sm:text-sm font-medium text-slate-700 focus:border-primary focus:outline-none">
            <option value="all" selected="@(selectedStatus == "all")">สถานะทั้งหมด</option>
            <option value="active" selected="@(selectedStatus == "active")">กำลังดำเนินการ / พร้อมรับสินค้า</option>
            <option value="completed" selected="@(selectedStatus == "completed")">รับสินค้าสำเร็จเรียบร้อย</option>
            <option value="cancelled" selected="@(selectedStatus == "cancelled")">ยกเลิกคำสั่งจอง</option>
        </select>
        <div class="flex items-center gap-2">
            <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs hover:opacity-90 transition-opacity cursor-pointer">
                @pageConfig.SearchBtnText
            </button>
            @if (!string.IsNullOrWhiteSpace(Model?.SearchTerm) || (selectedStatus != "all"))
            {
                <a asp-controller="Home" asp-action="PreorderStatus" class="rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                    @pageConfig.ClearBtnText
                </a>
            }
        </div>
    </form>

    @if (!preordersList.Any())
    {
        <!-- กรณีไม่พบรายการพรีออเดอร์ -->
        <div class="rounded-3xl border border-dashed border-slate-200 p-12 text-center space-y-4">
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-slate-50 text-slate-400">
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div>
                <h3 class="text-base font-bold text-text">@pageConfig.EmptyTitle</h3>
                <p class="text-xs text-slate-400 mt-1">@pageConfig.EmptySubtitle</p>
            </div>
            <a asp-controller="Home" asp-action="Collection" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-white hover:opacity-90">
                @pageConfig.EmptyActionText
            </a>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var po in preordersList)
            {
                var firstItem = po.Preorderitems.FirstOrDefault();
                string imageUrl = !string.IsNullOrEmpty(firstItem?.Product?.ImageUrl) ? firstItem.Product.ImageUrl : "~/media/images/naruto_hero_fig.png";
                string productName = firstItem?.Product?.Name ?? "รายการฟิกเกอร์พรีออเดอร์";
                int totalQty = po.Preorderitems.Sum(pi => pi.Quantity);

                string statusBadgeText = "รอดำเนินการ";
                string statusBadgeClass = "bg-amber-50/80 border-amber-200/80 text-amber-800";
                string noticeText = "รายการนี้จะแสดงสถานะอัปเดตแบบเรียลไทม์จากหน้าร้าน เมื่อมารับสินค้าแล้วสามารถแจ้งรหัสใบจองนี้ที่เคาน์เตอร์ได้ทันที";
                var steps = new List<dynamic>();
                bool canCancel = false;

                if (po.CurrentStatus == "PendingConfirm" || po.CurrentStatus == "WaitingStock" || po.CurrentStatus == "ReadyForPickup" || po.CurrentStatus == "Reserved")
                {
                    canCancel = true;
                    statusBadgeText = po.CurrentStatus == "ReadyForPickup" ? "สินค้าพร้อมรับแล้ว" : "รอดำเนินการ";
                    steps.Add(new { StepNumber = 1, Title = "แจ้งจองออเดอร์", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 2, Title = "รอชำระเงินและรับสินค้า", IsCompleted = false, IsActive = true, IsCancelled = false });
                }
                else if (po.CurrentStatus == "Completed")
                {
                    statusBadgeText = "สำเร็จเรียบร้อย";
                    statusBadgeClass = "bg-emerald-50/80 border-emerald-200/80 text-emerald-800";
                    noticeText = "รายการพรีออเดอร์นี้เสร็จสมบูรณ์เรียบร้อย ลูกค้าชำระเงินและรับสินค้าแล้ว ขอขอบคุณที่เลือกซื้อสินค้ากับ FriendHouse";
                    steps.Add(new { StepNumber = 1, Title = "แจ้งจองออเดอร์", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 2, Title = "ชำระเงินและรับสินค้าแล้ว", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 3, Title = "สำเร็จ", IsCompleted = true, IsActive = true, IsCancelled = false });
                }
                else if (po.CurrentStatus == "Cancelled")
                {
                    statusBadgeText = "ยกเลิกคำสั่งจอง";
                    statusBadgeClass = "bg-rose-50/80 border-rose-200/80 text-rose-800";
                    noticeText = "รายการนี้ถูกยกเลิกแล้ว เนื่องจากลูกค้ายกเลิกคำสั่งจองหรือไม่ได้มารับสินค้าตามกำหนด";
                    steps.Add(new { StepNumber = 1, Title = "แจ้งจองออเดอร์", IsCompleted = true, IsActive = false, IsCancelled = false });
                    steps.Add(new { StepNumber = 2, Title = "ยกเลิกคำสั่งจอง", IsCompleted = false, IsActive = false, IsCancelled = true });
                }

                <div class="rounded-3xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-all hover:border-primary/30">
                    <!-- แถบสถานะและหมายเลขใบจองด้านบน -->
                    <div class="flex items-center justify-between border-b @statusBadgeClass px-6 py-3.5">
                        <div class="flex items-center gap-2 text-xs sm:text-sm font-bold">
                            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>@statusBadgeText</span>
                        </div>
                        <span class="text-xs font-semibold opacity-80">อ้างอิง @po.ReservationNumber</span>
                    </div>

                    <!-- รายละเอียดสินค้าในใบสั่งจอง -->
                    <div class="p-6 sm:p-8 space-y-6">
                        <div class="space-y-3">
                            @foreach (var item in po.Preorderitems)
                            {
                                string itemImage = !string.IsNullOrEmpty(item.Product?.ImageUrl) ? item.Product.ImageUrl : "~/media/images/naruto_hero_fig.png";
                                <div class="flex items-center gap-4 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                                    <div class="size-16 shrink-0 rounded-xl border border-slate-200 overflow-hidden bg-white">
                                        <img src="@Url.Content(itemImage)" alt="@(item.Product?.Name ?? "สินค้า")" class="size-full object-cover" />
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-sm font-bold text-text truncate">@(item.Product?.Name ?? "สินค้าไม่มีชื่อ")</h3>
                                        <div class="text-xs font-semibold text-primary mt-0.5">฿@item.UnitPrice.ToString("N0") • จำนวน @item.Quantity ชิ้น</div>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-sm font-extrabold text-text">฿@((item.UnitPrice * item.Quantity).ToString("N0"))</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- ข้อมูลสรุปวันที่ทำรายการ กำหนดรับสินค้า และยอดรวม -->
                        <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-slate-100 text-xs">
                            <div class="flex items-center gap-6">
                                <div>
                                    <span class="text-slate-400 block">วันที่ทำรายการ</span>
                                    <span class="font-bold text-text">@po.CreatedAt.ToString("d MMM yyyy")</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block">กรุณามารับภายใน</span>
                                    <span class="font-bold text-text">@po.EstimatedPickupDate.ToString("d MMM yyyy")</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="text-right">
                                    <span class="text-slate-400 block">ยอดรวมทั้งสิ้น จำนวน @totalQty ชิ้น</span>
                                    <span class="text-base font-extrabold text-primary">฿@po.TotalFinalPrice.ToString("N0")</span>
                                </div>

                                @if (canCancel)
                                {
                                    @* ฟอร์มยกเลิกคำสั่งจองพรีออเดอร์ ส่งไปยัง HomeController แอ็กชัน CancelPreorder *@
                                    <form asp-controller="Home" asp-action="CancelPreorder">
                                        <input type="hidden" name="preorderId" value="@po.PreorderId" />
                                        <button type="submit" class="rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2 text-xs font-bold text-rose-600 hover:bg-rose-100 transition-colors cursor-pointer">
                                            @pageConfig.CancelBtnText
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                        <!-- แถบแสดงความคืบหน้าของสถานะใบสั่งจอง -->
                        <div class="border-t border-slate-100 pt-6">
                            <div class="relative max-w-md mx-auto">
                                <div class="absolute top-4.5 left-8 right-8 h-0.5 bg-slate-200 -z-0">
                                    <div class="h-full bg-primary w-full"></div>
                                </div>

                                <div class="relative z-10 grid @(steps.Count == 3 ? "grid-cols-3" : "grid-cols-2") gap-4 sm:gap-8">
                                    @foreach (var step in steps)
                                    {
                                        <div class="flex flex-col items-center text-center space-y-2">
                                            @if (step.IsCancelled)
                                            {
                                                <div class="flex size-9 sm:size-10 items-center justify-center rounded-full bg-rose-500 text-white shadow-xs">
                                                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                    </svg>
                                                </div>
                                                <span class="text-xs sm:text-sm font-bold text-rose-600">@step.Title</span>
                                            }
                                            else if (step.IsCompleted)
                                            {
                                                <div class="flex size-9 sm:size-10 items-center justify-center rounded-full bg-primary text-white shadow-xs">
                                                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="20 6 9 17 4 12"></polyline>
                                                    </svg>
                                                </div>
                                                <span class="text-xs sm:text-sm font-semibold text-text">@step.Title</span>
                                            }
                                            else if (step.IsActive)
                                            {
                                                <div class="flex size-9 sm:size-10 items-center justify-center rounded-full bg-primary text-white ring-4 ring-primary/20 shadow-xs">
                                                    <span class="size-2.5 rounded-full bg-white animate-pulse"></span>
                                                </div>
                                                <span class="text-xs sm:text-sm font-bold text-primary">@step.Title</span>
                                            }
                                            else
                                            {
                                                <div class="flex size-9 sm:size-10 items-center justify-center rounded-full bg-slate-100 text-slate-400 font-bold text-xs">
                                                    @step.StepNumber
                                                </div>
                                                <span class="text-xs sm:text-sm font-medium text-slate-400">@step.Title</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- กล่องข้อความคำแนะนำการรับสินค้า -->
                        <div class="rounded-2xl border border-primary/15 bg-primary/5 p-4 flex gap-3 text-xs text-slate-600 leading-relaxed">
                            <svg class="size-5 shrink-0 text-primary mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <span>@noticeText</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
