                    string rBadgeClass = red.IsCompleted
                        ? "bg-emerald-50/80 border-emerald-200/80 text-emerald-800"
                        : red.IsCancelled
                            ? "bg-rose-50/80 border-rose-200/80 text-rose-800"
                            : "bg-amber-50/80 border-amber-200/80 text-amber-800";

                    string rBadgeText = red.IsCancelled ? rCancelMeta.BadgeTitle : red.StatusText;

                    string rNotice = red.IsCompleted
                        ? "ส่งมอบของรางวัลชิ้นนี้ให้คุณเรียบร้อยแล้ว ขอขอบคุณที่ใช้บริการ FriendHouse"
                        : red.IsCancelled
                            ? $"{rCancelMeta.NoticeText} (คืน {red.PointsSpentFormatted})"
