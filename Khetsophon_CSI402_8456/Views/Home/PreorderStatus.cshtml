@section Scripts {
@* บล็อกสคริปต์ JavaScript สำหรับควบคุมการโต้ตอบฝั่งไคลเอนต์ *@
<script>
    // ฟังก์ชันเปิดหน้าต่างยืนยันยกเลิกคำสั่งจองพรีออเดอร์
    function openCancelPreorderStatusModal(btn) {
        // กำหนดค่ารหัสใบสั่งจองลงในฟิลด์ซ่อน
        document.getElementById('statusCancelPreorderId').value = btn.dataset.preorderId || '';
        // แสดงหมายเลขใบสั่งจอง
        document.getElementById('statusCancelPreorderCode').textContent = 'รหัสอ้างอิง: ' + (btn.dataset.reservationNo || '');
        // แสดงชื่อสินค้า
        document.getElementById('statusCancelPreorderName').textContent = btn.dataset.productName || '';
        // อ้างอิงหน้าต่าง Modal ยกเลิกคำสั่งจอง
        const modal = document.getElementById('cancelPreorderStatusModal');
        // แสดงหน้าต่าง Modal
        modal.classList.remove('hidden');
        // จัดวางด้วย Flexbox
        modal.classList.add('flex');
    }

    // ฟังก์ชันปิดหน้าต่างยืนยันยกเลิกคำสั่งจองพรีออเดอร์
    function closeCancelPreorderStatusModal() {
        // อ้างอิงหน้าต่าง Modal ยกเลิกคำสั่งจอง
        const modal = document.getElementById('cancelPreorderStatusModal');
        // ซ่อนหน้าต่าง Modal
        modal.classList.add('hidden');
        // นำคลาส flex ออก
        modal.classList.remove('flex');
    }

    // ฟังก์ชันและตัวดักจับเหตุการณ์สำหรับควบคุมการทำงานบนหน้าเว็บ
    function openCancelRedeemStatusModal(btn) {
        document.getElementById('statusCancelRedeemId').value = btn.dataset.redemptionId || '';
        document.getElementById('statusCancelRedeemCode').textContent = 'รหัสอ้างอิง: ' + (btn.dataset.redemptionCode || '');
        document.getElementById('statusCancelRedeemTitle').textContent = btn.dataset.rewardTitle || '';
        document.getElementById('statusCancelRedeemPoints').textContent = parseInt(btn.dataset.pointsSpent || '0', 10).toLocaleString('th-TH');

        // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
        const modal = document.getElementById('cancelRedeemStatusModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    // ฟังก์ชันและตัวดักจับเหตุการณ์สำหรับควบคุมการทำงานบนหน้าเว็บ
    function closeCancelRedeemStatusModal() {
        // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
        const modal = document.getElementById('cancelRedeemStatusModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>
}
