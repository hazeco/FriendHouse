@model Khetsophon_CSI402_8456.ViewModels.UserManagementViewModel
@{
    // กำหนดชื่อหน้าเว็บและโครงร่างหน้าผู้ดูแลระบบไอที
    ViewData["Title"] = "จัดการบัญชีผู้ใช้งาน — ร้านบ้านเพื่อน";
    Layout = "_ITSupportLayout";

    // READ: การตั้งค่าข้อมูลเนื้อหา ข้อความ ตัวเลือกการกรอง และไอคอน SVG ที่ส่วนบนสุดของไฟล์
    // WHY: รวมศูนย์ข้อความภาษาไทยทั้งหมดไว้ด้านบนสุดตามกฎของโปรเจกต์ ห้ามมีภาษาอังกฤษในวงเล็บ และห้ามใช้อีโมจิ
    var pageHeader = new {
        Title = "จัดการบัญชีผู้ใช้งานและสมาชิก",
        Subtitle = "สำหรับตรวจสอบ ค้นหา เพิ่ม แก้ไข รีเซ็ตรหัสผ่าน และจัดการสถานะบัญชีของลูกค้าและพนักงาน",
        InfoBanner = "หน้านี้ใช้สำหรับดูข้อมูลบัญชี ช่วยเหลือเรื่องรหัสผ่าน แก้ไขข้อมูลสมาชิก ลบบัญชี หรือปรับสิทธิ์ผู้ใช้งานผ่านฟอร์มมาตรฐาน"
    };

    var roleOptions = new[] {
        new { Value = "all", Label = "ทุกบทบาทผู้ใช้งาน" },
        new { Value = "customer", Label = "ลูกค้าทั่วไป" },
        new { Value = "staff", Label = "พนักงานหน้าร้าน" },
        new { Value = "owner", Label = "เจ้าของร้าน" },
        new { Value = "itsupport", Label = "ผู้ดูแลระบบไอที" },
        new { Value = "accountant", Label = "ฝ่ายบัญชีและการเงิน" }
    };

    var statusOptions = new[] {
        new { Value = "all", Label = "สถานะบัญชีทั้งหมด" },
        new { Value = "ปกติ", Label = "ปกติ" },
        new { Value = "ถูกล็อก", Label = "ถูกล็อก" }
    };

    var userItems = Model?.UserItems ?? new List<Khetsophon_CSI402_8456.ViewModels.UserAccountItemViewModel>();
    var currentSearch = Model?.SearchQuery ?? (ViewBag.SearchQuery as string) ?? string.Empty;
    var currentStatus = Model?.StatusFilter ?? (ViewBag.StatusFilter as string) ?? "all";
    var currentRole = Model?.RoleFilter ?? (ViewBag.RoleFilter as string) ?? "all";
    var tempResetEmail = Model?.TempResetEmail;
    var tempResetPassword = Model?.TempResetPassword;
}

<div class="space-y-6">
    <!-- ส่วนหัวของหน้าจัดการบัญชีผู้ใช้งาน -->
    <div>
        <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
        <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
    </div>

    <!-- แถบข้อมูลแนะนำการใช้งาน -->
    <div class="rounded-2xl bg-[#EFF6FF] border border-[#BFDBFE] p-4 flex items-center gap-3 text-xs text-[#1E40AF]">
        <svg class="size-4.5 shrink-0 text-[#2563EB]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="font-medium">@pageHeader.InfoBanner</span>
    </div>

    <!-- แสดงข้อความแจ้งเตือนผลสำเร็จหรือข้อผิดพลาดจาก TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-2xl bg-[#ECFDF5] border border-[#A7F3D0] p-4 flex items-center gap-3 text-xs text-[#065F46] shadow-xs">
            <svg class="size-5 text-[#10B981] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-2xl bg-[#FEF2F2] border border-[#FECACA] p-4 flex items-center gap-3 text-xs text-[#991B1B] shadow-xs">
            <svg class="size-5 text-[#EF4444] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- READ: ฟอร์มค้นหาและกรองบัญชีผู้ใช้งานตามมาตรฐาน MVC (ไม่มีแอตทริบิวต์ method) -->
    <form asp-controller="ITSupport" asp-action="Users" class="flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-[280px]">
            <svg class="size-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text"
                   name="searchQuery"
                   value="@currentSearch"
                   placeholder="ค้นหาด้วยชื่อ-นามสกุล อีเมล รหัสผู้ใช้ หรือเบอร์โทรศัพท์..."
                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
        </div>

        <div class="relative">
            <select name="roleFilter" class="appearance-none pr-9 pl-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 shadow-2xs focus:outline-none">
                @foreach (var rOpt in roleOptions)
                {
                    if (string.Equals(currentRole, rOpt.Value, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@rOpt.Value" selected>@rOpt.Label</option>
                    }
                    else
                    {
                        <option value="@rOpt.Value">@rOpt.Label</option>
                    }
                }
            </select>
            <svg class="size-4 absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <div class="relative">
            <select name="statusFilter" class="appearance-none pr-9 pl-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 shadow-2xs focus:outline-none">
                @foreach (var sOpt in statusOptions)
                {
                    if (string.Equals(currentStatus, sOpt.Value, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@sOpt.Value" selected>@sOpt.Label</option>
                    }
                    else
                    {
                        <option value="@sOpt.Value">@sOpt.Label</option>
                    }
                }
            </select>
            <svg class="size-4 absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <button type="submit" class="px-5 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold text-sm shadow-xs transition-colors cursor-pointer">
            ค้นหา
        </button>

        @if (!string.IsNullOrWhiteSpace(currentSearch) || currentStatus != "all" || currentRole != "all")
        {
            <a asp-controller="ITSupport" asp-action="Users" class="px-4 py-2.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-semibold text-sm transition-colors">
                ล้างตัวกรอง
            </a>
        }

        <button type="button" onclick="openAddUserModal()" class="px-5 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold text-sm shadow-xs transition-colors cursor-pointer ml-auto">
            เพิ่มผู้ใช้งาน
        </button>
    </form>

    <!-- ตารางแสดงข้อมูลบัญชีผู้ใช้งาน -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[840px]" id="usersTable">
                <thead>
                    <tr class="border-b border-gray-100 text-left text-xs font-semibold text-gray-400 bg-[#FBFBFE]">
                        <th class="py-4 px-6">อีเมลและชื่อผู้ใช้งาน</th>
                        <th class="py-4 px-6">เบอร์โทรศัพท์</th>
                        <th class="py-4 px-6 text-center">สถานะบัญชี</th>
                        <th class="py-4 px-6 text-center">แต้มสะสม</th>
                        <th class="py-4 px-6">เข้าสู่ระบบล่าสุด</th>
                        <th class="py-4 px-6">วันที่สมัคร</th>
                        <th class="py-4 px-6 text-center">จัดการบัญชี</th>
                        <th class="py-4 px-6 text-right">การช่วยเหลือ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (userItems.Any())
                    {
                        @foreach (var u in userItems)
                        {
                            <tr class="hover:bg-gray-50/70 transition-colors user-row">
                                <!-- อีเมลและรายละเอียดบทบาทภาษาไทย -->
                                <td class="py-4 px-6 font-semibold text-[#050315]">
                                    <div>@u.Email</div>
                                    <div class="text-xs text-gray-500 font-normal mt-0.5">
                                        @u.DisplayName · <span class="text-[#2F39A9] font-semibold">@u.RoleDisplayThai</span>
                                    </div>
                                </td>

                                <!-- เบอร์โทรศัพท์ -->
                                <td class="py-4 px-6 text-gray-500 font-mono text-xs">
                                    @u.Phone
                                </td>

                                <!-- ป้ายกำกับสถานะบัญชี -->
                                <td class="py-4 px-6 text-center">
                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full @(u.IsActive ? "bg-[#DCFCE7] text-[#16A34A]" : "bg-[#FEE2E2] text-[#DC2626]")">
                                        <span class="size-1.5 rounded-full bg-current"></span>
                                        @u.StatusText
                                    </span>
                                </td>

                                <!-- แต้มสะสม -->
                                <td class="py-4 px-6 text-center font-bold text-xs text-[#2F39A9]">
                                    @u.Points.ToString("N0") แต้ม
                                </td>

                                <!-- เวลาเข้าสู่ระบบล่าสุด -->
                                <td class="py-4 px-6 text-gray-500 text-xs">
                                    @if (u.LastLoginAt.HasValue)
                                    {
                                        <span>@u.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm น.")</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 italic">ยังไม่มีประวัติ</span>
                                    }
                                </td>

                                <!-- วันที่สมัครสมาชิก -->
                                <td class="py-4 px-6 text-gray-500 text-xs">
                                    @u.CreatedAt.ToString("dd/MM/yyyy")
                                </td>

                                <!-- ปุ่มแก้ไขและลบบัญชี -->
                                <td class="py-4 px-6 text-center">
                                    <div class="inline-flex items-center gap-1.5">
                                        <button type="button"
                                                onclick="openEditUserModal('@u.Email', '@u.Phone', '@(u.FullName ?? "")', '@u.RoleName', @u.Points, '@(u.IsActive ? "ปกติ" : "ถูกล็อก")')"
                                                class="size-8 rounded-lg bg-blue-50 hover:bg-blue-100 text-[#2563EB] flex items-center justify-center transition cursor-pointer"
                                                title="แก้ไขข้อมูล">
                                            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 20h9"></path>
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
                                            </svg>
                                        </button>
                                        <button type="button"
                                                onclick="openDeleteUserModal('@u.Email')"
                                                class="size-8 rounded-lg bg-red-50 hover:bg-red-100 text-[#DC2626] flex items-center justify-center transition cursor-pointer"
                                                title="ลบบัญชี">
                                            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>

                                <!-- ปุ่มช่วยรีเซ็ตรหัสผ่าน -->
                                <td class="py-4 px-6 text-right">
                                    <button type="button"
                                            onclick="openResetPasswordModal('@u.Email', @u.UserId)"
                                            class="px-3.5 py-1.5 rounded-lg bg-[#EFF6FF] hover:bg-blue-100 text-[#2563EB] text-xs font-semibold transition cursor-pointer">
                                        ช่วยรีเซ็ตรหัสผ่าน
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="py-8 text-center text-xs text-gray-400">
                                ไม่พบรายชื่อบัญชีผู้ใช้งานที่ตรงกับเงื่อนไขการค้นหา
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ส่วนท้ายตารางแสดงจำนวนบัญชีทั้งหมด -->
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
            <span>แสดงทั้งหมด @userItems.Count บัญชี</span>
        </div>
    </div>
</div>

<!-- 1. CREATE MODAL: หน้าต่างเพิ่มผู้ใช้งานใหม่ด้วยฟอร์ม MVC มาตรฐาน -->
<div id="addUserModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-[#050315]">เพิ่มผู้ใช้งานใหม่</h3>
            <button type="button" onclick="closeAllModals()" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <form asp-controller="ITSupport" asp-action="CreateUser" class="space-y-3">
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">บทบาทผู้ใช้งาน</label>
                <select name="role" id="newUserRole" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]">
                    <option value="Customer">ลูกค้าทั่วไป</option>
                    <option value="Staff">พนักงานหน้าร้าน</option>
                    <option value="Owner">เจ้าของร้าน</option>
                    <option value="ITSupport">ผู้ดูแลระบบไอที</option>
                    <option value="Accountant">ฝ่ายบัญชีและการเงิน</option>
                </select>
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">ชื่อ-นามสกุล</label>
                <input type="text" name="fullName" required placeholder="ระบุชื่อ-นามสกุลภาษาไทย" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">อีเมล</label>
                <input type="email" name="email" placeholder="example@friendhouse.com" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">เบอร์โทรศัพท์</label>
                <input type="tel" name="phone" placeholder="0812345678" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">รหัสผ่านเริ่มต้น</label>
                <input type="password" name="password" placeholder="ตั้งรหัสผ่านอย่างน้อย 6 ตัวอักษร" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div class="flex items-center gap-2 pt-2">
                <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                    ยกเลิก
                </button>
                <button type="submit" class="flex-1 bg-[#2F39A9] hover:bg-[#242D87] text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                    สร้างบัญชี
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 2. UPDATE MODAL: หน้าต่างแก้ไขข้อมูลผู้ใช้งานด้วยฟอร์ม MVC มาตรฐาน (ไม่มี fetch) -->
<div id="editUserModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-[#050315]">แก้ไขข้อมูลบัญชีผู้ใช้</h3>
            <button type="button" onclick="closeAllModals()" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <form asp-controller="ITSupport" asp-action="EditUser" class="space-y-3">
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">อีเมลบัญชีผู้ใช้</label>
                <input type="email" name="email" id="editUserEmail" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs bg-gray-50" readonly />
            </div>
            <div>
                <label class="text-xs font-bold text-gray-700 block mb-1">ชื่อ-นามสกุล</label>
                <input type="text" name="fullName" id="editUserFullName" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="text-xs font-bold text-gray-700 block mb-1">เบอร์โทรศัพท์</label>
                    <input type="tel" name="phone" id="editUserPhone" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
                </div>
                <div>
                    <label class="text-xs font-bold text-gray-700 block mb-1">แต้มสะสม</label>
                    <input type="number" name="points" id="editUserPoints" min="0" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="text-xs font-bold text-gray-700 block mb-1">บทบาทผู้ใช้งาน</label>
                    <select name="role" id="editUserRole" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]">
                        <option value="customer">ลูกค้าทั่วไป</option>
                        <option value="staff">พนักงานหน้าร้าน</option>
                        <option value="owner">เจ้าของร้าน</option>
                        <option value="itsupport">ผู้ดูแลระบบไอที</option>
                        <option value="accountant">ฝ่ายบัญชีและการเงิน</option>
                    </select>
                </div>
                <div>
                    <label class="text-xs font-bold text-gray-700 block mb-1">สถานะบัญชี</label>
                    <select name="status" id="editUserStatus" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-xs focus:outline-none focus:border-[#2F39A9]">
                        <option value="ปกติ">ปกติ</option>
                        <option value="ถูกล็อก">ถูกล็อก</option>
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-2 pt-2">
                <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                    ยกเลิก
                </button>
                <button type="submit" class="flex-1 bg-[#2F39A9] hover:bg-[#242D87] text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                    บันทึกการแก้ไข
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 3. RESET PASSWORD MODAL: หน้าต่างยืนยันการรีเซ็ตรหัสผ่านด้วยฟอร์ม MVC มาตรฐาน -->
<div id="resetPasswordModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 sm:p-7 shadow-2xl space-y-4 text-center border border-slate-100">
        <div class="size-14 rounded-full bg-amber-50 text-amber-500 mx-auto flex items-center justify-center">
            <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>
        <div>
            <h3 class="text-lg font-bold text-[#050315]">ยืนยันการรีเซ็ตรหัสผ่าน</h3>
            <p class="text-xs font-mono font-bold text-[#2F39A9] mt-1 bg-indigo-50 py-1 px-3 rounded-lg inline-block" id="resetTargetEmail"></p>
            <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                คุณแน่ใจหรือไม่ว่าต้องการรีเซ็ตรหัสผ่านสำหรับบัญชีนี้ ระบบจะสร้างรหัสผ่านชั่วคราวใหม่เพื่อให้เจ้าหน้าที่นำไปส่งมอบให้แก่ผู้ใช้งาน
            </p>
        </div>
        <form asp-controller="ITSupport" asp-action="ResetPassword" class="flex items-center gap-2 pt-2">
            <input type="hidden" name="userId" id="resetTargetUserId" />
            <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                ยกเลิก
            </button>
            <button type="submit" class="flex-1 bg-[#2F39A9] hover:bg-[#2F39A9]/90 text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                ยืนยันสร้างรหัส
            </button>
        </form>
    </div>
</div>

<!-- 3.1 หน้าต่างแสดงรหัสผ่านชั่วคราวที่เพิ่งสร้างเสร็จจาก TempData -->
@if (!string.IsNullOrEmpty(tempResetPassword))
{
    <div id="passwordGeneratedModal" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-2xl space-y-4 text-center border border-slate-100">
            <div class="size-14 rounded-full bg-emerald-50 text-emerald-500 mx-auto flex items-center justify-center">
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-[#050315]">สร้างรหัสผ่านชั่วคราวสำเร็จ</h3>
                <p class="text-xs text-slate-500 mt-1">
                    สำหรับผู้ใช้งาน: <span class="font-bold text-[#050315]">@tempResetEmail</span>
                </p>
            </div>

            <div class="bg-slate-50 rounded-2xl border border-slate-200/90 p-4 space-y-2">
                <div class="text-[11px] font-semibold text-slate-400">รหัสผ่านชั่วคราวใหม่</div>
                <div class="flex items-center justify-center gap-3">
                    <span class="font-mono text-xl font-black text-[#2F39A9] tracking-wider select-all" id="generatedPasswordBox">
                        @tempResetPassword
                    </span>
                    <button type="button" onclick="copyGeneratedPassword()"
                            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 shadow-2xs transition cursor-pointer">
                        <span id="copyPassLabel">คัดลอก</span>
                    </button>
                </div>
            </div>

            <div class="pt-2">
                <button type="button" onclick="closeAllModals()" class="w-full bg-[#2F39A9] hover:bg-[#2F39A9]/90 text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                    เสร็จสิ้น
                </button>
            </div>
        </div>
    </div>
}

<!-- 4. DELETE MODAL: หน้าต่างยืนยันการลบบัญชีผู้ใช้ด้วยฟอร์ม MVC มาตรฐาน -->
<div id="deleteUserModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl space-y-4 text-center">
        <div class="size-12 rounded-full bg-red-100 text-[#DC2626] mx-auto flex items-center justify-center">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </div>
        <div>
            <h3 class="text-base font-bold text-[#050315]">คุณแน่ใจว่าจะลบบัญชีนี้หรือไม่</h3>
            <p class="text-xs font-mono text-gray-500 mt-1" id="deleteTargetEmailLabel"></p>
            <p class="text-xs text-gray-500 mt-2">การลบบัญชีจะปิดการใช้งานหรือลบข้อมูลออกจากระบบทันที</p>
        </div>
        <form asp-controller="ITSupport" asp-action="DeleteUser" class="flex items-center gap-2 pt-2">
            <input type="hidden" name="email" id="deleteTargetEmailInput" />
            <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                ยกเลิก
            </button>
            <button type="submit" class="flex-1 bg-[#DC2626] hover:bg-[#B91C1C] text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                ยืนยันลบ
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // เปิดหน้าต่างเพิ่มผู้ใช้งานใหม่
        function openAddUserModal() {
            document.getElementById('addUserModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างแก้ไขข้อมูลผู้ใช้งานและเติมค่าปัจจุบันลงในฟอร์ม
        function openEditUserModal(email, phone, fullName, role, points, status) {
            document.getElementById('editUserEmail').value = email;
            document.getElementById('editUserPhone').value = phone || '';
            document.getElementById('editUserFullName').value = fullName || '';
            document.getElementById('editUserPoints').value = points || 0;
            if (role) {
                document.getElementById('editUserRole').value = role.toLowerCase();
            }
            document.getElementById('editUserStatus').value = status || 'ปกติ';
            document.getElementById('editUserModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างยืนยันการรีเซ็ตรหัสผ่าน
        function openResetPasswordModal(email, userId) {
            document.getElementById('resetTargetEmail').innerText = email;
            document.getElementById('resetTargetUserId').value = userId;
            document.getElementById('resetPasswordModal')?.classList.remove('hidden');
        }

        // คัดลอกรหัสผ่านชั่วคราวลงคลิปบอร์ด
        function copyGeneratedPassword() {
            const passBox = document.getElementById('generatedPasswordBox');
            if (!passBox) return;
            const pass = passBox.innerText.trim();
            navigator.clipboard.writeText(pass).then(() => {
                const label = document.getElementById('copyPassLabel');
                if (label) label.innerText = 'คัดลอกแล้ว';
            });
        }

        // เปิดหน้าต่างยืนยันการลบบัญชีผู้ใช้งาน
        function openDeleteUserModal(email) {
            document.getElementById('deleteTargetEmailLabel').innerText = email;
            document.getElementById('deleteTargetEmailInput').value = email;
            document.getElementById('deleteUserModal')?.classList.remove('hidden');
        }

        // ปิดหน้าต่าง Modal ทั้งหมดในหน้านี้
        function closeAllModals() {
            document.querySelectorAll('[id$="Modal"]').forEach(m => m.classList.add('hidden'));
        }
    </script>
}
