@{
    ViewData["Title"] = "ภาพรวมสถานะระบบ";
    Layout = "_ITSupportLayout";

    // ดึงรายการบันทึกประวัติกิจกรรมล่าสุดจาก ViewBag
    var recentLogs = ViewBag.RecentLogs as IEnumerable<Khetsophon_CSI402_8456.Models.Systemlog> ?? Enumerable.Empty<Khetsophon_CSI402_8456.Models.Systemlog>();

    // การกำหนดค่าข้อความส่วนหัวของหน้า
    var pageHeader = new {
        Title = "ภาพรวมสถานะระบบ",
        Subtitle = "ระบบติดตามสถานะเซิร์ฟเวอร์ ฐานข้อมูล และกิจกรรมระบบแบบ Realtime",
        RefreshText = "รีเฟรชข้อมูล"
    };

    // การกำหนดค่าสถิติสถานะของระบบ
    var serverStats = new {
        ServerStatus = "ออนไลน์",
        ServerLatency = "สถานะระบบทำงานปกติ",
        DbStatus = "MySQL ปกติ",
        DbBackup = ViewBag.TotalProducts != null ? $"สินค้าในระบบ {ViewBag.TotalProducts} รายการ" : "เชื่อมต่อฐานข้อมูลสมบูรณ์",
        TotalUsers = ViewBag.TotalUsers != null ? $"{ViewBag.TotalUsers} บัญชี" : "0 บัญชี",
        UsersSubtext = "สมาชิกและเจ้าหน้าที่ในระบบ",
        TotalLogs = ViewBag.TotalLogs != null ? $"{ViewBag.TotalLogs} รายการ" : "0 รายการ",
        LogsSubtext = ViewBag.ErrorLogs != null ? $"พบข้อผิดพลาด {ViewBag.ErrorLogs} ครั้ง" : "ไม่มีข้อผิดพลาด"
    };
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="space-y-6">
    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (TempData["SuccessMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="rounded-2xl bg-[#ECFDF5] border border-[#A7F3D0] p-4 flex items-center gap-3 text-xs text-[#065F46] shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-[#10B981] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }
    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="rounded-2xl bg-[#FEF2F2] border border-[#FECACA] p-4 flex items-center gap-3 text-xs text-[#DC2626] shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-[#DC2626] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Header Row (frame_9_19.png) -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div>
            @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
            <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
        </div>
        @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
        <button type="button" onclick="location.reload()"
                class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-bold px-4 py-2.5 rounded-xl shadow-2xs transition-colors cursor-pointer text-sm">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span>@pageHeader.RefreshText</span>
        </button>
    </div>

    <!-- 4 Stat Cards in a row (frame_9_19.png) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: สถานะเซิร์ฟเวอร์ -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center justify-between">
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="text-xs text-gray-400 font-medium">สถานะเซิร์ฟเวอร์</span>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="size-2 rounded-full bg-[#16A34A]"></span>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.ServerStatus</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-gray-400">@serverStats.ServerLatency</div>
        </div>

        <!-- Card 2: ฐานข้อมูล MySQL -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center justify-between">
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="text-xs text-gray-400 font-medium">ฐานข้อมูล</span>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="size-2 rounded-full bg-[#16A34A]"></span>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.DbStatus</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-gray-400">@serverStats.DbBackup</div>
        </div>

        <!-- Card 3: ผู้ใช้งานทั้งหมด -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center justify-between">
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="text-xs text-gray-400 font-medium">ผู้ใช้งานทั้งหมด</span>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="size-2 rounded-full bg-[#2F39A9]"></span>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.TotalUsers</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-gray-400">@serverStats.UsersSubtext</div>
        </div>

        <!-- Card 4: บันทึกกิจกรรมระบบ -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center justify-between">
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="text-xs text-gray-400 font-medium">บันทึกกิจกรรมระบบ</span>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="size-2 rounded-full bg-[#D97706]"></span>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.TotalLogs</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-gray-400">@serverStats.LogsSubtext</div>
        </div>
    </div>

    <!-- 2 Columns Grid: 30-Day Uptime & Recent Events (frame_9_19.png) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left 2 Cols: Uptime 30 วันล่าสุด -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-6">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center justify-between flex-wrap gap-2">
                @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
                <h2 class="text-sm font-bold text-[#050315]">Uptime รายวัน (30 วันล่าสุด)</h2>
                @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                <div class="flex items-center gap-4 text-xs">
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="flex items-center gap-1.5 text-gray-600 font-medium">
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="size-2 rounded-full bg-[#2F39A9]"></span> ปกติ (≥99.5%)
                    </span>
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="flex items-center gap-1.5 text-gray-600 font-medium">
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="size-2 rounded-full bg-[#D97706]"></span> สะดุด
                    </span>
                </div>
            </div>

            <!-- 30 Daily Bars Chart matching Figma -->
            <div class="h-48 flex items-end justify-between gap-1.5 pt-4">
                @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                @for (int i = 1; i <= 30; i++)
                {
                    bool isIncident = (i == 6 || i == 20);
                    int height = isIncident ? 40 : 85 + ((i * 7) % 15);
                    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                    <div class="flex-1 flex flex-col items-center h-full justify-end group cursor-pointer relative"
                         title="วันที่ @i: @(isIncident ? "98.2% (สะดุด)" : "100% (ปกติ)")">
                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                        <div class="w-full rounded-t-sm transition-all duration-200 @(isIncident ? "bg-[#D97706] hover:bg-[#B45309]" : "bg-[#2F39A9] hover:bg-[#202778]")"
                             style="height: @(height)%;"></div>
                    </div>
                }
            </div>

            <!-- X Axis Dates -->
            <div class="flex items-center justify-between text-xs text-gray-400 border-t border-gray-100 pt-2 font-mono">
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>11 ส.ค.</span>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>25 ส.ค.</span>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>09 ก.ย.</span>
            </div>
        </div>

        <!-- Right 1 Col: เหตุการณ์ล่าสุดจากฐานข้อมูลจริง -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
            @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
            <h2 class="text-sm font-bold text-[#050315]">เหตุการณ์ล่าสุด</h2>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="space-y-4">
                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                @if (recentLogs.Any())
                {
                    @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                    @foreach (var ev in recentLogs)
                    {
                        var iconBg = ev.LogLevel == "ERROR" ? "bg-[#FEE2E2] text-[#DC2626]" :
                                     ev.LogLevel == "WARNING" ? "bg-[#FEF3C7] text-[#D97706]" : "bg-[#DBEAFE] text-[#2F39A9]";

                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                        <div class="flex items-start gap-3">
                            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                            <div class="size-8 rounded-full @iconBg flex items-center justify-center shrink-0 mt-0.5">
                                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                @if (ev.LogLevel == "ERROR")
                                {
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                }
                                else if (ev.LogLevel == "WARNING")
                                {
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                }
                                else
                                {
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                            </div>
                            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                            <div class="flex-1 min-w-0">
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div class="text-xs font-semibold text-[#050315] leading-snug">@ev.Module: @ev.Message</div>
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div class="text-[11px] text-gray-400 mt-0.5 font-mono">@ev.Timestamp.ToString("dd MMM yyyy HH:mm น.")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                    <div class="text-xs text-gray-400 text-center py-6">
                        ยังไม่มีประวัติกิจกรรมในระบบ
                    </div>
                }
            </div>
        </div>
    </div>
</div>
