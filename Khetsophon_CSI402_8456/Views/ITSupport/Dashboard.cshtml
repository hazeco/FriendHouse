@* กำหนดตัวแปรและการตั้งค่าของหน้าเว็บภาพรวมระบบ *@
@{
    // กำหนดชื่อหัวข้อของหน้าเว็บภาพรวมสถานะระบบ
    ViewData["Title"] = "ภาพรวมสถานะระบบ";
    // กำหนดเค้าโครงหลักสำหรับผู้ดูแลระบบไอที
    Layout = "_ITSupportLayout";

    // ดึงรายการบันทึกประวัติกิจกรรมล่าสุดจาก ViewBag
    var recentLogs = ViewBag.RecentLogs as IEnumerable<Khetsophon_CSI402_8456.Models.Systemlog> ?? Enumerable.Empty<Khetsophon_CSI402_8456.Models.Systemlog>();
    // ดึงค่าช่วงเวลาของกราฟบันทึกกิจกรรมระบบ
    var chartRange = (ViewBag.ChartRange as string) ?? "30d";
    // ดึงหัวข้อของกราฟบันทึกกิจกรรมระบบ
    var chartTitle = (ViewBag.ChartTitle as string) ?? "สถิติบันทึกกิจกรรมระบบรายวัน (30 วันล่าสุด)";
    // ดึงป้ายกำกับแกนเวลาเริ่มต้น
    var chartStartLabel = (ViewBag.ChartStartLabel as string) ?? "";
    // ดึงป้ายกำกับแกนเวลากึ่งกลาง
    var chartMidLabel = (ViewBag.ChartMidLabel as string) ?? "";
    // ดึงป้ายกำกับแกนเวลาสิ้นสุด
    var chartEndLabel = (ViewBag.ChartEndLabel as string) ?? "";
    // ดึงรายการข้อมูลแท่งกราฟแบบซ้อนสัดส่วนจริงจากฐานข้อมูลจริง
    var chartBars = (ViewBag.ChartBars as List<(string Label, int InfoCount, int WarningCount, int ErrorCount, int TotalCount, int HeightPct, int InfoPct, int WarningPct, int ErrorPct)>) ?? new List<(string Label, int InfoCount, int WarningCount, int ErrorCount, int TotalCount, int HeightPct, int InfoPct, int WarningPct, int ErrorPct)>();

    // การกำหนดค่าข้อความส่วนหัวของหน้า
    var pageHeader = new {
        // ชื่อเรื่องของหน้าภาพรวมระบบ
        Title = "ภาพรวมสถานะระบบ",
        // คำอธิบายหน้าที่ของระบบติดตามสถานะ
        Subtitle = "ระบบติดตามสถานะเซิร์ฟเวอร์ ฐานข้อมูล และกิจกรรมระบบแบบ Realtime",
        // ข้อความบนปุ่มรีเฟรชข้อมูล
        RefreshText = "รีเฟรชข้อมูล"
    };

    // การกำหนดค่าสถิติสถานะของระบบ
    var serverStats = new {
        // สถานะการทำงานของเซิร์ฟเวอร์
        ServerStatus = "ออนไลน์",
        // ความเร็วและความหน่วงของเซิร์ฟเวอร์
        ServerLatency = "สถานะระบบทำงานปกติ",
        // สถานะการเชื่อมต่อฐานข้อมูล MySQL
        DbStatus = "MySQL ปกติ",
        // ข้อมูลการสำรองหรือจำนวนข้อมูลสินค้า
        DbBackup = ViewBag.TotalProducts != null ? $"สินค้าในระบบ {ViewBag.TotalProducts} รายการ" : "เชื่อมต่อฐานข้อมูลสมบูรณ์",
        // จำนวนผู้ใช้งานทั้งหมดในระบบ
        TotalUsers = ViewBag.TotalUsers != null ? $"{ViewBag.TotalUsers} บัญชี" : "0 บัญชี",
        // คำอธิบายย่อยของผู้ใช้งานในระบบ
        UsersSubtext = "สมาชิกและเจ้าหน้าที่ในระบบ",
        // จำนวนรายการบันทึกกิจกรรมทั้งหมด
        TotalLogs = ViewBag.TotalLogs != null ? $"{ViewBag.TotalLogs} รายการ" : "0 รายการ",
        // คำอธิบายย่อยจำนวนข้อผิดพลาด
        LogsSubtext = ViewBag.ErrorLogs != null ? $"พบข้อผิดพลาด {ViewBag.ErrorLogs} ครั้ง" : "ไม่มีข้อผิดพลาด"
    };
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดระยะห่างระหว่างองค์ประกอบ *@
<div class="space-y-6">
    @* ตรวจสอบเงื่อนไขข้อความสำเร็จจาก TempData *@
    @if (TempData["SuccessMessage"] != null) {
        @* กล่องแจ้งเตือนสีเขียวเมื่อการดำเนินการสำเร็จ *@
        <div class="rounded-2xl bg-[#ECFDF5] border border-[#A7F3D0] p-4 flex items-center gap-3 text-xs text-[#065F46] shadow-xs">
            @* ไอคอนเครื่องหมายถูก SVG แสดงสถานะสำเร็จ *@
            <svg class="size-5 text-[#10B981] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            @* ข้อความแจ้งเตือนความสำเร็จ *@
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }
    @* ตรวจสอบเงื่อนไขข้อความข้อผิดพลาดจาก TempData *@
    @if (TempData["ErrorMessage"] != null) {
        @* กล่องแจ้งเตือนสีแดงเมื่อเกิดข้อผิดพลาด *@
        <div class="rounded-2xl bg-[#FEF2F2] border border-[#FECACA] p-4 flex items-center gap-3 text-xs text-[#DC2626] shadow-xs">
            @* ไอคอนเครื่องหมายตกใจ SVG แสดงข้อผิดพลาด *@
            <svg class="size-5 text-[#DC2626] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            @* ข้อความแจ้งเตือนข้อผิดพลาด *@
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    @* แถวส่วนหัวแสดงชื่อระบบและปุ่มรีเฟรชข้อมูล *@
    <div class="flex items-center justify-between flex-wrap gap-4">
        @* กล่องชื่อหน้าและคำอธิบาย *@
        <div>
            @* หัวข้อหลักของหน้าภาพรวมสถานะระบบ *@
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            @* คำอธิบายรายละเอียดหน้าที่ของระบบติดตามสถานะ *@
            <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
        </div>
        @* ปุ่มรีเฟรชข้อมูลหน้าจอเพื่อโหลดสถานะล่าสุด *@
        <button type="button" onclick="location.reload()" class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-bold px-4 py-2.5 rounded-xl shadow-2xs transition-colors cursor-pointer text-sm">
            @* ไอคอนหมุนรีเฟรช SVG *@
            <svg class="size-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
            @* ข้อความปุ่มรีเฟรช *@
            <span>@pageHeader.RefreshText</span>
        </button>
    </div>

    @* แถวการ์ดสถิติระบบ 4 ใบแสดงสถานะเซิร์ฟเวอร์ ฐานข้อมูล สมาชิก และประวัติกิจกรรม *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @* การ์ดที่ 1: แสดงสถานะเซิร์ฟเวอร์ *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องส่วนหัวการ์ดสถานะเซิร์ฟเวอร์ *@
            <div class="flex items-center justify-between">
                @* ป้ายกำกับชื่อสถานะเซิร์ฟเวอร์ *@
                <span class="text-xs text-gray-400 font-medium">สถานะเซิร์ฟเวอร์</span>
                @* จุดสีเขียวแสดงสถานะออนไลน์ *@
                <span class="size-2 rounded-full bg-[#16A34A]"></span>
            </div>
            @* ข้อความสถานะเซิร์ฟเวอร์ออนไลน์ตัวหนา *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.ServerStatus</div>
            @* คำอธิบายความหน่วงของเซิร์ฟเวอร์ *@
            <div class="text-xs text-gray-400">@serverStats.ServerLatency</div>
        </div>

        @* การ์ดที่ 2: แสดงสถานะฐานข้อมูล MySQL *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องส่วนหัวการ์ดสถานะฐานข้อมูล *@
            <div class="flex items-center justify-between">
                @* ป้ายกำกับฐานข้อมูล *@
                <span class="text-xs text-gray-400 font-medium">ฐานข้อมูล</span>
                @* จุดสีเขียวแสดงสถานะปกติของฐานข้อมูล *@
                <span class="size-2 rounded-full bg-[#16A34A]"></span>
            </div>
            @* ข้อความสถานะฐานข้อมูล MySQL ปกติ *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.DbStatus</div>
            @* ข้อมูลจำนวนสินค้าหรือการเชื่อมต่อฐานข้อมูล *@
            <div class="text-xs text-gray-400">@serverStats.DbBackup</div>
        </div>

        @* การ์ดที่ 3: แสดงจำนวนผู้ใช้งานทั้งหมดในระบบ *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องส่วนหัวการ์ดจำนวนผู้ใช้งาน *@
            <div class="flex items-center justify-between">
                @* ป้ายกำกับผู้ใช้งานทั้งหมด *@
                <span class="text-xs text-gray-400 font-medium">ผู้ใช้งานทั้งหมด</span>
                @* จุดสีน้ำเงินแสดงผู้ใช้งานในระบบ *@
                <span class="size-2 rounded-full bg-[#2F39A9]"></span>
            </div>
            @* ตัวเลขจำนวนบัญชีผู้ใช้งานทั้งหมด *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.TotalUsers</div>
            @* คำอธิบายสัดส่วนสมาชิกและเจ้าหน้าที่ในระบบ *@
            <div class="text-xs text-gray-400">@serverStats.UsersSubtext</div>
        </div>

        @* การ์ดที่ 4: แสดงจำนวนบันทึกกิจกรรมระบบทั้งหมด *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-2">
            @* กล่องส่วนหัวการ์ดบันทึกกิจกรรมระบบ *@
            <div class="flex items-center justify-between">
                @* ป้ายกำกับบันทึกกิจกรรมระบบ *@
                <span class="text-xs text-gray-400 font-medium">บันทึกกิจกรรมระบบ</span>
                @* จุดสีส้มแสดงบันทึกกิจกรรม *@
                <span class="size-2 rounded-full bg-[#D97706]"></span>
            </div>
            @* ตัวเลขจำนวนรายการบันทึกกิจกรรมทั้งหมด *@
            <div class="text-3xl font-extrabold text-[#050315]">@serverStats.TotalLogs</div>
            @* คำอธิบายสถิติจำนวนข้อผิดพลาดที่ตรวจพบ *@
            <div class="text-xs text-gray-400">@serverStats.LogsSubtext</div>
        </div>
    </div>

    @* การจัดโครงร่างแบบ 2 คอลัมน์สำหรับกราฟสถานะระบบและเหตุการณ์ล่าสุด *@
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        @* คอลัมน์ซ้าย 2 ส่วนแสดงกราฟบันทึกกิจกรรมระบบจริงแบบแท่งซ้อน (รายวัน / 30 วัน / 90 วัน) *@
        <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-6">
            @* กล่องจัดวางส่วนหัวกราฟและปุ่มสลับช่วงเวลา *@
            <div class="flex items-center justify-between flex-wrap gap-3">
                @* กล่องหัวข้อกราฟและคำอธิบายสีสัดส่วนข้อมูล *@
                <div class="space-y-1.5">
                    @* หัวข้อกราฟบันทึกกิจกรรมระบบตามช่วงเวลา *@
                    <h2 class="text-sm font-bold text-[#050315]">@chartTitle</h2>
                    @* แถบคำอธิบายสีของระดับความสำคัญในกราฟแท่งแบบซ้อน *@
                    <div class="flex items-center flex-wrap gap-4 text-xs">
                        @* ป้ายคำอธิบายสีระดับปกติ (INFO) สีน้ำเงิน *@
                        <span class="flex items-center gap-1.5 text-gray-600 font-medium"><span class="size-2 rounded-full bg-[#2F39A9]"></span> Info (ปกติ)</span>
                        @* ป้ายคำอธิบายสีระดับแจ้งเตือน (WARNING) สีส้ม *@
                        <span class="flex items-center gap-1.5 text-gray-600 font-medium"><span class="size-2 rounded-full bg-[#D97706]"></span> Warning (แจ้งเตือน)</span>
                        @* ป้ายคำอธิบายสีระดับข้อผิดพลาด (ERROR) สีแดง *@
                        <span class="flex items-center gap-1.5 text-gray-600 font-medium"><span class="size-2 rounded-full bg-[#DC2626]"></span> Error (ข้อผิดพลาด)</span>
                    </div>
                </div>

                @* ปุ่มสลับช่วงเวลาของกราฟ (รายวัน 1d / 30 วัน 30d / 90 วัน 90d) *@
                <div class="inline-flex items-center rounded-xl bg-gray-100 p-1 text-xs font-bold">
                    @* ปุ่มดูกราฟรายวัน 24 ชั่วโมง *@
                    <a asp-controller="ITSupport" asp-action="Dashboard" asp-route-range="1d" class="px-3 py-1.5 rounded-lg transition-colors @(chartRange == "1d" ? "bg-[#2F39A9] text-white shadow-2xs" : "text-gray-600 hover:text-[#050315]")">รายวัน</a>
                    @* ปุ่มดูกราฟ 30 วันล่าสุด *@
                    <a asp-controller="ITSupport" asp-action="Dashboard" asp-route-range="30d" class="px-3 py-1.5 rounded-lg transition-colors @(chartRange == "30d" ? "bg-[#2F39A9] text-white shadow-2xs" : "text-gray-600 hover:text-[#050315]")">30 วัน</a>
                    @* ปุ่มดูกราฟ 90 วันล่าสุด *@
                    <a asp-controller="ITSupport" asp-action="Dashboard" asp-route-range="90d" class="px-3 py-1.5 rounded-lg transition-colors @(chartRange == "90d" ? "bg-[#2F39A9] text-white shadow-2xs" : "text-gray-600 hover:text-[#050315]")">90 วัน</a>
                </div>
            </div>

            @* กราฟแท่งแบบซ้อนตามสัดส่วนจริง (Stacked Bar) แสดงจำนวน Info, Warning, Error จากฐานข้อมูลจริง *@
            <div class="h-48 flex items-end justify-between gap-1.5 pt-4">
                @* วนลูปแสดงผลแท่งกราฟแต่ละช่วงเวลา *@
                @foreach (var bar in chartBars) {
                    @* กล่องแท่งกราฟพร้อมข้อความ Tooltip แสดงจำนวน Info / Warning / Error ตามจริง *@
                    <div class="flex-1 flex flex-col items-center h-full justify-end group cursor-pointer relative" title="@bar.Label: ทั้งหมด @bar.TotalCount รายการ (Info: @bar.InfoCount, Warning: @bar.WarningCount, Error: @bar.ErrorCount)">
                        @* ตรวจสอบเงื่อนไขว่ามีกิจกรรมในแท่งเวลานี้หรือไม่ *@
                        @if (bar.TotalCount == 0) {
                            @* กรณีไม่มีรายการบันทึกในช่วงเวลานั้น แสดงแท่งสีเทาจาง *@
                            <div class="w-full rounded-t-sm bg-gray-200 hover:bg-gray-300 transition-all duration-200" style="height: @(bar.HeightPct)%;"></div>
                        }
                        @* กรณีมีรายการบันทึกในแท่งช่วงเวลานี้ แสดงแท่งสัดส่วนจริง *@
                        else {
                            @* แท่งกราฟแบบซ้อนสัดส่วนจริง: สีแดง (Error) อยู่ด้านบน, สีส้ม (Warning) ตรงกลาง, และสีน้ำเงิน (Info) เป็นฐานหลัก *@
                            <div class="w-full rounded-t-sm overflow-hidden flex flex-col justify-end transition-all duration-200 group-hover:opacity-90" style="height: @(bar.HeightPct)%;">
                                @* ตรวจสอบสัดส่วนรายการ Error ว่ามากกว่าศูนย์หรือไม่ *@
                                @if (bar.ErrorPct > 0) {
                                    @* ส่วนสีแดงแสดงสัดส่วนรายการ Error บนสุด *@
                                    <div class="w-full bg-[#DC2626]" style="height: @(bar.ErrorPct)%;"></div>
                                }
                                @* ตรวจสอบสัดส่วนรายการ Warning ว่ามากกว่าศูนย์หรือไม่ *@
                                @if (bar.WarningPct > 0) {
                                    @* ส่วนสีส้มแสดงสัดส่วนรายการ Warning ตรงกลาง *@
                                    <div class="w-full bg-[#D97706]" style="height: @(bar.WarningPct)%;"></div>
                                }
                                @* ตรวจสอบสัดส่วนรายการ Info ว่ามากกว่าศูนย์หรือไม่ *@
                                @if (bar.InfoPct > 0) {
                                    @* ส่วนสีน้ำเงินแสดงสัดส่วนรายการ Info ซึ่งเป็นฐานหลัก *@
                                    <div class="w-full bg-[#2F39A9]" style="height: @(bar.InfoPct)%;"></div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* ป้ายกำกับแกน X แสดงวันที่หรือเวลาตามช่วงที่เลือก *@
            <div class="flex items-center justify-between text-xs text-gray-400 border-t border-gray-100 pt-2 font-mono">
                @* ป้ายกำกับเริ่มต้นแกนเวลา *@
                <span>@chartStartLabel</span>
                @* ป้ายกำกับกึ่งกลางแกนเวลา *@
                <span>@chartMidLabel</span>
                @* ป้ายกำกับสิ้นสุดแกนเวลา *@
                <span>@chartEndLabel</span>
            </div>
        </div>

        @* คอลัมน์ขวา 1 ส่วนแสดงรายการเหตุการณ์ล่าสุดจากฐานข้อมูลจริง *@
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
            @* หัวข้อย่อยแสดงประวัติเหตุการณ์ล่าสุด *@
            <h2 class="text-sm font-bold text-[#050315]">เหตุการณ์ล่าสุด</h2>
            @* รายการเหตุการณ์แบบเว้นระยะห่าง *@
            <div class="space-y-4">
                @* ตรวจสอบว่ามีรายการบันทึกประวัติล่าสุดหรือไม่ *@
                @if (recentLogs.Any()) {
                    @* วนลูปแสดงผลรายการกิจกรรมย่อยแต่ละชิ้น *@
                    @foreach (var ev in recentLogs) {
                        // แปลงระดับความสำคัญเป็นตัวพิมพ์ใหญ่เพื่อให้แสดงสีเหลือง/แดงได้ตรงกันทุกรายการ
                        var evLevel = (ev.LogLevel ?? "INFO").ToUpperInvariant();
                        // กำหนดสีพื้นหลังและสีไอคอนตามระดับความสำคัญ
                        var iconBg = evLevel == "ERROR" ? "bg-[#FEE2E2] text-[#DC2626]" : (evLevel == "WARNING" ? "bg-[#FEF3C7] text-[#D97706]" : "bg-[#DBEAFE] text-[#2F39A9]");

                        @* แถวจัดวางไอคอนและรายละเอียดเหตุการณ์ *@
                        <div class="flex items-start gap-3">
                            @* กล่องวงกลมสีตามระดับความสำคัญสำหรับบรรจุไอคอน *@
                            <div class="size-8 rounded-full @iconBg flex items-center justify-center shrink-0 mt-0.5">
                                @* ตรวจสอบเงื่อนไขระดับ Error เพื่อแสดงไอคอนกากบาท *@
                                @if (evLevel == "ERROR") {
                                    @* ไอคอนกากบาท SVG สีแดงสำหรับ Error *@
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                }
                                // ตรวจสอบเงื่อนไขระดับ Warning เพื่อแสดงไอคอนเครื่องหมายตกใจ
                                else if (evLevel == "WARNING") {
                                    @* ไอคอนสามเหลี่ยมเตือนภัย SVG สีส้มสำหรับ Warning *@
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                }
                                // กรณีระดับ Info หรือทั่วไป แสดงไอคอนเครื่องหมายถูก
                                else {
                                    @* ไอคอนเช็กถูก SVG สีน้ำเงินสำหรับ Info *@
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                }
                            </div>
                            @* กล่องข้อความรายละเอียดเหตุการณ์และเวลา *@
                            <div class="flex-1 min-w-0">
                                @* ข้อความโมดูลและรายละเอียดเหตุการณ์ *@
                                <div class="text-xs font-semibold text-[#050315] leading-snug">@ev.Module: @ev.Message</div>
                                @* วันที่และเวลาที่เกิดเหตุการณ์ในรูปแบบภาษาไทย *@
                                <div class="text-[11px] text-gray-400 mt-0.5 font-mono">@ev.Timestamp.ToString("dd MMM yyyy HH:mm น.")</div>
                            </div>
                        </div>
                    }
                }
                @* กรณีไม่มีประวัติกิจกรรมในระบบ *@
                else {
                    @* ข้อความแจ้งกรณีไม่มีประวัติกิจกรรมในระบบ *@
                    <div class="text-xs text-gray-400 text-center py-6">ยังไม่มีประวัติกิจกรรมในระบบ</div>
                }
            </div>
        </div>
    </div>
</div>
