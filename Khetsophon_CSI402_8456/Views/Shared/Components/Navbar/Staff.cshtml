@* ประกาศและกำหนดค่าข้อมูลระบบแถบนำทางพนักงาน *@
@{
    // ดึงตัวเลขแจ้งเตือนรายการเร่งด่วนฝั่งหน้าร้านจาก ViewBag
    int notifCount = ViewBag.StaffNotificationCount != null ? (int)ViewBag.StaffNotificationCount : 0;
    // ดึงจำนวนสินค้าที่หมดสต็อก
    int outOfStockCount = ViewBag.StaffOutOfStockCount != null ? (int)ViewBag.StaffOutOfStockCount : 0;
    // ดึงจำนวนสินค้าที่ใกล้หมดสต็อก
    int lowStockCount = ViewBag.StaffLowStockCount != null ? (int)ViewBag.StaffLowStockCount : 0;
    // ดึงจำนวนรายการพรีออเดอร์ที่รอดำเนินการ
    int pendingPreorders = ViewBag.StaffPendingPreorders != null ? (int)ViewBag.StaffPendingPreorders : 0;
    // ดึงจำนวนรายการแลกของรางวัลที่รอดำเนินการ
    int pendingRewards = ViewBag.StaffPendingRewards != null ? (int)ViewBag.StaffPendingRewards : 0;

    // กำหนดข้อมูลแบรนด์ ชื่อบทบาทพนักงาน และข้อมูลโปรไฟล์ไว้ส่วนบนสุดของไฟล์
    var brand = new {
        // เส้นทางไฟล์รูปภาพโลโก้ร้าน
        LogoUrl = "~/logo/logo.png",
        // ชื่อแบรนด์ร้านค้า
        Name = "FriendHouse",
        // คำบรรยายบทบาทของระบบ
        Subtitle = "ระบบจัดการสต็อก · หน้าร้าน",
        // จำนวนการแจ้งเตือน
        NotificationCount = notifCount,
        // ชื่อผู้ใช้งานพนักงาน
        UserName = ViewBag.RoleUserName as string ?? "พนักงานหน้าร้าน",
        // ชื่อบทบาทที่แสดงผล
        UserRole = "พนักงาน",
        // อักษรย่อสำหรับแสดงในรูปโปรไฟล์
        UserInitials = ViewBag.RoleUserInitials as string ?? "พน"
    };

    // ตรวจสอบชื่อ Controller ปัจจุบัน
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    // ตรวจสอบชื่อ Action ปัจจุบันเพื่อไฮไลต์เมนูที่ใช้งานอยู่
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // ฟังก์ชันคืนค่าคลาส CSS สำหรับปุ่มเมนูนำทางฝั่งพนักงาน
    string NavClass(string action) {
        // ตรวจสอบความตรงกันของแอ็กชันเพื่อระบุสถานะ Active
        bool isActive = currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
        // คืนค่าคลาส CSS ตามสถานะการใช้งาน
        return isActive ? "px-4 py-2 rounded-xl bg-[#3E4AB8] text-white font-semibold text-sm transition-all" : "px-4 py-2 rounded-xl hover:bg-white/10 text-white/80 hover:text-white font-medium text-sm transition-all";
    }
}

@* แถบนำทางหลักสีน้ำเงินเข้มสำหรับบทบาทพนักงานหน้าร้าน *@
<div class="bg-[#2F39A9] text-white">
    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        @* โลโก้ร้านและชื่อระบบจัดการสต็อกหน้าร้าน เชื่อมโยงกลับหน้าแรกพนักงาน *@
        <a asp-controller="Staff" asp-action="Index" class="flex items-center gap-3 shrink-0 cursor-pointer">
            @* กล่องบรรจุรูปภาพโลโก้ร้านทรงสี่เหลี่ยมโค้งมน *@
            <div class="size-9 rounded-xl overflow-hidden bg-white shadow-xs flex items-center justify-center shrink-0">
                @* รูปภาพโลโก้ร้านพร้อมตัวสำรองกรณีโหลดรูปไม่สำเร็จ *@
                <img src="@Url.Content(brand.LogoUrl)" alt="@brand.Name" class="size-full object-cover" onerror="this.outerHTML='<span class=\'text-[#2F39A9] font-black text-xs\'>FH</span>'" />
            </div>
            @* กล่องข้อความชื่อแบรนด์และคำบรรยายระบบหน้าร้าน *@
            <div>
                @* ชื่อแบรนด์ FriendHouse ตัวหนาสีขาว *@
                <div class="font-bold leading-tight text-sm tracking-tight text-white">@brand.Name</div>
                @* คำบรรยายระบบจัดการสต็อกหน้าร้าน *@
                <div class="text-[11px] text-white/75 leading-tight">@brand.Subtitle</div>
            </div>
        </a>

        @* เมนูหลักฝั่งพนักงาน: สต็อกสินค้า และเคาน์เตอร์พรีออเดอร์ บนหน้าจอเดสก์ท็อป *@
        <nav class="hidden md:flex items-center gap-2">
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าสต็อกสินค้า *@
            <a asp-controller="Staff" asp-action="Index" class="@NavClass("Index")">
                @* ข้อความป้ายกำกับเมนูสต็อกสินค้า *@
                <span>สต็อกสินค้า</span>
            </a>
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเคาน์เตอร์พรีออเดอร์ *@
            <a asp-controller="Staff" asp-action="CounterPreorder" class="@NavClass("CounterPreorder")">
                @* ข้อความป้ายกำกับเมนูเคาน์เตอร์พรีออเดอร์ *@
                <span>เคาน์เตอร์พรีออเดอร์</span>
            </a>
        </nav>

        @* ส่วนแสดงข้อมูลพนักงานและปุ่มออกจากระบบ *@
        <div class="flex items-center gap-3.5">
            @* กล่องแสดงภาพย่อโปรไฟล์และชื่อพนักงาน *@
            <div class="flex items-center gap-2.5">
                @* กล่องวงกลมสีขาวแสดงอักษรย่อของพนักงาน *@
                <div class="size-8 rounded-full bg-white text-[#2F39A9] font-bold text-xs flex items-center justify-center shadow-xs">@brand.UserInitials</div>
                @* กล่องข้อความแสดงชื่อและตำแหน่งพนักงาน ซ่อนบนหน้าจอขนาดเล็ก *@
                <div class="hidden sm:block text-left">
                    @* ชื่อจริงของพนักงานหน้าร้าน *@
                    <div class="text-xs font-bold leading-tight text-white">@brand.UserName</div>
                    @* ตำแหน่งพนักงาน *@
                    <div class="text-[10px] text-white/70 leading-tight">@brand.UserRole</div>
                </div>
            </div>

            @* ลิงก์ออกจากระบบสำหรับพนักงานหน้าร้าน *@
            <a asp-controller="Account" asp-action="Logout" asp-route-role="staff" class="text-xs font-semibold text-white/80 hover:text-red-300 transition-colors cursor-pointer shrink-0">ออกจากระบบ</a>
        </div>
    </div>

    @* แถบนำทางย่อยสำหรับหน้าจอมือถือ รองรับการเลื่อนตามแนวนอน *@
    <div class="md:hidden border-t border-white/10 px-4 py-2 flex items-center gap-2 overflow-x-auto">
        @* ปุ่มเมนูสต็อกสินค้าบนมือถือ *@
        <a asp-controller="Staff" asp-action="Index" class="@NavClass("Index") text-xs py-1.5 px-3 shrink-0">สต็อกสินค้า</a>
        @* ปุ่มเมนูเคาน์เตอร์พรีออเดอร์บนมือถือ *@
        <a asp-controller="Staff" asp-action="CounterPreorder" class="@NavClass("CounterPreorder") text-xs py-1.5 px-3 shrink-0">เคาน์เตอร์พรีออเดอร์</a>
    </div>
</div>
