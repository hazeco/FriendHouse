@using Khetsophon_CSI402_8456.Controllers
<!DOCTYPE html>
<html lang="th" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Khetsophon_CSI402_8456</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script type="module" src="https://cdnjs.cloudflare.com/ajax/libs/model-viewer/4.3.1/model-viewer.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Khetsophon_CSI402_8456.styles.css" asp-append-version="true" />
</head>
@{
    var sessionRole = Context.Session.GetString("Role")?.ToLowerInvariant();
    var customerUserId = Context.Session.GetInt32("CustomerUserId");
    var queryRole = Context.Request.Query["role"].ToString().ToLowerInvariant();

    // WHY: Layout หน้าร้านจะแสดง Navbar หน้าร้านเสมอ
    // ไม่สลับไปเป็น Navbar ฝั่งจัดการของพนักงาน/ผู้จัดการ แม้จะมีการล็อกอินบทบาทอื่นในอีกแท็บก็ตาม
    string userRole = "guest";
    if (sessionRole == "customer" || customerUserId.HasValue || queryRole == "customer")
    {
        userRole = "customer";
    }
    else if (ViewData["Role"] is string explicitRole && explicitRole.ToLowerInvariant() == "customer")
    {
        userRole = "customer";
    }
}
<body class="flex min-h-screen flex-col bg-background text-text bg-white">
    <header class="sticky top-0 z-50 w-full bg-white">
        @await Component.InvokeAsync("Navbar", new { role = userRole })
    </header>
    <main role="main" class="flex-1 w-full">
        @RenderBody()
    </main>
    @await Component.InvokeAsync("Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
