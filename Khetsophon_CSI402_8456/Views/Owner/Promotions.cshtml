@model IEnumerable<Khetsophon_CSI402_8456.Models.Promotion>
@{
    ViewData["Title"] = "จัดการโปรโมชั่น";
    Layout = "_OwnerLayout";

    var hasDbData = Model != null && Model.Any();

    // Top-of-file Media & Content Configuration
    var pageHeader = new {
        Breadcrumb = "โปรโมชั่น",
        Title = "จัดการโปรโมชั่น",
        Subtitle = "ตั้งค่าและติดตามโปรโมชั่นทั้งหมดของร้าน — เปิด/ปิดใช้งานได้ทันทีจากหน้านี้",
        CreateButtonText = "+ สร้างโปรโมชั่นใหม่",
        CreateAction = "AddPromotion",
        CreateController = "Owner"
    };

    var stats = new {
        Total = hasDbData ? Model!.Count() : 0,
        Active = hasDbData ? Model!.Count(p => p.IsActive == true) : 0,
        Inactive = hasDbData ? Model!.Count(p => p.IsActive == false) : 0,
        ExpiringSoon = 1
    };
}

<div class="space-y-6">
    <!-- Breadcrumb & Header Row (frame_9_7.png) -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <div class="text-xs text-gray-400 font-medium mb-1">@pageHeader.Breadcrumb</div>
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
        </div>
        <a asp-controller="@pageHeader.CreateController" asp-action="@pageHeader.CreateAction"
           class="inline-flex items-center gap-2 bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold px-5 py-2.5 rounded-xl shadow-xs transition-colors cursor-pointer text-sm">
            <span>@pageHeader.CreateButtonText</span>
        </a>
    </div>

    <!-- 4 Stat Cards in a row (frame_9_7.png) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5">
            <div class="text-xs text-gray-400 font-medium">โปรโมชั่นทั้งหมด</div>
            <div class="text-3xl font-extrabold text-[#050315] mt-1.5">@stats.Total</div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5">
            <div class="text-xs text-gray-400 font-medium">เปิดใช้งานอยู่</div>
            <div class="text-3xl font-extrabold text-[#2F39A9] mt-1.5">@stats.Active</div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5">
            <div class="text-xs text-gray-400 font-medium">ปิดใช้งาน</div>
            <div class="text-3xl font-extrabold text-gray-500 mt-1.5">@stats.Inactive</div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5">
            <div class="text-xs text-gray-400 font-medium">ใกล้หมดเขต (7 วัน)</div>
            <div class="text-3xl font-extrabold text-[#2F39A9] mt-1.5">@stats.ExpiringSoon</div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-2xl bg-[#ECFDF5] border border-[#A7F3D0] p-4 flex items-center gap-3 text-xs text-[#065F46] shadow-xs">
            <svg class="size-5 text-[#10B981] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Table Card (frame_9_7.png) -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[640px]">
                <thead>
                    <tr class="border-b border-gray-100 text-left text-xs font-semibold text-gray-400 bg-[#FBFBFE]">
                        <th class="py-4 px-6 w-36">ประเภท</th>
                        <th class="py-4 px-6">ชื่อโปรโมชั่น</th>
                        <th class="py-4 px-6">เงื่อนไข / รหัสคูปอง</th>
                        <th class="py-4 px-6 text-center w-36">สถานะ</th>
                        <th class="py-4 px-6 text-center w-24">จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (hasDbData)
                    {
                        @foreach (var p in Model!)
                        {
                            <tr class="hover:bg-gray-50/70 transition-colors">
                                <!-- Type Badge -->
                                <td class="py-4 px-6">
                                    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#ECFEFF] text-[#0E7490] border border-[#A5F3FC]">
                                        @(p.PromoType == "percent" ? "ส่วนลด %" : "ส่วนลดคงที่")
                                    </span>
                                </td>

                                <!-- Title & Subtitle -->
                                <td class="py-4 px-6">
                                    <div class="font-bold text-[#050315] text-sm">@p.Name</div>
                                    <div class="text-xs text-[#2F39A9] font-mono mt-0.5">โค้ด: @p.VoucherCode</div>
                                </td>

                                <!-- Condition -->
                                <td class="py-4 px-6 text-xs text-gray-600">
                                    ลด @(p.DiscountValue?.ToString("N0") ?? "0") @(p.PromoType == "percent" ? "%" : "บาท") (ยอดซื้อขั้นต่ำ @(p.MinimumSpend?.ToString("N0") ?? "0") บาท) · @p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy")
                                </td>

                                <!-- Toggle Switch (Active/Inactive) -->
                                <td class="py-4 px-6 text-center">
                                    <label class="inline-flex flex-col items-center cursor-pointer">
                                        <input type="checkbox" class="sr-only peer" @(p.IsActive == true ? "checked" : "") onchange="togglePromoStatus(this, @p.PromotionId)" />
                                        <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#2F39A9]"></div>
                                        <span class="text-[11px] font-medium text-gray-400 mt-1 promo-status-label">
                                            @(p.IsActive == true ? "เปิดใช้งาน" : "ปิดใช้งาน")
                                        </span>
                                    </label>
                                </td>

                                <!-- Management: Edit & Delete Buttons -->
                                <td class="py-4 px-6 text-center">
                                    <div class="inline-flex items-center gap-1.5">
                                        <a asp-controller="Owner" asp-action="EditPromotion" asp-route-id="@p.PromotionId"
                                           class="inline-flex size-8 rounded-lg bg-blue-50 hover:bg-blue-100 items-center justify-center text-[#2563EB] shadow-2xs transition-colors cursor-pointer" title="แก้ไขโปรโมชั่น">
                                            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 20h9"></path>
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
                                            </svg>
                                        </a>
                                        <button type="button" onclick="confirmDeletePromo(@p.PromotionId, '@p.Name')"
                                                class="inline-flex size-8 rounded-lg bg-red-50 hover:bg-red-100 items-center justify-center text-[#DC2626] shadow-2xs transition-colors cursor-pointer" title="ลบโปรโมชั่น">
                                            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-xs text-gray-400">
                                ยังไม่มีโปรโมชั่นในระบบ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Promotion Modal -->
<div id="deletePromoModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl space-y-4 animate-scale-up text-center">
        <div class="size-12 rounded-full bg-red-100 text-[#DC2626] mx-auto flex items-center justify-center">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </div>
        <div>
            <h3 class="text-base font-bold text-[#050315]">ยืนยันการลบโปรโมชั่น</h3>
            <p class="text-xs font-semibold text-[#2F39A9] mt-1" id="deletePromoNameText"></p>
            <p class="text-xs text-gray-500 mt-2">ระบบจะทำการปิดการใช้งานโปรโมชั่นนี้เพื่อรักษาประวัติข้อมูลการสั่งซื้อเดิม</p>
        </div>
        <div class="flex items-center gap-2 pt-2">
            <button type="button" onclick="closeDeletePromoModal()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-xs cursor-pointer">
                ยกเลิก
            </button>
            <button type="button" onclick="executeDeletePromo()" class="flex-1 bg-[#DC2626] hover:bg-[#B91C1C] text-white py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-xs">
                ยืนยันลบ
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let targetPromoId = 0;

        async function togglePromoStatus(input, promoId) {
            const label = input.parentElement.querySelector('.promo-status-label');
            if (label) {
                label.innerText = input.checked ? 'เปิดใช้งาน' : 'ปิดใช้งาน';
            }

            if (promoId) {
                const formData = new FormData();
                formData.append('id', promoId);
                try {
                    await fetch('/Owner/TogglePromotion', { method: 'POST', body: formData });
                } catch (e) { }
            }
        }

        function confirmDeletePromo(promoId, promoName) {
            targetPromoId = promoId;
            document.getElementById('deletePromoNameText').innerText = promoName;
            document.getElementById('deletePromoModal').classList.remove('hidden');
        }

        function closeDeletePromoModal() {
            document.getElementById('deletePromoModal').classList.add('hidden');
            targetPromoId = 0;
        }

        async function executeDeletePromo() {
            if (targetPromoId > 0) {
                const formData = new FormData();
                formData.append('id', targetPromoId);
                try {
                    const res = await fetch('/Owner/DeletePromotion', { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert(data.message || 'เกิดข้อผิดพลาดในการลบ');
                    }
                } catch (e) {
                    window.location.reload();
                }
            }
        }
    </script>
}
