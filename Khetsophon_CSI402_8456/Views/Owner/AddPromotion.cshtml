@{
    // กำหนดชื่อหัวข้อของหน้าสร้างโปรโมชั่นใหม่
    ViewData["Title"] = "สร้างโปรโมชั่นใหม่";
    // กำหนด Layout หลักของฝั่งเจ้าของร้าน
    Layout = "_OwnerLayout";

    // กำหนดค่าคอนฟิกข้อความและหัวเรื่องส่วนบนสุดของไฟล์ตามมาตรฐานโครงการ
    var pageHeader = new {
        Breadcrumb1 = "โปรโมชั่น",
        Breadcrumb2 = "สร้างโปรโมชั่นใหม่",
        Title = "สร้างโปรโมชั่นใหม่"
    };

    // ดึงรายการสินค้าทั้งหมดในร้านจาก ViewBag สำหรับเลือกของแถมหรือจับคู่ชุด Bundle
    var allProducts = ViewBag.AllProducts as List<Khetsophon_CSI402_8456.Models.Product> ?? new List<Khetsophon_CSI402_8456.Models.Product>();
}

@* แบบฟอร์มสร้างโปรโมชั่นใหม่เชื่อมโยงไปยัง OwnerController.AddPromotion (ไม่ใส่ method attribute) *@
<form asp-controller="Owner" asp-action="AddPromotion" class="space-y-6">
    @* ตรวจสอบและแสดงข้อความแจ้งเตือนข้อผิดพลาด *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องข้อความสีแดงแจ้งเตือนข้อผิดพลาด *@
        <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 flex items-center gap-3 text-xs text-rose-800 shadow-xs">
            <svg class="size-5 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    @* ส่วนหัวนำทางและปุ่มย้อนกลับไปยังหน้ารายการโปรโมชั่น *@
    <div>
        @* แถบแสดงลำดับขั้นเมนูนำทาง *@
        <div class="text-xs text-gray-400 font-medium flex items-center gap-1.5 mb-2">
            <a asp-controller="Owner" asp-action="Promotions" class="hover:text-gray-600">@pageHeader.Breadcrumb1</a>
            <span>/</span>
            <span class="text-gray-600">@pageHeader.Breadcrumb2</span>
        </div>
        @* ปุ่มย้อนกลับพร้อมหัวข้อใหญ่ของหน้าเว็บ *@
        <div class="flex items-center gap-3">
            @* ปุ่มไอคอนย้อนกลับ *@
            <a asp-controller="Owner" asp-action="Promotions"
               class="size-9 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center text-gray-600 shadow-2xs transition-colors cursor-pointer">
                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </a>
            @* หัวข้อหลักของหน้าสร้างโปรโมชั่นใหม่ *@
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
        </div>
    </div>

    @* โครงสร้างกริด 2 คอลัมน์ (ซ้ายข้อมูลหลัก 2 ส่วน / ขวาสถานะและเงื่อนไข 1 ส่วน) *@
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        @* คอลัมน์ด้านซ้ายสำหรับกรอกข้อมูลหลักของโปรโมชั่น *@
        <div class="lg:col-span-2 space-y-6">
            @* การ์ดสีขาวบรรจุช่องกรอกข้อมูลรายละเอียดโปรโมชั่น *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-5">
                @* หัวข้อกลุ่มข้อมูลหลัก *@
                <h2 class="text-base font-bold text-[#050315]">ข้อมูลหลักโปรโมชั่น</h2>

                @* ช่องกรอกชื่อโปรโมชั่น *@
                <div>
                    @* ป้ายกำกับช่องกรอกชื่อโปรโมชั่น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">ชื่อโปรโมชั่น</label>
                    @* ช่องกรอกข้อความชื่อโปรโมชั่น *@
                    <input type="text" name="Name" placeholder="ระบุชื่อโปรโมชั่น (เช่น Flash Sale ประจำเดือน)" required
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                </div>

                @* ช่องกรอกรหัสโปรโมชั่นพร้อมปุ่มสุ่มโค้ดอัตโนมัติ *@
                <div>
                    @* ป้ายกำกับช่องกรอกรหัสโปรโมชั่น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">รหัสโปรโมชั่น / Voucher Code</label>
                    @* กล่องจัดวางแนวนอนระหว่างช่องกรอกและปุ่มกด *@
                    <div class="flex items-center gap-2">
                        @* ช่องกรอกรหัสโปรโมชั่น *@
                        <input type="text" name="VoucherCode" id="voucherCodeInput" placeholder="ระบุโค้ด (เช่น FRIENDS20)" required
                               class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-mono focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                        @* ปุ่มคลิกสุ่มรหัสคูปองอัตโนมัติ *@
                        <button type="button" onclick="generateVoucherCode()"
                                class="px-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 hover:bg-gray-100 text-xs font-bold text-gray-700 transition cursor-pointer shadow-2xs shrink-0">
                            สร้างรหัสอัตโนมัติ
                        </button>
                    </div>
                </div>

                @* ส่วนเลือกประเภทโปรโมชั่นทั้ง 5 แบบ *@
                <div>
                    @* ป้ายกำกับประเภทโปรโมชั่น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">ประเภทโปรโมชั่น</label>
                    @* กล่องปุ่มเลือกประเภทส่วนลด *@
                    <div class="bg-gray-100 p-1 rounded-xl grid grid-cols-2 sm:grid-cols-5 gap-1">
                        @* ปุ่มเลือกส่วนลดแบบเปอร์เซ็นต์ *@
                        <button type="button" data-promo-type="percent" onclick="selectDiscountType('percent')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-bold text-[#050315] bg-white shadow-xs transition cursor-pointer">
                            ส่วนลด %
                        </button>
                        @* ปุ่มเลือกส่วนลดแบบจำนวนเงินบาท *@
                        <button type="button" data-promo-type="fixed" onclick="selectDiscountType('fixed')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer">
                            ส่วนลดบาท
                        </button>
                        @* ปุ่มเลือกโปรโมชั่นซื้อ 1 แถม 1 *@
                        <button type="button" data-promo-type="bogo" onclick="selectDiscountType('bogo')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer">
                            ซื้อ 1 แถม 1
                        </button>
                        @* ปุ่มเลือกโปรโมชั่นชุดเซ็ตสุดคุ้ม *@
                        <button type="button" data-promo-type="bundle" onclick="selectDiscountType('bundle')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer">
                            ชุดเซ็ตสุดคุ้ม
                        </button>
                        @* ปุ่มเลือกโปรโมชั่นแต้มสะสมสองเท่า *@
                        <button type="button" data-promo-type="double_points" onclick="selectDiscountType('double_points')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer col-span-2 sm:col-span-1">
                            แต้มสะสม x2
                        </button>
                    </div>
                    @* ฟิลด์ซ่อนสำหรับเก็บค่าประเภทโปรโมชั่น *@
                    <input type="hidden" name="PromoType" id="promoTypeInput" value="percent" />
                </div>

                @* แถวคู่กรอกมูลค่าส่วนลดและยอดสั่งซื้อขั้นต่ำ *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @* ช่องกรอกมูลค่าส่วนลด *@
                    <div id="discountValueWrapper">
                        @* ป้ายกำกับมูลค่าส่วนลด *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5" id="discountValueLabel">มูลค่าส่วนลด (%)</label>
                        @* ช่องกรอกตัวเลขมูลค่าส่วนลด *@
                        <input type="number" name="DiscountValue" id="discountValueInput" value="0" min="0" max="100" step="0.01" required
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                        @* ข้อความคำแนะนำการกรอกค่าส่วนลด *@
                        <p class="text-[11px] text-gray-400 mt-1" id="discountValueHint">ระบุเปอร์เซ็นต์ส่วนลด 1 ถึง 100 เช่น 10 หรือ 20</p>
                    </div>
                    @* ช่องกรอกยอดสั่งซื้อขั้นต่ำ *@
                    <div>
                        @* ป้ายกำกับยอดสั่งซื้อขั้นต่ำ *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5">ยอดสั่งซื้อขั้นต่ำ (฿)</label>
                        @* ช่องกรอกตัวเลขยอดสั่งซื้อขั้นต่ำ *@
                        <input type="number" name="MinimumSpend" value="0" min="0" step="0.01"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                    </div>
                </div>

                @* ส่วนเลือกขอบเขตสินค้าที่ร่วมรายการสำหรับส่วนลดทั่วไป / ล้างสต็อก / แต้มสะสม *@
                <div id="standardScopePanel" class="space-y-3">
                    @* ป้ายกำกับขอบเขตสินค้า *@
                    <label class="text-xs font-bold text-gray-700 block">ขอบเขตสินค้าที่ร่วมรายการ</label>
                    @* กลุ่มปุ่มเลือกขอบเขตสินค้า *@
                    <div class="flex items-center gap-2 flex-wrap">
                        @* ปุ่มเลือกสินค้าทั้งหมด *@
                        <button type="button" onclick="selectScope(this, 'all')" class="scope-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#2F39A9] text-white shadow-xs cursor-pointer">
                            สินค้าทั้งหมด
                        </button>
                        @* ปุ่มเลือกเฉพาะหมวดฟิกเกอร์ *@
                        <button type="button" onclick="selectScope(this, 'figures')" class="scope-btn px-4 py-2 rounded-xl text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 cursor-pointer">
                            เฉพาะหมวดฟิกเกอร์
                        </button>
                        @* ปุ่มเลือกเฉพาะสินค้าค้างสต็อกนาน / ลดล้างสต็อก *@
                        <button type="button" onclick="selectScope(this, 'clearance')" class="scope-btn px-4 py-2 rounded-xl text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 cursor-pointer">
                            สินค้าค้างสต็อกนาน / ล้างสต็อกสิ้นปี
                        </button>
                    </div>
                </div>

                @* แผงตั้งค่าเฉพาะสำหรับโปรโมชั่น "ซื้อ 1 แถม 1" (เลือกได้ว่าจะแถมตัวมันเอง แถมสินค้าที่ระบุ หรือให้ลูกค้าเลือกเอง) *@
                <div id="bogoConfigPanel" class="hidden rounded-2xl border border-[#92EEFF] bg-[#F8FAFF] p-4 space-y-4">
                    @* หัวข้อแผงตั้งค่าซื้อ 1 แถม 1 *@
                    <div class="text-xs font-bold text-[#2F39A9]">ตั้งค่าเงื่อนไข ซื้อ 1 แถม 1 (กำหนดสินค้าที่ซื้อและรูปแบบของแถม)</div>

                    @* เลือกสินค้าหรือหมวดหมู่ที่ลูกค้าต้องซื้อ *@
                    <div>
                        @* ป้ายกำกับสินค้าที่ต้องซื้อ *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5">1. สินค้าที่ต้องซื้อ (เงื่อนไขการรับแถม)</label>
                        @* ดรอปดาวน์เลือกหมวดหมู่หรือสินค้าเฉพาะรุ่น *@
                        <select id="bogoBuyTargetSelect" onchange="syncBogoScope()"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9]">
                            @* ตัวเลือกหมวดฟิกเกอร์ทั้งหมด *@
                            <option value="figures">สินค้าหมวดฟิกเกอร์ที่ร่วมรายการ</option>
                            @* ตัวเลือกสินค้าทุกหมวด *@
                            <option value="all">สินค้าทุกหมวดหมู่ในร้าน</option>
                            @* ตัวเลือกสินค้าค้างสต็อก *@
                            <option value="clearance">สินค้าค้างสต็อกนาน / ล้างสต็อก</option>
                            @* วนลูปแสดงรายการสินค้าเฉพาะรุ่นในร้าน *@
                            @foreach (var prod in allProducts)
                            {
                                @* ตัวเลือกสินค้าเฉพาะรุ่น *@
                                <option value="@prod.ProductId">เฉพาะรุ่น: @prod.Name (฿@prod.RetailPrice.ToString("N0"))</option>
                            }
                        </select>
                    </div>

                    @* เลือกรูปแบบของแถมว่าจะแถมตัวมันเอง แถมสินค้าที่ระบุ หรือให้ลูกค้าเลือกเอง *@
                    <div>
                        @* ป้ายกำกับรูปแบบของแถม *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5">2. รูปแบบสินค้าที่แถมฟรี</label>
                        @* ดรอปดาวน์เลือกรูปแบบของแถม *@
                        <select id="bogoGiftModeSelect" onchange="syncBogoScope()"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9]">
                            @* โหมดให้ลูกค้าเลือกเองหรือเลือกแถมตัวมันเองในหน้าตะกร้า *@
                            <option value="pick">ให้ลูกค้าเลือกของแถมเองในตะกร้า (หรือเลือกแถมตัวมันเองได้)</option>
                            @* โหมดแถมตัวมันเองรุ่นเดียวกัน *@
                            <option value="same">แถมตัวมันเอง (ซื้อรุ่นไหน แถมฟรีรุ่นนั้นอีก 1 ชิ้น)</option>
                            @* โหมดเจ้าของร้านระบุสินค้าที่จะแถม *@
                            <option value="item">แถมสินค้าเฉพาะรุ่นที่ร้านกำหนดไว้</option>
                        </select>
                    </div>

                    @* กล่องเลือกสินค้าของแถมกรณีเลือกโหมด "แถมสินค้าเฉพาะรุ่นที่ร้านกำหนดไว้" *@
                    <div id="bogoSpecificGiftWrapper" class="hidden">
                        @* ป้ายกำกับเลือกสินค้าของแถม *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5">3. เลือกสินค้าที่จะแถมฟรีให้ลูกค้า</label>
                        @* ดรอปดาวน์รายชื่อสินค้าของแถม *@
                        <select id="bogoFreeProdSelect" onchange="syncBogoScope()"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9]">
                            @* วนลูปแสดงรายการสินค้าทั้งหมดให้เลือกเป็นของแถม *@
                            @foreach (var prod in allProducts)
                            {
                                @* ตัวเลือกสินค้าของแถม *@
                                <option value="@prod.ProductId">แถมฟรี: @prod.Name (มูลค่า ฿@prod.RetailPrice.ToString("N0"))</option>
                            }
                        </select>
                    </div>
                </div>

                @* แผงตั้งค่าเฉพาะสำหรับโปรโมชั่น "ชุดเซ็ตสุดคุ้ม / ซื้อคู่ Bundle" *@
                <div id="bundleConfigPanel" class="hidden rounded-2xl border border-[#92EEFF] bg-[#F8FAFF] p-4 space-y-4">
                    @* หัวข้อแผงตั้งค่าซื้อคู่ Bundle *@
                    <div class="text-xs font-bold text-[#2F39A9]">ตั้งค่าเงื่อนไข ซื้อคู่ / Bundle (ซื้อเป็นชุดในราคาพิเศษกว่าซื้อแยก)</div>

                    @* เลือกรูปแบบการจัดชุด *@
                    <div>
                        @* ป้ายกำกับรูปแบบการจัดชุด *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5">1. รูปแบบการจับคู่ชุดสินค้า</label>
                        @* ดรอปดาวน์เลือกรูปแบบการจับคู่ *@
                        <select id="bundleModeSelect" onchange="syncBundleScope()"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9]">
                            @* โหมดจับคู่สินค้า 2 ชิ้นที่กำหนด *@
                            <option value="pair">จับคู่สินค้า 2 รุ่นที่กำหนด (ซื้อคู่กันได้ลดราคาพิเศษ)</option>
                            @* โหมดซื้อครบ 2 ชิ้นในหมวดฟิกเกอร์ *@
                            <option value="any2:figures">ซื้อสินค้าหมวดฟิกเกอร์ครบ 2 ชิ้นขึ้นไป</option>
                            @* โหมดซื้อครบ 2 ชิ้นในร้าน *@
                            <option value="any2:all">ซื้อสินค้าในร้านครบ 2 ชิ้นขึ้นไป (ทุกหมวดหมู่)</option>
                        </select>
                    </div>

                    @* กล่องเลือกสินค้าคู่ที่ 1 และคู่ที่ 2 *@
                    <div id="bundlePairSelectors" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @* สินค้าชิ้นที่ 1 ในชุดคู่ *@
                        <div>
                            @* ป้ายกำกับสินค้าชิ้นที่ 1 *@
                            <label class="text-xs font-bold text-gray-700 block mb-1">สินค้าในชุด ชิ้นที่ 1</label>
                            @* ดรอปดาวน์เลือกสินค้าชิ้นที่ 1 *@
                            <select id="bundleProd1Select" onchange="syncBundleScope()"
                                    class="w-full px-3 py-2 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9]">
                                @* วนลูปแสดงรายการสินค้าสำหรับชิ้นที่ 1 *@
                                @foreach (var prod in allProducts)
                                {
                                    @* ตัวเลือกสินค้าชิ้นที่ 1 *@
                                    <option value="@prod.ProductId">@prod.Name (฿@prod.RetailPrice.ToString("N0"))</option>
                                }
                            </select>
                        </div>
                        @* สินค้าชิ้นที่ 2 ในชุดคู่ *@
                        <div>
                            @* ป้ายกำกับสินค้าชิ้นที่ 2 *@
                            <label class="text-xs font-bold text-gray-700 block mb-1">สินค้าในชุด ชิ้นที่ 2</label>
                            @* ดรอปดาวน์เลือกสินค้าชิ้นที่ 2 *@
                            <select id="bundleProd2Select" onchange="syncBundleScope()"
                                    class="w-full px-3 py-2 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9]">
                                @{
                                    // กำหนดลำดับเริ่มต้นให้ชิ้นที่ 2 ต่างจากชิ้นที่ 1
                                    int pIdx = 0;
                                }
                                @* วนลูปแสดงรายการสินค้าสำหรับชิ้นที่ 2 *@
                                @foreach (var prod in allProducts)
                                {
                                    if (pIdx == 1)
                                    {
                                        @* ตัวเลือกเริ่มต้นสำหรับชิ้นที่ 2 *@
                                        <option value="@prod.ProductId" selected>@prod.Name (฿@prod.RetailPrice.ToString("N0"))</option>
                                    }
                                    else
                                    {
                                        @* ตัวเลือกสินค้าอื่นๆ *@
                                        <option value="@prod.ProductId">@prod.Name (฿@prod.RetailPrice.ToString("N0"))</option>
                                    }
                                    pIdx++;
                                }
                            </select>
                        </div>
                    </div>
                </div>

                @* ฟิลด์ซ่อนสำหรับเก็บค่าขอบเขตและเงื่อนไขสินค้าที่เลือกส่งไปยัง Controller *@
                <input type="hidden" name="ApplicableScope" id="applicableScopeInput" value="all" />

                @* กล่องข้อความแจ้งเตือนเงื่อนไขการนำโปรโมชั่นไปคำนวณ *@
                <div class="rounded-xl bg-[#F8F9FD] border border-slate-100 px-4 py-3 text-xs text-slate-600">
                    <span class="font-bold text-[#2F39A9]">หมายเหตุการใช้งาน:</span> ระบบจะแสดงเงื่อนไขการใช้งานให้ลูกค้าอัตโนมัติตามประเภทส่วนลด ยอดซื้อขั้นต่ำ ขอบเขตสินค้า และช่วงวันที่กำหนดไว้ (ใช้ได้กับสินค้าซื้อ/พรีออเดอร์เท่านั้น ไม่สามารถใช้กับการแลกแต้มได้)
                </div>
            </div>
        </div>

        @* คอลัมน์ด้านขวาสำหรับการตั้งค่าสถานะ ระยะเวลา และสิทธิ์ใช้งาน *@
        <div class="space-y-6">
            @* การ์ดตั้งค่าเปิดหรือปิดการใช้งานโปรโมชั่นทันที *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
                @* แถบสวิตช์เปิดใช้งาน *@
                <div class="flex items-center justify-between">
                    @* ข้อความกำกับสวิตช์ *@
                    <span class="text-sm font-bold text-[#050315]">เปิดใช้งานทันที</span>
                    @* สวิตช์เช็คบ็อกซ์แบบสลับเปิด/ปิด *@
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="IsActive" value="true" checked class="sr-only peer" />
                        <input type="hidden" name="IsActive" value="false" />
                        <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#2F39A9]"></div>
                    </label>
                </div>
            </div>

            @* การ์ดกำหนดช่วงวันเริ่มต้นและวันสิ้นสุดของโปรโมชั่น *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
                @* หัวข้อการ์ดระยะเวลา *@
                <h3 class="text-sm font-bold text-[#050315]">ระยะเวลาโปรโมชั่น</h3>
                @* ช่องเลือกวันที่เริ่มต้น *@
                <div>
                    @* ป้ายกำกับวันเริ่มต้น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1">วันที่เริ่มต้น</label>
                    @* กรอบอินพุตวันที่พร้อมไอคอนปฏิทิน *@
                    <div class="flex items-center border border-gray-200 rounded-xl px-3 py-2 bg-white shadow-2xs">
                        <svg class="size-4 text-gray-400 mr-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <input type="date" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" class="text-xs font-medium text-gray-700 w-full focus:outline-none" />
                    </div>
                </div>

                @* ช่องเลือกวันที่สิ้นสุด *@
                <div>
                    @* ป้ายกำกับวันสิ้นสุด *@
                    <label class="text-xs font-bold text-gray-700 block mb-1">วันที่สิ้นสุด</label>
                    @* กรอบอินพุตวันที่พร้อมไอคอนปฏิทิน *@
                    <div class="flex items-center border border-gray-200 rounded-xl px-3 py-2 bg-white shadow-2xs">
                        <svg class="size-4 text-gray-400 mr-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <input type="date" name="EndDate" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" class="text-xs font-medium text-gray-700 w-full focus:outline-none" />
                    </div>
                </div>
            </div>

            @* การ์ดจำกัดจำนวนสิทธิ์การใช้งานทั้งหมด *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
                @* หัวข้อการ์ดจำกัดสิทธิ์ *@
                <h3 class="text-sm font-bold text-[#050315]">จำกัดสิทธิ์การใช้งาน</h3>
                @* ช่องกรอกจำนวนสิทธิ์สูงสุด *@
                <div>
                    @* ป้ายกำกับจำนวนสิทธิ์ *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">จำนวนสิทธิ์ทั้งหมด (ครั้ง)</label>
                    @* ช่องกรอกตัวเลขจำนวนสิทธิ์ *@
                    <input type="number" name="UsageLimit" min="1" placeholder="เว้นว่างหากไม่จำกัด"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                </div>
            </div>
        </div>
    </div>

    @* แถบล่างสุดสำหรับปุ่มยกเลิกและปุ่มบันทึกข้อมูล *@
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200/60">
        @* ปุ่มยกเลิกและกลับไปหน้ารายการโปรโมชั่น *@
        <a asp-controller="Owner" asp-action="Promotions" class="px-6 py-2.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-bold text-sm shadow-2xs cursor-pointer">
            ยกเลิก
        </a>
        @* ปุ่มส่งแบบฟอร์มบันทึกโปรโมชั่นใหม่ *@
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold text-sm shadow-xs flex items-center gap-1.5 transition-colors cursor-pointer">
            <span>บันทึกโปรโมชั่น</span>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>
    </div>
</form>

@* ส่วนสคริปต์จาวาสคริปต์ควบคุมการทำงานของแบบฟอร์ม *@
@section Scripts {
    <script>
        // ฟังก์ชันสร้างรหัสโปรโมชั่นแบบสุ่มอัตโนมัติขึ้นต้นด้วย FH-
        function generateVoucherCode() {
            // ชุดตัวอักษรและตัวเลขที่ใช้ในการสุ่มรหัส
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let code = 'FH-';
            // สุ่มตัวอักษรจำนวน 6 ตัวต่อท้าย
            for (let i = 0; i < 6; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            // นำรหัสที่สุ่มได้ไปใส่ในช่องกรอกรหัสโปรโมชั่น
            document.getElementById('voucherCodeInput').value = code;
        }

        // ฟังก์ชันเปลี่ยนประเภทส่วนลดและปรับปรุงป้ายคำอธิบายช่องกรอกตามประเภทที่เลือก
        function selectDiscountType(type) {
            // กำหนดค่าประเภทโปรโมชั่นลงในอินพุตซ่อน
            document.getElementById('promoTypeInput').value = type;
            // อัปเดตรูปแบบปุ่มกดของประเภทโปรโมชั่น
            document.querySelectorAll('.promo-type-btn').forEach(btn => {
                const isSelected = btn.getAttribute('data-promo-type') === type;
                btn.className = isSelected
                    ? 'promo-type-btn py-2 px-2 rounded-lg text-xs font-bold text-[#050315] bg-white shadow-xs transition cursor-pointer'
                    : 'promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer';
            });

            // ดึงอิลิเมนต์ป้ายและช่องกรอกมูลค่าส่วนลด
            const label = document.getElementById('discountValueLabel');
            const hint = document.getElementById('discountValueHint');
            const valInput = document.getElementById('discountValueInput');
            if (!label || !valInput) return;

            // สลับการแสดงแผงตั้งค่าขอบเขตตามประเภทโปรโมชั่น
            const stdPanel = document.getElementById('standardScopePanel');
            const bogoPanel = document.getElementById('bogoConfigPanel');
            const bundlePanel = document.getElementById('bundleConfigPanel');
            if (stdPanel) stdPanel.classList.toggle('hidden', type === 'bogo' || type === 'bundle');
            if (bogoPanel) bogoPanel.classList.toggle('hidden', type !== 'bogo');
            if (bundlePanel) bundlePanel.classList.toggle('hidden', type !== 'bundle');

            // ตรวจสอบประเภทส่วนลดเพื่อปรับการแสดงผลและขีดจำกัด
            if (type === 'percent') {
                label.innerText = 'มูลค่าส่วนลด (%)';
                hint.innerText = 'ระบุเปอร์เซ็นต์ส่วนลด เช่น ล้างสต็อกสิ้นปี 20 ถึง 50%';
                valInput.readOnly = false;
                valInput.max = '100';
            } else if (type === 'bogo') {
                label.innerText = 'เพดานราคาของแถมสูงสุด (บาท)';
                hint.innerText = 'ระบุวงเงินราคาของแถมสูงสุด (หรือระบุ 0 เพื่อให้แถมตามราคาจริงของสินค้าแถม)';
                valInput.readOnly = false;
                valInput.removeAttribute('max');
                syncBogoScope();
            } else if (type === 'bundle') {
                label.innerText = 'ส่วนลดพิเศษเมื่อซื้อครบชุดคู่ (บาท)';
                hint.innerText = 'ระบุส่วนลดเมื่อซื้อเป็นชุดคู่ให้ถูกกว่าซื้อแยก เช่น ลดทันที 650 บาท';
                valInput.readOnly = false;
                valInput.removeAttribute('max');
                syncBundleScope();
            } else if (type === 'double_points') {
                label.innerText = 'ตัวคูณคะแนนสะสม (เฉพาะสมาชิก Login)';
                hint.innerText = 'ลูกค้าสมาชิกจะได้รับแต้มสะสม x2 สำหรับนำไปแลกของรางวัล';
                valInput.value = '2';
                valInput.readOnly = true;
                valInput.removeAttribute('max');
            } else {
                label.innerText = 'มูลค่าส่วนลดพรีออเดอร์ / ท้ายบิล (บาท)';
                hint.innerText = 'ระบุจำนวนเงินส่วนลดเป็นบาทสำหรับใบสั่งจองรับและชำระที่หน้าร้าน';
                valInput.readOnly = false;
                valInput.removeAttribute('max');
            }
        }

        // ฟังก์ชันอัปเดตค่า ApplicableScope สำหรับโปรโมชั่น ซื้อ 1 แถม 1
        function syncBogoScope() {
            // อ่านค่าสินค้าที่ต้องซื้อ
            const buyTarget = document.getElementById('bogoBuyTargetSelect')?.value || 'figures';
            // อ่านโหมดของแถม (pick, same, item)
            const giftMode = document.getElementById('bogoGiftModeSelect')?.value || 'pick';
            // อ่านรหัสสินค้าของแถมเฉพาะรุ่น
            const freeProdId = document.getElementById('bogoFreeProdSelect')?.value || '1';
            // แสดงหรือซ่อนกล่องเลือกสินค้าของแถมเฉพาะรุ่น
            const specWrapper = document.getElementById('bogoSpecificGiftWrapper');
            if (specWrapper) specWrapper.classList.toggle('hidden', giftMode !== 'item');
            // ประกอบรหัสขอบเขต BOGO ลงในฟิลด์ซ่อน
            const scopeVal = giftMode === 'item'
                ? `bogo:item:${buyTarget}:${freeProdId}`
                : `bogo:${giftMode}:${buyTarget}`;
            document.getElementById('applicableScopeInput').value = scopeVal;
        }

        // ฟังก์ชันอัปเดตค่า ApplicableScope สำหรับโปรโมชั่น ซื้อคู่ / Bundle
        function syncBundleScope() {
            // อ่านโหมดการจัดชุดคู่
            const mode = document.getElementById('bundleModeSelect')?.value || 'pair';
            // แสดงหรือซ่อนกล่องเลือกสินค้า 2 ชิ้น
            const pairBox = document.getElementById('bundlePairSelectors');
            if (pairBox) pairBox.classList.toggle('hidden', mode !== 'pair');
            if (mode === 'pair') {
                const p1 = document.getElementById('bundleProd1Select')?.value || '1';
                const p2 = document.getElementById('bundleProd2Select')?.value || '2';
                document.getElementById('applicableScopeInput').value = `bundle:${p1}:${p2}`;
            } else {
                document.getElementById('applicableScopeInput').value = `bundle:${mode}`;
            }
        }

        // ฟังก์ชันเลือกขอบเขตสินค้าที่ร่วมรายการและปรับเปลี่ยนสไตล์ปุ่มที่เลือก
        function selectScope(btn, val) {
            // บันทึกค่าขอบเขตสินค้าลงในอินพุตซ่อน
            document.getElementById('applicableScopeInput').value = val;
            // รีเซ็ตรูปแบบปุ่มทั้งหมดกลับเป็นสถานะปกติ
            document.querySelectorAll('.scope-btn').forEach(b => {
                b.className = 'scope-btn px-4 py-2 rounded-xl text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 cursor-pointer';
            });
            // ไฮไลต์ปุ่มที่ถูกเลือกด้วยสีประจำร้าน
            if (btn) {
                btn.className = 'scope-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#2F39A9] text-white shadow-xs cursor-pointer';
            }
        }
    </script>
}
