@* กำหนดโมเดลข้อมูลโปรโมชั่นสำหรับการแก้ไข *@
@model Khetsophon_CSI402_8456.Models.Promotion?
@* กำหนดฟังก์ชันช่วยเหลือและการตั้งค่าข้อมูลหน้าแก้ไขโปรโมชั่น *@
@{

    // ฟังก์ชันจัดรูปแบบวันที่เป็น ISO (yyyy-MM-dd)
    string FormatIsoDate(DateOnly date)
    {
        int year = date.Year;
        if (year > 0 && year < 1900) year += 543;
        else if (year >= 2400) year -= 543;
        var gregorian = new DateOnly(year, date.Month, date.Day);
        return gregorian.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    }
    // กำหนดชื่อหัวข้อของหน้าแก้ไขโปรโมชั่น
    ViewData["Title"] = "แก้ไขโปรโมชั่น";
    // กำหนด Layout หลักของฝั่งเจ้าของร้าน
    Layout = "_OwnerLayout";

    // กำหนดค่าคอนฟิกข้อความและข้อมูลเดิมของโปรโมชั่นไว้ส่วนบนสุดของไฟล์
    var pageHeader = new {
        Breadcrumb1 = "โปรโมชั่น",
        Breadcrumb2 = "แก้ไขโปรโมชั่น",
        Title = "แก้ไขโปรโมชั่น",
        PromoName = Model?.Name ?? string.Empty,
        VoucherCode = Model?.VoucherCode ?? string.Empty,
        DiscountValue = Model?.DiscountValue ?? 0m,
        MinimumSpend = Model?.MinimumSpend ?? 0m
    };

    // กำหนดประเภทโปรโมชั่นตั้งต้น
    string initialPromoType = (Model?.PromoType ?? "percent").Trim().ToLowerInvariant();
    // จัดรูปแบบวันที่เริ่มต้นในรูปแบบ ISO yyyy-MM-dd
    string startIso = Model != null
        ? FormatIsoDate(Model.StartDate)
        : DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    // จัดรูปแบบวันที่สิ้นสุดในรูปแบบ ISO yyyy-MM-dd
    string endIso = Model != null
        ? FormatIsoDate(Model.EndDate)
        : DateTime.Today.AddDays(30).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}

@* แบบฟอร์มแก้ไขโปรโมชั่นเชื่อมโยงไปยัง OwnerController.EditPromotion (ไม่ใส่ method attribute) *@
<form asp-controller="Owner" asp-action="EditPromotion" class="space-y-6">
    @* ตรวจสอบและแสดงข้อความแจ้งเตือนข้อผิดพลาด *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องข้อความสีแดงแจ้งเตือนข้อผิดพลาด *@
        <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 flex items-center gap-3 text-xs text-rose-800 shadow-xs">
            <svg class="size-5 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    @* รหัสไอดีของโปรโมชั่นที่ต้องการแก้ไขในฐานข้อมูล *@
    <input type="hidden" name="PromotionId" value="@(Model?.PromotionId ?? 1)" />

    @* ส่วนหัวนำทางและปุ่มย้อนกลับไปยังหน้ารายการโปรโมชั่น *@
    <div>
        @* แถบแสดงลำดับขั้นเมนูนำทาง *@
        <div class="text-xs text-gray-400 font-medium flex items-center gap-1.5 mb-2">
            <a asp-controller="Owner" asp-action="Promotions" class="hover:text-gray-600">@pageHeader.Breadcrumb1</a>
            <span>/</span>
            <span class="text-gray-600">@pageHeader.Breadcrumb2</span>
        </div>
        @* ปุ่มย้อนกลับพร้อมหัวข้อใหญ่ของหน้าเว็บ *@
        <div class="flex items-center gap-3">
            @* ปุ่มไอคอนย้อนกลับ *@
            <a asp-controller="Owner" asp-action="Promotions"
               class="size-9 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center text-gray-600 shadow-2xs transition-colors cursor-pointer">
                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </a>
            @* หัวข้อหลักของหน้าแก้ไขโปรโมชั่น *@
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
        </div>
    </div>

    @* โครงสร้างกริด 2 คอลัมน์ (ซ้ายข้อมูลหลัก 2 ส่วน / ขวาสถานะและเงื่อนไข 1 ส่วน) *@
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        @* คอลัมน์ด้านซ้ายสำหรับแก้ไขข้อมูลหลักของโปรโมชั่น *@
        <div class="lg:col-span-2 space-y-6">
            @* การ์ดสีขาวบรรจุช่องกรอกข้อมูลรายละเอียดโปรโมชั่น *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-5">
                @* หัวข้อกลุ่มข้อมูลหลัก *@
                <h2 class="text-base font-bold text-[#050315]">ข้อมูลหลักโปรโมชั่น</h2>

                @* ช่องแก้ไขชื่อโปรโมชั่น *@
                <div>
                    @* ป้ายกำกับช่องชื่อโปรโมชั่น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">ชื่อโปรโมชั่น</label>
                    @* ช่องกรอกข้อความชื่อโปรโมชั่น *@
                    <input type="text" name="Name" value="@pageHeader.PromoName" required
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                </div>

                @* ช่องแก้ไขรหัสโปรโมชั่นพร้อมปุ่มสุ่มโค้ด *@
                <div>
                    @* ป้ายกำกับรหัสโปรโมชั่น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">รหัสโปรโมชั่น / Voucher Code</label>
                    @* กล่องจัดวางแนวนอนระหว่างช่องกรอกและปุ่มกด *@
                    <div class="flex items-center gap-2">
                        @* ช่องกรอกรหัสโปรโมชั่น *@
                        <input type="text" name="VoucherCode" id="voucherCodeInput" value="@pageHeader.VoucherCode" required
                               class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-mono focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                        @* ปุ่มคลิกสุ่มรหัสคูปองอัตโนมัติ *@
                        <button type="button" onclick="generateVoucherCode()"
                                class="px-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 hover:bg-gray-100 text-xs font-bold text-gray-700 transition cursor-pointer shadow-2xs shrink-0">
                            สร้างรหัสอัตโนมัติ
                        </button>
                    </div>
                </div>

                @* ส่วนเลือกประเภทโปรโมชั่นทั้ง 5 แบบ *@
                <div>
                    @* ป้ายกำกับประเภทโปรโมชั่น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">ประเภทโปรโมชั่น</label>
                    @* กล่องปุ่มเลือกประเภทส่วนลด *@
                    <div class="bg-gray-100 p-1 rounded-xl grid grid-cols-2 sm:grid-cols-5 gap-1">
                        @* ปุ่มเลือกส่วนลดแบบเปอร์เซ็นต์ *@
                        <button type="button" data-promo-type="percent" onclick="selectDiscountType('percent')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer">
                            ส่วนลด %
                        </button>
                        @* ปุ่มเลือกส่วนลดแบบจำนวนเงินบาท *@
                        <button type="button" data-promo-type="fixed" onclick="selectDiscountType('fixed')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer">
                            ส่วนลดบาท
                        </button>
                        @* ปุ่มเลือกโปรโมชั่นซื้อ 1 แถม 1 *@
                        <button type="button" data-promo-type="bogo" onclick="selectDiscountType('bogo')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer">
                            ซื้อ 1 แถม 1
                        </button>
                        @* ปุ่มเลือกโปรโมชั่นชุดเซ็ตสุดคุ้ม *@
                        <button type="button" data-promo-type="bundle" onclick="selectDiscountType('bundle')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer">
                            ชุดเซ็ตสุดคุ้ม
                        </button>
                        @* ปุ่มเลือกโปรโมชั่นแต้มสะสมสองเท่า *@
                        <button type="button" data-promo-type="double_points" onclick="selectDiscountType('double_points')"
                                class="promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer col-span-2 sm:col-span-1">
                            แต้มสะสม x2
                        </button>
                    </div>
                    @* ฟิลด์ซ่อนสำหรับเก็บค่าประเภทโปรโมชั่น *@
                    <input type="hidden" name="PromoType" id="promoTypeInput" value="@initialPromoType" />
                </div>

                @* แถวคู่แก้ไขมูลค่าส่วนลดและยอดสั่งซื้อขั้นต่ำ *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @* ช่องกรอกมูลค่าส่วนลด *@
                    <div>
                        @* ป้ายกำกับมูลค่าส่วนลด *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5" id="discountValueLabel">มูลค่าส่วนลด (%)</label>
                        @* ช่องกรอกตัวเลขมูลค่าส่วนลด *@
                        <input type="number" name="DiscountValue" id="discountValueInput" value="@pageHeader.DiscountValue" min="0" step="0.01" required
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                        @* ข้อความคำแนะนำการกรอกค่าส่วนลด *@
                        <p class="text-[11px] text-gray-400 mt-1" id="discountValueHint">ระบุเปอร์เซ็นต์ส่วนลด หรือจำนวนเงินตามประเภท</p>
                    </div>
                    @* ช่องกรอกยอดสั่งซื้อขั้นต่ำ *@
                    <div>
                        @* ป้ายกำกับยอดสั่งซื้อขั้นต่ำ *@
                        <label class="text-xs font-bold text-gray-700 block mb-1.5">ยอดสั่งซื้อขั้นต่ำ (฿)</label>
                        @* ช่องกรอกตัวเลขยอดสั่งซื้อขั้นต่ำ *@
                        <input type="number" name="MinimumSpend" value="@pageHeader.MinimumSpend" min="0" step="0.01"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                    </div>
                </div>

                @* กำหนดตัวแปรคลาสของปุ่มเลือกขอบเขตสินค้า *@
                @{
                    string currentScope = (Model?.ApplicableScope ?? "all").Trim().ToLowerInvariant();
                    string activeScopeCls = "scope-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#2F39A9] text-white shadow-xs cursor-pointer";
                    string idleScopeCls = "scope-btn px-4 py-2 rounded-xl text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 cursor-pointer";
                }

                @* ส่วนเลือกขอบเขตสินค้าที่ร่วมรายการ *@
                <div>
                    @* ป้ายกำกับขอบเขตสินค้า *@
                    <label class="text-xs font-bold text-gray-700 block mb-2">ขอบเขตสินค้าที่ร่วมรายการ</label>
                    @* กลุ่มปุ่มเลือกขอบเขตสินค้า *@
                    <div class="flex items-center gap-2 flex-wrap">
                        @* ปุ่มเลือกสินค้าทั้งหมด *@
                        <button type="button" onclick="selectScope(this, 'all')" class="@(currentScope == "all" ? activeScopeCls : idleScopeCls)">
                            สินค้าทั้งหมด
                        </button>
                        @* ปุ่มเลือกเฉพาะหมวดฟิกเกอร์ *@
                        <button type="button" onclick="selectScope(this, 'figures')" class="@(currentScope == "figures" ? activeScopeCls : idleScopeCls)">
                            เฉพาะหมวดฟิกเกอร์
                        </button>
                        @* ปุ่มเลือกเฉพาะสินค้าพร้อมส่ง *@
                        <button type="button" onclick="selectScope(this, 'clearance')" class="@(currentScope == "clearance" ? activeScopeCls : idleScopeCls)">
                            สินค้าลดล้างสต๊อก / พร้อมส่ง
                        </button>
                    </div>
                    @* ฟิลด์ซ่อนสำหรับเก็บค่าขอบเขตสินค้าที่เลือก *@
                    <input type="hidden" name="ApplicableScope" id="applicableScopeInput" value="@currentScope" />
                </div>

                @* กล่องข้อความแจ้งเตือนเงื่อนไขการนำโปรโมชั่นไปคำนวณ *@
                <div class="rounded-xl bg-[#F8F9FD] border border-slate-100 px-4 py-3 text-xs text-slate-600">
                    <span class="font-bold text-[#2F39A9]">หมายเหตุการใช้งาน:</span> ระบบจะแสดงเงื่อนไขการใช้งานให้ลูกค้าอัตโนมัติตามประเภทส่วนลด ยอดซื้อขั้นต่ำ ขอบเขตสินค้า และช่วงวันที่กำหนดไว้ (ใช้ได้กับสินค้าซื้อ/พรีออเดอร์เท่านั้น ไม่สามารถใช้กับการแลกแต้มได้)
                </div>
            </div>
        </div>

        @* คอลัมน์ด้านขวาสำหรับการตั้งค่าสถานะ ระยะเวลา และสิทธิ์ใช้งาน *@
        <div class="space-y-6">
            @* การ์ดตั้งค่าเปิดหรือปิดการใช้งานโปรโมชั่น *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
                @* แถบสวิตช์เปิดใช้งาน *@
                <div class="flex items-center justify-between">
                    @* ข้อความกำกับสวิตช์ *@
                    <span class="text-sm font-bold text-[#050315]">เปิดใช้งาน</span>
                    @* สวิตช์เช็คบ็อกซ์แบบสลับเปิด/ปิด *@
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="IsActive" value="true" @(Model != null ? (Model.IsActive == true ? "checked" : "") : "checked") class="sr-only peer" />
                        <input type="hidden" name="IsActive" value="false" />
                        <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#2F39A9]"></div>
                    </label>
                </div>
            </div>

            @* การ์ดกำหนดช่วงวันเริ่มต้นและวันสิ้นสุดของโปรโมชั่น *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
                @* หัวข้อการ์ดระยะเวลา *@
                <h3 class="text-sm font-bold text-[#050315]">ระยะเวลาโปรโมชั่น</h3>
                @* ช่องเลือกวันที่เริ่มต้น *@
                <div>
                    @* ป้ายกำกับวันเริ่มต้น *@
                    <label class="text-xs font-bold text-gray-700 block mb-1">วันที่เริ่มต้น</label>
                    @* กรอบอินพุตวันที่พร้อมไอคอนปฏิทิน *@
                    <div class="flex items-center border border-gray-200 rounded-xl px-3 py-2 bg-white shadow-2xs">
                        <svg class="size-4 text-gray-400 mr-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <input type="date" name="StartDate" value="@startIso" class="text-xs font-medium text-gray-700 w-full focus:outline-none" />
                    </div>
                </div>

                @* ช่องเลือกวันที่สิ้นสุด *@
                <div>
                    @* ป้ายกำกับวันสิ้นสุด *@
                    <label class="text-xs font-bold text-gray-700 block mb-1">วันที่สิ้นสุด</label>
                    @* กรอบอินพุตวันที่พร้อมไอคอนปฏิทิน *@
                    <div class="flex items-center border border-gray-200 rounded-xl px-3 py-2 bg-white shadow-2xs">
                        <svg class="size-4 text-gray-400 mr-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <input type="date" name="EndDate" value="@endIso" class="text-xs font-medium text-gray-700 w-full focus:outline-none" />
                    </div>
                </div>
            </div>

            @* การ์ดจำกัดจำนวนสิทธิ์การใช้งานทั้งหมด *@
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-4">
                @* หัวข้อการ์ดจำกัดสิทธิ์ *@
                <h3 class="text-sm font-bold text-[#050315]">จำกัดสิทธิ์การใช้งาน</h3>
                @* ช่องกรอกจำนวนสิทธิ์สูงสุด *@
                <div>
                    @* ป้ายกำกับจำนวนสิทธิ์ *@
                    <label class="text-xs font-bold text-gray-700 block mb-1.5">จำนวนสิทธิ์ทั้งหมด (ครั้ง)</label>
                    @* ช่องกรอกตัวเลขจำนวนสิทธิ์ *@
                    <input type="number" name="UsageLimit" value="@(Model?.UsageLimit)" min="1" placeholder="เว้นว่างหากไม่จำกัด"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-[#2F39A9] shadow-2xs" />
                </div>
            </div>
        </div>
    </div>

    @* แถบล่างสุดสำหรับปุ่มยกเลิกและปุ่มบันทึกการแก้ไข *@
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200/60">
        @* ปุ่มยกเลิกและกลับไปหน้ารายการโปรโมชั่น *@
        <a asp-controller="Owner" asp-action="Promotions" class="px-6 py-2.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-bold text-sm shadow-2xs cursor-pointer">
            ยกเลิก
        </a>
        @* ปุ่มส่งแบบฟอร์มบันทึกการแก้ไขโปรโมชั่น *@
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#242D87] text-white font-bold text-sm shadow-xs flex items-center gap-1.5 transition-colors cursor-pointer">
            <span>บันทึกการแก้ไข</span>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>
    </div>
</form>

@* ส่วนสคริปต์จาวาสคริปต์ควบคุมการทำงานของแบบฟอร์ม *@
@section Scripts {
    <script>
        // ฟังก์ชันสร้างรหัสโปรโมชั่นแบบสุ่มอัตโนมัติขึ้นต้นด้วย FH-
        function generateVoucherCode() {
            // ชุดตัวอักษรและตัวเลขที่ใช้ในการสุ่มรหัส
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let code = 'FH-';
            // สุ่มตัวอักษรจำนวน 6 ตัวต่อท้าย
            for (let i = 0; i < 6; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            // นำรหัสที่สุ่มได้ไปใส่ในช่องกรอกรหัสโปรโมชั่น
            document.getElementById('voucherCodeInput').value = code;
        }

        // ฟังก์ชันเปลี่ยนประเภทส่วนลดและปรับปรุงป้ายคำอธิบายช่องกรอกตามประเภทที่เลือก
        function selectDiscountType(type) {
            // กำหนดค่าประเภทโปรโมชั่นลงในอินพุตซ่อน
            document.getElementById('promoTypeInput').value = type;
            // อัปเดตรูปแบบปุ่มกดของประเภทโปรโมชั่น
            document.querySelectorAll('.promo-type-btn').forEach(btn => {
                const isSelected = btn.getAttribute('data-promo-type') === type;
                btn.className = isSelected
                    ? 'promo-type-btn py-2 px-2 rounded-lg text-xs font-bold text-[#050315] bg-white shadow-xs transition cursor-pointer'
                    : 'promo-type-btn py-2 px-2 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-800 transition cursor-pointer';
            });

            // ดึงอิลิเมนต์ป้ายและช่องกรอกมูลค่าส่วนลด
            const label = document.getElementById('discountValueLabel');
            const hint = document.getElementById('discountValueHint');
            const valInput = document.getElementById('discountValueInput');
            if (!label || !valInput) return;

            // ตรวจสอบประเภทส่วนลดเพื่อปรับการแสดงผลและขีดจำกัด
            if (type === 'percent') {
                label.innerText = 'มูลค่าส่วนลด (%)';
                hint.innerText = 'ระบุเปอร์เซ็นต์ส่วนลด 1 ถึง 100 เช่น 10 หรือ 20';
                valInput.readOnly = false;
                valInput.max = '100';
            } else if (type === 'bogo') {
                label.innerText = 'เพดานส่วนลดของแถม (บาท)';
                hint.innerText = 'ระบุ 0 เพื่อใช้ราคาสินค้าชิ้นที่ถูกที่สุดอัตโนมัติ (ต้องซื้ออย่างน้อย 2 ชิ้น)';
                valInput.readOnly = false;
                valInput.removeAttribute('max');
            } else if (type === 'double_points') {
                label.innerText = 'ตัวคูณคะแนนสะสม';
                hint.innerText = 'ลูกค้าจะได้รับแต้มสะสม x2 อัตโนมัติเมื่อชำระเงินที่หน้าร้าน';
                valInput.value = '2';
                valInput.readOnly = true;
                valInput.removeAttribute('max');
            } else {
                label.innerText = 'มูลค่าส่วนลด (บาท)';
                hint.innerText = 'ระบุจำนวนเงินส่วนลดเป็นบาท เช่น 100 หรือ 300';
                valInput.readOnly = false;
                valInput.removeAttribute('max');
            }
        }

        // ฟังก์ชันเลือกขอบเขตสินค้าที่ร่วมรายการและปรับเปลี่ยนสไตล์ปุ่มที่เลือก
        function selectScope(btn, val) {
            // บันทึกค่าขอบเขตสินค้าลงในอินพุตซ่อน
            document.getElementById('applicableScopeInput').value = val;
            // รีเซ็ตรูปแบบปุ่มทั้งหมดกลับเป็นสถานะปกติ
            document.querySelectorAll('.scope-btn').forEach(b => {
                b.className = 'scope-btn px-4 py-2 rounded-xl text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 cursor-pointer';
            });
            // ไฮไลต์ปุ่มที่ถูกเลือกด้วยสีประจำร้าน
            btn.className = 'scope-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#2F39A9] text-white shadow-xs cursor-pointer';
        }

        // เมื่อโหลดหน้าเว็บเสร็จสมบูรณ์ ให้เลือกประเภทส่วนลดตามค่าที่มีในฐานข้อมูล
        document.addEventListener('DOMContentLoaded', function () {
            const initialType = document.getElementById('promoTypeInput')?.value || 'percent';
            selectDiscountType(initialType);
        });
    </script>
}
