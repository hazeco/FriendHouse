@* กำหนดโมเดลข้อมูลรายงานสรุปยอดขายและการเงินประจำเดือน *@
@model Khetsophon_CSI402_8456.ViewModels.FinancialReportViewModel
@* กำหนดฟังก์ชันช่วยเหลือและการตั้งค่าข้อมูลหน้ารายงานประจำเดือน *@
@{
    ViewData["Title"] = "รายงานสรุปยอดประจำเดือน";
    Layout = "_OwnerLayout";

    // การกำหนดค่าหัวข้อและข้อความแสดงผลทั้งหมดไว้ส่วนบนสุดของไฟล์ โดยใช้ตัวเลขจริงจากฐานข้อมูลชุดเดียวกับฝ่ายบัญชี
    var pageHeader = new {
        Breadcrumb = "รายงาน",
        Title = "รายงานสรุปยอดประจำเดือน",
        Subtitle = "ภาพรวมรายรับ สต็อกเข้า-ออก และพรีออเดอร์ รายเดือน (เชื่อมโยงข้อมูลตรงจากฐานข้อมูลร้าน)",
        SelectedMonth = Model.SelectedMonthLabel
    };

    var stats = new {
        Revenue = "฿" + Model.TotalRevenue.ToString("N0"),
        RevenueDelta = Model.RevenueDeltaText,
        StockIn = Model.TotalStockInQty.ToString("N0") + " ชิ้น",
        StockInDelta = Model.StockInDeltaText,
        StockOut = Model.TotalStockOutQty.ToString("N0") + " ชิ้น",
        StockOutDelta = Model.StockOutDeltaText,
        Preorder = Model.TotalPreorderCount.ToString("N0") + " ออเดอร์",
        PreorderDelta = Model.PreorderDeltaText
    };

    int startRow = Model.TotalProductRowCount == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endRow = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalProductRowCount);
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="space-y-6">
    @* ส่วนหัวหน้าเพจและตัวเลือกช่วงเดือนที่เชื่อมโยงฐานข้อมูลจริง *@
    <div class="flex items-center justify-between flex-wrap gap-4">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium mb-1">@pageHeader.Breadcrumb</div>
            @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
            <p class="text-sm text-slate-500 mt-1">@pageHeader.Subtitle</p>
        </div>

        @* ปุ่มเลื่อนช่วงเดือนและการส่งออกรายงาน *@
        <div class="flex items-center gap-2 print:hidden">
            @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
            @if (!string.IsNullOrEmpty(Model.PrevMonthKey))
            {
                @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                <a asp-controller="Owner" asp-action="MonthlyReport" asp-route-selectedMonth="@Model.PrevMonthKey"
                   class="size-9 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 flex items-center justify-center text-sm font-bold shadow-2xs cursor-pointer" title="เดือนก่อนหน้า" aria-label="เดือนก่อนหน้า">
                    ‹
                </a>
            }
            else
            {
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="size-9 rounded-xl border border-slate-100 bg-slate-50 text-slate-300 flex items-center justify-center text-sm font-bold cursor-not-allowed" title="ไม่มีข้อมูลเดือนก่อนหน้า">
                    ‹
                </span>
            }
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="relative">
                @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                <select id="headerMonthSelect" onchange="navigateReportMonth(this.value)"
                        class="appearance-none pr-8 pl-3.5 py-2 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-[#050315] shadow-2xs focus:outline-none cursor-pointer">
                    @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                    @foreach (var m in Model.AvailableMonths)
                    {
                        if (m.Key.Equals(Model.SelectedMonthKey, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@m.Key" selected>@m.Label</option>
                        }
                        else
                        {
                            <option value="@m.Key">@m.Label</option>
                        }
                    }
                </select>
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>
            @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
            @if (!string.IsNullOrEmpty(Model.NextMonthKey))
            {
                @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                <a asp-controller="Owner" asp-action="MonthlyReport" asp-route-selectedMonth="@Model.NextMonthKey"
                   class="size-9 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 flex items-center justify-center text-sm font-bold shadow-2xs cursor-pointer" title="เดือนถัดไป" aria-label="เดือนถัดไป">
                    ›
                </a>
            }
            else
            {
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="size-9 rounded-xl border border-slate-100 bg-slate-50 text-slate-300 flex items-center justify-center text-sm font-bold cursor-not-allowed" title="อยู่ในเดือนล่าสุดแล้ว">
                    ›
                </span>
            }
            @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
            <button type="button" onclick="openExportModal()" class="inline-flex items-center gap-1.5 bg-[#2F39A9] hover:bg-[#2F39A9]/90 text-white font-bold px-4 py-2 rounded-xl shadow-xs transition-colors cursor-pointer text-sm ml-1">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 4v12m0 0l-4-4m4 4l4-4M4 18h16"></path>
                </svg>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>ส่งออก</span>
            </button>
        </div>
    </div>

    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (TempData["SuccessMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="rounded-2xl bg-[#ECFDF5] border border-[#A7F3D0] p-4 flex items-center gap-3 text-xs text-[#065F46] shadow-xs print:hidden">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-[#10B981] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }
    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 flex items-center gap-3 text-xs text-rose-800 shadow-xs print:hidden">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    @* การ์ดสถิติสรุปยอด 4 รายการจากฐานข้อมูลจริง ยอดรายได้ตรงกับหน้าภาพรวมการเงินบัญชี *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">ยอดรายได้รวม</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315] mt-1.5">@stats.Revenue</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs font-semibold text-[#16A34A] mt-2">@stats.RevenueDelta</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-[11px] text-slate-400 mt-1">หน้าร้าน ฿@Model.StorefrontRevenue.ToString("N0") + บัญชี ฿@Model.LedgerIncome.ToString("N0")</div>
        </div>
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">จำนวนสต็อกที่รับเข้า</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315] mt-1.5">@stats.StockIn</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs font-semibold text-[#2F39A9] mt-2">@stats.StockInDelta</div>
        </div>
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">จำนวนสต็อกที่ขายออก</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315] mt-1.5">@stats.StockOut</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs font-semibold text-slate-500 mt-2">@stats.StockOutDelta</div>
        </div>
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">คำสั่งจองพรีออเดอร์</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-[#050315] mt-1.5">@stats.Preorder</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs font-semibold text-[#16A34A] mt-2">@stats.PreorderDelta</div>
        </div>
    </div>

    @* กราฟแท่งแสดงแนวโน้มรายได้จริงย้อนหลัง 6 เดือนจากฐานข้อมูล *@
    <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-6 space-y-4">
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="flex items-center justify-between">
            @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
            <h2 class="text-sm font-bold text-[#050315]">แนวโน้มรายได้ 6 เดือนล่าสุด</h2>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="text-xs text-slate-400">หน่วย: บาท</span>
        </div>

        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="pt-6 pb-2 h-64 flex items-end justify-between gap-4 max-w-4xl mx-auto px-4">
            @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
            @foreach (var bar in Model.MonthlyTrends)
            {
                @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end group" title="@bar.MonthShort: ฿@bar.Revenue.ToString("N0")">
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="text-xs font-semibold @(bar.IsCurrent ? "text-[#2F39A9] font-bold" : "text-slate-400")">
                        @bar.RevenueShortLabel
                    </span>
                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                    <div class="w-full max-w-[56px] rounded-t-xl transition-all duration-300 @(bar.IsCurrent ? "bg-[#2F39A9] shadow-xs" : "bg-[#92EEFF]/60 hover:bg-[#92EEFF]")"
                         style="height: @(bar.RevenueHeightPct)%;">
                    </div>
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="text-xs font-semibold mt-1 @(bar.IsCurrent ? "text-[#050315] font-bold" : "text-slate-500")">
                        @bar.MonthShort
                    </span>
                </div>
            }
        </div>
    </div>

    @* ตารางรายละเอียดความเคลื่อนไหวสต็อกสินค้าจริงจากฐานข้อมูลพร้อมระบบแบ่งหน้า *@
    <div class="bg-white rounded-2xl border border-slate-100 shadow-xs overflow-hidden">
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-wrap gap-2">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>
                @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
                <h2 id="reportTableMonthHeading" class="text-sm font-bold text-[#050315]">รายละเอียดสต็อกเข้า-ออกรายสินค้า · @pageHeader.SelectedMonth</h2>
                @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
                <p class="text-[11px] text-slate-400 mt-0.5">คำนวณจากยอดรับเข้าคลังและรายการขายตามใบเสร็จรับเงินหน้าร้าน (ไม่รวมรายรับสมุดบัญชีอื่น)</p>
            </div>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="text-xs text-slate-400">@Model.TotalProductRowCount รายการ</span>
        </div>

        @* รายการการ์ดสำหรับหน้าจอมือถือ *@
        <div class="divide-y divide-slate-100 md:hidden">
            @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
            @foreach (var row in Model.StockMovementRows)
            {
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="p-4 space-y-2.5">
                    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
