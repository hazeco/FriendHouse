                                <div class="text-[11px] font-mono text-slate-400">@row.Sku</div>
                            </td>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td class="py-3.5 px-6 text-slate-500 text-xs">@row.CategoryName</td>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td class="py-3.5 px-6 text-center text-slate-600 font-medium">@row.InQty.ToString("N0")</td>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td class="py-3.5 px-6 text-center text-slate-600 font-medium">@row.OutQty.ToString("N0")</td>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td class="py-3.5 px-6 text-center text-slate-600 font-medium">@row.RemainQty.ToString("N0")</td>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td class="py-3.5 px-6 text-right text-slate-600 font-medium">฿@row.InValue.ToString("N0")</td>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td class="py-3.5 px-6 text-right font-bold text-[#050315]">฿@row.OutValue.ToString("N0")</td>
                        </tr>
                    }
                    @* แถวยอดรวมทั้งหมดของสินค้าทุกชิ้นในฐานข้อมูล *@
                    <tr class="bg-slate-50/80 font-bold text-[#050315]">
                        @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                        <td class="py-4 px-6">รวมทั้งหมด (@Model.TotalProductRowCount รายการ)</td>
                        @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                        <td class="py-4 px-6"></td>
                        @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                        <td class="py-4 px-6 text-center">@Model.GrandTotalInQty.ToString("N0")</td>
                        @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                        <td class="py-4 px-6 text-center">@Model.GrandTotalOutQty.ToString("N0")</td>
                        @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                        <td class="py-4 px-6 text-center">@Model.GrandTotalRemainQty.ToString("N0")</td>
                        @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                        <td class="py-4 px-6 text-right">฿@Model.GrandTotalInValue.ToString("N0")</td>
                        @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                        <td class="py-4 px-6 text-right text-base text-[#2F39A9]">฿@Model.GrandTotalOutValue.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        @* แถบแบ่งหน้าตารางรายงานประจำเดือน *@
        <div class="px-6 py-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-slate-500">
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span>แสดง @startRow–@endRow จากทั้งหมด @Model.TotalProductRowCount รายการ</span>
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center gap-1.5">
                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                @if (Model.CurrentPage > 1)
                {
                    @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                    <a asp-controller="Owner" asp-action="MonthlyReport"
                       asp-route-selectedMonth="@Model.SelectedMonthKey"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium cursor-pointer">
                        ก่อนหน้า
                    </a>
                }
                else
                {
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 font-medium cursor-not-allowed">
                        ก่อนหน้า
                    </span>
                }

                @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="size-8 rounded-lg bg-[#2F39A9] text-white font-bold flex items-center justify-center">
                            @p
                        </span>
                    }
                    else
                    {
                        @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                        <a asp-controller="Owner" asp-action="MonthlyReport"
                           asp-route-selectedMonth="@Model.SelectedMonthKey"
                           asp-route-page="@p"
                           class="size-8 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium flex items-center justify-center cursor-pointer">
                            @p
                        </a>
                    }
                }

                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                    <a asp-controller="Owner" asp-action="MonthlyReport"
                       asp-route-selectedMonth="@Model.SelectedMonthKey"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium cursor-pointer">
                        ถัดไป
                    </a>
                }
                else
                {
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 font-medium cursor-not-allowed">
                        ถัดไป
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@* หน้าต่างโมดัลที่ 1 รายงานส่งออก *@
