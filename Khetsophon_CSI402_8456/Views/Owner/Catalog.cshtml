@* กำหนดโมเดลข้อมูลสำหรับหน้าจัดการสินค้าและของรางวัล *@
@model Khetsophon_CSI402_8456.ViewModels.OwnerCatalogViewModel
@* กำหนดฟังก์ชันช่วยเหลือและการตั้งค่าข้อมูลหน้าแคตตาล็อกสินค้า *@
@{

    // ฟังก์ชันตรวจสอบและคืนค่าพาธรูปภาพสำหรับแสดงในการ์ดสินค้า
    string ResolveCardImageUrl(string? imageUrl)
    {
        // กรณีไม่มีรูปภาพให้ใช้รูปภาพสำรองตั้งต้นของระบบ
        if (string.IsNullOrWhiteSpace(imageUrl)) return "~/media/images/naruto_hero_fig.png";
        // ตัดช่องว่างส่วนหัวและท้ายของพาธรูปภาพ
        string trimmed = imageUrl.Trim();
        // ปรับรูปแบบพาธโดยตัดเครื่องหมาย tilde หากมี
        string normalized = trimmed.StartsWith("~/") ? trimmed[1..] : trimmed;
        // ตรวจสอบความถูกต้องของโฟลเดอร์มีเดียและป้องกัน path traversal
        if (!normalized.StartsWith("/media/images/", StringComparison.OrdinalIgnoreCase) || normalized.Contains("..")) return trimmed;
        // ดึงชื่อไฟล์โดยไม่รวมนามสกุล
        string? fileNameNoExt = System.IO.Path.GetFileNameWithoutExtension(normalized);
        // หากไม่มีชื่อไฟล์หรือลงท้ายด้วย _card อยู่แล้วให้คืนค่าพาธเดิม
        if (string.IsNullOrWhiteSpace(fileNameNoExt) || fileNameNoExt.EndsWith("_card", StringComparison.OrdinalIgnoreCase)) return trimmed;
        // กำหนดชื่อไฟล์รูปภาพขนาดการ์ด
        string cardFileName = fileNameNoExt + "_card.png";
        // กำหนดพาธแบบสัมพัทธ์ของรูปภาพการ์ด
        string cardRelative = "/media/images/" + cardFileName;
        // ตรวจสอบพาธไฟล์จริงบนระบบปฏิบัติการ
        string physicalPath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "media", "images", cardFileName);
        // หากมีไฟล์รูปภาพการ์ดอยู่จริงให้ใช้ไฟล์การ์ด มิฉะนั้นใช้พาธเดิม
        if (System.IO.File.Exists(physicalPath)) return trimmed.StartsWith("~/") ? "~" + cardRelative : cardRelative;
        // ส่งคืนพาธรูปภาพเดิมหากไม่พบไฟล์การ์ด
        return trimmed;
    }
    ViewData["Title"] = "จัดการสินค้าและของรางวัล";
    Layout = "_OwnerLayout";

    // การกำหนดค่าสื่อ รูปภาพ ไอคอน และข้อความสำคัญทั้งหมดไว้ส่วนบนสุดของไฟล์ตามมาตรฐาน
    var pageConfig = new
    {
        // ข้อความระบุเส้นทางเมนูนำทาง
        Breadcrumb = "เจ้าของร้าน / สินค้าและของรางวัล",
        // หัวข้อหลักของหน้าเว็บ
        Title = "จัดการสินค้าและของแลกแต้ม",
        // คำอธิบายการทำงานของหน้าเว็บ
        Subtitle = "เพิ่ม แก้ไข หรือลบรายการสินค้าในร้าน และกำหนดสิทธิ์เลือกว่าสินค้าใดใช้สำหรับขายหรือแลกแต้มสะสม",
        // รูปภาพสำรองเมื่อไม่มีรูปภาพสินค้า
        FallbackImage = "/media/images/tanjiro_kamado.png",
        // ข้อความบนปุ่มเพิ่มสินค้าใหม่
        AddProductBtn = "เพิ่มสินค้าใหม่",
        // ข้อความบนปุ่มเพิ่มของแลกแต้มใหม่
        AddRewardBtn = "เพิ่มของแลกแต้มใหม่",
        // ป้ายชื่อแท็บรายการสินค้าวางขาย
        ProductTabLabel = "สินค้าวางขายหน้าร้าน",
        // ป้ายชื่อแท็บรายการของแลกแต้มสมาชิก
        RewardTabLabel = "ของแลกแต้มสมาชิก",
        // ชุดพาธ SVG สำหรับไอคอนต่างๆ ที่ใช้ในหน้านี้
        Icons = new
        {
            // ไอคอนเครื่องหมายบวก
            Plus = "M12 4v16m8-8H4",
            // ไอคอนแว่นขยายค้นหา
            Search = "M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z",
            // ไอคอนดินสอแก้ไข
            Edit = "M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z",
            // ไอคอนถังขยะลบ
            Trash = "M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2",
            // ไอคอนกล่องของขวัญ
            Gift = "M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z",
            // ไอคอนกล่องสินค้า
            Box = "M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z",
            // ไอคอนกากบาทปิด
            Close = "M18 6L6 18M6 6l12 12"
        }
    };

    // ตรวจสอบว่ากำลังเปิดแท็บสินค้าหรือแท็บของรางวัล
    bool isProductsTab = Model.ActiveTab != "rewards";
    // คำนวณลำดับแถวเริ่มต้นสำหรับการแสดงผลการแบ่งหน้า
    int startRow = Model.TotalCount == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    // คำนวณลำดับแถวสิ้นสุดสำหรับการแสดงผลการแบ่งหน้า
    int endRow = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="space-y-6">
    @* ส่วนหัวหน้าเพจและปุ่มเพิ่มรายการใหม่ *@
    <div class="flex items-center justify-between flex-wrap gap-4">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div>
            @* ข้อความระบุตำแหน่งเมนู *@
            <div class="text-xs text-slate-400 font-medium mb-1">@pageConfig.Breadcrumb</div>
            @* หัวข้อหลักของหน้าเว็บ *@
            <h1 class="text-2xl font-bold text-text">@pageConfig.Title</h1>
            @* คำอธิบายหน้าที่และความสามารถของหน้าเว็บ *@
            <p class="text-sm text-slate-500 mt-1">@pageConfig.Subtitle</p>
        </div>
        @* กลุ่มปุ่มดำเนินการส่วนหัว สำหรับสร้างของรางวัลและสินค้าใหม่ *@
        <div class="flex items-center gap-2.5 flex-wrap">
            @* ปุ่มเปิดหน้าต่างเพิ่มของแลกแต้มใหม่ *@
            <button type="button" onclick="openCreateRewardModal()"
                    class="inline-flex items-center gap-2 rounded-xl border border-primary/25 bg-white hover:bg-secondary/20 text-primary font-bold px-4 py-2.5 text-sm shadow-2xs transition cursor-pointer">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="@pageConfig.Icons.Gift"></path>
                </svg>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>@pageConfig.AddRewardBtn</span>
            </button>
            @* ปุ่มเปิดหน้าต่างเพิ่มสินค้าใหม่เข้าคลัง *@
            <button type="button" onclick="openCreateProductModal()"
                    class="inline-flex items-center gap-2 rounded-xl bg-primary hover:bg-accent text-white font-bold px-5 py-2.5 text-sm shadow-xs transition cursor-pointer">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="@pageConfig.Icons.Plus"></path>
                </svg>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>@pageConfig.AddProductBtn</span>
            </button>
        </div>
    </div>

    @* แถบการ์ดสรุปข้อมูลสถิติสินค้าและของแลกแต้มทั้งร้าน 4 ช่อง *@
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        @* การ์ดที่ 1: สรุปจำนวนสินค้าทั้งหมดในฐานข้อมูล *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">สินค้าในฐานข้อมูลทั้งหมด</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-text mt-1.5">@Model.TotalProducts</div>
        </div>
        @* การ์ดที่ 2: สรุปจำนวนสินค้าที่เปิดวางขายหน้าร้าน *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">เปิดวางขายหน้าร้าน</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-primary mt-1.5">@Model.ActiveSaleProducts</div>
        </div>
        @* การ์ดที่ 3: สรุปจำนวนสินค้าที่หมดสต็อกหรือปิดวางขาย *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">สินค้าหมดสต็อก</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-rose-600 mt-1.5">@Model.PreorderProducts</div>
        </div>
        @* การ์ดที่ 4: สรุปจำนวนของแลกแต้มที่เปิดใช้งาน *@
        <div class="bg-white rounded-2xl border border-slate-100 shadow-xs p-5">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-xs text-slate-400 font-medium">ของแลกแต้มที่เปิดใช้งาน</div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div class="text-3xl font-extrabold text-emerald-600 mt-1.5">@Model.ActiveRewards <span class="text-sm font-medium text-slate-400">/ @Model.TotalRewards</span></div>
        </div>
    </div>

    @* กล่องแจ้งเตือนผลลัพธ์การทำงาน (แจ้งเตือนความสำเร็จ หรือ ข้อผิดพลาด) *@
    @if (TempData["SuccessMessage"] != null)
    {
        @* กล่องแจ้งเตือนข้อความสำเร็จสีเขียว *@
        <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-4 flex items-center gap-3 text-xs text-emerald-800 shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }
    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องแจ้งเตือนข้อความผิดพลาดสีแดง *@
        <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 flex items-center gap-3 text-xs text-rose-700 shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    @* แถบสลับแท็บระหว่างรายการสินค้าขาย กับ รายการของแลกแต้ม *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        @* กลุ่มปุ่มกดเลือกแท็บสินค้าหรือของแลกแต้ม *@
        <div class="inline-flex rounded-2xl bg-slate-100 p-1 self-start">
            @* ปุ่มแท็บรายการสินค้าขายหน้าร้าน *@
            <a asp-controller="Owner" asp-action="Catalog" asp-route-tab="products"
               class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs sm:text-sm font-bold transition @(isProductsTab ? "bg-white text-primary shadow-xs" : "text-slate-500 hover:text-text")">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="@pageConfig.Icons.Box"></path>
                </svg>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>@pageConfig.ProductTabLabel (@Model.TotalProducts)</span>
            </a>
            @* ปุ่มแท็บรายการของแลกแต้มสมาชิก *@
            <a asp-controller="Owner" asp-action="Catalog" asp-route-tab="rewards"
               class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs sm:text-sm font-bold transition @(!isProductsTab ? "bg-white text-primary shadow-xs" : "text-slate-500 hover:text-text")">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="@pageConfig.Icons.Gift"></path>
                </svg>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span>@pageConfig.RewardTabLabel (@Model.TotalRewards)</span>
            </a>
        </div>
    </div>

    @* แถบค้นหาและตัวกรองข้อมูลตามแท็บที่เลือก ส่งค่าผ่านฟอร์ม MVC มาตรฐานโดยไม่ระบุ method *@
    @* แบบฟอร์มแถบค้นหาและตัวกรองข้อมูลตามแท็บที่เลือก (ไม่ใส่ method attribute) *@
    <form asp-controller="Owner" asp-action="Catalog" class="bg-white rounded-2xl border border-slate-100 shadow-xs p-4">
        @* ตัวแปรซ่อนเก็บสถานะแท็บปัจจุบัน (สินค้า หรือ ของรางวัล) *@
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        @* กริดจัดวางองค์ประกอบการค้นหาและตัวกรองแบบ Responsive *@
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
            @* ช่องกรอกคำค้นหาพร้อมไอคอนแว่นขยาย *@
            <div class="lg:col-span-5 relative">
                @* ไอคอนแว่นขยายค้นหาแบบ SVG *@
                <svg class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="@pageConfig.Icons.Search"></path>
                </svg>
                @* ช่องกรอกข้อความคำค้นหา *@
                <input type="text" name="searchQuery" value="@Model.SearchQuery"
                       placeholder="@(isProductsTab ? "ค้นหาชื่อสินค้า รหัสสินค้า บาร์โค้ด หรือซีรีส์..." : "ค้นหาชื่อของรางวัล รหัสของรางวัล หรือหมวดหมู่...")"
                       class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-xs sm:text-sm text-text focus:outline-none focus:border-primary" />
            </div>

            @* ตรวจสอบว่ากำลังแสดงแท็บสินค้าหรือไม่ *@
            @if (isProductsTab)
            {
                @* เมนูเลือกกรองตามหมวดหมู่สินค้า *@
                <div class="lg:col-span-3">
                    @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                    <select name="categoryFilter" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white text-xs sm:text-sm text-text focus:outline-none focus:border-primary">
                        @* ตัวเลือกทุกหมวดหมู่สินค้า *@
                        <option value="all">ทุกหมวดหมู่สินค้า</option>
                        @* วนลูปแสดงรายชื่อหมวดหมู่สินค้าทั้งหมดจากฐานข้อมูล *@
                        @foreach (var cat in Model.AllCategories)
                        {
                            if (Model.CategoryFilter == cat.CategoryId.ToString())
                            {
                                <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                            }
                            else
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        }
                    </select>
                </div>
                @* เมนูเลือกกรองตามสถานะการวางขายของสินค้า *@
                <div class="lg:col-span-2">
                    @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                    <select name="saleModeFilter" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white text-xs sm:text-sm text-text focus:outline-none focus:border-primary">
                        <option value="all" selected="@(Model.SaleModeFilter == "all" ? "selected" : null)">ทุกสถานะสินค้า</option>
                        <option value="sale" selected="@(Model.SaleModeFilter == "sale" ? "selected" : null)">มีสินค้าพร้อมส่ง</option>
                        <option value="outofstock" selected="@(Model.SaleModeFilter == "outofstock" ? "selected" : null)">สินค้าหมดสต็อก</option>
                        <option value="hidden" selected="@(Model.SaleModeFilter == "hidden" ? "selected" : null)">ซ่อนจากหน้าขาย</option>
                    </select>
                </div>
            }
            else
            {
                @* เมนูเลือกกรองตามสถานะของรางวัลแลกแต้มสะสม *@
                <div class="lg:col-span-5">
                    @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                    <select name="saleModeFilter" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white text-xs sm:text-sm text-text focus:outline-none focus:border-primary">
                        <option value="all" selected="@(Model.SaleModeFilter == "all" ? "selected" : null)">ทุกสถานะของแลกแต้ม</option>
                        <option value="available" selected="@(Model.SaleModeFilter == "available" ? "selected" : null)">เปิดให้แลกและมีคงเหลือ</option>
                        <option value="unavailable" selected="@(Model.SaleModeFilter == "unavailable" ? "selected" : null)">ปิดให้แลกชั่วคราว</option>
                        <option value="outofstock" selected="@(Model.SaleModeFilter == "outofstock" ? "selected" : null)">สิทธิ์แลกหมดสต็อก</option>
                    </select>
                </div>
            }

            @* กลุ่มปุ่มกดส่งคำค้นหาและปุ่มล้างค่าตัวกรอง *@
            <div class="lg:col-span-2 flex items-center gap-2">
                @* ปุ่มกดเริ่มการค้นหา *@
                <button type="submit" class="flex-1 rounded-xl bg-primary hover:bg-accent text-white text-xs sm:text-sm font-bold py-2.5 px-4 transition cursor-pointer">
                    ค้นหา
                </button>
                @* ตรวจสอบว่ามีการระบุเงื่อนไขค้นหาหรือตัวกรองอยู่หรือไม่ *@
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.CategoryFilter != "all" || Model.SaleModeFilter != "all")
                {
                    @* ปุ่มรีเซ็ตล้างค่าตัวกรองเพื่อกลับสู่ค่าเริ่มต้น *@
                    <a asp-controller="Owner" asp-action="Catalog" asp-route-tab="@Model.ActiveTab"
                       class="rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-xs font-semibold py-2.5 px-3">
                        ล้างค่า
                    </a>
                }
            </div>
        </div>
    </form>

    @* ตารางแสดงข้อมูลตามแท็บที่เลือก แยกการ์ดมือถือและการ์ดเดสก์ท็อป *@
    <div class="bg-white rounded-2xl border border-slate-100 shadow-xs overflow-hidden">
        @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
        @if (isProductsTab)
        {
            @* การ์ดรายการสินค้าสำหรับหน้าจอมือถือ *@
            @* ส่วนแสดงรายการสินค้าในรูปแบบการ์ดบนหน้าจอมือถือ *@
            <div class="divide-y divide-slate-100 md:hidden">
                @* ตรวจสอบว่ามีรายการสินค้าในระบบหรือไม่ *@
                @if (Model.Products.Any())
                {
                    @* วนลูปแสดงข้อมูลสินค้าแต่ละรายการในการ์ดมือถือ *@
                    @foreach (var p in Model.Products)
                    {
                        var stockQty = p.IsPreorder ? 0 : Math.Max(0, (p.Inventory?.QuantityOnHand ?? 0) - (p.Inventory?.ReservedQuantity ?? 0));
                        var safetyQty = p.Inventory?.SafetyStockLevel ?? 5;
                        var storageLoc = p.Inventory?.StorageLocation ?? "โซน A-01";
                        bool isSaleActive = p.IsActive == true;
                        bool isOutOfStock = p.IsPreorder || stockQty <= 0;
                        bool hasLinkedReward = Model.LinkedRewardTitles.Contains(p.Name);

                        @* การ์ดข้อมูลสินค้าแต่ละรายการ *@
                        <div class="p-4 space-y-3">
                            @* แถวข้อมูลส่วนหัว: รูปภาพและชื่อสินค้า *@
                            <div class="flex items-start gap-3">
                                @* กรอบรูปภาพขนาดย่อของสินค้า *@
                                <div class="size-14 rounded-xl border border-slate-100 bg-white shrink-0 overflow-hidden">
                                    @* รูปภาพประกอบรายการพร้อมกำหนดคลาสจัดสัดส่วนการแสดงผล *@
                                    <img src="@Url.Content(ResolveCardImageUrl(string.IsNullOrEmpty(p.ImageUrl) ? pageConfig.FallbackImage : p.ImageUrl))"
                                         alt="@p.Name" class="size-full object-cover object-top" />
                                </div>
                                @* กล่องชื่อสินค้า รหัส SKU และป้ายสถานะ *@
                                <div class="min-w-0 flex-1">
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="font-bold text-text text-sm leading-snug">@p.Name</div>
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="text-[11px] font-mono text-slate-400 mt-0.5">@p.Sku · @(p.Category?.CategoryName ?? "ทั่วไป")</div>
                                    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                    <div class="flex items-center flex-wrap gap-1.5 mt-1.5">
                                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold whitespace-nowrap @(!isSaleActive ? "bg-slate-100 text-slate-500" : isOutOfStock ? "bg-rose-50 text-rose-700" : "bg-emerald-50 text-emerald-700")">
                                            @(!isSaleActive ? "ซ่อนจากหน้าขาย" : isOutOfStock ? "สินค้าหมด" : "วางขายหน้าร้าน")
                                        </span>
                                        @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                        @if (hasLinkedReward)
                                        {
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span class="inline-flex items-center rounded-full bg-secondary/35 px-2.5 py-0.5 text-[10px] font-bold text-primary whitespace-nowrap">
                                                มีในรายการแลกแต้ม
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            @* แถวข้อมูลราคาขายและจำนวนสต็อกคงเหลือ *@
                            <div class="flex items-center justify-between text-xs bg-slate-50/70 rounded-xl px-3 py-2">
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="text-slate-400">ราคาขาย:</span>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="font-bold text-primary ml-1">฿@p.RetailPrice.ToString("N0")</span>
                                </div>
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="text-slate-400">คงเหลือ:</span>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="font-bold ml-1 @(stockQty <= 0 ? "text-rose-600" : stockQty <= safetyQty ? "text-amber-600" : "text-text")">@stockQty ชิ้น</span>
                                </div>
                            </div>
                            @* กลุ่มปุ่มดำเนินการสำหรับสินค้ารายการนี้ (สลับสถานะ / ตั้งเป็นของแลก / แก้ไข / ลบ) *@
                            <div class="flex flex-wrap items-center gap-1.5 pt-1 border-t border-slate-100">
                                @* แบบฟอร์มสลับสถานะเปิดขาย/ซ่อนขายหน้าร้าน *@
                                <form asp-controller="Owner" asp-action="ToggleProductSaleStatus" class="inline">
                                    @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
                                    <input type="hidden" name="productId" value="@p.ProductId" />
                                    @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
                                    <input type="hidden" name="mode" value="active" />
                                    @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
                                    <input type="hidden" name="page" value="@Model.CurrentPage" />
                                    @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
                                    <button type="submit"
                                            class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50 text-slate-700 px-2.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap">
                                        @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                        @if (isSaleActive)
                                        {
                                            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                            <svg class="size-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                                <line x1="1" y1="1" x2="23" y2="23"></line>
                                            </svg>
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span>ซ่อนขาย</span>
                                        }
                                        else
                                        {
                                            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                            <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span>เปิดขาย</span>
                                        }
                                    </button>
                                </form>

                                @* ปุ่มเปิดหน้าต่างแปลงหรือกำหนดสินค้าเป็นของรางวัลแลกแต้ม *@
                                <button type="button"
                                        onclick="openConvertRewardModal(this)"
                                        data-id="@p.ProductId"
                                        data-name="@p.Name"
                                        data-sku="@p.Sku"
                                        data-price="@p.RetailPrice"
                                        data-stock="@stockQty"
                                        class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-primary/40 hover:bg-primary/5 px-2.5 text-xs font-semibold text-primary transition-colors cursor-pointer whitespace-nowrap">
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="@pageConfig.Icons.Gift"></path>
                                    </svg>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span>ตั้งเป็นของแลก</span>
                                </button>

                                @* ปุ่มเปิดหน้าต่างแก้ไขข้อมูลสินค้า *@
                                <button type="button"
                                        onclick="openEditProductModal(this)"
                                        data-id="@p.ProductId"
                                        data-sku="@p.Sku"
                                        data-barcode="@(p.Barcode ?? p.Sku)"
                                        data-name="@p.Name"
                                        data-category="@p.CategoryId"
                                        data-series="@(p.SeriesName ?? "")"
                                        data-brand="@(p.BrandName ?? "")"
                                        data-scale="@(p.Scale ?? "")"
                                        data-height="@(p.HeightCm?.ToString() ?? "")"
                                        data-material="@(p.Material ?? "")"
                                        data-retail="@p.RetailPrice"
                                        data-isactive="@(isSaleActive ? "true" : "false")"
                                        data-stock="@stockQty"
                                        data-safety="@safetyQty"
                                        data-location="@storageLoc"
                                        data-image="@p.ImageUrl"
                                        class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50 hover:text-primary px-2.5 text-xs font-semibold text-slate-700 transition-colors cursor-pointer whitespace-nowrap">
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="@pageConfig.Icons.Edit"></path>
                                    </svg>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span>แก้ไข</span>
                                </button>

                                @* ปุ่มเปิดหน้าต่างยืนยันการลบสินค้า *@
                                <button type="button"
                                        onclick="openDeleteProductModal(this)"
                                        data-id="@p.ProductId"
                                        data-name="@p.Name"
                                        data-sku="@p.Sku"
                                        class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-rose-300 hover:bg-rose-50/50 hover:text-rose-600 px-2.5 text-xs font-semibold text-slate-700 transition-colors cursor-pointer whitespace-nowrap">
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="@pageConfig.Icons.Trash"></path>
                                    </svg>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span>ลบ</span>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                    <div class="py-12 text-center text-xs text-slate-400">
                        ไม่พบรายการสินค้าที่ตรงกับเงื่อนไขการค้นหา
                    </div>
                }
            </div>

            @* ส่วนตารางรายการสินค้าสำหรับหน้าจอเดสก์ท็อป *@
            <div class="hidden md:block overflow-x-auto">
                @* ตารางแสดงรายการข้อมูลอย่างเป็นระเบียบพร้อมรองรับการเลื่อนแนวนอนบนจอเล็ก *@
                <table class="w-full min-w-[960px] text-sm">
                    @* ส่วนหัวตารางกำหนดชื่อคอลัมน์ข้อมูล *@
                    <thead>
                        @* แถวหัวตารางข้อมูลสินค้า *@
                        <tr class="border-b border-slate-100 text-left text-xs font-semibold text-slate-400 bg-background">
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-5">สินค้า</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4">หมวดหมู่ / ซีรีส์</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4 text-right whitespace-nowrap">ราคาขาย</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4 text-center whitespace-nowrap">คงเหลือ</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4 text-center whitespace-nowrap">บทบาทในร้าน</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-5 text-right whitespace-nowrap">จัดการ</th>
                        </tr>
                    </thead>
                    @* ส่วนเนื้อหาตารางแสดงแถวข้อมูลแต่ละรายการ *@
                    <tbody class="divide-y divide-slate-100">
                        @* ตรวจสอบว่ามีรายการสินค้าในระบบหรือไม่ *@
                        @if (Model.Products.Any())
                        {
                            @* วนลูปแสดงข้อมูลสินค้าแต่ละรายการในตาราง *@
                            @foreach (var p in Model.Products)
                            {
                                var stockQty = p.IsPreorder ? 0 : Math.Max(0, (p.Inventory?.QuantityOnHand ?? 0) - (p.Inventory?.ReservedQuantity ?? 0));
                                var safetyQty = p.Inventory?.SafetyStockLevel ?? 5;
                                var storageLoc = p.Inventory?.StorageLocation ?? "โซน A-01";
                                bool isSaleActive = p.IsActive == true;
                                bool isOutOfStock = p.IsPreorder || stockQty <= 0;
                                bool hasLinkedReward = Model.LinkedRewardTitles.Contains(p.Name);

