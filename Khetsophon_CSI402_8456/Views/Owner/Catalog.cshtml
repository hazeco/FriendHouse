@section Scripts {
    <script>
        // ฟังก์ชันปิดหน้าต่างป๊อปอัปทั้งหมดในหน้าจัดการสินค้าและของรางวัล
        function closeCatalogModals() {
            const ids = [
                'createProductModal',
                'editProductModal',
                'convertRewardModal',
                'deleteProductModal',
                'createRewardModal',
                'editRewardModal',
                'deleteRewardModal'
            ];
            ids.forEach(id => document.getElementById(id)?.classList.add('hidden'));
        }

        // เปิดหน้าต่างเพิ่มสินค้าใหม่
        function openCreateProductModal() {
            closeCatalogModals();
            document.getElementById('createProductModal')?.classList.remove('hidden');
        }

        // เปิด-ปิดช่องกรอกแต้มเมื่อเลือกเปิดสินค้าใหม่เป็นของแลกแต้มควบคู่
        function toggleCreateRewardFields(checked) {
            const box = document.getElementById('createAlsoRewardFields');
            if (!box) return;
            box.classList.toggle('hidden', !checked);
        }

        // เปิดหน้าต่างแก้ไขสินค้าพร้อมเติมค่าเดิมจากปุ่มที่กด
        function openEditProductModal(btn) {
            closeCatalogModals();
            const d = btn.dataset;
            document.getElementById('editProdId').value = d.id || '';
            document.getElementById('editProdSku').value = d.sku || '';
            document.getElementById('editProdBarcode').value = d.barcode || '';
            document.getElementById('editProdName').value = d.name || '';
            document.getElementById('editProdCategory').value = d.category || '';
            document.getElementById('editProdSeries').value = d.series || '';
            document.getElementById('editProdBrand').value = d.brand || '';
            document.getElementById('editProdRetail').value = d.retail || '0';
            document.getElementById('editProdPreorder').value = d.preorder || '';
            document.getElementById('editProdStock').value = d.stock || '0';
            document.getElementById('editProdSafety').value = d.safety || '5';
            document.getElementById('editProdActive').checked = d.isactive === 'true';
            document.getElementById('editProdIsPreorder').checked = d.ispreorder === 'true';

            const imgSelect = document.getElementById('editProdImage');
            if (imgSelect && d.image) {
                const match = Array.from(imgSelect.options).find(o => o.value.toLowerCase() === d.image.toLowerCase());
                if (match) imgSelect.value = match.value;
            }

            document.getElementById('editProductModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างกำหนดสินค้าให้เป็นของแลกแต้มสะสม
        function openConvertRewardModal(btn) {
            closeCatalogModals();
            const d = btn.dataset;
            const price = parseFloat(d.price || '1000');
            const suggestedPoints = Math.max(500, Math.round(price / 100) * 100);
            document.getElementById('convertProdId').value = d.id || '';
            document.getElementById('convertProdLabel').innerText = `${d.name} (${d.sku})`;
            document.getElementById('convertPoints').value = suggestedPoints;
            document.getElementById('convertStock').value = Math.max(1, parseInt(d.stock || '5', 10));
            document.getElementById('convertRewardModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างยืนยันการลบสินค้า
        function openDeleteProductModal(id, name, sku) {
            closeCatalogModals();
            document.getElementById('deleteProdId').value = id;
            document.getElementById('deleteProdName').innerText = name;
            document.getElementById('deleteProdSku').innerText = sku;
            document.getElementById('deleteProductModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างเพิ่มของแลกแต้มใหม่
        function openCreateRewardModal() {
            closeCatalogModals();
            document.getElementById('createRewardModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างแก้ไขของแลกแต้ม
        function openEditRewardModal(btn) {
            closeCatalogModals();
            const d = btn.dataset;
            document.getElementById('editRewardId').value = d.id || '';
            document.getElementById('editRewardCode').value = d.code || '';
            document.getElementById('editRewardTitle').value = d.title || '';
            document.getElementById('editRewardBrand').value = d.brand || '';
            document.getElementById('editRewardTag').value = d.tag || '';
            document.getElementById('editRewardPoints').value = d.points || '1000';
            document.getElementById('editRewardStock').value = d.stock || '1';
            document.getElementById('editRewardAvailable').checked = d.available === 'true';

            const imgSelect = document.getElementById('editRewardImage');
            if (imgSelect && d.image) {
                const match = Array.from(imgSelect.options).find(o => o.value.toLowerCase() === d.image.toLowerCase());
                if (match) imgSelect.value = match.value;
            }

            document.getElementById('editRewardModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างยืนยันการลบของแลกแต้ม
        function openDeleteRewardModal(id, title, code) {
            closeCatalogModals();
            document.getElementById('deleteRewardId').value = id;
            document.getElementById('deleteRewardTitle').innerText = title;
            document.getElementById('deleteRewardCode').innerText = code;
            document.getElementById('deleteRewardModal')?.classList.remove('hidden');
        }
    </script>
}

