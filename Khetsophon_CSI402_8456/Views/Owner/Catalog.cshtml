            @* แถวเลือกรูปภาพจากคลังสื่อหรืออัปโหลดรูปใหม่ *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                    <label class="text-xs font-bold text-text block mb-1">รูปภาพในคลังสื่อ</label>
                    @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                    <select name="imageUrl" id="editRewardImage" data-cropper-select="editReward" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs bg-white focus:border-primary focus:outline-none">
                        @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                        @foreach (var img in Model.AvailableImages)
                        {
                            <option value="@img">@System.IO.Path.GetFileName(img)</option>
                        }
                    </select>
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                    <label class="text-xs font-bold text-text block mb-1">อัปโหลดรูปภาพใหม่</label>
                    @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                    <input type="file" name="imageFile" accept="image/*" data-cropper-file="editReward"
                           class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-primary/10 file:px-3 file:py-1 file:text-xs file:font-bold file:text-primary" />
                </div>
            </div>
            @* ช่องสำหรับแทรกตัวปรับแต่งรูปภาพ 1:1 *@
            <div class="catalog-cropper-slot" data-cropper-key="editReward"></div>

            @* ตัวเลือกสถานะเปิดให้ลูกค้าแลกแต้ม *@
            <label class="inline-flex items-center gap-2 text-xs cursor-pointer">
                @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                <input type="checkbox" name="isAvailable" id="editRewardAvailable" value="true" class="size-4 accent-primary" />
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="font-semibold text-text">เปิดให้ลูกค้าแลกแต้ม</span>
            </label>

            @* แถบปุ่มยกเลิกและปุ่มยืนยันบันทึกการแก้ไข *@
            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
                <button type="button" onclick="closeCatalogModals()" class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">
                    ยกเลิก
                </button>
                @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
                <button type="submit" class="rounded-xl bg-primary hover:bg-accent px-5 py-2 text-xs font-bold text-white cursor-pointer">
                    บันทึกการแก้ไขของรางวัล
                </button>
            </div>
        </form>
    </div>
</div>

@* หน้าต่างโมดัลที่ 7 ยืนยันการลบของแลกแต้ม *@
@* หน้าต่างป๊อปอัปยืนยันการลบของรางวัลแลกแต้มออกจากระบบ *@
<div id="deleteRewardModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
    @* กล่องการ์ดยืนยันการลบของรางวัล *@
    <div class="w-full max-w-md rounded-3xl bg-white p-6 shadow-2xl border border-slate-100 space-y-4">
        @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
        <h3 class="text-lg font-bold text-rose-600">ยืนยันการลบของแลกแต้ม</h3>
        @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
        <p class="text-xs text-slate-600 leading-relaxed">
            ต้องการลบของรางวัล <span id="deleteRewardTitle" class="font-bold text-text"></span> (<span id="deleteRewardCode" class="font-mono"></span>) ออกจากระบบหรือไม่
        </p>
        @* แบบฟอร์มลบของรางวัล (ไม่ใส่ method attribute) *@
        <form asp-controller="Owner" asp-action="DeleteReward" class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
            @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
            <input type="hidden" name="rewardId" id="deleteRewardId" />
            @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
            <button type="button" onclick="closeCatalogModals()" class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">
                ยกเลิก
            </button>
            @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
            <button type="submit" class="rounded-xl bg-rose-600 hover:bg-rose-700 px-5 py-2 text-xs font-bold text-white cursor-pointer">
                ยืนยันการลบ
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @* บล็อกสคริปต์ JavaScript สำหรับควบคุมการโต้ตอบฝั่งไคลเอนต์ *@
    <script>
        // ฟังก์ชันปิดหน้าต่างป๊อปอัปทั้งหมดในหน้าจัดการสินค้าและของรางวัล
        function closeCatalogModals() {
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const ids = [
                'createProductModal',
                'editProductModal',
                'convertRewardModal',
                'deleteProductModal',
                'createRewardModal',
                'editRewardModal',
                'deleteRewardModal'
            ];
            ids.forEach(id => document.getElementById(id)?.classList.add('hidden'));
        }

        // คลังเก็บออบเจกต์เครื่องมือตัดภาพขนาดย่อแยกตามคีย์ของแต่ละโมดัล
        const catalogCroppers = {};

        // ฟังก์ชันสร้างและตั้งค่าเครื่องมือตัดและปรับภาพขนาดย่อ 1:1 แบบ Canvas
        function initCatalogCropper(key) {
            // ค้นหาตำแหน่งสล็อตสำหรับเครื่องมือปรับกรอบภาพตามคีย์
            const slot = document.querySelector(`.catalog-cropper-slot[data-cropper-key="${key}"]`);
            // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
            if (!slot) return null;
            // ค้นหาแบบฟอร์มหลักที่ครอบสล็อตเครื่องมือ
            const form = slot.closest('form');
            // ค้นหาเมนูเลือกไฟล์รูปภาพที่มีอยู่เดิม
            const selectEl = form?.querySelector(`[data-cropper-select="${key}"]`);
            // ค้นหาช่องอัปโหลดไฟล์รูปภาพใหม่
            const fileEl = form?.querySelector(`[data-cropper-file="${key}"]`);
            // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
            if (!form || !fileEl) return null;

            // กำหนดสไตล์คอนเทนเนอร์ของเครื่องมือปรับภาพ
            slot.className = 'catalog-cropper-slot rounded-2xl border border-slate-200 bg-background p-3.5 space-y-3';
            // กำหนดโครงสร้าง HTML ภายในสล็อตเครื่องมือตัดภาพ
            slot.innerHTML = `
                <input type="file" name="thumbFile" accept="image/png" class="hidden" data-cropper-thumb="${key}" />
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div>
                        <div class="text-xs font-bold text-text">ปรับกรอบภาพสำหรับหน้าการ์ด 1:1 (ภาพต้นฉบับไม่ถูกตัด)</div>
                        <div class="text-[11px] text-slate-500" data-cropper-meta="${key}">ลากภาพบนกรอบเพื่อจัดตำแหน่ง หรือเลื่อนปรับขนาดซูม (หน้าสินค้าจะแสดงรูปเต็มสัดส่วนจริงเสมอ)</div>
                    </div>
                    <span class="inline-flex items-center rounded-full bg-white border border-slate-200 px-2.5 py-0.5 text-[10px] font-bold text-primary" data-cropper-badge="${key}">โหมดดูตัวอย่าง</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-3.5 items-center">
                    <div class="sm:col-span-5 flex justify-center">
                        <canvas width="360" height="360" data-cropper-canvas="${key}"
                                class="size-36 rounded-xl border border-slate-200 bg-white shadow-xs cursor-grab active:cursor-grabbing touch-none"></canvas>
                    </div>
                    <div class="sm:col-span-7 space-y-2 text-xs">
                        <div class="flex flex-wrap gap-1.5">
                            <button type="button" data-cropper-mode="fill" data-cropper-key="${key}"
                                    class="rounded-lg px-2.5 py-1.5 text-[11px] font-bold border border-primary bg-primary text-white transition cursor-pointer">
                                ครอปเต็มกรอบ (Fill 1:1)
                            </button>
                            <button type="button" data-cropper-mode="fit" data-cropper-key="${key}"
                                    class="rounded-lg px-2.5 py-1.5 text-[11px] font-bold border border-slate-200 bg-white text-text hover:border-primary transition cursor-pointer">
                                แสดงเต็มตัว (Fit พื้นขาว)
                            </button>
                            <button type="button" data-cropper-reset="${key}"
                                    class="rounded-lg px-2.5 py-1.5 text-[11px] font-bold border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition cursor-pointer">
                                รีเซ็ต
                            </button>
                        </div>
                        <div class="space-y-1">
                            <div class="flex items-center justify-between text-[11px] font-semibold text-slate-600">
                                <span>ขนาดซูม</span>
                                <span data-cropper-zoom-label="${key}">100%</span>
                            </div>
                            <input type="range" min="0.6" max="2.5" step="0.02" value="1" data-cropper-zoom="${key}"
                                   class="w-full accent-primary cursor-pointer" />
                        </div>
                        <p class="text-[11px] text-slate-500 leading-relaxed">
                            ลากขยับตำแหน่งภาพหรือปรับซูมเพื่อให้ภาพการ์ด 1:1 เต็มกรอบพอดี (หน้ารายละเอียดจะแสดงภาพเต็มทั้งตัวอัตโนมัติ)
                        </p>
                    </div>
                </div>
            `;

            // ดึงองค์ประกอบอินพุตไฟล์ภาพขนาดย่อซ่อน
            const thumbEl = slot.querySelector(`[data-cropper-thumb="${key}"]`);
            // ดึงองค์ประกอบแคนวาสแสดงตัวอย่าง
            const canvas = slot.querySelector(`[data-cropper-canvas="${key}"]`);
            // ดึงบริบทเรนเดอร์ 2 มิติของแคนวาส
            const ctx = canvas.getContext('2d');
            // ดึงสไลเดอร์ปรับระดับการซูม
            const zoomEl = slot.querySelector(`[data-cropper-zoom="${key}"]`);
            // ดึงป้ายแสดงเปอร์เซ็นต์การซูม
            const zoomLabel = slot.querySelector(`[data-cropper-zoom-label="${key}"]`);
            // ดึงป้ายแสดงรายละเอียดขนาดภาพต้นฉบับ
            const metaEl = slot.querySelector(`[data-cropper-meta="${key}"]`);
            // ดึงป้ายสถานะการตัดต่อภาพ
            const badgeEl = slot.querySelector(`[data-cropper-badge="${key}"]`);
            // ดึงปุ่มเปลี่ยนโหมดให้ภาพพอดีกรอบ
            const fitBtn = slot.querySelector(`button[data-cropper-mode="fit"]`);
            // ดึงปุ่มเปลี่ยนโหมดให้ภาพเต็มกรอบ 1:1
            const fillBtn = slot.querySelector(`button[data-cropper-mode="fill"]`);
            // ดึงปุ่มรีเซ็ตการจัดวางภาพ
            const resetBtn = slot.querySelector(`button[data-cropper-reset="${key}"]`);

            // ออบเจกต์เก็บสถานะการทำงานของเครื่องมือปรับภาพ
            const state = {
                // ออบเจกต์รูปภาพ Image ที่กำลังโหลด
                img: null,
                // โหมดการจัดวาง: 'fill' หรือ 'fit'
                mode: 'fill',
                // ระดับการซูมเริ่มต้น 1.0 (100%)
                zoom: 1,
                // ระยะเลื่อนในแนวนอน (แกน X)
                offsetX: 0,
                // ระยะเลื่อนในแนวตั้ง (แกน Y)
                offsetY: 0,
                // สถานะว่ามีการแก้ไขภาพแล้วหรือไม่
                dirty: false,
                // สถานะการลากเมาส์/สัมผัส
                dragging: false,
                // พิกัดเริ่มต้นแกน X เมื่อเริ่มคลิกลาก
                startX: 0,
                // พิกัดเริ่มต้นแกน Y เมื่อเริ่มคลิกลาก
                startY: 0,
                // ระยะเลื่อนเดิมแกน X
                origX: 0,
                // ระยะเลื่อนเดิมแกน Y
                origY: 0
            };

            // ฟังก์ชันอัปเดตสถานะการแสดงผลของปุ่มเลือกโหมด
            function refreshModeButtons() {
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const isFit = state.mode === 'fit';
                fitBtn.className = isFit
                    ? 'rounded-lg px-2.5 py-1.5 text-[11px] font-bold border border-primary bg-primary text-white transition cursor-pointer'
                    : 'rounded-lg px-2.5 py-1.5 text-[11px] font-bold border border-slate-200 bg-white text-text hover:border-primary transition cursor-pointer';
                fillBtn.className = !isFit
                    ? 'rounded-lg px-2.5 py-1.5 text-[11px] font-bold border border-primary bg-primary text-white transition cursor-pointer'
                    : 'rounded-lg px-2.5 py-1.5 text-[11px] font-bold border border-slate-200 bg-white text-text hover:border-primary transition cursor-pointer';
            }

            // ฟังก์ชันวาดภาพลงบนผืนผ้าแคนวาสเป้าหมาย
            function drawToCanvas(targetCanvas, targetCtx) {
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const size = targetCanvas.width;
                targetCtx.fillStyle = '#FFFFFF';
                targetCtx.fillRect(0, 0, size, size);
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (!state.img) return;

                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const iw = state.img.naturalWidth || state.img.width;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const ih = state.img.naturalHeight || state.img.height;
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (!iw || !ih) return;

                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const baseScale = state.mode === 'fill'
                    ? Math.max(size / iw, size / ih)
                    : Math.min(size / iw, size / ih);
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const scale = baseScale * state.zoom;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const drawW = iw * scale;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const drawH = ih * scale;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const ratioToPreview = size / canvas.width;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const dx = (size - drawW) / 2 + state.offsetX * ratioToPreview;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const dy = (size - drawH) / 2 + state.offsetY * ratioToPreview;
                targetCtx.drawImage(state.img, dx, dy, drawW, drawH);
            }

            // ฟังก์ชันแปลงภาพจากแคนวาสเป็นไฟล์เพื่อส่งผ่านแบบฟอร์ม
            function syncThumbFile() {
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (!state.img || !state.dirty) {
                    thumbEl.value = '';
                    badgeEl.textContent = 'โหมดดูตัวอย่าง';
                    badgeEl.className = 'inline-flex items-center rounded-full bg-white border border-slate-200 px-2.5 py-0.5 text-[10px] font-bold text-primary';
                    // ส่งคืนค่าหรือจบการทำงานของฟังก์ชัน
                    return;
                }
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const outCanvas = document.createElement('canvas');
                outCanvas.width = 800;
                outCanvas.height = 800;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const outCtx = outCanvas.getContext('2d');
                drawToCanvas(outCanvas, outCtx);

                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const dataUrl = outCanvas.toDataURL('image/png');
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const binStr = atob(dataUrl.split(',')[1]);
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const bytes = new Uint8Array(binStr.length);
                for (let i = 0; i < binStr.length; i++) {
                    bytes[i] = binStr.charCodeAt(i);
                }
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const file = new File([bytes], 'card_crop_1x1.png', { type: 'image/png' });
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const dt = new DataTransfer();
                dt.items.add(file);
                thumbEl.files = dt.files;

                badgeEl.textContent = 'พร้อมบันทึกการ์ด 1:1';
                badgeEl.className = 'inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-[10px] font-bold text-emerald-700';
            }

            // ฟังก์ชันเรนเดอร์ภาพตัวอย่างบนแคนวาสและปรับป้ายข้อความ
            function render(markDirty) {
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (markDirty) state.dirty = true;
                zoomLabel.textContent = `${Math.round(state.zoom * 100)}%`;
                refreshModeButtons();
                drawToCanvas(canvas, ctx);
                syncThumbFile();
            }

            // ฟังก์ชันโหลดรูปภาพต้นฉบับจาก URL หรือ Base64 Data
            function loadSource(src, markDirty) {
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (!src) return;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const normalized = src.startsWith('~/') ? '/' + src.slice(2) : src;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const image = new Image();
                image.crossOrigin = 'anonymous';
                image.onload = function () {
                    state.img = image;
                    state.zoom = 1;
                    state.offsetX = 0;
                    state.offsetY = 0;
                    zoomEl.value = '1';
                    // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                    const isTallOrWide = Math.abs((image.naturalWidth / Math.max(1, image.naturalHeight)) - 1) > 0.12;
                    state.mode = 'fill';
                    metaEl.textContent = `ต้นฉบับ: ${image.naturalWidth}x${image.naturalHeight} px · แนะนำ: ${isTallOrWide ? 'ครอปเต็มกรอบ 1:1 แล้วปรับซูม/ลากจัดตำแหน่ง' : 'เลือกปรับได้ตามต้องการ'}`;
                    render(markDirty);
                };
                image.src = normalized;
            }

            // จัดการอีเวนต์คลิกปุ่มโหมดเต็มตัว (Fit)
            fitBtn.addEventListener('click', () => { state.mode = 'fit'; state.offsetX = 0; state.offsetY = 0; render(true); });
            // จัดการอีเวนต์คลิกปุ่มโหมดเต็มกรอบ (Fill)
            fillBtn.addEventListener('click', () => { state.mode = 'fill'; state.offsetX = 0; state.offsetY = 0; render(true); });
            // จัดการอีเวนต์คลิกปุ่มรีเซ็ตการปรับแต่ง
            resetBtn.addEventListener('click', () => { state.zoom = 1; state.offsetX = 0; state.offsetY = 0; zoomEl.value = '1'; render(true); });
            // จัดการอีเวนต์เลื่อนสไลเดอร์ปรับการซูม
            zoomEl.addEventListener('input', () => { state.zoom = parseFloat(zoomEl.value) || 1; render(true); });

            // จัดการอีเวนต์เริ่มกดลากภาพบนแคนวาส
            canvas.addEventListener('pointerdown', (e) => {
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (!state.img) return;
                state.dragging = true;
                state.startX = e.clientX;
                state.startY = e.clientY;
                state.origX = state.offsetX;
                state.origY = state.offsetY;
                canvas.setPointerCapture(e.pointerId);
            });
            // จัดการอีเวนต์ขยับเมาส์ขณะลากภาพ
            canvas.addEventListener('pointermove', (e) => {
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (!state.dragging) return;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const rect = canvas.getBoundingClientRect();
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const ratio = rect.width > 0 ? (canvas.width / rect.width) : 2;
                state.offsetX = state.origX + (e.clientX - state.startX) * ratio;
                state.offsetY = state.origY + (e.clientY - state.startY) * ratio;
                render(true);
            });
            // จัดการอีเวนต์ปล่อยการลากภาพ
            canvas.addEventListener('pointerup', () => { state.dragging = false; });
            // จัดการอีเวนต์ยกเลิกการลากภาพ
            canvas.addEventListener('pointercancel', () => { state.dragging = false; });

            // ดักฟังการเปลี่ยนตัวเลือกรูปภาพเดิมจากระบบ
            if (selectEl) {
                // ฟังก์ชันและตัวดักจับเหตุการณ์สำหรับควบคุมการทำงานบนหน้าเว็บ
                selectEl.addEventListener('change', () => {
                    fileEl.value = '';
                    loadSource(selectEl.value, false);
                });
            }

            // ดักฟังการอัปโหลดไฟล์รูปภาพใหม่จากเครื่อง
            fileEl.addEventListener('change', () => {
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const file = fileEl.files && fileEl.files[0];
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (!file) return;
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const reader = new FileReader();
                reader.onload = (ev) => {
                    // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                    if (ev.target?.result) {
                        loadSource(String(ev.target.result), true);
                    }
                };
                reader.readAsDataURL(file);
            });

            // ดักฟังการส่งแบบฟอร์มเพื่อซิงค์ไฟล์ภาพสุดท้าย
            form.addEventListener('submit', () => {
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (state.dirty && state.img) syncThumbFile();
            });

            // คืนค่าออบเจกต์ฟังก์ชันควบคุมภายนอก
            return {
                resetForOpen: function (url) {
                    fileEl.value = '';
                    thumbEl.value = '';
                    state.dirty = false;
                    loadSource(url || (selectEl ? selectEl.value : ''), false);
                }
            };
        }

        // ดักฟังเหตุการณ์เมื่อโครงสร้าง DOM โหลดเสร็จสมบูรณ์
        document.addEventListener('DOMContentLoaded', function () {
            // วนลูปเริ่มต้นการทำงานของเครื่องมือครอบตัดภาพสำหรับแต่ละโมดัล
            ['createProd', 'editProd', 'createReward', 'editReward'].forEach(key => {
                // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
                const inst = initCatalogCropper(key);
                // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
                if (inst) catalogCroppers[key] = inst;
            });
        });

        // เปิดหน้าต่างเพิ่มสินค้าใหม่
        function openCreateProductModal() {
            closeCatalogModals();
            catalogCroppers.createProd?.resetForOpen();
            document.getElementById('createProductModal')?.classList.remove('hidden');
        }

        // เปิด-ปิดช่องกรอกแต้มเมื่อเลือกเปิดสินค้าใหม่เป็นของแลกแต้มควบคู่
        function toggleCreateRewardFields(checked) {
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const box = document.getElementById('createAlsoRewardFields');
            // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
            if (!box) return;
            box.classList.toggle('hidden', !checked);
        }

        // รักษาค่า ImageUrl เดิมแม้เป็นพาธรูปภาพที่อยู่นอกรายการตัวเลือกมาตรฐาน
        function setOrAppendImageOption(selectEl, imageUrl) {
            // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
            if (!selectEl || !imageUrl) return;
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            let match = Array.from(selectEl.options).find(o => o.value.toLowerCase() === imageUrl.toLowerCase());
            // ตรวจสอบเงื่อนไขก่อนดำเนินการปรับเปลี่ยนสถานะหรือแสดงผล
            if (!match) {
                match = document.createElement('option');
                match.value = imageUrl;
                match.text = imageUrl + ' (รูปปัจจุบัน)';
                selectEl.appendChild(match);
            }
            selectEl.value = match.value;
        }

        // เปิดหน้าต่างแก้ไขสินค้าพร้อมเติมค่าเดิมจากปุ่มที่กด
        function openEditProductModal(btn) {
            closeCatalogModals();
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const d = btn.dataset;
            document.getElementById('editProdId').value = d.id || '';
            document.getElementById('editProdSku').value = d.sku || '';
            document.getElementById('editProdBarcode').value = d.barcode || '';
            document.getElementById('editProdName').value = d.name || '';
            document.getElementById('editProdCategory').value = d.category || '';
            document.getElementById('editProdSeries').value = d.series || '';
            document.getElementById('editProdBrand').value = d.brand || '';
            document.getElementById('editProdRetail').value = d.retail || '0';
            document.getElementById('editProdStock').value = d.stock || '0';
            document.getElementById('editProdSafety').value = d.safety || '5';
            document.getElementById('editProdActive').checked = d.isactive === 'true';

            setOrAppendImageOption(document.getElementById('editProdImage'), d.image);
            catalogCroppers.editProd?.resetForOpen(d.image);

            document.getElementById('editProductModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างกำหนดสินค้าให้เป็นของแลกแต้มสะสม
        function openConvertRewardModal(btn) {
            closeCatalogModals();
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const d = btn.dataset;
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const price = parseFloat(d.price || '1000');
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const suggestedPoints = Math.max(500, Math.round(price / 100) * 100);
            document.getElementById('convertProdId').value = d.id || '';
            document.getElementById('convertProdLabel').innerText = `${d.name} (${d.sku})`;
            document.getElementById('convertPoints').value = suggestedPoints;
            document.getElementById('convertStock').value = Math.max(1, parseInt(d.stock || '5', 10));
            document.getElementById('convertRewardModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างยืนยันการลบสินค้าโดยใช้ dataset ป้องกันอักขระพิเศษ
        function openDeleteProductModal(btn) {
            closeCatalogModals();
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const d = btn.dataset;
            document.getElementById('deleteProdId').value = d.id || '';
            document.getElementById('deleteProdName').innerText = d.name || '';
            document.getElementById('deleteProdSku').innerText = d.sku || '';
            document.getElementById('deleteProductModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างเพิ่มของแลกแต้มใหม่
        function openCreateRewardModal() {
            closeCatalogModals();
            catalogCroppers.createReward?.resetForOpen();
            document.getElementById('createRewardModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างแก้ไขของแลกแต้ม
        function openEditRewardModal(btn) {
            closeCatalogModals();
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const d = btn.dataset;
            document.getElementById('editRewardId').value = d.id || '';
            document.getElementById('editRewardCode').value = d.code || '';
            document.getElementById('editRewardTitle').value = d.title || '';
            document.getElementById('editRewardBrand').value = d.brand || '';
            document.getElementById('editRewardTag').value = d.tag || '';
            document.getElementById('editRewardPoints').value = d.points || '1000';
            document.getElementById('editRewardStock').value = d.stock || '1';
            document.getElementById('editRewardAvailable').checked = d.available === 'true';

            setOrAppendImageOption(document.getElementById('editRewardImage'), d.image);
            catalogCroppers.editReward?.resetForOpen(d.image);

            document.getElementById('editRewardModal')?.classList.remove('hidden');
        }

        // เปิดหน้าต่างยืนยันการลบของแลกแต้มโดยใช้ dataset ป้องกันอักขระพิเศษ
        function openDeleteRewardModal(btn) {
            closeCatalogModals();
            // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
            const d = btn.dataset;
            document.getElementById('deleteRewardId').value = d.id || '';
            document.getElementById('deleteRewardTitle').innerText = d.title || '';
            document.getElementById('deleteRewardCode').innerText = d.code || '';
            document.getElementById('deleteRewardModal')?.classList.remove('hidden');
        }
    </script>
}

