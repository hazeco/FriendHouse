                <button type="submit" class="rounded-xl bg-primary hover:bg-accent px-5 py-2 text-xs font-bold text-white shadow-xs cursor-pointer">
                    บันทึกการแก้ไขสินค้า
                </button>
            </div>
        </form>
    </div>
</div>

@* หน้าต่างโมดัลที่ 3 กำหนดสินค้าให้เป็นของแลกแต้ม *@
