                                                <line x1="1" y1="1" x2="23" y2="23"></line>
                                            </svg>
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span>ปิดแลก</span>
                                        }
                                        else
                                        {
                                            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                            <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span>เปิดแลก</span>
                                        }
                                    </button>
                                </form>

                                @* ปุ่มเปิดหน้าต่างแก้ไขของรางวัลแลกแต้ม *@
                                <button type="button"
                                        onclick="openEditRewardModal(this)"
                                        data-id="@r.RewardId"
                                        data-code="@r.RewardCode"
                                        data-title="@r.Title"
                                        data-brand="@(r.Brand ?? "")"
                                        data-tag="@r.CategoryTag"
                                        data-points="@r.PointsRequired"
                                        data-stock="@r.StockQuantity"
                                        data-available="@(isAvail ? "true" : "false")"
                                        data-image="@r.ImageUrl"
                                        class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50 hover:text-primary px-2.5 text-xs font-semibold text-slate-700 transition-colors cursor-pointer whitespace-nowrap">
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="@pageConfig.Icons.Edit"></path>
                                    </svg>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span>แก้ไข</span>
                                </button>

                                @* ปุ่มเปิดหน้าต่างยืนยันการลบของรางวัลแลกแต้ม *@
                                <button type="button"
                                        onclick="openDeleteRewardModal(this)"
                                        data-id="@r.RewardId"
                                        data-title="@r.Title"
                                        data-code="@r.RewardCode"
                                        class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-rose-300 hover:bg-rose-50/50 hover:text-rose-600 px-2.5 text-xs font-semibold text-slate-700 transition-colors cursor-pointer whitespace-nowrap">
                                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                    <svg class="size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="@pageConfig.Icons.Trash"></path>
                                    </svg>
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span>ลบ</span>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                    <div class="py-12 text-center text-xs text-slate-400">
                        ไม่พบรายการของแลกแต้มในระบบ
                    </div>
                }
            </div>

            @* ตารางรายการของแลกแต้มสะสมสำหรับสมาชิกบนเดสก์ท็อป *@
            @* ส่วนตารางรายการของรางวัลสำหรับหน้าจอเดสก์ท็อป *@
            <div class="hidden md:block overflow-x-auto">
                @* ตารางแสดงรายการข้อมูลอย่างเป็นระเบียบพร้อมรองรับการเลื่อนแนวนอนบนจอเล็ก *@
                <table class="w-full min-w-[800px] text-sm">
                    @* ส่วนหัวตารางกำหนดชื่อคอลัมน์ข้อมูล *@
                    <thead>
                        @* แถวหัวตารางข้อมูลของรางวัล *@
                        <tr class="border-b border-slate-100 text-left text-xs font-semibold text-slate-400 bg-background">
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-5">ของรางวัลแลกแต้ม</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4">หมวดหมู่ / แบรนด์</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4 text-right">แต้มที่ใช้แลก</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4 text-center">จำนวนคงเหลือ</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-4 text-center">สถานะแลกแต้ม</th>
                            @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                            <th class="py-4 px-5 text-right">จัดการ</th>
                        </tr>
                    </thead>
                    @* ส่วนเนื้อหาตารางแสดงแถวข้อมูลแต่ละรายการ *@
                    <tbody class="divide-y divide-slate-100">
                        @* ตรวจสอบว่ามีรายการของรางวัลในระบบหรือไม่ *@
                        @if (Model.Rewards.Any())
                        {
                            @* วนลูปแสดงข้อมูลของรางวัลแต่ละรายการในตาราง *@
                            @foreach (var r in Model.Rewards)
                            {
                                bool isAvail = r.IsAvailable == true;
                                @* แถวข้อมูลของรางวัลแต่ละรายการ *@
                                <tr class="hover:bg-slate-50/70 transition-colors">
                                    @* คอลัมน์รูปภาพและชื่อของรางวัล *@
                                    <td class="py-3.5 px-5">
                                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                        <div class="flex items-center gap-3">
                                            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                            <div class="size-12 rounded-xl border border-slate-100 bg-white shrink-0 overflow-hidden">
                                                @* รูปภาพประกอบรายการพร้อมกำหนดคลาสจัดสัดส่วนการแสดงผล *@
                                                <img src="@Url.Content(ResolveCardImageUrl(string.IsNullOrEmpty(r.ImageUrl) ? pageConfig.FallbackImage : r.ImageUrl))"
                                                     alt="@r.Title" class="size-full object-cover object-top" />
                                            </div>
                                            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                            <div class="min-w-0">
                                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                                <div class="font-bold text-text text-sm truncate max-w-[260px]">@r.Title</div>
                                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                                <div class="text-xs font-mono text-slate-400 mt-0.5">@r.RewardCode</div>
                                            </div>
                                        </div>
                                    </td>
                                    @* คอลัมน์หมวดหมู่และแบรนด์ของรางวัล *@
                                    <td class="py-3.5 px-4">
                                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                        <div class="text-xs font-semibold text-text">@r.CategoryTag</div>
                                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                        <div class="text-[11px] text-slate-400 mt-0.5">@(r.Brand ?? "FriendHouse")</div>
                                    </td>
                                    @* คอลัมน์แต้มคะแนนที่ต้องใช้ในการแลก *@
                                    <td class="py-3.5 px-4 text-right font-extrabold text-primary">
                                        @r.PointsRequired.ToString("N0") แต้ม
                                    </td>
                                    @* คอลัมน์จำนวนคงเหลือในคลัง *@
                                    <td class="py-3.5 px-4 text-center">
                                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                        <span class="font-bold text-sm @(r.StockQuantity <= 0 ? "text-rose-600" : "text-text")">
                                            @r.StockQuantity ชิ้น
                                        </span>
                                    </td>
                                    @* คอลัมน์ป้ายสถานะเปิดให้แลกหรือปิดแลกชั่วคราว *@
                                    <td class="py-3.5 px-4 text-center">
                                        @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                        @if (isAvail)
                                        {
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-[11px] font-bold text-emerald-700">
                                                เปิดให้แลกแต้ม
                                            </span>
                                        }
                                        else
                                        {
                                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                            <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-500">
                                                ปิดแลกชั่วคราว
                                            </span>
                                        }
                                    </td>
                                    @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                                    <td class="py-3.5 px-5 text-right whitespace-nowrap">
                                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                                        <div class="inline-flex items-center justify-end gap-1.5">
                                            @* แบบฟอร์มสลับสถานะเปิดให้แลก/ปิดแลกชั่วคราว *@
                                            <form asp-controller="Owner" asp-action="ToggleRewardAvailability" class="inline">
                                                @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
                                                <input type="hidden" name="rewardId" value="@r.RewardId" />
                                                @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
                                                <input type="hidden" name="page" value="@Model.CurrentPage" />
                                                @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
                                                <button type="submit"
                                                        class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50 text-slate-700 px-2.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap">
                                                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                                    @if (isAvail)
                                                    {
                                                        @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                                        <svg class="size-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                                            <line x1="1" y1="1" x2="23" y2="23"></line>
                                                        </svg>
                                                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                        <span>ปิดแลก</span>
                                                    }
                                                    else
                                                    {
                                                        @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                                        <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                            <circle cx="12" cy="12" r="3"></circle>
                                                        </svg>
                                                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                        <span>เปิดแลก</span>
                                                    }
                                                </button>
                                            </form>

                                            @* ปุ่มเปิดหน้าต่างแก้ไขของรางวัลแลกแต้ม *@
                                            <button type="button"
                                                    onclick="openEditRewardModal(this)"
                                                    data-id="@r.RewardId"
                                                    data-code="@r.RewardCode"
                                                    data-title="@r.Title"
                                                    data-brand="@(r.Brand ?? "")"
                                                    data-tag="@r.CategoryTag"
                                                    data-points="@r.PointsRequired"
                                                    data-stock="@r.StockQuantity"
                                                    data-available="@(isAvail ? "true" : "false")"
                                                    data-image="@r.ImageUrl"
                                                    class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50 hover:text-primary px-2.5 text-xs font-semibold text-slate-700 transition-colors cursor-pointer whitespace-nowrap">
                                                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                                <svg class="size-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="@pageConfig.Icons.Edit"></path>
                                                </svg>
                                                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                <span>แก้ไข</span>
                                            </button>

                                            @* ปุ่มเปิดหน้าต่างยืนยันการลบของรางวัลแลกแต้ม *@
                                            <button type="button"
                                                    onclick="openDeleteRewardModal(this)"
                                                    data-id="@r.RewardId"
                                                    data-title="@r.Title"
                                                    data-code="@r.RewardCode"
                                                    class="h-8 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:border-rose-300 hover:bg-rose-50/50 hover:text-rose-600 px-2.5 text-xs font-semibold text-slate-700 transition-colors cursor-pointer whitespace-nowrap">
                                                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                                                <svg class="size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="@pageConfig.Icons.Trash"></path>
                                                </svg>
                                                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                                <span>ลบ</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                            <tr>
                                @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                                <td colspan="6" class="py-12 text-center text-xs text-slate-400">
                                    ไม่พบรายการของแลกแต้มในระบบ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* แถบแบ่งหน้าตารางเจ้าของร้าน เชื่อมโยงกับ OwnerController.Catalog *@
        @* คอนเทนเนอร์แสดงการแบ่งหน้า (Pagination) และสรุปจำนวนรายการ *@
        <div class="px-6 py-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-slate-500">
            @* ข้อความสรุปช่วงลำดับรายการที่กำลังแสดงผล *@
            <span>แสดง @startRow–@endRow จากทั้งหมด @Model.TotalCount รายการ</span>
            @* กลุ่มปุ่มนำทางเปลี่ยนหน้า *@
            <div class="flex items-center gap-1.5">
                @* ตรวจสอบว่าสามารถย้อนกลับหน้าก่อนหน้าได้หรือไม่ *@
                @if (Model.CurrentPage > 1)
                {
                    @* ลิงก์ย้อนกลับไปยังหน้าก่อนหน้า *@
                    <a asp-controller="Owner" asp-action="Catalog"
                       asp-route-tab="@Model.ActiveTab"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter"
                       asp-route-saleModeFilter="@Model.SaleModeFilter"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium cursor-pointer">
                        ก่อนหน้า
                    </a>
                }
                else
                {
                    @* ป้ายแสดงปุ่มก่อนหน้าแบบปิดใช้งานเมื่ออยู่ที่หน้าแรก *@
                    <span class="px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 font-medium cursor-not-allowed">
                        ก่อนหน้า
                    </span>
                }

                @{
                    // คำนวณช่วงหมายเลขหน้าแบบเลื่อนทีละ 3 หมายเลข (เช่น 1 2 3 -> 2 (3) 4 -> 3 (4) 5)
                    int startPage = Math.Clamp(Model.CurrentPage - 1, 1, Math.Max(1, Model.TotalPages - 2));
                    // คำนวณหมายเลขหน้าสิ้นสุดไม่ให้เกินจำนวนหน้าทั้งหมด
                    int endPage = Math.Min(Model.TotalPages, startPage + 2);
                }
                @* วนลูปสร้างปุ่มตัวเลขหน้าแบบเลื่อนทีละ 3 หมายเลข *@
                @for (int p = startPage; p <= endPage; p++)
                {
                    if (p == Model.CurrentPage)
                    {
                        @* ป้ายแสดงหน้าปัจจุบันเน้นสีหลัก *@
                        <span class="size-8 rounded-lg bg-primary text-white font-bold flex items-center justify-center">
                            @p
                        </span>
                    }
                    else
                    {
                        @* ลิงก์ตัวเลขไปยังหน้านั้นๆ *@
                        <a asp-controller="Owner" asp-action="Catalog"
                           asp-route-tab="@Model.ActiveTab"
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-categoryFilter="@Model.CategoryFilter"
                           asp-route-saleModeFilter="@Model.SaleModeFilter"
                           asp-route-page="@p"
                           class="size-8 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium flex items-center justify-center cursor-pointer">
                            @p
                        </a>
                    }
                }

                @* ตรวจสอบว่าสามารถไปยังหน้าถัดไปได้หรือไม่ *@
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    @* ลิงก์ไปยังหน้าถัดไป *@
                    <a asp-controller="Owner" asp-action="Catalog"
                       asp-route-tab="@Model.ActiveTab"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryFilter="@Model.CategoryFilter"
                       asp-route-saleModeFilter="@Model.SaleModeFilter"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-medium cursor-pointer">
                        ถัดไป
                    </a>
                }
                else
                {
                    @* ป้ายแสดงปุ่มถัดไปแบบปิดใช้งานเมื่ออยู่ที่หน้าสุดท้าย *@
                    <span class="px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 font-medium cursor-not-allowed">
                        ถัดไป
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@* หน้าต่างโมดัลจัดการสินค้าและของแลกแต้ม *@

@* หน้าต่างโมดัลที่ 1 เพิ่มสินค้าใหม่ *@
@* หน้าต่างป๊อปอัปสำหรับสร้างและเพิ่มสินค้าใหม่เข้าสู่ระบบฐานข้อมูล *@
<div id="createProductModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
    @* กล่องการ์ดเนื้อหาของหน้าต่างป๊อปอัปแบบปรับเลื่อนแนวตั้งได้ *@
    <div class="w-full max-w-2xl max-h-[90vh] rounded-3xl bg-white shadow-2xl border border-slate-100 flex flex-col overflow-hidden">
        @* แถบหัวข้อหน้าต่างป๊อปอัปและปุ่มกากบาทปิด *@
        <div class="shrink-0 flex items-center justify-between border-b border-slate-100 px-5 sm:px-6 py-4">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>
                @* ชื่อหัวข้อหลักของหน้าต่าง *@
                <h2 class="text-lg font-bold text-text">เพิ่มสินค้าใหม่เข้าฐานข้อมูลร้าน</h2>
                @* คำอธิบายขั้นตอนการกรอกข้อมูล *@
                <p class="text-xs text-slate-500 mt-0.5">กรอกรายละเอียดสินค้า ราคา และสต็อกเริ่มต้น พร้อมเลือกเปิดให้แลกแต้มได้ทันที</p>
            </div>
            @* ปุ่มปิดหน้าต่างป๊อปอัป *@
            <button type="button" onclick="closeCatalogModals()" class="rounded-xl p-1.5 text-slate-400 hover:bg-slate-100 cursor-pointer">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="@pageConfig.Icons.Close"></path>
                </svg>
            </button>
        </div>

        @* แบบฟอร์มบันทึกสินค้าใหม่ (ไม่ใส่ method attribute ตามกฎโครงการ) *@
        <form asp-controller="Owner" asp-action="CreateProduct" enctype="multipart/form-data" class="flex-1 overflow-y-auto px-5 sm:px-6 py-4 space-y-3.5">
            @* แถวช่องกรอกรหัสสินค้า SKU และรหัสบาร์โค้ด *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับรหัสสินค้า SKU *@
                    <label class="text-xs font-bold text-text block mb-1">รหัสสินค้า *</label>
                    @* ช่องกรอกรหัสสินค้า SKU *@
                    <input type="text" name="sku" required placeholder="เช่น FIG-NARUTO-999"
                           class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-xs sm:text-sm font-mono focus:border-primary focus:outline-none" />
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับรหัสบาร์โค้ด *@
                    <label class="text-xs font-bold text-text block mb-1">รหัสบาร์โค้ด</label>
                    @* ช่องกรอกรหัสบาร์โค้ด *@
                    <input type="text" name="barcode" placeholder="เว้นว่างเพื่อใช้รหัสเดียวกับรหัสสินค้า"
                           class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-xs sm:text-sm font-mono focus:border-primary focus:outline-none" />
                </div>
            </div>

            @* แถวช่องกรอกชื่อสินค้า *@
            <div>
                @* ป้ายกำกับชื่อสินค้าฟิกเกอร์ *@
                <label class="text-xs font-bold text-text block mb-1">ชื่อสินค้า *</label>
                @* ช่องกรอกชื่อสินค้า *@
                <input type="text" name="name" required placeholder="ระบุชื่อฟิกเกอร์หรือโมเดลภาษาไทย"
                       class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-xs sm:text-sm focus:border-primary focus:outline-none" />
            </div>

            @* แถวช่องเลือกหมวดหมู่ ซีรีส์ และค่ายผู้ผลิต *@
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับหมวดหมู่สินค้า *@
                    <label class="text-xs font-bold text-text block mb-1">หมวดหมู่ *</label>
                    @* เมนูเลือกหมวดหมู่สินค้า *@
                    <select name="categoryId" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs sm:text-sm bg-white focus:border-primary focus:outline-none">
                        @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                        @foreach (var cat in Model.AllCategories)
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับซีรีส์อนิเมะ *@
                    <label class="text-xs font-bold text-text block mb-1">ซีรีส์อนิเมะ</label>
                    @* ช่องกรอกชื่อซีรีส์ *@
                    <input type="text" name="seriesName" placeholder="เช่น ดาบพิฆาตอสูร"
                           class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-xs sm:text-sm focus:border-primary focus:outline-none" />
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับค่ายผู้ผลิต *@
                    <label class="text-xs font-bold text-text block mb-1">ค่ายผู้ผลิต</label>
                    @* ช่องกรอกค่ายผู้ผลิต *@
                    <input type="text" name="brandName" placeholder="เช่น Good Smile Company"
                           class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-xs sm:text-sm focus:border-primary focus:outline-none" />
                </div>
            </div>

            @* แถวระบุราคาขายปกติ สต็อกเริ่มต้น และจุดแจ้งเตือนสินค้าใกล้หมด *@
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับราคาขายปกติ *@
                    <label class="text-xs font-bold text-text block mb-1">ราคาปกติ *</label>
                    @* ช่องกรอกราคาขายปกติ (บาท) *@
                    <input type="number" name="retailPrice" required min="0" step="1" value="1890"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs sm:text-sm font-bold focus:border-primary focus:outline-none" />
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับจำนวนสต็อกเริ่มต้น *@
                    <label class="text-xs font-bold text-text block mb-1">สต็อกเริ่มต้น</label>
                    @* ช่องกรอกจำนวนสต็อกเริ่มต้น *@
                    <input type="number" name="initialStock" min="0" value="10"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs sm:text-sm font-bold focus:border-primary focus:outline-none" />
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับจุดแจ้งเตือนสต็อกขั้นต่ำ *@
                    <label class="text-xs font-bold text-text block mb-1">จุดแจ้งเตือนขั้นต่ำ</label>
                    @* ช่องกรอกจำนวนสต็อกขั้นต่ำเพื่อแจ้งเตือน *@
                    <input type="number" name="safetyStockLevel" min="1" value="5"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs sm:text-sm focus:border-primary focus:outline-none" />
                </div>
            </div>

            @* แถวระบุสเกลโมเดลและวัสดุหลัก *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับสเกลโมเดล *@
                    <label class="text-xs font-bold text-text block mb-1">สเกลโมเดล</label>
                    @* ช่องกรอกสเกลโมเดล *@
                    <input type="text" name="scale" value="1/7" placeholder="เช่น 1/7 หรือ ไม่มีสเกล"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs sm:text-sm focus:border-primary focus:outline-none" />
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับวัสดุหลักที่ใช้ผลิต *@
                    <label class="text-xs font-bold text-text block mb-1">วัสดุหลัก</label>
                    @* ช่องกรอกวัสดุหลัก เช่น PVC/ABS *@
                    <input type="text" name="material" value="PVC / ABS"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs sm:text-sm focus:border-primary focus:outline-none" />
                </div>
            </div>

            @* แถวเลือกรูปภาพจากคลังสื่อหรืออัปโหลดไฟล์ใหม่ *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับเลือกภาพจากคลัง *@
                    <label class="text-xs font-bold text-text block mb-1">เลือกรูปภาพจากคลังสื่อของร้าน</label>
                    @* เมนูเลือกรูปภาพที่มีอยู่ในเซิร์ฟเวอร์ *@
                    <select name="imageUrl" data-cropper-select="createProd" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs bg-white focus:border-primary focus:outline-none">
                        @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                        @foreach (var img in Model.AvailableImages)
                        {
                            <option value="@img">@System.IO.Path.GetFileName(img)</option>
                        }
                    </select>
                </div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายกำกับอัปโหลดรูปภาพใหม่ *@
                    <label class="text-xs font-bold text-text block mb-1">หรืออัปโหลดรูปภาพใหม่จากเครื่อง</label>
                    @* ปุ่มเลือกไฟล์ภาพเพื่ออัปโหลด *@
                    <input type="file" name="imageFile" accept="image/*" data-cropper-file="createProd"
                           class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-primary/10 file:px-3 file:py-1 file:text-xs file:font-bold file:text-primary" />
                </div>
            </div>
            @* ช่องสำหรับแทรกเครื่องมือปรับอัตราส่วนรูปภาพ 1:1 แบบไดนามิก *@
            <div class="catalog-cropper-slot" data-cropper-key="createProd"></div>

            @* กล่องตั้งค่าเปิดวางขายหน้าร้านและเปิดให้แลกแต้ม *@
            <div class="rounded-2xl bg-background border border-slate-200 p-4 space-y-3">
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="text-xs font-bold text-text">กำหนดรูปแบบการแสดงผลในร้าน</div>
                @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                <div class="flex flex-wrap items-center gap-5 text-xs">
                    @* ตัวเลือกเปิดวางขายหน้าร้านทันที *@
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                        <input type="checkbox" name="isActive" value="true" checked class="size-4 accent-primary" />
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="font-semibold text-text">เปิดวางขายหน้าร้านทันที</span>
                    </label>
                    @* ตัวเลือกเปิดใช้เป็นของรางวัลแลกแต้มควบคู่ *@
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                        <input type="checkbox" name="alsoAsReward" value="true" onchange="toggleCreateRewardFields(this.checked)" class="size-4 accent-primary" />
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="font-bold text-primary">เปิดใช้เป็นของแลกแต้มด้วย</span>
                    </label>
                </div>
                @* ส่วนกรอกแต้มและโควตาเมื่อเลือกเปิดเป็นของแลกแต้ม *@
                <div id="createAlsoRewardFields" class="hidden grid grid-cols-2 gap-3 pt-2 border-t border-slate-200">
                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                    <div>
                        @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                        <label class="text-[11px] font-bold text-primary block mb-1">แต้มที่ใช้แลก</label>
                        @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                        <input type="number" name="rewardPointsRequired" value="1800" min="50"
                               class="w-full rounded-xl border border-primary/30 px-3 py-1.5 text-xs font-bold" />
                    </div>
                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                    <div>
                        @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                        <label class="text-[11px] font-bold text-primary block mb-1">โควตาจำนวนของแลกแต้ม</label>
                        @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                        <input type="number" name="rewardStockQuantity" value="5" min="1"
                               class="w-full rounded-xl border border-primary/30 px-3 py-1.5 text-xs font-bold" />
                    </div>
                </div>
            </div>

            @* แถบปุ่มยกเลิกและปุ่มยืนยันบันทึกสินค้าใหม่ *@
            <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100">
                @* ปุ่มยกเลิกและปิดหน้าต่าง *@
                <button type="button" onclick="closeCatalogModals()" class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">
                    ยกเลิก
                </button>
                @* ปุ่มยืนยันการบันทึกสินค้าใหม่ *@
                <button type="submit" class="rounded-xl bg-primary hover:bg-accent px-5 py-2 text-xs font-bold text-white shadow-xs cursor-pointer">
                    บันทึกสินค้าใหม่
                </button>
            </div>
        </form>
    </div>
</div>

@* หน้าต่างโมดัลที่ 2 แก้ไขข้อมูลสินค้า *@
@* หน้าต่างป๊อปอัปสำหรับแก้ไขรายละเอียด ราคา และสต็อกของสินค้าเดิม *@
<div id="editProductModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
    @* กล่องการ์ดเนื้อหาหน้าต่างแก้ไขสินค้า *@
    <div class="w-full max-w-2xl max-h-[90vh] rounded-3xl bg-white shadow-2xl border border-slate-100 flex flex-col overflow-hidden">
        @* แถบหัวข้อหน้าต่างแก้ไขข้อมูลสินค้า *@
        <div class="shrink-0 flex items-center justify-between border-b border-slate-100 px-5 sm:px-6 py-4">
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>
