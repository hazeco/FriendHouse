        <!-- Desktop Table View -->
        <div class="hidden md:block overflow-x-auto">
            @* ตารางแสดงรายการข้อมูลอย่างเป็นระเบียบพร้อมรองรับการเลื่อนแนวนอนบนจอเล็ก *@
            <table class="w-full text-xs min-w-[540px]">
                @* ส่วนหัวตารางกำหนดชื่อคอลัมน์ข้อมูล *@
                <thead>
                    @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                    <tr class="text-left font-semibold text-gray-400 border-b border-gray-100 bg-[#FBFBFE]">
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-3 px-6">วันและเวลา</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-3 px-6">รหัสรายการ</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-3 px-6">รายละเอียดการรับเข้าคลัง</th>
                    </tr>
                </thead>
                @* ส่วนเนื้อหาตารางแสดงแถวข้อมูลแต่ละรายการ *@
                <tbody class="divide-y divide-gray-100">
                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                    @if (recentRestockLogs.Any())
                    {
                        @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                        @foreach (var log in recentRestockLogs)
                        {
                            @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                            <tr class="hover:bg-gray-50/70 transition-colors">
