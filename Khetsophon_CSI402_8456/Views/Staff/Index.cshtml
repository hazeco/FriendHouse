@model IEnumerable<Khetsophon_CSI402_8456.Models.Product>
@{
    ViewData["Title"] = "สต็อกสินค้า";
    Layout = "_StaffLayout";

    var hasDbProducts = Model != null && Model.Any();
    var allProducts = Model?.ToList() ?? new List<Khetsophon_CSI402_8456.Models.Product>();

    // การกำหนดค่าเนื้อหา ไอคอน และข้อมูลสำหรับหน้าต่างรับสินค้าไว้ส่วนบนสุดของไฟล์ตามมาตรฐาน
    var pageHeader = new {
        Title = "สต็อกสินค้า",
        Subtitle = "ภาพรวมคงเหลือทั้งหมดในร้าน อัปเดตอัตโนมัติทุกครั้งที่รับเข้าหรือขายออก",
        ReceiveButtonText = "รับสินค้า"
    };

    var allModalProducts = ViewBag.AllProductsForModal as List<Khetsophon_CSI402_8456.Models.Product> ?? allProducts;
    var recentRestockLogs = ViewBag.RecentRestockLogs as List<Khetsophon_CSI402_8456.Models.Systemlog> ?? new List<Khetsophon_CSI402_8456.Models.Systemlog>();
    bool shouldAutoOpenReceive = ViewBag.OpenReceiveModal == true;

    var lowStockProducts = allModalProducts.Where(p => (p.Inventory?.QuantityOnHand ?? 0) <= (p.Inventory?.SafetyStockLevel ?? 5)).ToList();
    // ดึงจำนวนสถิติรวมของสินค้าทั้งคลังและตัวกรองปัจจุบันจาก ViewBag
    int totalProductCount = ViewBag.TotalProductCount ?? allProducts.Count;
    int filteredCount = ViewBag.FilteredCount ?? allProducts.Count;
    int normalCount = ViewBag.NormalStockCount ?? allProducts.Count(p => (p.Inventory?.QuantityOnHand ?? 0) > (p.Inventory?.SafetyStockLevel ?? 5));
    int lowCount = ViewBag.LowStockCount ?? allProducts.Count(p => (p.Inventory?.QuantityOnHand ?? 0) > 0 && (p.Inventory?.QuantityOnHand ?? 0) <= (p.Inventory?.SafetyStockLevel ?? 5));
    int outOfStockCount = ViewBag.OutOfStockCount ?? allProducts.Count(p => (p.Inventory?.QuantityOnHand ?? 0) <= 0);
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int startRow = filteredCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int endRow = Math.Min(currentPage * pageSize, filteredCount);

    string selectedStockFilter = (ViewBag.SelectedStockFilter as string ?? "all").ToLowerInvariant();
    string selectedSearch = ViewBag.SelectedSearch as string ?? string.Empty;
    string rawSelectedCat = ViewBag.SelectedCategory as string ?? "all";
    string selectedCategory = (string.IsNullOrWhiteSpace(rawSelectedCat) || rawSelectedCat == "ทุกหมวดหมู่") ? "all" : rawSelectedCat;

    var dbCategories = new List<string>();
    if (ViewBag.AllCategories is List<string> serverCats && serverCats.Any())
    {
        dbCategories.AddRange(serverCats.Where(c => !string.IsNullOrWhiteSpace(c) && c != "ทุกหมวดหมู่").Distinct());
    }
    else
    {
        dbCategories.AddRange(allModalProducts.Select(p => p.Category?.CategoryName).Where(c => !string.IsNullOrEmpty(c) && c != "ทุกหมวดหมู่").Distinct()!);
    }
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="space-y-6">
    <!-- ส่วนหัวหน้าสต็อกสินค้าและปุ่มเปิดหน้าต่างรับสินค้าเข้าสต็อก -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div>
            @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
            <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
            @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
            <p class="text-sm text-gray-500 mt-1">@pageHeader.Subtitle</p>
        </div>
        @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
        <button type="button" onclick="openReceiveStockModal('scan')"
                class="inline-flex items-center gap-2 bg-[#3027FF] hover:bg-[#261ECC] text-white font-bold px-5 py-2.5 rounded-xl shadow-xs transition-colors cursor-pointer text-sm">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span>@pageHeader.ReceiveButtonText</span>
        </button>
    </div>

    <!-- กล่องแจ้งเตือนผลการรับสินค้าเข้าสต็อก -->
    @if (TempData["SuccessMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="rounded-2xl bg-[#ECFDF5] border border-[#A7F3D0] p-4 flex items-center gap-3 text-xs text-[#065F46] shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-[#10B981] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }
    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="rounded-2xl bg-[#FEF2F2] border border-[#FECACA] p-4 flex items-center gap-3 text-xs text-[#DC2626] shadow-xs">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-[#DC2626] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="font-bold">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Alert Banner (Matching frame_9_3.png) -->
    @if (lowStockProducts.Any())
    {
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="rounded-2xl border border-[#FCA5A5]/70 bg-[#FFF5F5] p-4 space-y-3">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center gap-2 text-[#DC2626]">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                <span class="text-xs sm:text-sm font-bold">แจ้งเตือนสต็อก — มีสินค้าใกล้หมด/หมดสต็อก @lowStockProducts.Count รายการ ต้องดำเนินการ</span>
            </div>
            @* คอนเทนเนอร์จัดวางโครงสร้างแบบ Grid รองรับ Responsive ทุกขนาดหน้าจอ *@
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                @foreach (var alert in lowStockProducts.Take(3))
                {
                    var qty = alert.Inventory?.QuantityOnHand ?? 0;
                    var badgeCls = qty <= 0 ? "bg-[#FEE2E2] text-[#DC2626]" : "bg-[#FEF3C7] text-[#D97706]";
                    var statusLbl = qty <= 0 ? "หมด · 0 ชิ้น" : $"ใกล้หมด · {qty} ชิ้น";
                    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                    <div class="bg-white rounded-xl p-3.5 border border-red-100/80 flex items-center justify-between shadow-2xs">
                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                        <div class="min-w-0 pr-2">
                            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                            <div class="text-sm font-bold text-[#050315] truncate">@alert.Name</div>
                            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                            <div class="text-xs text-gray-400 font-mono mt-0.5">@alert.Sku</div>
                        </div>
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full shrink-0 @badgeCls">
                            @statusLbl
                        </span>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50/80 p-4 flex items-center gap-2.5 text-emerald-800">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="text-xs sm:text-sm font-bold">สต็อกสินค้าทั้งหมดอยู่ในระดับปกติ ไม่มีสินค้าใกล้หมดหรือขาดสต็อก</span>
        </div>
    }

    <!-- Search & Filter Bar (Server-side PRG & GET Query Filter) -->
    <div class="flex flex-col lg:flex-row lg:items-center gap-3">
        @* แบบฟอร์มส่งข้อมูลไปยัง Controller ตามมาตรฐาน ASP.NET Core MVC (ไม่ระบุ method) *@
        <form asp-controller="Staff" asp-action="Index" class="flex-1 flex flex-wrap items-center gap-2.5">
            @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
            <input type="hidden" name="stockFilter" value="@selectedStockFilter" />
            <!-- Search Input -->
            <div class="relative flex-1 min-w-[220px]">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                <input type="text" name="search" id="stockSearch" value="@selectedSearch" placeholder="ค้นหาชื่อสินค้าหรือ SKU (รองรับพิมพ์ติดกันไม่มีขีด)..."
                       class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#2F39A9]/20 focus:border-[#2F39A9] shadow-2xs" />
            </div>

            <!-- Category Dropdown -->
            <div class="relative">
                @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                <select name="category" id="stockCategoryFilter" onchange="this.form.submit()" class="appearance-none pr-9 pl-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 shadow-2xs focus:outline-none focus:border-[#2F39A9]">
                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                    @if (selectedCategory == "all")
                    {
                        <option value="all" selected>ทุกหมวดหมู่</option>
                    }
                    else
                    {
                        <option value="all">ทุกหมวดหมู่</option>
                    }
                    @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                    @foreach (var c in dbCategories)
                    {
                        if (string.Equals(c, selectedCategory, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@c" selected>@c</option>
                        }
                        else
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4 absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>

            @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
            <button type="submit" class="px-4 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#3027FF] text-white text-sm font-semibold transition-colors cursor-pointer">
                ค้นหา
            </button>
            @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
            @if (!string.IsNullOrWhiteSpace(selectedSearch) || selectedCategory != "all" || selectedStockFilter != "all")
            {
                @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                <a asp-controller="Staff" asp-action="Index" class="px-3.5 py-2.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-xs font-semibold text-gray-600 transition-colors">
                    ล้างตัวกรอง
                </a>
            }
        </form>

        <!-- Status Filter Tabs (Server-side Route Filter across Pages) -->
        <div class="flex flex-wrap items-center gap-1.5" id="stockStatusButtons">
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
            <a asp-controller="Staff" asp-action="Index" asp-route-stockFilter="all" asp-route-search="@selectedSearch" asp-route-category="@selectedCategory"
               class="status-tab px-4 py-2 rounded-xl text-sm font-semibold transition @(selectedStockFilter == "all" ? "bg-[#2F39A9] text-white" : "bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 shadow-2xs")">
                ทั้งหมด @totalProductCount
            </a>
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
            <a asp-controller="Staff" asp-action="Index" asp-route-stockFilter="normal" asp-route-search="@selectedSearch" asp-route-category="@selectedCategory"
               class="status-tab px-4 py-2 rounded-xl text-sm font-semibold transition @(selectedStockFilter == "normal" ? "bg-[#2F39A9] text-white" : "bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 shadow-2xs")">
                ปกติ @normalCount
            </a>
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
            <a asp-controller="Staff" asp-action="Index" asp-route-stockFilter="low" asp-route-search="@selectedSearch" asp-route-category="@selectedCategory"
               class="status-tab px-4 py-2 rounded-xl text-sm font-semibold transition @(selectedStockFilter == "low" ? "bg-[#D97706] text-white" : "bg-white border border-[#FDE68A] text-[#D97706] hover:bg-amber-50 shadow-2xs")">
                ใกล้หมด @lowCount
            </a>
            @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
            <a asp-controller="Staff" asp-action="Index" asp-route-stockFilter="out" asp-route-search="@selectedSearch" asp-route-category="@selectedCategory"
               class="status-tab px-4 py-2 rounded-xl text-sm font-semibold transition @(selectedStockFilter == "out" ? "bg-[#DC2626] text-white" : "bg-white border border-[#FECACA] text-[#DC2626] hover:bg-red-50 shadow-2xs")">
                หมด @outOfStockCount
            </a>
        </div>
    </div>

    <!-- Stock Card: Desktop Table & Mobile Cards -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden">
        <!-- Mobile Card View -->
        <div class="md:hidden divide-y divide-gray-100">
            @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
            @if (hasDbProducts)
            {
                @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                @foreach (var p in Model!)
                {
                    var totalStock = p.Inventory != null ? p.Inventory.QuantityOnHand : 0;
                    var safetyLevel = p.Inventory?.SafetyStockLevel ?? 5;
                    var statusText = totalStock <= 0 ? "หมด" : totalStock <= safetyLevel ? "ใกล้หมด" : "ปกติ";
                    var statusClass = totalStock <= 0 ? "bg-[#FEE2E2] text-[#DC2626]" : totalStock <= safetyLevel ? "bg-[#FEF3C7] text-[#D97706]" : "bg-[#DCFCE7] text-[#16A34A]";
                    var stockClass = totalStock <= 0 ? "text-[#DC2626]" : totalStock <= safetyLevel ? "text-[#D97706]" : "text-[#050315]";
                    var categoryName = p.Category?.CategoryName ?? "ทั่วไป";
                    var imgPath = !string.IsNullOrEmpty(p.ImageUrl) ? p.ImageUrl : "~/media/images/naruto_hero_fig.png";

                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                    <div class="p-4 space-y-2.5 stock-row" data-category="@categoryName" data-status="@statusText">
                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                        <div class="flex items-start justify-between gap-3">
                            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                            <div class="flex items-center gap-3 min-w-0">
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div class="size-11 rounded-xl border border-gray-200 bg-white shrink-0 overflow-hidden">
                                    @* รูปภาพประกอบรายการพร้อมกำหนดคลาสจัดสัดส่วนการแสดงผล *@
                                    <img src="@Url.Content(PromoAndRedemptionHelper.ResolveCardImageUrl(imgPath))" alt="@p.Name" class="size-full object-cover object-top" loading="lazy" />
                                </div>
                                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                <div class="min-w-0">
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="font-bold text-[#050315] text-sm truncate">@p.Name</div>
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="text-xs text-gray-400 mt-0.5">@categoryName · ฿@p.RetailPrice.ToString("N0")</div>
                                </div>
                            </div>
                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                            <span class="text-xs font-semibold px-2.5 py-1 rounded-full shrink-0 whitespace-nowrap @statusClass">
                                @statusText
                            </span>
                        </div>
                        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                        <div class="flex items-center justify-between text-xs pt-1 border-t border-gray-50">
                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                            <span class="font-mono text-gray-500">SKU: @p.Sku</span>
                            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                            <span class="font-bold @stockClass">คงเหลือ @totalStock ชิ้น</span>
                        </div>
                    </div>
                }
            }
            else
            {
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="py-8 text-center text-xs text-gray-400">
                    ไม่พบรายการสินค้าในคลัง
                </div>
            }
        </div>

        <!-- Desktop Table View -->
        <div class="hidden md:block overflow-x-auto">
            @* ตารางแสดงรายการข้อมูลอย่างเป็นระเบียบพร้อมรองรับการเลื่อนแนวนอนบนจอเล็ก *@
            <table class="w-full text-sm min-w-[620px]" id="stockTable">
                @* ส่วนหัวตารางกำหนดชื่อคอลัมน์ข้อมูล *@
                <thead>
                    @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                    <tr class="border-b border-gray-100 text-left text-xs font-semibold text-gray-400">
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-4 px-6">สินค้า</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-4 px-6">SKU</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-4 px-6 text-center">คงเหลือ</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-4 px-6 text-center">สถานะ</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="py-4 px-6 text-left">วันที่เพิ่มสินค้า</th>
                    </tr>
                </thead>
                @* ส่วนเนื้อหาตารางแสดงแถวข้อมูลแต่ละรายการ *@
                <tbody class="divide-y divide-gray-100">
                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                    @if (hasDbProducts)
                    {
                        @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                        @foreach (var p in Model!)
                        {
                            var totalStock = p.Inventory != null ? p.Inventory.QuantityOnHand : 0;
                            var safetyLevel = p.Inventory?.SafetyStockLevel ?? 5;
                            var statusText = totalStock <= 0 ? "หมด" : totalStock <= safetyLevel ? "ใกล้หมด" : "ปกติ";
                            var statusClass = totalStock <= 0 ? "bg-[#FEE2E2] text-[#DC2626]" : totalStock <= safetyLevel ? "bg-[#FEF3C7] text-[#D97706]" : "bg-[#DCFCE7] text-[#16A34A]";
                            var stockClass = totalStock <= 0 ? "text-[#DC2626]" : totalStock <= safetyLevel ? "text-[#D97706]" : "text-[#050315]";
                            var categoryName = p.Category?.CategoryName ?? "ทั่วไป";
                            var imgPath = !string.IsNullOrEmpty(p.ImageUrl) ? p.ImageUrl : "~/media/images/naruto_hero_fig.png";

                            @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                            <tr class="hover:bg-gray-50/70 transition-colors stock-row" data-category="@categoryName" data-status="@statusText">
                                <!-- Product Image & Name -->
                                <td class="py-4 px-6 flex items-center gap-3.5">
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="size-11 rounded-xl border border-gray-200 bg-white shrink-0 overflow-hidden">
                                        @* รูปภาพประกอบรายการพร้อมกำหนดคลาสจัดสัดส่วนการแสดงผล *@
                                        <img src="@Url.Content(PromoAndRedemptionHelper.ResolveCardImageUrl(imgPath))" alt="@p.Name" class="size-full object-cover object-top" loading="lazy" />
                                    </div>
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div>
                                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                        <div class="font-bold text-[#050315] text-sm">@p.Name</div>
                                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                        <div class="text-xs text-gray-400 mt-0.5">@categoryName · ฿@p.RetailPrice.ToString("N0")</div>
                                    </div>
                                </td>

                                <!-- SKU -->
                                <td class="py-4 px-6 font-mono text-xs text-gray-500">
                                    @p.Sku
                                </td>

                                <!-- Stock Count -->
                                <td class="py-4 px-6 text-center font-bold text-base @stockClass">
                                    @totalStock
                                </td>

                                <!-- Status Pill -->
                                <td class="py-4 px-6 text-center">
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap @statusClass">
                                        @statusText
                                    </span>
                                </td>

                                <!-- Created Date -->
                                <td class="py-4 px-6 text-gray-500 text-xs whitespace-nowrap">
                                    @Khetsophon_CSI402_8456.Helpers.PromoAndRedemptionHelper.FormatThaiDate(DateOnly.FromDateTime(p.CreatedAt))
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                        <tr>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td colspan="5" class="py-8 text-center text-xs text-gray-400">
                                ไม่พบรายการสินค้าในคลัง
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- แถบแบ่งหน้ารายการสต็อกสินค้า เชื่อมโยงกับ StaffController.Index -->
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between flex-wrap gap-4 text-sm">
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span class="text-xs text-gray-500">แสดง @startRow–@endRow จากที่ตรงเงื่อนไข @filteredCount รายการ</span>
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center gap-1.5">
                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                @if (currentPage > 1)
                {
                    @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                    <a asp-controller="Staff" asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-stockFilter="@selectedStockFilter"
                       asp-route-search="@selectedSearch"
                       asp-route-category="@selectedCategory"
                       class="px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 text-xs font-medium cursor-pointer">
                        ก่อนหน้า
                    </a>
                }
                else
                {
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="px-3 py-1.5 rounded-lg border border-gray-100 bg-gray-50 text-gray-300 text-xs font-medium cursor-not-allowed">
                        ก่อนหน้า
                    </span>
                }

                @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == currentPage)
                    {
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="size-8 rounded-lg bg-[#2F39A9] text-white text-xs font-bold flex items-center justify-center">
                            @p
                        </span>
                    }
                    else
                    {
                        @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                        <a asp-controller="Staff" asp-action="Index"
                           asp-route-page="@p"
                           asp-route-stockFilter="@selectedStockFilter"
                           asp-route-search="@selectedSearch"
                           asp-route-category="@selectedCategory"
                           class="size-8 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 text-xs font-medium flex items-center justify-center cursor-pointer">
                            @p
                        </a>
                    }
                }

                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                @if (currentPage < totalPages)
                {
                    @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                    <a asp-controller="Staff" asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-stockFilter="@selectedStockFilter"
                       asp-route-search="@selectedSearch"
                       asp-route-category="@selectedCategory"
                       class="px-3 py-1.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 text-xs font-medium cursor-pointer">
                        ถัดไป
                    </a>
                }
                else
                {
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="px-3 py-1.5 rounded-lg border border-gray-100 bg-gray-50 text-gray-300 text-xs font-medium cursor-not-allowed">
                        ถัดไป
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- ประวัติการรับสินค้าเข้าสต็อกล่าสุด -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs overflow-hidden">
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-wrap gap-2">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center gap-2 text-sm font-bold text-[#050315]">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-4.5 text-[#2F39A9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
