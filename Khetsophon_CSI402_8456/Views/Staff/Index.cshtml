                                <td class="py-3 px-6 text-gray-500 whitespace-nowrap">@Khetsophon_CSI402_8456.Helpers.PromoAndRedemptionHelper.FormatThaiDate(DateOnly.FromDateTime(log.Timestamp)) @log.Timestamp.ToString("HH:mm") น.</td>
                                @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                                <td class="py-3 px-6 font-mono text-[#2F39A9] font-semibold whitespace-nowrap">@log.LogCode</td>
                                @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                                <td class="py-3 px-6 text-[#050315] font-medium">@log.Message</td>
                            </tr>
                        }
                    }
