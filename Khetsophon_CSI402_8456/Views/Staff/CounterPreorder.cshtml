                <input type="hidden" name="preorderId" value="@preorderResult.PreorderId" />
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div>
                    @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                    <label class="text-xs font-bold text-gray-700 block mb-1">เลือกเหตุผล</label>
                    @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                    <select name="reason" id="rejectReasonSelect" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#2F39A9]">
                        <option value="">เลือกเหตุผล...</option>
                        <option value="บรรจุภัณฑ์ชำรุดเสียหาย">บรรจุภัณฑ์ชำรุดเสียหาย</option>
                        <option value="สินค้าไม่ตรงตามที่สั่งจอง">สินค้าไม่ตรงตามที่สั่งจอง</option>
                        <option value="ลูกค้าเปลี่ยนใจ">ลูกค้าเปลี่ยนใจ</option>
                        <option value="อื่นๆ">อื่นๆ</option>
                    </select>
                </div>
