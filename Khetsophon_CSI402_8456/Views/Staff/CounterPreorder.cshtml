@model Khetsophon_CSI402_8456.ViewModels.CounterPreorderViewModel;
@{
    ViewData["Title"] = "เคาน์เตอร์พรีออเดอร์";
    Layout = "_StaffLayout";

    // Top-of-file Media & Content Configuration
    var pageHeader = new {
        Title = "เคาน์เตอร์พรีออเดอร์",
        Subtitle = "ค้นหาลูกค้าเพื่อเช็คสถานะรับสินค้าที่จองไว้",
        DefaultSearch = "081-234-5xxx"
    };

    var preorderResult = ViewBag.SearchResult as Khetsophon_CSI402_8456.Models.Preorder;
    var redemptionResult = ViewBag.SearchResultRedemption as Khetsophon_CSI402_8456.Models.Rewardredemption;
    var redemptionMetaMap = ViewBag.RedemptionMetaMap as Dictionary<string, Khetsophon_CSI402_8456.Helpers.RedemptionMetaPayload>;
    var preorderPromoMap = ViewBag.PreorderPromoMap as Dictionary<string, Khetsophon_CSI402_8456.Helpers.PreorderPromoPayload>;
    Khetsophon_CSI402_8456.Helpers.RedemptionMetaPayload? activeRedemptionMeta = null;
    if (redemptionResult != null && redemptionMetaMap != null)
    {
        redemptionMetaMap.TryGetValue(redemptionResult.RedemptionCode, out activeRedemptionMeta);
    }
    Khetsophon_CSI402_8456.Helpers.PreorderPromoPayload? activePreorderPromo = null;
    if (preorderResult != null && preorderPromoMap != null)
    {
        preorderPromoMap.TryGetValue(preorderResult.ReservationNumber, out activePreorderPromo);
    }
    string currentContactPhone = preorderResult?.ContactPhone ?? preorderResult?.User?.Phone ?? "";
    string? memberNotFoundPhone = TempData["MemberNotFoundPhone"] as string;
    var knownMemberPhones = ViewBag.KnownMemberPhones as IEnumerable<string> ?? Enumerable.Empty<string>();
    string knownPhonesJson = System.Text.Json.JsonSerializer.Serialize(knownMemberPhones);

    // แปลงสถานะของใบสั่งจองเป็นข้อความภาษาไทยสำหรับการแสดงผล
    string statusBadgeThai = preorderResult?.CurrentStatus switch {
        "Completed" => "รับสินค้าแล้ว",
        "Cancelled" => "ยกเลิกรายการ",
        "ReadyForPickup" => "พร้อมรับสินค้า",
        "PendingConfirm" => "รอยืนยัน",
        _ => preorderResult?.CurrentStatus ?? "รอมารับสินค้า"
    };

    // กำหนดการแสดงชื่อลูกค้าตามลำดับ Fallback: FullName -> Email -> ไม่พบข้อมูลผู้จอง
    string customerDisplay;
    if (preorderResult != null)
    {
        if (!string.IsNullOrWhiteSpace(preorderResult.User?.FullName))
        {
            customerDisplay = preorderResult.User.FullName;
        }
        else if (!string.IsNullOrWhiteSpace(preorderResult.User?.Email))
        {
            customerDisplay = preorderResult.User.Email;
        }
        else
        {
            customerDisplay = "ไม่พบข้อมูลผู้จอง";
        }
    }
    else
    {
        customerDisplay = "คุณสมชาย ใจดี";
    }
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Header Center -->
    <div class="text-center space-y-1">
        <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
        <p class="text-sm text-gray-500">@pageHeader.Subtitle</p>
    </div>

    <!-- Notification Messages (Flash TempData) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm font-semibold flex items-center gap-3 shadow-xs">
            <div class="size-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 text-sm font-semibold flex items-center gap-3 shadow-xs">
            <div class="size-8 rounded-lg bg-rose-600 text-white flex items-center justify-center shrink-0">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    @* ฟอร์มค้นหาใบสั่งจองพรีออเดอร์และรหัสแลกของรางวัล ส่งข้อมูลไปยัง StaffController แอ็กชัน CounterPreorder *@
    <form asp-controller="Staff" asp-action="CounterPreorder" class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6">
        @* ป้ายข้อความกำกับช่องค้นหา *@
        <label class="text-xs font-bold text-[#050315] block mb-2">ค้นหาด้วยรหัสพรีออเดอร์ / รหัสแลกรางวัล / เบอร์โทร / ชื่อลูกค้า</label>
        <div class="flex items-center gap-2.5">
            <div class="relative flex-1">
                @* ไอคอนรูปโทรศัพท์ SVG แสดงด้านหน้าช่องค้นหา *@
                <svg class="size-4.5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"></path>
                </svg>
                @* กล่องกรอกข้อความค้นหาผูกกับโมเดลฟิลด์ ReservationNumber *@
                <input asp-for="ReservationNumber" id="searchPreorderInput" type="text" placeholder="พิมพ์เลขใบจอง (เช่น PO20261001, 1001 ไม่ต้องใส่ขีด) รหัสแลกรางวัล หรือเบอร์โทร 0812345678"
                       class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-200 bg-white text-base font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9] focus:ring-1 focus:ring-[#2F39A9] shadow-2xs" />
            </div>
            @* ปุ่มกดยืนยันการค้นหาข้อมูลในระบบฐานข้อมูลจริง *@
            <button type="submit" class="bg-[#2F39A9] hover:bg-[#232B80] text-white px-6 py-3 rounded-xl font-bold text-sm shadow-xs flex items-center gap-2 transition-colors cursor-pointer shrink-0">
                @* ไอคอนรูปแว่นขยาย SVG *@
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                @* ข้อความบนปุ่มค้นหา *@
                <span>ค้นหา</span>
            </button>
        </div>
        @* ข้อความแนะนำวิธีการค้นหาเพิ่มเติมด้านล่าง *@
        <p class="text-xs text-gray-400 mt-2.5">พิมพ์รหัสใบจอง รหัสแลกของรางวัล (เช่น RWD123456) ชื่อลูกค้า หรือเบอร์โทร ระบบจะค้นหาและแสดงรายละเอียดจากฐานข้อมูลทันที</p>
    </form>

    @if (ViewBag.Status != null)
    {
        <div class="p-4 rounded-xl text-sm font-semibold @(preorderResult != null || redemptionResult != null ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-amber-50 text-amber-800 border border-amber-200")">
            @ViewBag.Status
        </div>
    }

    <!-- 1. กรณีพบรายการแลกของรางวัลในระบบ -->
    @if (redemptionResult != null)
    {
        string redeemBadgeClass = redemptionResult.Status switch {
            "Completed" => "bg-emerald-600 text-white",
            "Cancelled" => "bg-rose-600 text-white",
            _ => "bg-amber-500 text-white"
        };
        string redeemBadgeText = redemptionResult.Status switch {
            "Completed" => "รับของรางวัลแล้ว",
            "Cancelled" => "ยกเลิก / คืนแต้มแล้ว",
            _ => "รอรับของรางวัล"
        };

        <div class="bg-white rounded-2xl border-2 border-primary/25 shadow-xs p-6 space-y-5">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2 text-sm font-bold text-[#050315]">
                    <svg class="size-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>พบรายการจองแลกของรางวัลในระบบ</span>
                </div>
                <span class="text-xs font-bold px-3.5 py-1.5 rounded-full @redeemBadgeClass shadow-xs">
                    @redeemBadgeText
                </span>
            </div>

            <div class="flex items-center gap-4 p-4 rounded-2xl bg-amber-50/60 border border-amber-200/80">
                <img src="@Url.Content(!string.IsNullOrEmpty(redemptionResult.Reward?.ImageUrl) ? redemptionResult.Reward.ImageUrl : "~/media/images/tanjiro_kamado.png")" alt="@redemptionResult.Reward?.Title" class="size-16 rounded-xl object-cover border border-amber-200 shrink-0 bg-white" />
                <div class="flex-1 min-w-0">
                    <span class="text-xs font-bold text-amber-800">@(redemptionResult.Reward?.Brand ?? "FriendHouse Exclusive")</span>
                    <h3 class="text-sm font-bold text-[#050315] truncate">@(redemptionResult.Reward?.Title ?? "ของรางวัล")</h3>
                    <div class="text-xs font-semibold text-primary mt-1">ใช้แต้มแลก: @redemptionResult.PointsSpent.ToString("N0") แต้ม (ชำระด้วยแต้มแล้ว ไม่ต้องชำระเงิน)</div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-6 pt-2 border-t border-gray-100">
                <div>
                    <div class="text-xs text-gray-400 font-medium">รหัสแลกของรางวัล</div>
                    <div class="text-base font-black font-mono text-primary mt-0.5">@redemptionResult.RedemptionCode</div>
                </div>
                <div>
                    <div class="text-xs text-gray-400 font-medium">ชื่อลูกค้า / เบอร์ติดต่อรับของ</div>
                    <div class="text-sm font-bold text-[#050315] mt-0.5">@(redemptionResult.User?.FullName ?? redemptionResult.User?.Email) (@(activeRedemptionMeta?.ContactPhone ?? redemptionResult.User?.Phone ?? "ไม่มีเบอร์"))</div>
                </div>
                <div>
                    <div class="text-xs text-gray-400 font-medium">วันที่ทำรายการจองแลก</div>
                    <div class="text-sm font-bold text-[#050315] mt-0.5">@redemptionResult.RedeemedAt.ToString("dd MMM yyyy HH:mm น.")</div>
                </div>
                <div>
                    <div class="text-xs text-gray-400 font-medium">กำหนดนัดรับ / สถานะการส่งมอบ</div>
                    <div class="text-sm font-bold text-[#050315] mt-0.5">
                        @if (!string.IsNullOrEmpty(activeRedemptionMeta?.PickupDate))
                        {
                            <span class="text-primary">นัดรับ @Khetsophon_CSI402_8456.Helpers.PromoAndRedemptionHelper.FormatPickupDateThai(activeRedemptionMeta.PickupDate) · </span>
                        }
                        @(redemptionResult.CompletedAt.HasValue ? $"ส่งมอบเมื่อ {redemptionResult.CompletedAt.Value:dd MMM yyyy HH:mm น.}" : redemptionResult.Status == "Cancelled" ? "ยกเลิกและคืนแต้มสะสมแล้ว" : "ยังไม่ได้ส่งมอบ")
                    </div>
                </div>
            </div>

            <!-- สถานะและแถบปุ่มดำเนินการ 3 ปุ่มสำหรับสินค้าแลกแต้ม -->
            @if (redemptionResult.Status == "Completed")
            {
                <div class="rounded-2xl border border-emerald-200 bg-emerald-50/90 p-4.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
                    <div class="flex items-center gap-3.5">
                        <div class="size-11 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-extrabold text-emerald-950">ของรางวัลชิ้นนี้ส่งมอบให้ลูกค้าเรียบร้อยแล้ว</h4>
                            <p class="text-xs text-emerald-700 mt-0.5">
                                @(redemptionResult.CompletedAt.HasValue ? $"บันทึกส่งมอบเมื่อ: {redemptionResult.CompletedAt.Value:dd MMM yyyy HH:mm น.}" : "รายการนี้ปิดการส่งมอบเรียบร้อยแล้ว")
                            </p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold shrink-0 shadow-xs">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>ส่งมอบแล้ว</span>
                    </span>
                </div>
            }
            else if (redemptionResult.Status == "Cancelled")
            {
                <div class="rounded-2xl border border-rose-200 bg-rose-50/90 p-4.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
                    <div class="flex items-center gap-3.5">
                        <div class="size-11 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-extrabold text-rose-950">รายการแลกของรางวัลนี้ถูกยกเลิกแล้ว</h4>
                            <p class="text-xs text-rose-700 mt-0.5">ลูกค้าไม่รับสินค้าหรือไม่ได้มารับตามกำหนด ระบบได้คืน @redemptionResult.PointsSpent.ToString("N0") แต้มสะสมและคืนสต็อกของรางวัลเรียบร้อยแล้ว</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-600 text-white text-xs font-bold shrink-0 shadow-xs">
                        <span>ยกเลิก / คืนแต้มแล้ว</span>
                    </span>
                </div>
            }
            else
            {
                @* แถวปุ่มดำเนินการทั้ง 3 ปุ่ม เรียงจากซ้ายไปขวา: ไม่รับสินค้า, ไม่มารับสินค้า, มารับแล้ว / ส่งมอบของรางวัล *@
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-3 border-t border-gray-100">
                    <button type="button" onclick="openRedeemRejectModal()" class="w-full sm:w-auto px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-bold text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer shadow-2xs">
                        <svg class="size-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>ไม่รับสินค้า</span>
                    </button>

                    <button type="button" onclick="openRedeemNoShowModal()" class="w-full sm:w-auto px-4 py-3 rounded-xl border border-[#FCA5A5] bg-white hover:bg-red-50 text-[#DC2626] font-bold text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer shadow-2xs">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                        <span>ไม่มารับสินค้า</span>
                    </button>

                    <button type="button" onclick="openRedeemCompleteModal()" class="w-full sm:flex-1 py-3 px-6 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white font-bold text-sm flex items-center justify-center gap-2 shadow-xs transition-colors cursor-pointer">
                        <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>มารับแล้ว / ส่งมอบของรางวัล</span>
                    </button>
                </div>

                <div class="space-y-1.5 text-xs text-gray-400 pt-1">
                    <div class="flex items-start gap-1.5">
                        <svg class="size-3.5 text-gray-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>เมื่อกด "มารับแล้ว / ส่งมอบของรางวัล" ระบบจะปิดรายการส่งมอบให้ลูกค้าทันที (ไม่ต้องชำระเงินหรือกรอกเบอร์สะสมแต้ม)</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <svg class="size-3.5 text-gray-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>เมื่อกด "ไม่รับสินค้า" หรือ "ไม่มารับสินค้า" ระบบจะบันทึกสาเหตุและคืนแต้มสะสมพร้อมคืนสต็อกของรางวัลให้ลูกค้าอัตโนมัติ</span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- 2. การแสดงรายการพรีออเดอร์ -->
    @if (preorderResult != null)
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6 space-y-5">
            <!-- Top Status Header -->
            <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2 text-sm font-bold text-[#050315]">
                    <svg class="size-5 text-[#16A34A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>พบรายการพรีออเดอร์ในระบบ</span>
                </div>
                @{
                    string topBadgeClass = preorderResult.CurrentStatus switch {
                        "Completed" => "bg-emerald-600 text-white",
                        "Cancelled" => "bg-rose-600 text-white",
                        "ReadyForPickup" => "bg-blue-600 text-white",
                        _ => "bg-[#2F39A9] text-white"
                    };
                }
                <span class="text-xs font-bold px-3.5 py-1.5 rounded-full @topBadgeClass shadow-xs">
                    @statusBadgeThai
                </span>
            </div>

            <!-- Product Items List Block -->
            <div class="space-y-3">
                @if (preorderResult.Preorderitems != null && preorderResult.Preorderitems.Any())
                {
                    <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">
                        รายการสินค้าที่สั่งจอง (@preorderResult.Preorderitems.Sum(pi => pi.Quantity) ชิ้น)
                    </div>
                    @foreach (var item in preorderResult.Preorderitems)
                    {
                        <div class="flex items-center gap-4 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                            <div class="size-14 rounded-xl overflow-hidden bg-white border border-slate-200 shrink-0 flex items-center justify-center">
                                @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                {
                                    <img src="@Url.Content(item.Product.ImageUrl)" alt="@item.Product.Name" class="size-full object-cover" />
                                }
                                else
                                {
                                    <div class="size-full bg-[#BAF2FF]/40 text-[#2F39A9] flex items-center justify-center">
                                        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-sm font-bold text-[#050315] truncate">@(item.Product?.Name ?? "สินค้าพรีออเดอร์")</h3>
                                <p class="text-xs text-gray-500 mt-0.5">จำนวนที่จอง: @item.Quantity ชิ้น · ราคาต่อหน่วย: ฿@item.UnitPrice.ToString("N0")</p>
                            </div>
                            <div class="text-right">
                                <span class="text-sm font-extrabold text-[#2F39A9]">฿@((item.UnitPrice * item.Quantity).ToString("N0"))</span>
                            </div>
                        </div>
                    }
                    <div class="flex flex-wrap justify-between items-center gap-2 text-xs font-bold text-gray-700 px-1 pt-1">
                        <span>จำนวนสินค้ารวมทั้งหมด: @(preorderResult.Preorderitems.Sum(pi => pi.Quantity)) ชิ้น</span>
                        <div class="text-right">
                            @if (activePreorderPromo != null)
                            {
                                <div class="text-[11px] font-bold text-emerald-700 mb-0.5">
                                    ใช้คูปอง @activePreorderPromo.VoucherCode
                                    @(activePreorderPromo.DiscountAmount > 0m ? $" (ลด -฿{activePreorderPromo.DiscountAmount:N0})" : activePreorderPromo.IsDoublePoints ? " (รับแต้มสะสม x2)" : "")
                                </div>
                            }
                            <span class="text-sm font-extrabold text-[#2F39A9]">ยอดชำระสุทธิ: ฿@preorderResult.TotalFinalPrice.ToString("N0")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 text-center text-xs font-semibold text-slate-500">
                        ไม่มีรายการสินค้าในคำสั่งจองนี้
                    </div>
                }
            </div>

            <!-- Details Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-6 pt-2 border-t border-gray-100">
                <div>
                    <div class="text-xs text-gray-400 font-medium">รหัสพรีออเดอร์ / เบอร์โทร</div>
                    <div class="text-sm font-bold text-[#050315] mt-0.5">@preorderResult.ReservationNumber · @preorderResult.ContactPhone</div>
                </div>
                <div>
                    <div class="text-xs text-gray-400 font-medium">ชื่อลูกค้า / ข้อมูลผู้จอง</div>
                    <div class="text-sm font-bold text-[#050315] mt-0.5">@customerDisplay</div>
                </div>
                <div>
                    <div class="text-xs text-gray-400 font-medium">วันที่สั่งจอง</div>
                    <div class="text-sm font-bold text-[#050315] mt-0.5">@preorderResult.CreatedAt.ToString("dd MMM yyyy")</div>
                </div>
                <div>
                    <div class="text-xs text-gray-400 font-medium">กำหนดมารับภายใน</div>
                    <div class="text-sm font-bold text-[#050315] mt-0.5">@preorderResult.EstimatedPickupDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <!-- สถานะของคำสั่งจอง และฟอร์มการดำเนินการ -->
            @if (preorderResult.CurrentStatus == "Completed")
            {
                <!-- ป้องกันการกดซ้ำ: ออเดอร์ที่ Completed จะแสดงเฉพาะแบนเนอร์แจ้งเตือน ไม่แสดงปุ่มใดๆ ทั้งสิ้น -->
                <div class="rounded-2xl border border-emerald-200 bg-emerald-50/90 p-4.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
                    <div class="flex items-center gap-3.5">
                        <div class="size-11 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-extrabold text-emerald-950">รายการนี้ส่งมอบและชำระเงินเสร็จสิ้นแล้ว</h4>
                            <p class="text-xs text-emerald-700 mt-0.5">
                                @(preorderResult.CompletedAt.HasValue ? $"บันทึกส่งมอบเมื่อ: {preorderResult.CompletedAt.Value:dd MMM yyyy HH:mm น.}" : "ออเดอร์นี้ถูกปิดยอดเรียบร้อยแล้ว ไม่สามารถดำเนินการซ้ำได้เพื่อป้องกันการปั๊มแต้ม")
                            </p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold shrink-0 shadow-xs">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>ปิดยอดสมบูรณ์แล้ว</span>
                    </span>
                </div>
            }
            else if (preorderResult.CurrentStatus == "Cancelled")
            {
                <!-- ออเดอร์ที่ Cancelled จะแสดงเฉพาะแบนเนอร์แจ้งเตือน ไม่แสดงปุ่มใดๆ ทั้งสิ้น -->
                <div class="rounded-2xl border border-rose-200 bg-rose-50/90 p-4.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
                    <div class="flex items-center gap-3.5">
                        <div class="size-11 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-extrabold text-rose-950">รายการนี้ถูกยกเลิกแล้ว</h4>
                            <p class="text-xs text-rose-700 mt-0.5">ลูกค้าไม่รับสินค้าหรือไม่ได้มารับสินค้าตามกำหนด และระบบได้คืนสต็อกเรียบร้อยแล้ว</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-600 text-white text-xs font-bold shrink-0 shadow-xs">
                        <span>ยกเลิกรายการแล้ว</span>
                    </span>
                </div>
            }
            else
            {
                @* แถวปุ่มดำเนินการทั้ง 3 ปุ่ม เรียงจากซ้ายไปขวา: ไม่รับสินค้า, ไม่มารับสินค้า, มารับแล้ว / ชำระเงินแล้ว *@
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-3 border-t border-gray-100">
                    @* ปุ่มที่ 1 (ซ้าย): ไม่รับสินค้า เปิดหน้าต่าง Modal ให้เลือกเหตุผลการปฏิเสธรับสินค้า *@
                    <button type="button" onclick="openRejectReasonModal()" class="w-full sm:w-auto px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-bold text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer shadow-2xs">
                        @* ไอคอนเครื่องหมายตกใจในวงกลม SVG *@
                        <svg class="size-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>ไม่รับสินค้า</span>
                    </button>

                    @* ปุ่มที่ 2 (กลาง): ไม่มารับสินค้า เปิดหน้าต่าง Modal ให้เลือกสาเหตุที่ลูกค้าไม่มารับสินค้า *@
                    <button type="button" onclick="openConfirmNoShowModal()" class="w-full sm:w-auto px-4 py-3 rounded-xl border border-[#FCA5A5] bg-white hover:bg-red-50 text-[#DC2626] font-bold text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer shadow-2xs">
                        @* ไอคอนเครื่องหมายกากบาท SVG *@
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                        <span>ไม่มารับสินค้า</span>
                    </button>

                    @* ปุ่มที่ 3 (ขวา): มารับแล้ว / ชำระเงินแล้ว เปิดหน้าต่าง Modal ให้กรอกเบอร์โทรสมาชิกเพื่อสะสมแต้ม *@
                    <button type="button" onclick="openMemberPointsModal()" class="w-full sm:flex-1 py-3 px-6 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white font-bold text-sm flex items-center justify-center gap-2 shadow-xs transition-colors cursor-pointer">
                        @* ไอคอนเครื่องหมายถูก SVG *@
                        <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>มารับแล้ว / ชำระเงินแล้ว</span>
                    </button>
                </div>

                @* คำชี้แจงขั้นตอนการทำงานใต้ปุ่มทั้ง 3 *@
                <div class="space-y-1.5 text-xs text-gray-400 pt-1">
                    <div class="flex items-start gap-1.5">
                        <svg class="size-3.5 text-gray-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>เมื่อกด "มารับแล้ว" สถานะพรีออเดอร์ของลูกค้าจะถูกปิดโดยอัตโนมัติ และต้องกรอกเบอร์ลูกค้าเพื่อสะสมแต้ม แต่หากไม่เป็นสมาชิกกดปุ่มไม่ได้เป็นสมาชิก</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <svg class="size-3.5 text-gray-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>เมื่อกด "ไม่รับสินค้า" ระบบจะให้กรอกสาเหตุว่าทำไมถึงไม่รับ</span>
                    </div>
                </div>
            }
        </div>
    }
    else if (redemptionResult == null)
    {
        <!-- กล่องกรณีค้นหาไม่พบ หรือยังไม่ได้ค้นหา -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-10 text-center space-y-3">
            <div class="size-16 rounded-2xl bg-slate-100 text-slate-400 mx-auto flex items-center justify-center">
                <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
            <h3 class="text-base font-bold text-[#050315]">ไม่พบข้อมูลคำสั่งจองพรีออเดอร์</h3>
            <p class="text-xs text-gray-500 max-w-md mx-auto">
                กรุณาตรวจสอบหมายเลขใบสั่งจองหรือเบอร์โทรศัพท์ของลูกค้า แล้วกดปุ่มค้นหาใหม่อีกครั้ง
            </p>
        </div>
    }

    <!-- Recent Searches Card (ทางลัดค้นหาด่วนทั้งใบจองพรีออเดอร์และรายการแลกของรางวัล) -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-xs p-5 space-y-4">
        <div>
            <h4 class="text-xs font-bold text-gray-400 mb-2.5">ใบจองพรีออเดอร์ล่าสุดในระบบฐานข้อมูลจริง (คลิกเพื่อค้นหาทันที)</h4>
            <div class="flex items-center gap-2 flex-wrap">
                @if (ViewBag.RecentPreorders is IEnumerable<Khetsophon_CSI402_8456.Models.Preorder> recentList && recentList.Any())
                {
                    foreach (var ro in recentList)
                    {
                        var pName = ro.Preorderitems.FirstOrDefault()?.Product?.Name ?? "สินค้า";
                        if (pName.Length > 18) pName = pName.Substring(0, 18) + "...";
                        string badgeColor = ro.CurrentStatus switch {
                            "Completed" => "border-emerald-200 bg-emerald-50/70 text-emerald-800 hover:bg-emerald-100",
                            "Cancelled" => "border-rose-200 bg-rose-50/70 text-rose-800 hover:bg-rose-100",
                            _ => "border-blue-200 bg-blue-50/70 text-[#2F39A9] hover:bg-blue-100"
                        };
                        <a asp-controller="Staff" asp-action="CounterPreorder" asp-route-query="@ro.ReservationNumber"
                           class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-full border @badgeColor transition-colors">
                            @ro.ReservationNumber (@pName ฿@ro.TotalFinalPrice.ToString("N0"))
                        </a>
                    }
                }
                else
                {
                    <span class="text-xs text-gray-400">ยังไม่มีประวัติการจองในระบบ</span>
                }
            </div>
        </div>

        <div class="pt-3 border-t border-gray-100">
            <h4 class="text-xs font-bold text-gray-400 mb-2.5">รายการจองแลกของรางวัลด้วยแต้มล่าสุด (คลิกเพื่อค้นหาทันที)</h4>
            <div class="flex items-center gap-2 flex-wrap">
                @if (ViewBag.RecentRedemptions is IEnumerable<Khetsophon_CSI402_8456.Models.Rewardredemption> recentRedemptions && recentRedemptions.Any())
                {
                    foreach (var rdm in recentRedemptions)
                    {
                        var rTitle = rdm.Reward?.Title ?? "ของรางวัล";
                        if (rTitle.Length > 18) rTitle = rTitle.Substring(0, 18) + "...";
                        string rBadgeColor = rdm.Status switch {
                            "Completed" => "border-emerald-200 bg-emerald-50/70 text-emerald-800 hover:bg-emerald-100",
                            "Cancelled" => "border-rose-200 bg-rose-50/70 text-rose-800 hover:bg-rose-100",
                            _ => "border-amber-200 bg-amber-50/70 text-amber-800 hover:bg-amber-100"
                        };
                        <a asp-controller="Staff" asp-action="CounterPreorder" asp-route-query="@rdm.RedemptionCode"
                           class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-full border @rBadgeColor transition-colors">
                            @rdm.RedemptionCode (@rTitle · @rdm.PointsSpent.ToString("N0") แต้ม)
                        </a>
                    }
                }
                else
                {
                    <span class="text-xs text-gray-400">ยังไม่มีประวัติการแลกของรางวัลในระบบ</span>
                }
            </div>
        </div>
    </div>
</div>

@* ==================== หน้าต่างป๊อปอัป (MODALS) สำหรับจัดการสถานะพรีออเดอร์ ==================== *@
@if (preorderResult != null && preorderResult.CurrentStatus != "Completed" && preorderResult.CurrentStatus != "Cancelled")
{
    @* 1. หน้าต่างป๊อปอัปสะสมแต้มสมาชิก เปิดขึ้นหลังจากกดปุ่ม "มารับแล้ว / ชำระเงินแล้ว" *@
    <div id="memberPointsModal" class="fixed inset-0 z-50 @(string.IsNullOrEmpty(memberNotFoundPhone) ? "hidden" : "") bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
            <div class="text-center space-y-1">
                <h3 class="text-lg font-bold text-[#050315]">สะสมแต้มสมาชิก</h3>
                <p class="text-xs text-gray-500">กรอกหมายเลขโทรศัพท์ลูกค้า เพื่อนำยอดคำสั่งซื้อ ฿@preorderResult.TotalFinalPrice.ToString("N0") ไปสะสมแต้มเข้าบัญชีสมาชิก</p>
            </div>

            @* ฟอร์มส่งข้อมูลยืนยันรับสินค้าและสะสมแต้มไปยัง StaffController แอ็กชัน CompletePickup *@
            <form id="completePickupForm" asp-controller="Staff" asp-action="CompletePickup" onsubmit="return handleCompletePickupSubmit(event)" class="space-y-4">
                @* ตัวแปรซ่อนเก็บรหัสใบสั่งจองพรีออเดอร์ *@
                <input type="hidden" name="preorderId" value="@preorderResult.PreorderId" />
                @* ตัวแปรซ่อนเก็บสถานะยืนยันดำเนินการต่อแบบลูกค้าทั่วไปเมื่อไม่พบเบอร์สมาชิก *@
                <input type="hidden" name="forceWithoutMember" id="forceWithoutMemberInput" value="false" />

                <div>
                    <label class="text-xs font-bold text-gray-700 block mb-1">หมายเลขโทรศัพท์สมาชิก</label>
                    <input type="text" name="memberPhone" id="memberPhoneInput" placeholder="ตัวอย่าง 081-234-5678 หรือ 0812345678" value="@(memberNotFoundPhone ?? currentContactPhone)"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9]" />
                </div>

                @* กล่องแจ้งเตือนเมื่อกรอกเบอร์โทรศัพท์ที่ไม่พบในระบบสมาชิก *@
                <div id="memberNotFoundWarning" class="@(string.IsNullOrEmpty(memberNotFoundPhone) ? "hidden" : "") p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800 space-y-2.5">
                    <div class="font-bold flex items-center gap-1.5">
                        <svg class="size-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>ไม่พบเบอร์สมาชิกในระบบ</span>
                    </div>
                    <p class="text-amber-700">ท่านต้องการดำเนินการต่อแบบลูกค้าทั่วไปโดยไม่สะสมแต้ม หรือต้องการแก้ไขหมายเลขโทรศัพท์?</p>
                    <div class="flex items-center gap-2 pt-1">
                        <button type="button" onclick="confirmContinueWithoutMember()" class="flex-1 bg-amber-600 hover:bg-amber-700 text-white py-2 px-3 rounded-lg font-bold text-xs cursor-pointer">
                            ดำเนินการต่อแบบทั่วไป
                        </button>
                        <button type="button" onclick="focusEditMemberPhone()" class="bg-white border border-amber-300 text-amber-900 py-2 px-3 rounded-lg font-semibold text-xs cursor-pointer">
                            แก้ไขเบอร์
                        </button>
                    </div>
                </div>

                <div class="space-y-2 pt-1">
                    @* ปุ่มยืนยันรับสินค้าและสะสมแต้ม *@
                    <button type="submit" class="w-full bg-[#2F39A9] hover:bg-[#232B80] text-white py-2.5 rounded-xl font-bold text-sm shadow-xs cursor-pointer">
                        ยืนยันและสะสมแต้ม
                    </button>
                    @* ปุ่มข้ามการสะสมแต้มสำหรับลูกค้าที่ไม่ได้เป็นสมาชิก *@
                    <button type="button" onclick="skipPointsAndSubmit()" class="w-full bg-white border border-gray-200 hover:bg-gray-50 text-gray-600 py-2.5 rounded-xl font-semibold text-sm cursor-pointer">
                        ไม่ได้เป็นสมาชิก / ข้าม
                    </button>
                    @* ปุ่มปิดหน้าต่างป๊อปอัป *@
                    <button type="button" onclick="closeAllModals()" class="w-full text-xs text-gray-400 hover:text-gray-600 py-1 font-semibold cursor-pointer">
