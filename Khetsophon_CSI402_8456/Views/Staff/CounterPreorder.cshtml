                <div class="font-bold text-[#050315]">@(redemptionResult.Reward?.Title ?? "ของรางวัล")</div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="text-slate-600">ลูกค้า: @(redemptionResult.User?.FullName ?? redemptionResult.User?.Email)</div>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="text-emerald-700 font-bold">ชำระด้วยแต้มสะสมแล้ว (@redemptionResult.PointsSpent.ToString("N0") แต้ม) · ไม่มีค่าใช้จ่ายเพิ่มเติม</div>
            </div>

            @* ฟอร์มส่งมอบของรางวัลไปยัง StaffController แอ็กชัน CompleteRewardRedemption *@
            <form asp-controller="Staff" asp-action="CompleteRewardRedemption" class="flex items-center gap-2.5 pt-1">
                @* ฟิลด์ซ่อนสำหรับส่งค่าพารามิเตอร์แนบไปกับแบบฟอร์ม *@
                <input type="hidden" name="redemptionId" value="@redemptionResult.RedemptionId" />
                @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
