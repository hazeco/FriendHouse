                    <label class="text-xs font-bold text-gray-700 block mb-1">
                        ข้อความเพิ่มเติม <span class="text-rose-500">* จำเป็นต้องระบุเมื่อเลือกเหตุผลอื่นๆ</span>
                    </label>
                    <textarea name="remark" id="rejectReasonRemark" rows="3" placeholder="โปรดระบุเหตุผลเฉพาะหรือหมายเหตุจากเจ้าหน้าที่ที่นี่..."
                              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#2F39A9]"></textarea>
                </div>
                @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
                <p id="rejectValidationMsg" class="hidden text-xs text-rose-500 font-semibold"></p>

                @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                <div class="flex items-center gap-2.5 pt-2">
                    @* ปุ่มกดเรียกฟังก์ชันโต้ตอบหรือเปิด-ปิดหน้าต่าง Modal *@
                    <button type="button" onclick="closeAllModals()" class="flex-1 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-2.5 rounded-xl font-semibold text-sm cursor-pointer">
                        ยกเลิก
                    </button>
                    @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
                    <button type="submit" class="flex-1 bg-[#2F39A9] hover:bg-[#232B80] text-white py-2.5 rounded-xl font-bold text-sm cursor-pointer shadow-xs">
                        บันทึก
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* ==================== หน้าต่างป๊อปอัป (MODALS) สำหรับจัดการรายการจองแลกของรางวัลด้วยแต้ม ==================== *@
@if (redemptionResult != null && redemptionResult.Status != "Completed" && redemptionResult.Status != "Cancelled")
{
    @* 1. หน้าต่างป๊อปอัปยืนยันการส่งมอบของรางวัล ("มารับแล้ว / ส่งมอบของรางวัล") *@
