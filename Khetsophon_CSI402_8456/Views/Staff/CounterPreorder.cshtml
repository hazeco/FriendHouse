@* กำหนดโมเดลข้อมูลสำหรับเคาน์เตอร์พรีออเดอร์หน้าร้าน *@
@model Khetsophon_CSI402_8456.ViewModels.CounterPreorderViewModel;
@* กำหนดฟังก์ชันช่วยเหลือและการประมวลผลสำหรับหน้าเคาน์เตอร์พรีออเดอร์ *@
@{

    // ฟังก์ชันแปลงวันที่นัดรับสินค้าเป็นภาษาไทย
    string FormatPickupDateThai(string? isoDate)
    {
        if (!string.IsNullOrWhiteSpace(isoDate) &&
            DateOnly.TryParseExact(isoDate.Trim(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed))
        {
            return parsed.ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("th-TH"));
        }
        return "-";
    }

    // ฟังก์ชันสกัดข้อมูลสถานะและเหตุผลการไม่รับสินค้า/ไม่มารับสินค้า/ยกเลิกคำสั่งจองจากตาราง Systemlogs
    (string BadgeTitle, string StepTitle, string NoticeText, string ReasonDetail) ResolveOrderCancelMeta(
        IEnumerable<Systemlog>? logs,
        string? referenceCode,
        bool isReward = false)
    {
        // กำหนดหัวข้อเริ่มต้นตามประเภทรายการ
        string defaultTitle = isReward ? "ยกเลิกการแลกของรางวัล" : "ยกเลิกคำสั่งจอง";
        // กำหนดข้อความแจ้งเตือนเริ่มต้นสำหรับของรางวัลหรือสินค้าพรีออเดอร์
        string defaultNotice = isReward
            ? "รายการแลกของรางวัลนี้ถูกยกเลิกแล้ว ระบบได้คืนแต้มสะสมและคืนสต็อกของรางวัลเรียบร้อยแล้ว"
            : "รายการนี้ถูกยกเลิกตามคำขอของลูกค้า และระบบได้คืนสิทธิ์สต็อกสินค้าเรียบร้อยแล้ว";
        // หากไม่มีข้อมูลประวัติการทำงานหรือไม่มีรหัสอ้างอิง ให้ส่งคืนค่าเริ่มต้น
        if (logs == null || string.IsNullOrWhiteSpace(referenceCode))
            return (defaultTitle, defaultTitle, defaultNotice, "ลูกค้าแจ้งยกเลิกรายการ");
        // ตัดช่องว่างของรหัสอ้างอิงเพื่อใช้เปรียบเทียบ
        string cleanCode = referenceCode.Trim();
        // ค้นหาบันทึกประวัติการยกเลิกหรือปฏิเสธรับสินค้าที่ตรงกับรหัสอ้างอิง
        var matchedLog = logs
            .Where(l => !string.IsNullOrEmpty(l.Message) &&
                        l.Message.Contains(cleanCode, StringComparison.OrdinalIgnoreCase) &&
                        (l.Module == "CounterPreorder" || l.Module == "preorder.cancel" || l.Module == "reward.cancel" ||
                         l.LogCode.StartsWith("REJECT", StringComparison.OrdinalIgnoreCase) ||
                         l.LogCode.StartsWith("NOSHOW", StringComparison.OrdinalIgnoreCase) ||
                         l.LogCode.StartsWith("PO-CAN", StringComparison.OrdinalIgnoreCase) ||
                         l.LogCode.StartsWith("RWD-CAN", StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(l => l.Timestamp)
            .FirstOrDefault();
        // หากไม่พบบันทึกประวัติที่ตรงกัน ให้ส่งคืนค่าเริ่มต้น
        if (matchedLog == null)
            return (defaultTitle, defaultTitle, defaultNotice, "ลูกค้าแจ้งยกเลิกรายการ");
        // ข้อความรายละเอียดในบันทึกระบบ
        string msg = matchedLog.Message ?? string.Empty;
        // ตัวแปรเก็บข้อความสาเหตุการยกเลิก
        string reasonPart = string.Empty;
        // ค้นหาตำแหน่งคำว่า สาเหตุ: ในข้อความ
        int reasonIdx = msg.IndexOf("สาเหตุ:", StringComparison.OrdinalIgnoreCase);
        // สกัดข้อความสาเหตุหากพบในบันทึก
        if (reasonIdx >= 0)
        {
            // ดึงข้อความตั้งแต่ตำแหน่งคำว่า สาเหตุ:
            reasonPart = msg[reasonIdx..].Trim();
            // ค้นหาตำแหน่งข้อความการคืนเงินหรือคืนแต้มเพื่อตัดออก
            int refundIdx = reasonPart.IndexOf("| คืน", StringComparison.OrdinalIgnoreCase);
            // ตัดข้อความส่วนเกินออกให้เหลือเฉพาะสาเหตุหลัก
            if (refundIdx > 0) reasonPart = reasonPart[..refundIdx].Trim();
            // ลบข้อความที่ระบุว่า ไม่มี ออกเพื่อให้กระชับ
            reasonPart = reasonPart.Replace("| รายละเอียด: ไม่มี", "").Replace("| หมายเหตุ: ไม่มี", "").Trim();
        }
        // ตรวจสอบกรณีลูกค้าปฏิเสธไม่รับสินค้าที่หน้าร้าน
        if (matchedLog.LogCode.StartsWith("REJECT", StringComparison.OrdinalIgnoreCase) ||
            msg.Contains("ลูกค้าไม่รับ", StringComparison.OrdinalIgnoreCase))
        {
            // กำหนดหัวข้อตามประเภทของรางวัลหรือสินค้า
            string title = isReward ? "ลูกค้าไม่รับของรางวัล" : "ลูกค้าไม่รับสินค้า";
            // กำหนดรายละเอียดสาเหตุการปฏิเสธ
            string detail = !string.IsNullOrWhiteSpace(reasonPart) ? reasonPart : "สาเหตุ: ลูกค้าปฏิเสธไม่รับสินค้าที่เคาน์เตอร์หน้าร้าน";
            // ส่งคืนข้อมูลสถานะและข้อความแจ้งเตือนกรณีไม่รับสินค้า
            return (title, title, $"รายการนี้{title}ที่หน้าร้าน — {detail} (คืนสต็อกเรียบร้อยแล้ว)", detail);
        }
        // ตรวจสอบกรณีลูกค้าไม่มารับสินค้าตามกำหนดนัดหมาย
        if (matchedLog.LogCode.StartsWith("NOSHOW", StringComparison.OrdinalIgnoreCase) ||
            msg.Contains("ลูกค้าไม่มารับ", StringComparison.OrdinalIgnoreCase))
        {
            // กำหนดหัวข้อตามประเภทของรางวัลหรือสินค้า
            string title = isReward ? "ลูกค้าไม่มารับของรางวัล" : "ลูกค้าไม่มารับสินค้า";
            // กำหนดรายละเอียดสาเหตุที่ไม่มารับตามนัด
            string detail = !string.IsNullOrWhiteSpace(reasonPart) ? reasonPart : "สาเหตุ: ลูกค้าไม่มารับตามกำหนดนัดหมาย";
            // ส่งคืนข้อมูลสถานะและข้อความแจ้งเตือนกรณีไม่มารับสินค้า
            return (title, title, $"รายการนี้ถูกยกเลิกเนื่องจาก{title}ตามกำหนด — {detail} (คืนสต็อกเรียบร้อยแล้ว)", detail);
        }
        // กรณีลูกค้ากดยกเลิกรายการด้วยตนเอง
        string cancelDetail = !string.IsNullOrWhiteSpace(reasonPart) ? reasonPart : "สาเหตุ: ลูกค้ากดยกเลิกคำสั่งจองด้วยตนเอง";
        // ส่งคืนข้อมูลสถานะและข้อความแจ้งเตือนกรณีลูกค้ายกเลิก
        return (defaultTitle, defaultTitle, $"รายการนี้ถูกยกเลิกตามคำขอของลูกค้า — {cancelDetail} (คืนสิทธิ์สต็อกเรียบร้อยแล้ว)", cancelDetail);
    }
    ViewData["Title"] = "เคาน์เตอร์พรีออเดอร์";
    Layout = "_StaffLayout";

    // การกำหนดค่าข้อความส่วนหัวของหน้าเคาน์เตอร์พรีออเดอร์ตามกฎโครงการ
    var pageHeader = new {
        Title = "เคาน์เตอร์พรีออเดอร์",
        Subtitle = "ค้นหาลูกค้าเพื่อเช็คสถานะรับสินค้าที่จองไว้"
    };

    var preorderResult = ViewBag.SearchResult as Khetsophon_CSI402_8456.Models.Preorder;
    var redemptionResult = ViewBag.SearchResultRedemption as Khetsophon_CSI402_8456.Models.Rewardredemption;
    var redemptionMetaMap = ViewBag.RedemptionMetaMap as Dictionary<string, Khetsophon_CSI402_8456.ViewModels.RedemptionMetaPayload>;
    var preorderPromoMap = ViewBag.PreorderPromoMap as Dictionary<string, Khetsophon_CSI402_8456.ViewModels.PreorderPromoPayload>;
    Khetsophon_CSI402_8456.ViewModels.RedemptionMetaPayload? activeRedemptionMeta = null;
    if (redemptionResult != null && redemptionMetaMap != null)
    {
        redemptionMetaMap.TryGetValue(redemptionResult.RedemptionCode, out activeRedemptionMeta);
    }
    Khetsophon_CSI402_8456.ViewModels.PreorderPromoPayload? activePreorderPromo = null;
    if (preorderResult != null && preorderPromoMap != null)
    {
        preorderPromoMap.TryGetValue(preorderResult.ReservationNumber, out activePreorderPromo);
    }
    string currentContactPhone = preorderResult?.ContactPhone ?? preorderResult?.User?.Phone ?? "";
    string? memberNotFoundPhone = TempData["MemberNotFoundPhone"] as string;
    var cancelLogs = ViewBag.CancelLogs as IEnumerable<Khetsophon_CSI402_8456.Models.Systemlog>;
    var preorderCancelMeta = preorderResult != null
        ? ResolveOrderCancelMeta(cancelLogs, preorderResult.ReservationNumber, isReward: false)
        : (BadgeTitle: "ยกเลิกคำสั่งจอง", StepTitle: "ยกเลิกคำสั่งจอง", NoticeText: "รายการนี้ถูกยกเลิกแล้ว", ReasonDetail: "");
    var redemptionCancelMeta = redemptionResult != null
        ? ResolveOrderCancelMeta(cancelLogs, redemptionResult.RedemptionCode, isReward: true)
        : (BadgeTitle: "ยกเลิกการแลกของรางวัล", StepTitle: "ยกเลิกการแลกของรางวัล", NoticeText: "รายการแลกของรางวัลนี้ถูกยกเลิกแล้ว", ReasonDetail: "");

    // แปลงสถานะของใบสั่งจองเป็นข้อความภาษาไทยสำหรับการแสดงผล (แสดงสถานะไม่รับสินค้า/ไม่มารับสินค้า/ยกเลิกตามจริง)
    string statusBadgeThai = preorderResult?.CurrentStatus switch {
        "Completed" => "รับสินค้าแล้ว",
        "Cancelled" => preorderCancelMeta.BadgeTitle,
        "ReadyForPickup" => "พร้อมรับสินค้า",
        "PendingConfirm" => "รอยืนยัน",
        _ => preorderResult?.CurrentStatus ?? "รอมารับสินค้า"
    };

    // กำหนดการแสดงชื่อลูกค้าตามลำดับ Fallback: FullName -> Email -> ไม่พบข้อมูลผู้จอง
    string customerDisplay;
    if (preorderResult != null)
    {
        if (!string.IsNullOrWhiteSpace(preorderResult.User?.FullName))
        {
            customerDisplay = preorderResult.User.FullName;
        }
        else if (!string.IsNullOrWhiteSpace(preorderResult.User?.Email))
        {
            customerDisplay = preorderResult.User.Email;
        }
        else
        {
            customerDisplay = "ไม่พบข้อมูลผู้จอง";
        }
    }
    else
    {
        customerDisplay = "ไม่พบข้อมูลผู้จอง";
    }
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="max-w-3xl mx-auto space-y-6">
    @* ส่วนหัวหน้าเพจแสดงชื่อเรื่องและคำอธิบาย *@
    <div class="text-center space-y-1">
        @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
        <h1 class="text-2xl font-bold text-[#050315]">@pageHeader.Title</h1>
        @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
        <p class="text-sm text-gray-500">@pageHeader.Subtitle</p>
    </div>

    @* กล่องแสดงข้อความแจ้งเตือนผลการดำเนินงาน *@
    @if (TempData["SuccessMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="p-4.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm font-semibold flex items-center gap-3 shadow-xs">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="size-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (TempData["ErrorMessage"] != null)
    {
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="p-4.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 text-sm font-semibold flex items-center gap-3 shadow-xs">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="size-8 rounded-lg bg-rose-600 text-white flex items-center justify-center shrink-0">
                @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    @* ฟอร์มค้นหาใบสั่งจองพรีออเดอร์และรหัสแลกของรางวัล ส่งข้อมูลไปยัง StaffController แอ็กชัน CounterPreorder *@
    <form asp-controller="Staff" asp-action="CounterPreorder" class="bg-white rounded-2xl border border-gray-100 shadow-xs p-6">
        @* ป้ายข้อความกำกับช่องค้นหา *@
        <label class="text-xs font-bold text-[#050315] block mb-2">ค้นหาด้วยรหัสพรีออเดอร์ / รหัสแลกรางวัล / เบอร์โทร / ชื่อลูกค้า</label>
        @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
        <div class="flex items-center gap-2.5">
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="relative flex-1">
                @* ไอคอนรูปแว่นขยาย SVG แสดงด้านหน้าช่องค้นหา *@
                <svg class="size-4.5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                @* กล่องกรอกข้อความค้นหาผูกกับโมเดลฟิลด์ ReservationNumber *@
                <input asp-for="ReservationNumber" id="searchPreorderInput" type="text" placeholder="พิมพ์เลขใบจอง (เช่น PO-2026-0001 หรือ 0001) รหัสแลกรางวัล (RWD-2026-...) หรือเบอร์โทร"
                       class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-200 bg-white text-base font-semibold text-[#050315] focus:outline-none focus:border-[#2F39A9] focus:ring-1 focus:ring-[#2F39A9] shadow-2xs" />
            </div>
            @* ปุ่มกดยืนยันการค้นหาข้อมูลในระบบฐานข้อมูล *@
            <button type="submit" class="bg-[#2F39A9] hover:bg-[#232B80] text-white px-6 py-3 rounded-xl font-bold text-sm shadow-xs flex items-center gap-2 transition-colors cursor-pointer shrink-0">
                @* ไอคอนรูปแว่นขยาย SVG *@
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                @* ข้อความบนปุ่มค้นหา *@
                <span>ค้นหา</span>
            </button>
        </div>
        @* ข้อความแนะนำวิธีการค้นหาเพิ่มเติมด้านล่าง *@
        <p class="text-xs text-gray-400 mt-2.5">พิมพ์รหัสใบจอง รหัสแลกของรางวัล (เช่น RWD-2026-...) ชื่อลูกค้า หรือเบอร์โทร ระบบจะค้นหาและแสดงรายละเอียดให้ทันที</p>
    </form>

    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
    @if (ViewBag.Status != null)
    {
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="p-4 rounded-xl text-sm font-semibold @(preorderResult != null || redemptionResult != null ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-amber-50 text-amber-800 border border-amber-200")">
            @ViewBag.Status
        </div>
    }

    @* แสดงรายละเอียดรายการแลกของรางวัลเมื่อค้นพบในระบบ *@
    @if (redemptionResult != null)
    {
        string redeemBadgeClass = redemptionResult.Status switch {
            "Completed" => "bg-emerald-600 text-white",
            "Cancelled" => "bg-rose-600 text-white",
            _ => "bg-amber-500 text-white"
        };
        string redeemBadgeText = redemptionResult.Status switch {
            "Completed" => "รับของรางวัลแล้ว",
            "Cancelled" => "ยกเลิก / คืนแต้มแล้ว",
            _ => "รอรับของรางวัล"
        };

        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="bg-white rounded-2xl border-2 border-primary/25 shadow-xs p-6 space-y-5">
