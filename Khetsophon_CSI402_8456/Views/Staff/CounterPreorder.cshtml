                <p class="text-xs font-mono text-gray-400">รหัสใบจอง @preorderResult.ReservationNumber</p>
            </div>

            @* ฟอร์มส่งข้อมูลบันทึกเหตุผลที่ลูกค้าปฏิเสธไม่รับสินค้าไปยัง StaffController แอ็กชัน RejectPreorder *@
            <form id="rejectPreorderForm" asp-controller="Staff" asp-action="RejectPreorder" onsubmit="return validateRejectForm(event)" class="space-y-3">
