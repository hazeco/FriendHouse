@section Scripts {
    <script>
        // รายการเบอร์โทรศัพท์สมาชิกในระบบฐานข้อมูลสำหรับตรวจสอบก่อนส่งฟอร์ม
        const knownMemberPhones = @Html.Raw(knownPhonesJson);
        const defaultOrderPhone = '@Html.Raw(currentContactPhone)';

        // ฟังก์ชันกลางสำหรับผูกการแสดง/ซ่อนช่องหมายเหตุเมื่อเลือกเหตุผล "อื่นๆ"
        function bindRemarkToggle(selectId, containerId) {
            document.getElementById(selectId)?.addEventListener('change', function () {
                const container = document.getElementById(containerId);
                container?.classList.toggle('hidden', this.value !== 'อื่นๆ');
            });
        }

        // ฟังก์ชันกลางสำหรับตรวจสอบความครบถ้วนของฟอร์มระบุเหตุผล/สาเหตุ
        function validateReasonModalForm(e, selectId, remarkId, msgId, emptyPrompt) {
            const select = document.getElementById(selectId);
            const remark = document.getElementById(remarkId);
            const msg = document.getElementById(msgId);

            if (!select || !select.value) {
                e.preventDefault();
                if (msg) {
                    msg.innerText = emptyPrompt;
                    msg.classList.remove('hidden');
                }
                return false;
            }
            if (select.value === 'อื่นๆ' && (!remark || !remark.value.trim())) {
                e.preventDefault();
                if (msg) {
                    msg.innerText = 'กรุณาระบุข้อความเพิ่มเติมสำหรับสาเหตุอื่นๆ';
                    msg.classList.remove('hidden');
                }
                return false;
            }
            msg?.classList.add('hidden');
            return true;
        }

        bindRemarkToggle('rejectReasonSelect', 'rejectRemarkContainer');
        bindRemarkToggle('noShowReasonSelect', 'noShowRemarkContainer');
        bindRemarkToggle('redeemRejectReasonSelect', 'redeemRejectRemarkContainer');
        bindRemarkToggle('redeemNoShowReasonSelect', 'redeemNoShowRemarkContainer');

        // ซ่อนกล่องเตือนเมื่อพนักงานเริ่มแก้ไขเบอร์โทรศัพท์ในช่องกรอก
        document.getElementById('memberPhoneInput')?.addEventListener('input', function () {
            document.getElementById('memberNotFoundWarning')?.classList.add('hidden');
            const forceInput = document.getElementById('forceWithoutMemberInput');
            if (forceInput) forceInput.value = 'false';
        });

        // ฟังก์ชันเปิดหน้าต่างสะสมแต้มสมาชิกเมื่อกดปุ่ม "มารับแล้ว / ชำระเงินแล้ว"
        function openMemberPointsModal() {
            document.getElementById('memberNotFoundWarning')?.classList.add('hidden');
            const forceInput = document.getElementById('forceWithoutMemberInput');
            if (forceInput) forceInput.value = 'false';
            const inputEl = document.getElementById('memberPhoneInput');
            if (inputEl && !inputEl.value) {
                inputEl.value = defaultOrderPhone;
            }
            document.getElementById('memberPointsModal')?.classList.remove('hidden');
        }

        // ฟังก์ชันตรวจสอบเบอร์โทรศัพท์สมาชิกก่อนส่งฟอร์มยืนยันรับสินค้า
        function handleCompletePickupSubmit(e) {
            const phoneInput = document.getElementById('memberPhoneInput');
            const forceInput = document.getElementById('forceWithoutMemberInput');
            const warningEl = document.getElementById('memberNotFoundWarning');

            const rawPhone = (phoneInput?.value || '').trim();
            const cleanPhone = rawPhone.replace(/-/g, '').replace(/\s+/g, '').toLowerCase();

            // หากไม่ได้กรอกเบอร์โทร หรือยืนยันข้ามการสะสมแต้มแล้ว ให้ส่งฟอร์มได้ทันที
            if (!cleanPhone || forceInput?.value === 'true') {
                return true;
            }

            // ตรวจสอบว่ามีเบอร์โทรศัพท์นี้ในรายชื่อสมาชิกหรือไม่
            if (Array.isArray(knownMemberPhones) && !knownMemberPhones.includes(cleanPhone)) {
                e.preventDefault();
                warningEl?.classList.remove('hidden');
                return false;
            }

            return true;
        }

        // ฟังก์ชันเมื่อพนักงานกด "ดำเนินการต่อแบบทั่วไป" หลังจากไม่พบเบอร์สมาชิก
        function confirmContinueWithoutMember() {
            const forceInput = document.getElementById('forceWithoutMemberInput');
            if (forceInput) forceInput.value = 'true';
            document.getElementById('completePickupForm')?.submit();
        }

        // ฟังก์ชันเมื่อพนักงานกด "แก้ไขเบอร์" เพื่อกลับไปแก้หมายเลขโทรศัพท์สมาชิก
        function focusEditMemberPhone() {
            document.getElementById('memberNotFoundWarning')?.classList.add('hidden');
            const phoneInput = document.getElementById('memberPhoneInput');
            if (phoneInput) {
                phoneInput.focus();
                phoneInput.select();
            }
        }

        // ฟังก์ชันเมื่อพนักงานกดปุ่ม "ไม่ได้เป็นสมาชิก / ข้าม"
        function skipPointsAndSubmit() {
            const phoneInput = document.getElementById('memberPhoneInput');
            const forceInput = document.getElementById('forceWithoutMemberInput');
            if (phoneInput) phoneInput.value = '';
            if (forceInput) forceInput.value = 'true';
            document.getElementById('completePickupForm')?.submit();
        }

        // ฟังก์ชันเปิดหน้าต่างยืนยันกรณีลูกค้าไม่มารับสินค้า
        function openConfirmNoShowModal() {
            document.getElementById('noShowValidationMsg')?.classList.add('hidden');
            document.getElementById('confirmNoShowModal')?.classList.remove('hidden');
        }

        // ฟังก์ชันตรวจสอบความครบถ้วนก่อนส่งฟอร์มลูกค้าไม่มารับสินค้า
        function validateNoShowForm(e) {
            return validateReasonModalForm(e, 'noShowReasonSelect', 'noShowReasonRemark', 'noShowValidationMsg', 'กรุณาเลือกสาเหตุที่ไม่มารับสินค้า');
        }

        // ฟังก์ชันเปิดหน้าต่างบันทึกเหตุผลกรณีลูกค้าไม่รับสินค้า
        function openRejectReasonModal() {
            document.getElementById('rejectValidationMsg')?.classList.add('hidden');
            document.getElementById('rejectReasonModal')?.classList.remove('hidden');
        }

        // ฟังก์ชันตรวจสอบความครบถ้วนก่อนส่งฟอร์มลูกค้าไม่รับสินค้า
        function validateRejectForm(e) {
            return validateReasonModalForm(e, 'rejectReasonSelect', 'rejectReasonRemark', 'rejectValidationMsg', 'กรุณาเลือกเหตุผลการปฏิเสธรับสินค้า');
        }

        // ฟังก์ชันเปิดหน้าต่างสำหรับจัดการรายการแลกของรางวัลทั้ง 3 ปุ่ม
        function openRedeemCompleteModal() {
            document.getElementById('redeemCompleteModal')?.classList.remove('hidden');
        }

        function openRedeemNoShowModal() {
            document.getElementById('redeemNoShowValidationMsg')?.classList.add('hidden');
            document.getElementById('redeemNoShowModal')?.classList.remove('hidden');
        }

        function validateRedeemNoShowForm(e) {
            return validateReasonModalForm(e, 'redeemNoShowReasonSelect', 'redeemNoShowReasonRemark', 'redeemNoShowValidationMsg', 'กรุณาเลือกสาเหตุที่ไม่มารับของรางวัล');
        }

        function openRedeemRejectModal() {
            document.getElementById('redeemRejectValidationMsg')?.classList.add('hidden');
            document.getElementById('redeemRejectModal')?.classList.remove('hidden');
        }

        function validateRedeemRejectForm(e) {
            return validateReasonModalForm(e, 'redeemRejectReasonSelect', 'redeemRejectReasonRemark', 'redeemRejectValidationMsg', 'กรุณาเลือกเหตุผลการปฏิเสธรับของรางวัล');
        }

        // ฟังก์ชันปิดหน้าต่างป๊อปอัปทั้งหมด
        function closeAllModals() {
            document.querySelectorAll('[id$="Modal"]').forEach(m => m.classList.add('hidden'));
        }
    </script>
}
