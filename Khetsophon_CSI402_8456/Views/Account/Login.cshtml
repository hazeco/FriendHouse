@* กำหนดโมเดลสำหรับรับค่าอีเมลและรหัสผ่านจากฟอร์มเข้าสู่ระบบ *@
@model Khetsophon_CSI402_8456.ViewModels.LoginViewModel;
@* บล็อก C# ส่วนบนสุดของไฟล์สำหรับกำหนดคอนฟิกข้อความและข้อมูลบัญชีทดสอบ *@
@{
    // กำหนดชื่อหน้าเว็บสำหรับแสดงบนแท็บเบราว์เซอร์
    ViewData["Title"] = "เข้าสู่ระบบ";
    // กำหนด Layout หลักสำหรับหน้าจัดการบัญชีผู้ใช้งาน
    Layout = "_AccountLayout";

    // ประกาศอ็อบเจกต์เก็บข้อความเนื้อหาสำคัญของหน้าเข้าสู่ระบบ (Top-of-file Content Configuration)
    var loginContent = new
    {
        // หัวข้อหลักของหน้าเข้าสู่ระบบ
        Title = "เข้าสู่ระบบ",
        // คำอธิบายย่อยใต้หัวข้อหลัก
        Subtitle = "เข้าสู่ระบบเพื่อสั่งพรีออเดอร์และสะสมแต้ม",
        // หัวข้อกำกับกลุ่มปุ่มเข้าสู่ระบบด่วน
        FastLoginHeading = "เข้าสู่ระบบด่วน (กรอกอีเมล/รหัสผ่านและยืนยันผ่านระบบจริง)"
    };

    // ประกาศรายการบัญชีทดสอบจริงในฐานข้อมูลครบทั้ง 5 บทบาท (ตรวจสอบรหัสผ่านด้วย BCrypt ใน AccountController.Login)
    var fastLoginAccounts = new[]
    {
        // บัญชีทดสอบบทบาทลูกค้าทั่วไป
        new { Key = "customer", Label = "ลูกค้าทั่วไป (Customer View)", Email = "customer@friendhouse.com", Password = "password123", IsFullWidth = true },
        // บัญชีทดสอบบทบาทพนักงานหน้าร้าน
        new { Key = "staff", Label = "พนักงาน (Staff)", Email = "staff@friendhouse.com", Password = "password123", IsFullWidth = false },
        // บัญชีทดสอบบทบาทเจ้าของร้าน
        new { Key = "owner", Label = "เจ้าของร้าน (Owner)", Email = "owner@friendhouse.com", Password = "password123", IsFullWidth = false },
        // บัญชีทดสอบบทบาทเจ้าหน้าที่ไอที
        new { Key = "itsupport", Label = "ไอที (IT Support)", Email = "it@friendhouse.com", Password = "password123", IsFullWidth = false },
        // บัญชีทดสอบบทบาทฝ่ายบัญชีและการเงิน
        new { Key = "accountant", Label = "คนทำบัญชี (Account)", Email = "account@friendhouse.com", Password = "password123", IsFullWidth = false }
    };
}

@* กล่องครอบหลักจัดกึ่งกลางหน้าจอทั้งแนวตั้งและแนวนอน *@
<div class="min-h-dvh flex-1 flex items-center justify-center px-4 py-8 sm:py-12 bg-white">
    @* กล่องจำกัดความกว้างสูงสุดของการ์ดเข้าสู่ระบบ *@
    <div class="w-full max-w-sm">
        @* การ์ดสีขาวขอบมนและเงาสำหรับบรรจุฟอร์มเข้าสู่ระบบ *@
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8">
            @* ส่วนหัวการ์ดแสดงไอคอนแม่กุญแจและชื่อหน้า *@
            <div class="flex flex-col items-center text-center mb-6">
                @* กล่องวงกลมพื้นหลังสีรองสำหรับวางไอคอนแม่กุญแจ *@
                <div class="w-14 h-14 rounded-2xl bg-secondary/30 flex items-center justify-center mb-3">
                    @* ไอคอนรูปแม่กุญแจ SVG *@
                    <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                </div>
                @* หัวข้อหลักของหน้าเข้าสู่ระบบ *@
                <h1 class="text-xl font-bold text-slate">@loginContent.Title</h1>
                @* ข้อความคำอธิบายใต้หัวข้อหลัก *@
                <p class="text-sm text-slate-500 mt-1">@loginContent.Subtitle</p>
            </div>

            @* ตรวจสอบว่ามีข้อความแจ้งเตือนผลสำเร็จจาก TempData หรือไม่ *@
            @if (TempData["SuccessMessage"] != null)
            {
                @* กล่องแจ้งเตือนสีเขียวแสดงข้อความผลสำเร็จ *@
                <div class="mb-4 rounded-xl bg-emerald-50 border border-emerald-200 p-3 text-xs text-emerald-700 font-medium text-center">
                    @* แสดงข้อความผลสำเร็จจาก TempData *@
                    @TempData["SuccessMessage"]
                </div>
            }

            @* ตรวจสอบว่ามีข้อความแจ้งเตือนข้อผิดพลาดจาก TempData หรือไม่ *@
            @if (TempData["ErrorMessage"] != null)
            {
                @* กล่องแจ้งเตือนสีแดงแสดงข้อความข้อผิดพลาด *@
                <div class="mb-4 rounded-xl bg-rose-50 border border-rose-200 p-3 text-xs text-rose-600 font-medium text-center">
                    @* แสดงข้อความข้อผิดพลาดจาก TempData *@
                    @TempData["ErrorMessage"]
                </div>
            }

            @* ตรวจสอบว่ามีข้อความแจ้งเตือนสถานะการล็อกอินจาก ViewBag หรือไม่ *@
            @if (ViewBag.Status != null)
            {
                @* กล่องแจ้งเตือนสีแดงเมื่ออีเมลหรือรหัสผ่านไม่ถูกต้อง *@
                <div class="mb-4 rounded-xl bg-rose-50 border border-rose-200 p-3 text-xs text-rose-600 font-medium text-center">
                    @* แสดงข้อความสถานะจาก ViewBag *@
                    @ViewBag.Status
                </div>
            }

            @* ฟอร์มเข้าสู่ระบบจริง ส่งข้อมูลไปยัง AccountController แอ็กชัน Login พร้อม AntiForgeryToken อัตโนมัติ (ไม่ระบุ method) *@
            <form id="loginForm" class="space-y-4" asp-controller="Account" asp-action="Login">
              @* กล่องครอบช่องกรอกอีเมล *@
              <div>
                @* ป้ายกำกับช่องกรอกอีเมล *@
                <label class="block text-xs font-medium text-slate-700 mb-1.5">อีเมล</label>
                @* กล่องจัดตำแหน่งไอคอนด้านซ้ายของช่องกรอกอีเมล *@
                <div class="relative">
                  @* ไอคอนรูปซองจดหมาย SVG *@
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"></path></svg>
                  @* ช่องกรอกอีเมลผูกกับฟิลด์ Email ของ LoginViewModel *@
                  <input id="loginEmail" asp-for="Email" type="email" placeholder="you@example.com" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                </div>
                @* ข้อความแจ้งเตือน Validation ของฟิลด์ Email *@
                <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
              </div>
              @* กล่องครอบช่องกรอกรหัสผ่าน *@
              <div>
                @* แถวจัดวางป้ายกำกับช่องกรอกรหัสผ่าน *@
                <div class="flex items-center justify-between mb-1.5">
                  @* ป้ายกำกับช่องกรอกรหัสผ่าน *@
                  <label class="block text-xs font-medium text-slate-700">รหัสผ่าน</label>
                </div>
                @* กล่องจัดตำแหน่งไอคอนด้านซ้ายและขวาของช่องกรอกรหัสผ่าน *@
                <div class="relative">
                  @* ไอคอนรูปแม่กุญแจ SVG ด้านซ้าย *@
                  <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                  @* ช่องกรอกรหัสผ่านผูกกับฟิลด์ Password ของ LoginViewModel *@
                  <input id="loginPassword" asp-for="Password" type="password" placeholder="••••••••" class="w-full pl-9 pr-9 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary">
                  @* ไอคอนรูปดวงตา SVG ด้านขวา *@
                  <svg class="cursor-pointer w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </div>
                @* ข้อความแจ้งเตือน Validation ของฟิลด์ Password *@
                <span asp-validation-for="Password" class="text-xs text-rose-500 mt-1 block"></span>
              </div>
              @* แถวตัวเลือกจดจำการเข้าสู่ระบบและลิงก์ลืมรหัสผ่าน *@
              <div class="flex items-center justify-between">
                @* ป้ายกำกับพร้อมช่องทำเครื่องหมายจดจำผู้ใช้งาน *@
                <label class="flex items-center gap-2 text-xs text-slate-500">
                  @* ช่องทำเครื่องหมายจดจำฉันไว้ในเครื่องนี้ *@
                  <input type="checkbox" class="cursor-pointer rounded border-slate-300 text-primary focus:ring-primary/30">
                  @* ข้อความกำกับช่องทำเครื่องหมาย *@
                  <div class="font-medium text-slate-600">จดจำฉันไว้ในเครื่องนี้</div>
                </label>
                @* ลิงก์นำทางไปยังหน้า ResetPassword ใน AccountController *@
                <a asp-controller="Account" asp-action="ResetPassword" class="text-xs text-primary hover:underline">ลืมรหัสผ่าน?</a>
              </div>
              @* ปุ่มกดยืนยันส่งฟอร์มเข้าสู่ระบบจริง *@
              <button id="loginSubmitBtn" type="submit"
                 class="block w-full py-2.5 rounded-xl bg-primary text-white text-center text-sm font-semibold shadow-sm hover:opacity-90 transition cursor-pointer">
                  เข้าสู่ระบบ
              </button>

              @* ส่วนกลุ่มปุ่มเข้าสู่ระบบด่วนแบบปลอดภัย (กรอกอีเมล/รหัสผ่านลงช่องจริงแล้วกดปุ่มเข้าสู่ระบบอัตโนมัติ) *@
              <div class="pt-2 border-t border-slate-100 space-y-2">
                  @* หัวข้อกำกับกลุ่มปุ่มเข้าสู่ระบบด่วน *@
                  <span class="block text-[11px] font-bold text-slate-400 text-center uppercase tracking-wider">@loginContent.FastLoginHeading</span>
                  @* ตารางกริด 2 คอลัมน์จัดเรียงปุ่มแต่ละบทบาท *@
                  <div class="grid grid-cols-2 gap-2">
                      @* วนลูปสร้างปุ่มเข้าสู่ระบบด่วนครบทุกบทบาทจากอาร์เรย์ fastLoginAccounts *@
                      @foreach (var acc in fastLoginAccounts)
                      {
                          // เลือกคลาสสไตล์ปุ่มแบบเต็มความกว้างสำหรับลูกค้า และแบบครึ่งความกว้างสำหรับบทบาทอื่น
                          string btnClass = acc.IsFullWidth
                              ? "col-span-2 flex items-center justify-center gap-2 rounded-xl bg-secondary/25 py-2 px-3 text-xs font-bold text-primary hover:bg-secondary/40 transition-colors cursor-pointer"
                              : "flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white py-2 px-2 text-xs font-bold text-text hover:bg-slate-50 transition-colors cursor-pointer";
                          @* ปุ่มเรียกฟังก์ชัน autoFillAndLogin เพื่อกรอกอีเมล/รหัสผ่านลงช่องแล้วกดส่งฟอร์มจริง *@
                          <button type="button" onclick="autoFillAndLogin('@acc.Email', '@acc.Password')" class="@btnClass">
                              @* ตรวจสอบบทบาทเพื่อแสดงไอคอน SVG ที่ตรงกับบทบาทนั้น *@
                              @if (acc.Key == "customer")
                              {
                                  @* ไอคอนรูปลูกค้า SVG *@
                                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                              }
                              @* กรณีบทบาทพนักงานหน้าร้าน *@
                              else if (acc.Key == "staff")
                              {
                                  @* ไอคอนรูปกระเป๋าทำงาน SVG *@
                                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                              }
                              @* กรณีบทบาทเจ้าของร้าน *@
                              else if (acc.Key == "owner")
                              {
                                  @* ไอคอนรูปดาว SVG *@
                                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                              }
                              @* กรณีบทบาทเจ้าหน้าที่ไอที *@
                              else if (acc.Key == "itsupport")
                              {
                                  @* ไอคอนรูปตารางระบบ SVG *@
                                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                              }
                              @* กรณีบทบาทฝ่ายบัญชีและการเงิน *@
                              else
                              {
                                  @* ไอคอนรูปสัญลักษณ์การเงิน SVG *@
                                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                              }
                              @* แสดงชื่อปุ่มบทบาทผู้ใช้งาน *@
                              <span>@acc.Label</span>
                          </button>
                      }
                  </div>
              </div>

              @* เส้นคั่นแนวนอนพร้อมคำว่า "หรือ" *@
              <div class="flex items-center gap-3 my-4">
                  @* เส้นคั่นฝั่งซ้าย *@
                  <div class="h-px flex-1 bg-slate-200"></div>
                  @* ข้อความคั่นตรงกลาง *@
                  <span class="text-[11px] text-slate-400">หรือ</span>
                  @* เส้นคั่นฝั่งขวา *@
                  <div class="h-px flex-1 bg-slate-200"></div>
              </div>

              @* ข้อความและลิงก์สำหรับสมัครสมาชิกใหม่ *@
              <p class="text-center text-xs text-slate-500">
                ยังไม่มีบัญชีสมาชิก?
                @* ลิงก์นำทางไปยังหน้า Register ใน AccountController *@
                <a asp-controller="Account" asp-action="Register" class="text-primary font-bold hover:underline">สมัครสมาชิกใหม่</a>
              </p>
            </form>
        </div>
    </div>
</div>

@* บล็อกสคริปต์ JavaScript สำหรับกรอกอีเมล/รหัสผ่านลงช่องฟอร์มจริงแล้วกดปุ่มเข้าสู่ระบบอัตโนมัติ (ไม่ใช้ AJAX) *@
<script>
    // ฟังก์ชันรับค่าอีเมลและรหัสผ่านมากรอกลงในช่อง input จริง แล้วสั่งคลิกปุ่มเข้าสู่ระบบ
    function autoFillAndLogin(email, password) {
        // กรอกค่าอีเมลลงในช่อง input อีเมลจริง
        document.getElementById('loginEmail').value = email;
        // กรอกค่ารหัสผ่านลงในช่อง input รหัสผ่านจริง
        document.getElementById('loginPassword').value = password;
        // หน่วงเวลา 150 มิลลิวินาทีให้เห็นค่าที่กรอกในช่อง แล้วสั่งกดปุ่มเข้าสู่ระบบเพื่อส่ง POST ฟอร์มจริง
        setTimeout(function () {
            // สั่งคลิกปุ่ม submit ของฟอร์มเข้าสู่ระบบเพื่อให้เบราว์เซอร์ส่ง POST พร้อม AntiForgeryToken
            document.getElementById('loginSubmitBtn').click();
        }, 150);
    }
</script>
