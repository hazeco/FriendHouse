@* กำหนดโมเดลข้อมูลโปรไฟล์ผู้ใช้งานของระบบ *@
@model Khetsophon_CSI402_8456.ViewModels.UserProfileViewModel
@* ประกาศและกำหนดค่าข้อมูลโปรไฟล์และอ็อบเจกต์เนื้อหาส่วนบนของไฟล์ *@
@{
    // กำหนดชื่อหัวข้อของหน้าโปรไฟล์
    ViewData["Title"] = "โปรไฟล์ของฉัน — FriendHouse";

    // กำหนดค่าข้อมูลโปรไฟล์สมาชิกเริ่มต้นไว้ที่ส่วนบนสุดของไฟล์ตามมาตรฐานโครงการ
    var defaultUser = new {
        // ชื่อที่แสดงผลของสมาชิก
        Name = Model?.DisplayName ?? "สมาชิก FriendHouse",
        // อักษรย่อตัวแรกของชื่อสมาชิก
        Initial = Model?.Initial ?? "F",
        // ที่อยู่อีเมลของสมาชิก
        Email = Model?.Email ?? "customer@friendhouse.local",
        // เบอร์โทรศัพท์ติดต่อของสมาชิก
        Phone = Model?.Phone ?? "081-234-5678",
        // คะแนนสะสมของสมาชิกที่จัดรูปแบบแล้ว
        Points = Model?.PointsFormatted ?? "0 แต้ม",
        // ข้อความแจ้งเตือนจำนวนรายการพรีออเดอร์ที่ค้างอยู่
        PendingOrders = Model?.PendingOrderNotice ?? "คุณมีพรีออเดอร์ที่รอดำเนินการอยู่ 0 รายการ"
    };
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 bg-white">
    @* แถบนำทางแสดงเส้นทางหน้าเว็บ (Breadcrumb) *@
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium mb-8" aria-label="แถบนำทาง">
        @* ลิงก์นำทางเชื่อมโยงไปยังหน้าแรก *@
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors">หน้าแรก</a>
        @* สัญลักษณ์แบ่งคั่นเส้นทาง *@
        <span>/</span>
        @* ป้ายกำกับชื่อหน้าปัจจุบันโปรไฟล์ของฉัน *@
        <span class="text-text font-semibold">โปรไฟล์ของฉัน</span>
    </nav>

    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลข้อความแจ้งเตือนสำเร็จ *@
    @if (TempData["SuccessMessage"] != null) {
        @* กล่องแสดงผลข้อความแจ้งเตือนการทำงานสำเร็จ *@
        <div class="mx-auto max-w-[576px] mb-5 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2 shadow-xs">
            @* ไอคอนเครื่องหมายถูก SVG สีเขียว *@
            <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            @* ข้อความแจ้งผลลัพธ์สำเร็จ *@
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลข้อความแจ้งเตือนข้อผิดพลาด *@
    @if (TempData["ErrorMessage"] != null) {
        @* กล่องแสดงผลข้อความแจ้งเตือนข้อผิดพลาด *@
        <div class="mx-auto max-w-[576px] mb-5 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2 shadow-xs">
            @* ไอคอนเครื่องหมายตกใจ SVG สีแดง *@
            <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            @* ข้อความแจ้งผลลัพธ์ข้อผิดพลาด *@
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @* เลย์เอาต์จัดกึ่งกลางสำหรับการแสดงผลโปรไฟล์ความกว้าง 576 พิกเซล *@
    <div class="mx-auto max-w-[576px] space-y-5">
        @* ส่วนหัวการ์ดโปรไฟล์แสดงรูปโปรไฟล์และชื่อสมาชิก *@
        <div class="flex items-center justify-between gap-4">
            @* กล่องจัดวางองค์ประกอบโปรไฟล์และชื่อผู้ใช้ *@
            <div class="flex items-center gap-4">
                @* วงกลมแสดงตัวอักษรย่อชื่อสมาชิกแทนรูปโปรไฟล์ *@
                <div class="flex size-16 items-center justify-center rounded-full border-2 border-primary/20 bg-primary/10 text-xl font-bold text-primary shadow-sm shrink-0">
                    @* ข้อความแสดงตัวอักษรย่อตัวแรกของชื่อสมาชิก *@
                    <span>@defaultUser.Initial</span>
                </div>

                @* กล่องข้อความแสดงชื่อสมาชิกและคำอธิบาย *@
                <div>
                    @* หัวข้อหลักแสดงชื่อจริงของสมาชิก *@
                    <h1 class="text-xl sm:text-2xl font-bold text-text flex items-center gap-2">
                        @* ข้อความชื่อสมาชิกที่แสดงผล *@
                        <span id="userNameDisplay">@defaultUser.Name</span>
                    </h1>
                    @* ข้อความอธิบายสถานะข้อมูลบัญชีสมาชิก *@
                    <p class="text-xs text-slate-500 mt-0.5">ข้อมูลบัญชีสมาชิก FriendHouse</p>
                </div>
            </div>

            @* ปุ่มเปิดหน้าต่างแก้ไขข้อมูลโปรไฟล์ *@
            <button type="button" id="btn-open-edit-profile" class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-text shadow-2xs hover:border-primary/40 hover:bg-slate-50 transition-colors cursor-pointer">
                @* ไอคอนรูปดินสอแก้ไข SVG *@
                <svg class="size-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                @* ข้อความบนปุ่มแก้ไขข้อมูล *@
                <span>แก้ไขข้อมูล</span>
            </button>
        </div>

        @* แถบสีเหลืองแจ้งเตือนรายการพรีออเดอร์ที่รอดำเนินการ *@
        <div class="flex items-center justify-between rounded-xl border border-[#FDE8B0] bg-[#FFFBE8] px-4 py-3 text-xs text-[#995204] shadow-2xs">
            @* กล่องจัดวางไอคอนและข้อความแจ้งเตือนรายการพรีออเดอร์ *@
            <div class="flex items-center gap-2 font-medium">
                @* ไอคอนรถส่งของ SVG สำหรับสถานะพรีออเดอร์ *@
                <svg class="size-4 shrink-0 text-[#995204]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                @* ข้อความแจ้งจำนวนรายการพรีออเดอร์ที่ค้างอยู่ *@
                <span>@defaultUser.PendingOrders</span>
            </div>
            @* ลิงก์นำทางไปยังหน้าตรวจสอบสถานะพรีออเดอร์ *@
            <a asp-controller="Home" asp-action="PreorderStatus" class="inline-flex items-center gap-1 shrink-0 font-semibold hover:underline">
                @* ข้อความปุ่มดูสถานะ *@
                <span>ดูสถานะ</span>
                @* ไอคอนลูกศรชี้ขวา SVG *@
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
        </div>

        @* การ์ดแสดงข้อมูลรายละเอียดของสมาชิก *@
        <div class="rounded-2xl border border-slate-200/80 bg-white shadow-xs overflow-hidden">
            @* แถวที่ 1 แสดงข้อมูลอีเมลของสมาชิก *@
            <div class="flex items-center gap-4 px-5 py-4">
                @* กล่องวงกลมบรรจุไอคอนอีเมล *@
                <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    @* ไอคอนซองจดหมาย SVG *@
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                @* กล่องข้อความแสดงหัวข้อและที่อยู่อีเมล *@
                <div class="min-w-0 flex-1">
                    @* ป้ายระบุประเภทข้อมูลอีเมล *@
                    <span class="block text-[11px] text-slate-400 font-medium">อีเมล</span>
                    @* ข้อความที่อยู่อีเมลของสมาชิก *@
                    <span id="userEmailDisplay" class="text-sm font-semibold text-text truncate">@defaultUser.Email</span>
                </div>
            </div>

            @* เส้นแบ่งคั่นแนวนอนระหว่างแถว *@
            <div class="h-px w-full bg-slate-100"></div>

            @* แถวที่ 2 แสดงข้อมูลเบอร์โทรศัพท์ของสมาชิก *@
            <div class="flex items-center gap-4 px-5 py-4">
                @* กล่องวงกลมบรรจุไอคอนเบอร์โทรศัพท์ *@
                <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    @* ไอคอนหูโทรศัพท์ SVG *@
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                @* กล่องข้อความแสดงหัวข้อและเบอร์โทรศัพท์ *@
                <div class="min-w-0 flex-1">
                    @* ป้ายระบุประเภทข้อมูลเบอร์โทรศัพท์ *@
                    <span class="block text-[11px] text-slate-400 font-medium">เบอร์โทรศัพท์</span>
                    @* ข้อความเบอร์โทรศัพท์ติดต่อของสมาชิก *@
                    <span id="userPhoneDisplay" class="text-sm font-semibold text-text">@defaultUser.Phone</span>
                </div>
            </div>

            @* เส้นแบ่งคั่นแนวนอนระหว่างแถว *@
            <div class="h-px w-full bg-slate-100"></div>

            @* แถวที่ 3 แสดงข้อมูลแต้มสะสมและปุ่มแลกแต้ม *@
            <div class="flex items-center justify-between gap-4 px-5 py-4">
                @* กล่องจัดวางไอคอนและตัวเลขแต้มสะสม *@
                <div class="flex items-center gap-4">
                    @* กล่องวงกลมบรรจุไอคอนดาวแต้มสะสม *@
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-amber-500/15 text-amber-600">
                        @* ไอคอนรูปดาว SVG สำหรับคะแนนสะสม *@
                        <svg class="size-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                    </div>
                    @* กล่องข้อความป้ายกำกับและจำนวนแต้ม *@
                    <div>
                        @* ป้ายระบุประเภทข้อมูลแต้มสะสม *@
                        <span class="block text-[11px] text-slate-400 font-medium">แต้มสะสม</span>
                        @* ข้อความตัวเลขแต้มสะสมของสมาชิก *@
                        <span class="text-sm font-semibold text-text">@defaultUser.Points</span>
                    </div>
                </div>

                @* ลิงก์นำทางไปยังหน้ารายการแลกของรางวัล *@
                <a asp-controller="Home" asp-action="Rewards" class="rounded-lg bg-accent px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:opacity-90 transition-opacity cursor-pointer">แลกแต้ม</a>
            </div>
        </div>

        @* การ์ดรวมเมนูทางลัดสำหรับจัดการบัญชี *@
        <div class="rounded-2xl border border-slate-200/80 bg-white shadow-xs overflow-hidden">
            @* เมนูทางลัดที่ 1 เปลี่ยนรหัสผ่าน *@
            <a asp-controller="Account" asp-action="ResetPassword" class="flex items-center justify-between px-5 py-4 text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer group">
                @* กล่องจัดวางไอคอนและข้อความลิงก์เปลี่ยนรหัสผ่าน *@
                <div class="flex items-center gap-3">
                    @* ไอคอนแม่กุญแจ SVG สื่อถึงความปลอดภัย *@
                    <svg class="size-4 text-slate-400 group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    @* ข้อความลิงก์เปลี่ยนรหัสผ่าน *@
                    <span class="text-sm font-medium text-text group-hover:text-primary transition-colors">เปลี่ยนรหัสผ่าน</span>
                </div>
                @* ไอคอนลูกศรชี้ขวา SVG *@
                <svg class="size-4 text-slate-300 group-hover:text-primary group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>

            @* เส้นแบ่งคั่นแนวนอนระหว่างแถวลิงก์ *@
            <div class="h-px w-full bg-slate-100"></div>

            @* เมนูทางลัดที่ 2 รายการพรีออเดอร์ของฉัน *@
            <a asp-controller="Home" asp-action="PreorderStatus" class="flex items-center justify-between px-5 py-4 text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer group">
                @* กล่องจัดวางไอคอนและข้อความลิงก์พรีออเดอร์ของฉัน *@
                <div class="flex items-center gap-3">
                    @* ไอคอนกล่องพัสดุ SVG สื่อถึงการส่งมอบสินค้า *@
                    <svg class="size-4 text-slate-400 group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    @* ข้อความลิงก์พรีออเดอร์ของฉัน *@
                    <span class="text-sm font-medium text-text group-hover:text-primary transition-colors">พรีออเดอร์ของฉัน</span>
                </div>
                @* ไอคอนลูกศรชี้ขวา SVG *@
                <svg class="size-4 text-slate-300 group-hover:text-primary group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>

            @* เส้นแบ่งคั่นแนวนอนระหว่างแถวลิงก์ *@
            <div class="h-px w-full bg-slate-100"></div>

            @* เมนูทางลัดที่ 3 ปุ่มเปิดหน้าต่างยืนยันการลบบัญชี *@
            <button type="button" id="btn-open-delete-account" class="w-full flex items-center justify-between px-5 py-4 text-rose-600 hover:bg-rose-50/60 transition-colors cursor-pointer group text-left">
                @* กล่องจัดวางไอคอนและข้อความขอลบบัญชี *@
                <div class="flex items-center gap-3">
                    @* ไอคอนถังขยะ SVG สื่อถึงการลบบัญชี *@
                    <svg class="size-4 text-rose-400 group-hover:text-rose-600 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    @* ข้อความปุ่มลบบัญชีผู้ใช้งาน *@
                    <span class="text-sm font-medium text-rose-600">ลบบัญชีผู้ใช้งาน</span>
                </div>
                @* ไอคอนลูกศรชี้ขวา SVG สีแดง *@
                <svg class="size-4 text-rose-300 group-hover:text-rose-600 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>

        @* ปุ่มออกจากระบบบัญชีสมาชิก *@
        <a asp-controller="Account" asp-action="Logout" class="block w-full rounded-xl border border-red-300 bg-white py-3 text-center text-sm font-semibold text-red-500 shadow-2xs hover:bg-red-50 transition-colors cursor-pointer">ออกจากระบบ</a>
    </div>
</div>

@* หน้าต่างโมดัลแก้ไขข้อมูลโปรไฟล์สมาชิก *@
<div id="edit-profile-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4 backdrop-blur-xs">
    @* กล่องจัดวางเนื้อหาหน้าต่างโมดัลแก้ไขโปรไฟล์ *@
    <div class="relative w-full max-w-md rounded-2xl bg-white p-6 shadow-xl space-y-4">
        @* แถบส่วนหัวของหน้าต่างโมดัลแก้ไขโปรไฟล์ *@
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            @* หัวข้อของหน้าต่างแก้ไขข้อมูลโปรไฟล์ *@
            <h3 class="text-base font-bold text-text">แก้ไขข้อมูลโปรไฟล์</h3>
            @* ปุ่มปิดหน้าต่างโมดัลแก้ไขโปรไฟล์ *@
            <button type="button" id="btn-close-edit-modal" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        </div>

        @* ฟอร์มแก้ไขข้อมูลส่วนตัวของสมาชิก (ชื่อ-นามสกุล และเบอร์โทรศัพท์) ไม่ใส่ method attribute ตามกฎโปรเจกต์ *@
        <form asp-controller="Account" asp-action="UpdateProfile" class="space-y-4">
            @* กลุ่มช่องกรอกข้อมูลชื่อและนามสกุล *@
            <div>
                @* ป้ายชื่อกำกับช่องกรอกข้อมูลชื่อ-นามสกุล *@
                <label for="editFullName" class="block text-xs font-semibold text-slate-700 mb-1">ชื่อ-นามสกุล</label>
                @* ช่องกรอกข้อมูลสำหรับรับค่าชื่อ-นามสกุล *@
                <input type="text" id="editFullName" asp-for="FullName" required class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-text focus:border-primary focus:outline-none" />
            </div>

            @* กลุ่มช่องกรอกข้อมูลอีเมล (ปิดใช้งานการแก้ไข) *@
            <div>
                @* ป้ายชื่อกำกับช่องแสดงอีเมล *@
                <label for="editEmail" class="block text-xs font-semibold text-slate-700 mb-1">อีเมล</label>
                @* ช่องแสดงข้อมูลอีเมลที่ไม่สามารถแก้ไขได้ *@
                <input type="email" id="editEmail" value="@defaultUser.Email" disabled class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-500 focus:outline-none cursor-not-allowed" />
            </div>

            @* กลุ่มช่องกรอกข้อมูลเบอร์โทรศัพท์ *@
            <div>
                @* ป้ายชื่อกำกับช่องกรอกเบอร์โทรศัพท์ *@
                <label for="editPhone" class="block text-xs font-semibold text-slate-700 mb-1">เบอร์โทรศัพท์</label>
                @* ช่องกรอกข้อมูลเบอร์โทรศัพท์ติดต่อ *@
                <input type="tel" id="editPhone" asp-for="Phone" required class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-text focus:border-primary focus:outline-none" />
            </div>

            @* กล่องปุ่มควบคุมการบันทึกหรือยกเลิกการแก้ไขโปรไฟล์ *@
            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                @* ปุ่มกดยกเลิกการแก้ไขโปรไฟล์ *@
                <button type="button" id="btn-cancel-edit" class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer">ยกเลิก</button>
                @* ปุ่มกดยืนยันบันทึกการแก้ไขโปรไฟล์ *@
                <button type="submit" class="rounded-xl bg-primary px-5 py-2 text-xs font-bold text-white shadow-xs hover:opacity-90 cursor-pointer">บันทึกข้อมูล</button>
            </div>
        </form>
    </div>
</div>

@* หน้าต่างโมดัลยืนยันการขอลบบัญชีผู้ใช้งาน *@
<div id="delete-account-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4 backdrop-blur-xs">
    @* กล่องจัดวางเนื้อหาหน้าต่างยืนยันการลบบัญชี *@
    <div class="relative w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl space-y-4 text-center">
        @* กล่องวงกลมสีแดงบรรจุไอคอนถังขยะเตือนภัย *@
        <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-rose-100 text-rose-600">
            @* ไอคอนรูปถังขยะ SVG สีแดงเตือนภัย *@
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        </div>
        @* กล่องข้อความแจ้งเตือนผลกระทบของการลบบัญชี *@
        <div>
            @* หัวข้อยืนยันการลบบัญชีผู้ใช้งาน *@
            <h3 class="text-base font-bold text-text">ยืนยันการลบบัญชีผู้ใช้งาน</h3>
            @* คำอธิบายผลกระทบที่จะเกิดขึ้นเมื่อยืนยันลบบัญชี *@
            <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">คุณแน่ใจหรือไม่ว่าต้องการลบบัญชีสมาชิก <span class="font-semibold text-text">@defaultUser.Email</span>? บัญชีของคุณจะถูกระงับการใช้งานและออกจากระบบทันที</p>
        </div>
        @* ฟอร์มยืนยันการลบบัญชี ส่งไปยัง AccountController.DeleteAccount ไม่ใส่ method attribute *@
        <form asp-controller="Account" asp-action="DeleteAccount" class="flex items-center gap-2 pt-2">
            @* ปุ่มกดยกเลิกการลบบัญชี *@
            <button type="button" id="btn-cancel-delete-account" class="flex-1 rounded-xl border border-slate-200 bg-white py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer">ยกเลิก</button>
            @* ปุ่มกดยืนยันการลบบัญชีผู้ใช้งาน *@
            <button type="submit" class="flex-1 rounded-xl bg-rose-600 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-rose-700 cursor-pointer">ยืนยันลบบัญชี</button>
        </form>
    </div>
</div>

@* ส่วนเซกชันสคริปต์สำหรับการจัดการการทำงานหน้าโปรไฟล์ *@
@section Scripts {
@* บล็อกสคริปต์ JavaScript สำหรับควบคุมการโต้ตอบหน้าต่างโมดัลฝั่งไคลเอนต์ *@
<script>
    // ตัวดักจับเหตุการณ์โหลดโครงสร้าง DOM สมบูรณ์
    document.addEventListener('DOMContentLoaded', function () {
        // อ้างอิงอิลิเมนต์หน้าต่างโมดัลแก้ไขโปรไฟล์
        var modal = document.getElementById('edit-profile-modal');
        // อ้างอิงปุ่มเปิดหน้าต่างแก้ไขโปรไฟล์
        var openBtn = document.getElementById('btn-open-edit-profile');
        // อ้างอิงปุ่มกากบาทปิดหน้าต่างแก้ไขโปรไฟล์
        var closeBtn = document.getElementById('btn-close-edit-modal');
        // อ้างอิงปุ่มกดยกเลิกการแก้ไขโปรไฟล์
        var cancelBtn = document.getElementById('btn-cancel-edit');

        // อ้างอิงอิลิเมนต์หน้าต่างโมดัลยืนยันลบบัญชี
        var deleteModal = document.getElementById('delete-account-modal');
        // อ้างอิงปุ่มเปิดหน้าต่างยืนยันการลบบัญชี
        var openDeleteBtn = document.getElementById('btn-open-delete-account');
        // อ้างอิงปุ่มกดยกเลิกการลบบัญชี
        var cancelDeleteBtn = document.getElementById('btn-cancel-delete-account');

        // ฟังก์ชันเปิดหน้าต่างโมดัลแก้ไขโปรไฟล์
        function openModal() {
            // ถอดคลาสซ่อนออกเพื่อแสดงหน้าต่างโมดัล
            modal.classList.remove('hidden');
            // เพิ่มคลาสการจัดวางแบบ Flexbox
            modal.classList.add('flex');
        }

        // ฟังก์ชันปิดหน้าต่างโมดัลแก้ไขโปรไฟล์
        function closeModal() {
            // เพิ่มคลาสซ่อนหน้าต่างโมดัล
            modal.classList.add('hidden');
            // ถอดคลาส Flexbox ออก
            modal.classList.remove('flex');
        }

        // ฟังก์ชันเปิดหน้าต่างโมดัลยืนยันการลบบัญชี
        function openDeleteModal() {
            // ตรวจสอบความถูกต้องของอิลิเมนต์หน้าต่างลบบัญชีก่อนดำเนินการ
            if (deleteModal) {
                // ถอดคลาสซ่อนหน้าต่างออก
                deleteModal.classList.remove('hidden');
                // เพิ่มคลาสจัดวาง Flexbox เพื่อแสดงผลตรงกลาง
                deleteModal.classList.add('flex');
            }
        }

        // ฟังก์ชันปิดหน้าต่างโมดัลยืนยันการลบบัญชี
        function closeDeleteModal() {
            // ตรวจสอบความถูกต้องของอิลิเมนต์หน้าต่างลบบัญชี
            if (deleteModal) {
                // เพิ่มคลาสซ่อนหน้าต่างกลับคืน
                deleteModal.classList.add('hidden');
                // ถอดคลาสจัดวาง Flexbox ออก
                deleteModal.classList.remove('flex');
            }
        }

        // เชื่อมโยงเหตุการณ์คลิกปุ่มเปิดโมดัลแก้ไขข้อมูล
        if (openBtn) { openBtn.addEventListener('click', openModal); }
        // เชื่อมโยงเหตุการณ์คลิกปุ่มกากบาทปิดโมดัลแก้ไข
        if (closeBtn) { closeBtn.addEventListener('click', closeModal); }
        // เชื่อมโยงเหตุการณ์คลิกปุ่มยกเลิกแก้ไขโปรไฟล์
        if (cancelBtn) { cancelBtn.addEventListener('click', closeModal); }

        // เชื่อมโยงเหตุการณ์คลิกปุ่มเปิดโมดัลยืนยันการลบบัญชี
        if (openDeleteBtn) { openDeleteBtn.addEventListener('click', openDeleteModal); }
        // เชื่อมโยงเหตุการณ์คลิกปุ่มยกเลิกการลบบัญชี
        if (cancelDeleteBtn) { cancelDeleteBtn.addEventListener('click', closeDeleteModal); }
    });
</script>
}