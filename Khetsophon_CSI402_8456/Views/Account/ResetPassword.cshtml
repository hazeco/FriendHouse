@model Khetsophon_CSI402_8456.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "เปลี่ยนรหัสผ่าน — FriendHouse";
    Layout = "_AccountLayout";

    // Top-of-file Media & Content Configuration
    var pageContent = new {
        Title = "เปลี่ยนรหัสผ่าน",
        Subtitle = "กรอกข้อมูลให้ถูกต้องเพื่อเปลี่ยนรหัสผ่านสำหรับบัญชีสมาชิก FriendHouse",
        CancelUrl = "/Account/Profile",
        Guidelines = new[] {
            "ความยาวอย่างน้อย 6 ตัวอักษร",
            "ควรมีตัวอักษรและตัวเลขผสมกัน",
            "ไม่ควรซ้ำกับรหัสผ่านเดิม"
        }
    };
}

<div class="min-h-dvh flex-1 flex items-center justify-center px-4 py-8 sm:py-12 bg-white">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-7 sm:p-8">
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0110 0v4"></path>
                    </svg>
                </div>
                <h1 class="text-xl font-bold text-slate">@pageContent.Title</h1>
                <p class="text-sm text-slate-500 mt-1">@pageContent.Subtitle</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2 shadow-xs">
                    <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-4 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2 shadow-xs">
                    <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @* ฟอร์มเปลี่ยนรหัสผ่าน ส่งข้อมูลไปยัง AccountController แอ็กชัน ResetPassword (ไม่มีแอตทริบิวต์ method ตามกฎ) *@
            <form class="space-y-4" asp-controller="Account" asp-action="ResetPassword">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-xs text-rose-500 font-semibold mb-2"></div>

                <!-- Current Password -->
                <div>
                    <label asp-for="CurrentPassword" class="block text-xs font-medium text-slate-700 mb-1.5"></label>
                    <div class="relative">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0110 0v4"></path>
                        </svg>
                        <input asp-for="CurrentPassword" type="password" placeholder="••••••••"
                               class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-xs text-rose-500 font-medium mt-1 block"></span>
                </div>

                <!-- New Password -->
                <div>
                    <label asp-for="NewPassword" class="block text-xs font-medium text-slate-700 mb-1.5"></label>
                    <div class="relative">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0110 0v4"></path>
                        </svg>
                        <input asp-for="NewPassword" type="password" placeholder="อย่างน้อย 6 ตัวอักษร"
                               class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-xs text-rose-500 font-medium mt-1 block"></span>
                </div>

                <!-- Confirm New Password -->
                <div>
                    <label asp-for="ConfirmNewPassword" class="block text-xs font-medium text-slate-700 mb-1.5"></label>
                    <div class="relative">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0110 0v4"></path>
                        </svg>
                        <input asp-for="ConfirmNewPassword" type="password" placeholder="พิมพ์รหัสผ่านใหม่อีกครั้ง"
                               class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate placeholder:text-slate/30 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-xs text-rose-500 font-medium mt-1 block"></span>
                </div>

                <!-- Password Guidelines -->
                <div class="bg-slate-50/80 rounded-xl p-3.5 space-y-1 border border-slate-100">
                    @foreach (var guide in pageContent.Guidelines)
                    {
                        <div class="text-xs text-slate-500">• @guide</div>
                    }
                </div>

                <!-- Actions -->
                <div class="flex items-center gap-3 pt-2">
                    <a asp-controller="Account" asp-action="Profile" class="cursor-pointer flex-1 py-2.5 text-center rounded-xl border border-slate-300 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-50 transition">ยกเลิก</a>
                    <button type="submit" class="cursor-pointer flex-1 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold shadow-sm hover:opacity-90 transition">บันทึกรหัสผ่านใหม่</button>
                </div>
            </form>
        </div>
    </div>
</div>
