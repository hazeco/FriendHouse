@* กำหนดโมเดลข้อมูลสำหรับหน้าลืมรหัสผ่าน *@
@model Khetsophon_CSI402_8456.ViewModels.ForgotPasswordViewModel
@* กำหนดค่าเริ่มต้นและคอนฟิกข้อความสำหรับหน้าลืมรหัสผ่าน *@
@{
    // กำหนดชื่อหน้าเว็บและโครงร่างหน้าบัญชีผู้ใช้
    ViewData["Title"] = "ลืมรหัสผ่าน — FriendHouse";
    // กำหนดเค้าโครงหลักสำหรับหน้าบัญชี
    Layout = "_AccountLayout";

    // การตั้งค่าข้อความและคำแนะนำสำหรับหน้ากู้คืนรหัสผ่านไว้ที่ส่วนบนสุดของไฟล์ตามกฎโปรเจกต์
    var pageContent = new {
        // หัวข้อหลักของหน้ากู้คืนรหัสผ่าน
        Title = "กู้คืนรหัสผ่านบัญชีผู้ใช้",
        // คำอธิบายขั้นตอนการกู้คืนรหัสผ่าน
        Subtitle = "ยืนยันที่อยู่อีเมลและเบอร์โทรศัพท์ที่ลงทะเบียนไว้เพื่อรับรหัสยืนยัน 6 หลักสำหรับตั้งรหัสผ่านใหม่ทันที",
        // ป้ายกำกับขั้นตอนที่ 1
        Step1Badge = "ขั้นตอนที่ 1: ยืนยันอีเมลและเบอร์โทรศัพท์",
        // ป้ายกำกับขั้นตอนที่ 2
        Step2Badge = "ขั้นตอนที่ 2: คัดลอกรหัสยืนยันและตั้งรหัสผ่านใหม่",
        // ข้อความปุ่มตรวจสอบและรับรหัสยืนยัน
        VerifyButtonText = "ตรวจสอบและรับรหัสยืนยัน 6 หลัก",
        // ข้อความปุ่มคัดลอกและกรอกรหัสอัตโนมัติ
        CopyAndFillText = "คัดลอกและกรอกรหัสอัตโนมัติ",
        // ข้อความปุ่มเมื่อคัดลอกและกรอกเสร็จแล้ว
        CopiedAndFilledText = "คัดลอกและกรอกรหัสแล้ว",
        // ข้อความปุ่มบันทึกรหัสผ่านใหม่
        SavePasswordButtonText = "บันทึกรหัสผ่านใหม่",
        // ข้อความลิงก์กลับไปหน้าเข้าสู่ระบบ
        BackToLoginText = "กลับไปหน้าเข้าสู่ระบบ",
        // ข้อความปุ่มเปลี่ยนอีเมลหรือเบอร์โทร
        StartOverText = "เปลี่ยนอีเมลหรือเบอร์โทรศัพท์",
        // หัวข้อกล่องข้อมูลบัญชีตัวอย่าง
        DemoHintTitle = "ข้อมูลบัญชีตัวอย่างสำหรับทดสอบกู้คืนรหัสผ่าน",
        // อีเมลบัญชีตัวอย่างสำหรับการทดสอบ
        DemoEmail = "customer@friendhouse.com",
        // เบอร์โทรศัพท์บัญชีตัวอย่างสำหรับการทดสอบ
        DemoPhone = "081-234-5678",
        // ข้อความปุ่มกรอกข้อมูลตัวอย่างอัตโนมัติ
        FillDemoBtnText = "กรอกข้อมูลตัวอย่างอัตโนมัติ"
    };
}

@* พื้นที่หลักจัดวางการ์ดกู้คืนรหัสผ่านให้อยู่กึ่งกลางหน้าจอ *@
<div class="min-h-dvh flex-1 flex items-center justify-center px-4 py-8 sm:py-12 bg-white">
    @* กล่องคอนเทนเนอร์ความกว้างสูงสุดสำหรับแบบฟอร์มกู้คืนรหัสผ่าน *@
    <div class="w-full max-w-md">
        @* การ์ดหลักแสดงแบบฟอร์มกู้คืนรหัสผ่าน *@
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 sm:p-8 space-y-5">
            @* ส่วนหัวของการ์ด แสดงไอคอนกุญแจและคำอธิบาย *@
            <div class="flex flex-col items-center text-center">
                @* กล่องไอคอนแม่กุญแจกู้คืนรหัสผ่าน *@
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-3">
                    @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                    <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                </div>
                @* หัวข้อหลักของหน้ากู้คืนรหัสผ่าน *@
                <h1 class="text-xl font-bold text-text">@pageContent.Title</h1>
                @* คำอธิบายขั้นตอนการกู้คืนรหัสผ่าน *@
                <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">@pageContent.Subtitle</p>
            </div>

            @* แถบแจ้งเตือนข้อผิดพลาดหากข้อมูลไม่ตรงกันหรือรหัสไม่ถูกต้อง *@
            @if (TempData["ErrorMessage"] != null) {
                @* กล่องแจ้งเตือนสีแดงสำหรับข้อผิดพลาด *@
                <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2 shadow-xs">
                    @* ไอคอนแจ้งเตือน SVG *@
                    <svg class="size-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    @* ข้อความแจ้งเตือนข้อผิดพลาด *@
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            @* แถบแจ้งเตือนความสำเร็จเมื่อสร้างรหัสยืนยัน 6 หลักเรียบร้อย *@
            @if (TempData["SuccessMessage"] != null) {
                @* กล่องแจ้งเตือนสีเขียวสำหรับผลสำเร็จ *@
                <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2 shadow-xs">
                    @* ไอคอนเครื่องหมายถูก SVG *@
                    <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    @* ข้อความแจ้งเตือนความสำเร็จ *@
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @* ตรวจสอบว่าอยู่ในขั้นตอนที่ 1 (ยืนยันตัวตน) หรือขั้นตอนที่ 2 (รับโค้ดและตั้งรหัสผ่านใหม่) *@
            @if (!Model.IsCodeGenerated) {
                @* ป้ายบอกสถานะขั้นตอนที่ 1 *@
                <div class="rounded-xl bg-slate-50 border border-slate-200/80 px-3.5 py-2.5 flex items-center justify-between gap-2">
                    @* ข้อความระบุขั้นตอนที่ 1 *@
                    <span class="text-xs font-bold text-primary">@pageContent.Step1Badge</span>
                    @* ปุ่มกรอกข้อมูลตัวอย่างอัตโนมัติเพื่อความสะดวกในการทดสอบ *@
                    <button type="button" onclick="fillDemoForgotAccount()" class="text-[11px] font-semibold text-primary hover:underline cursor-pointer">@pageContent.FillDemoBtnText</button>
                </div>

                @* แบบฟอร์มขั้นตอนที่ 1: ตรวจสอบอีเมลและเบอร์โทรศัพท์ (ไม่มีแอตทริบิวต์ method ตามกฎโปรเจกต์) *@
                <form class="space-y-4" asp-controller="Account" asp-action="GenerateResetCode">
                    @* โทเค็นความปลอดภัยป้องกันการปลอมแปลงคำขอ (CSRF) *@
                    @Html.AntiForgeryToken()

                    @* ช่องกรอกที่อยู่อีเมลที่ลงทะเบียนไว้ *@
                    <div>
                        @* ป้ายกำกับช่องกรอกอีเมล *@
                        <label asp-for="Email" class="block text-xs font-semibold text-slate-700 mb-1.5"></label>
                        @* ช่องรับค่าอีเมล *@
                        <input asp-for="Email" id="forgotEmailInput" type="email" required placeholder="customer@friendhouse.com" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>

                    @* ช่องกรอกเบอร์โทรศัพท์ที่ลงทะเบียนไว้ *@
                    <div>
                        @* ป้ายกำกับช่องกรอกเบอร์โทรศัพท์ *@
                        <label asp-for="Phone" class="block text-xs font-semibold text-slate-700 mb-1.5"></label>
                        @* ช่องรับค่าเบอร์โทรศัพท์ *@
                        <input asp-for="Phone" id="forgotPhoneInput" type="tel" required placeholder="081-234-5678" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>

                    @* กล่องแสดงข้อมูลบัญชีตัวอย่างสำหรับทดสอบ *@
                    <div class="rounded-xl bg-secondary/20 border border-primary/15 p-3 text-xs text-slate-600 space-y-1">
                        @* หัวข้อคำแนะนำข้อมูลทดสอบ *@
                        <div class="font-bold text-primary">@pageContent.DemoHintTitle</div>
                        @* รายละเอียดอีเมลและเบอร์โทรของบัญชีตัวอย่าง *@
                        <div>อีเมล: <span class="font-mono font-semibold text-text">@pageContent.DemoEmail</span> · เบอร์โทร: <span class="font-mono font-semibold text-text">@pageContent.DemoPhone</span></div>
                    </div>

                    @* ปุ่มกดยืนยันข้อมูลเพื่อสร้างรหัสยืนยัน 6 หลัก *@
                    <button type="submit" class="w-full py-2.5 rounded-xl bg-primary text-white text-sm font-bold shadow-sm hover:opacity-90 transition cursor-pointer">@pageContent.VerifyButtonText</button>
                </form>
            }
            @* ขั้นตอนที่ 2: ตั้งรหัสผ่านใหม่ด้วยรหัสยืนยัน 6 หลัก *@
            else {
                @* ป้ายบอกสถานะขั้นตอนที่ 2 *@
                <div class="rounded-xl bg-primary/5 border border-primary/20 px-3.5 py-2.5 flex items-center justify-between gap-2">
                    @* ข้อความระบุขั้นตอนที่ 2 *@
                    <span class="text-xs font-bold text-primary">@pageContent.Step2Badge</span>
                    @* ลิงก์สำหรับเริ่มกรอกอีเมลหรือเบอร์โทรใหม่ *@
                    <a asp-controller="Account" asp-action="ForgotPassword" class="text-[11px] font-semibold text-slate-500 hover:text-primary hover:underline">@pageContent.StartOverText</a>
                </div>

                @* กล่องแสดงรหัสยืนยัน 6 หลักที่ระบบสร้างขึ้น พร้อมปุ่มคัดลอกและกรอกอัตโนมัติ *@
                <div class="rounded-2xl border-2 border-dashed border-primary/40 bg-primary/5 p-4 text-center space-y-3">
                    @* ข้อความอธิบายรหัสยืนยัน *@
                    <div class="text-xs font-semibold text-slate-600">รหัสยืนยัน 6 หลักของคุณสำหรับบัญชี <span class="font-bold text-text">@Model.Email</span></div>
                    @* ตัวเลขรหัสยืนยัน 6 หลักขนาดใหญ่ชัดเจน *@
                    <div id="generatedOtpDisplay" class="font-mono text-2xl sm:text-3xl font-extrabold tracking-widest text-primary select-all">@Model.GeneratedCode</div>
                    @* ปุ่มกดคัดลอกรหัสและกรอกลงช่องยืนยันให้อัตโนมัติทันที *@
                    <button type="button" id="btnCopyAndFillOtp" onclick="copyAndAutoFillOtp('@Model.GeneratedCode')" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-accent transition cursor-pointer">
                        @* ไอคอนคัดลอก SVG *@
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
                        @* ข้อความบนปุ่มคัดลอกและกรอกอัตโนมัติ *@
                        <span id="btnCopyAndFillText">@pageContent.CopyAndFillText</span>
                    </button>
                </div>

                @* แบบฟอร์มขั้นตอนที่ 2: กรอกรหัสยืนยัน 6 หลักและตั้งรหัสผ่านใหม่ (ไม่มีแอตทริบิวต์ method ตามกฎโปรเจกต์) *@
                <form class="space-y-4" asp-controller="Account" asp-action="ConfirmForgotPassword">
                    @* โทเค็นความปลอดภัยป้องกันการปลอมแปลงคำขอ (CSRF) *@
                    @Html.AntiForgeryToken()
                    @* ฟิลด์ซ่อนส่งค่าอีเมลเดิมกลับมาด้วย *@
                    <input type="hidden" asp-for="Email" />
                    @* ฟิลด์ซ่อนส่งค่าเบอร์โทรศัพท์เดิมกลับมาด้วย *@
                    <input type="hidden" asp-for="Phone" />

                    @* ช่องกรอกรหัสยืนยัน 6 หลัก *@
                    <div>
                        @* ป้ายกำกับช่องรหัสยืนยัน 6 หลัก *@
                        <label asp-for="VerificationCode" class="block text-xs font-semibold text-slate-700 mb-1.5"></label>
                        @* ช่องรับค่ารหัสยืนยัน 6 หลัก *@
                        <input asp-for="VerificationCode" id="verificationCodeInput" type="text" maxlength="6" required placeholder="กรอกรหัส 6 หลัก หรือกดปุ่มด้านบน" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-mono text-sm font-bold tracking-widest text-text placeholder:font-sans placeholder:font-normal placeholder:tracking-normal placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>

                    @* ช่องกรอกรหัสผ่านใหม่ *@
                    <div>
                        @* ป้ายกำกับช่องรหัสผ่านใหม่ *@
                        <label asp-for="NewPassword" class="block text-xs font-semibold text-slate-700 mb-1.5"></label>
                        @* ช่องรับค่ารหัสผ่านใหม่ *@
                        <input asp-for="NewPassword" id="newPasswordInput" type="password" minlength="6" required placeholder="อย่างน้อย 6 ตัวอักษร" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>

                    @* ช่องกรอกยืนยันรหัสผ่านใหม่ *@
                    <div>
                        @* ป้ายกำกับช่องยืนยันรหัสผ่านใหม่ *@
                        <label asp-for="ConfirmNewPassword" class="block text-xs font-semibold text-slate-700 mb-1.5"></label>
                        @* ช่องรับค่ายืนยันรหัสผ่านใหม่ *@
                        <input asp-for="ConfirmNewPassword" id="confirmNewPasswordInput" type="password" minlength="6" required placeholder="กรอกรหัสผ่านใหม่อีกครั้ง" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm text-text placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    </div>

                    @* ปุ่มกดบันทึกรหัสผ่านใหม่ *@
                    <button type="submit" class="w-full py-2.5 rounded-xl bg-primary text-white text-sm font-bold shadow-sm hover:opacity-90 transition cursor-pointer">@pageContent.SavePasswordButtonText</button>
                </form>
            }

            @* ลิงก์กลับไปหน้าเข้าสู่ระบบ *@
            <div class="pt-3 border-t border-slate-100 text-center">
                @* ลิงก์นำทางกลับไปยังหน้า Login *@
                <a asp-controller="Account" asp-action="Login" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-primary transition-colors">
                    @* ไอคอนลูกศรย้อนกลับ SVG *@
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    @* ข้อความกลับไปหน้าเข้าสู่ระบบ *@
                    <span>@pageContent.BackToLoginText</span>
                </a>
            </div>
        </div>
    </div>
</div>

@* สคริปต์ฝั่งไคลเอนต์สำหรับช่วยกรอกข้อมูลตัวอย่างและคัดลอกพร้อมกรอกรหัส 6 หลักอัตโนมัติ *@
<script>
    // ฟังก์ชันกรอกอีเมลและเบอร์โทรศัพท์ของบัญชีลูกค้าตัวอย่างอัตโนมัติ
    function fillDemoForgotAccount() {
        // อ้างอิงช่องกรอกอีเมล
        var emailEl = document.getElementById('forgotEmailInput');
        // อ้างอิงช่องกรอกเบอร์โทรศัพท์
        var phoneEl = document.getElementById('forgotPhoneInput');
        // กำหนดค่าอีเมลตัวอย่างหากพบอิลิเมนต์
        if (emailEl) emailEl.value = '@pageContent.DemoEmail';
        // กำหนดค่าเบอร์โทรศัพท์ตัวอย่างหากพบอิลิเมนต์
        if (phoneEl) phoneEl.value = '@pageContent.DemoPhone';
    }

    // ฟังก์ชันคัดลอกรหัสยืนยัน 6 หลักลงคลิปบอร์ดและกรอกลงในช่อง VerificationCode ให้อัตโนมัติทันที
    function copyAndAutoFillOtp(code) {
        // อ้างอิงช่องกรอกรหัสยืนยัน 6 หลัก
        var inputEl = document.getElementById('verificationCodeInput');
        // อ้างอิงข้อความบนปุ่มคัดลอก
        var btnTextEl = document.getElementById('btnCopyAndFillText');
        // อ้างอิงช่องกรอกรหัสผ่านใหม่เพื่อเลื่อนโฟกัสไปให้พร้อมพิมพ์ต่อทันที
        var newPwdEl = document.getElementById('newPasswordInput');

        // กรอกรหัส 6 หลักลงในช่องอินพุตโดยอัตโนมัติ
        if (inputEl) { inputEl.value = code; }

        // คัดลอกรหัสลงคลิปบอร์ดของเบราว์เซอร์หากรองรับ
        if (navigator.clipboard && navigator.clipboard.writeText) {
            // ดำเนินการคัดลอกลงคลิปบอร์ดและดักจับข้อยกเว้น
            navigator.clipboard.writeText(code).catch(function () { /* ข้ามข้อผิดพลาดกรณีเบราว์เซอร์ไม่อนุญาต */ });
        }

        // เปลี่ยนข้อความบนปุ่มเพื่อแจ้งสถานะว่าคัดลอกและกรอกแล้ว
        if (btnTextEl) { btnTextEl.textContent = '@pageContent.CopiedAndFilledText'; }

        // เลื่อนโฟกัสไปยังช่องรหัสผ่านใหม่เพื่อให้ผู้ใช้ตั้งรหัสผ่านได้ต่อเนื่องทันที
        if (newPwdEl) { newPwdEl.focus(); }
    }
</script>
