        </div>
    </div>
</div>

@section Scripts {
@* บล็อกสคริปต์ JavaScript สำหรับควบคุมการโต้ตอบฝั่งไคลเอนต์ *@
<script>
    // ฟังก์ชันและตัวดักจับเหตุการณ์สำหรับควบคุมการทำงานบนหน้าเว็บ
    function previewReceiptFromRow(row) {
        // อ้างอิงอิลิเมนต์หรือกำหนดค่าตัวแปรสำหรับการประมวลผลฝั่งไคลเอนต์
        const d = row.dataset;
        document.getElementById('rcptNo').innerText = d.no || '';
        document.getElementById('rcptDateTime').innerText = d.time || '';
        document.getElementById('rcptCustomer').innerText = d.phone ? `${d.customer} (${d.phone})` : (d.customer || '');
        document.getElementById('rcptStaff').innerText = d.staff || '';
        document.getElementById('rcptItemName').innerText = d.items || '';
        document.getElementById('rcptItemTotal').innerText = d.total || '';
        document.getElementById('rcptVat').innerText = d.vat || '';
        document.getElementById('rcptPromo').innerText = d.promo || '—';
        document.getElementById('rcptFinalTotal').innerText = d.total || '';
        document.getElementById('rcptMethod').innerText = d.method || '';
        document.getElementById('rcptBarcode').innerText = `*${d.no || ''}*`;

        document.getElementById('receiptPreviewModal').classList.remove('hidden');
    }

    // ฟังก์ชันและตัวดักจับเหตุการณ์สำหรับควบคุมการทำงานบนหน้าเว็บ
    function closeReceiptPreview() {
        document.getElementById('receiptPreviewModal').classList.add('hidden');
    }
</script>
}
