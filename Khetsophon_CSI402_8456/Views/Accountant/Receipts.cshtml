@* กำหนดโมเดลข้อมูลรายการใบเสร็จรับเงินในระบบ *@
@model IEnumerable<Khetsophon_CSI402_8456.Models.Receipt>
@* กำหนดค่าเริ่มต้นและการประมวลผลสำหรับหน้าประวัติใบเสร็จ *@
@{
    // กำหนดชื่อหัวข้อของหน้าเว็บ
    ViewData["Title"] = "ประวัติใบเสร็จ / ธุรกรรม";
    // กำหนดเค้าโครงหลักสำหรับฝ่ายบัญชี
    Layout = "_AccountantLayout";

    // ตรวจสอบว่ามีรายการใบเสร็จในฐานข้อมูลหรือไม่
    var hasDbReceipts = Model != null && Model.Any();

    // กำหนดค่าข้อความและข้อมูลร้านสำหรับแสดงบนใบเสร็จรับเงินและส่วนหัวหน้าเพจ
    var pageHeader = new {
        // หัวข้อหลักของหน้าประวัติใบเสร็จ
        Title = "ประวัติใบเสร็จ / ธุรกรรม",
        // คำอธิบายขอบเขตข้อมูลของหน้า
        Subtitle = "รายการซื้อขายหน้าร้านและการรับสินค้าพรีออเดอร์ทั้งหมด สำหรับตรวจสอบและกระทบยอด",
        // ชื่อทางการค้าของร้านค้า
        StoreName = "FriendHouse Shop",
        // เลขประจำตัวผู้เสียภาษีอากร
        TaxId = "0-1055-67890-12-3",
        // ที่ตั้งและที่อยู่ของร้านค้า
        StoreAddress = "123 อาคารฟิกเกอร์สตรีท ชั้น 2 ถนนพระราม 9 แขวงห้วยขวาง เขตห้วยขวาง กรุงเทพฯ 10310"
    };
}

@* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
<div class="space-y-5">
    @* ส่วนหัวของหน้าแสดงชื่อเรื่อง คำอธิบาย และปุ่มส่งออกไฟล์ CSV *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div>
            @* หัวข้อหลักหรือหัวข้อย่อยสำหรับแบ่งส่วนเนื้อหาของหน้าเว็บ *@
            <h1 class="text-xl font-bold text-[#050315] tracking-tight">@pageHeader.Title</h1>
            @* ข้อความอธิบายรายละเอียดเพิ่มเติมสำหรับผู้ใช้งาน *@
            <p class="text-[13px] text-[#050315]/60 mt-1">@pageHeader.Subtitle</p>
        </div>
        @* ลิงก์นำทางสำหรับส่งออกข้อมูลใบเสร็จเป็นไฟล์ CSV *@
        <a asp-controller="Accountant" asp-action="ExportReceiptsCSV" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" asp-route-promoFilter="@ViewBag.PromoFilter" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#2F39A9] hover:bg-[#3027FF] text-[13px] font-medium text-white shadow-xs transition cursor-pointer self-start sm:self-auto">
            @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v12m0 0l-4-4m4 4l4-4M4 18h16" stroke-linecap="round" stroke-linejoin="round"/></svg>
            @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
            <span>ส่งออก .csv</span>
        </a>
    </div>

    @* แถบค้นหาและตัวกรองข้อมูลใบเสร็จ เชื่อมโยงกับ AccountantController *@
    <form asp-controller="Accountant" asp-action="Receipts" class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-xs">
        @* คอนเทนเนอร์จัดวางโครงสร้างแบบ Grid รองรับ Responsive ทุกขนาดหน้าจอ *@
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
            @* ช่องกรองวันที่เริ่มต้น *@
            <div class="lg:col-span-2">
                @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                <label class="block text-[11px] font-medium text-[#050315]/70 mb-1.5">ตั้งแต่วันที่</label>
                @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="w-full px-3 py-2 text-[12px] rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#2F39A9]/20 bg-white text-[#050315]" />
            </div>

            @* ช่องกรองวันที่สิ้นสุด *@
            <div class="lg:col-span-2">
                @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                <label class="block text-[11px] font-medium text-[#050315]/70 mb-1.5">ถึงวันที่</label>
                @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="w-full px-3 py-2 text-[12px] rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#2F39A9]/20 bg-white text-[#050315]" />
            </div>

            @* กล่องค้นหาคำค้นหา เลขที่ใบเสร็จ หรือเบอร์โทรศัพท์ *@
            <div class="lg:col-span-4">
                @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                <label class="block text-[11px] font-medium text-[#050315]/70 mb-1.5">ค้นหา</label>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="relative">
                    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </div>
                    @* ช่องกรอกข้อมูลสำหรับรับค่าจากผู้ใช้งาน *@
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="เลขที่ใบเสร็จ รหัสบาร์โค้ด หรือเบอร์โทร" class="w-full pl-9 pr-3 py-2 text-[12px] rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#2F39A9]/20 bg-white text-[#050315] placeholder:text-[#050315]/40" />
                </div>
            </div>

            @* เมนูดรอปดาวน์เลือกกรองตามโปรโมชั่นหรือส่วนลด *@
            <div class="lg:col-span-2">
                @* ป้ายชื่อกำกับช่องกรอกข้อมูลในแบบฟอร์ม *@
                <label class="block text-[11px] font-medium text-[#050315]/70 mb-1.5">ส่วนลด / โปรโมชั่น</label>
                @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                <div class="relative">
                    @* เมนูดรอปดาวน์สำหรับเลือกตัวกรองหรือหมวดหมู่ข้อมูล *@
                    <select name="promoFilter" class="w-full appearance-none px-3 py-2 pr-8 text-[12px] rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#2F39A9]/20 bg-white text-[#050315] cursor-pointer">
                        @* ตัวเลือกโปรโมชั่นทั้งหมด *@
                        <option value="all" selected="@((ViewBag.PromoFilter ?? "all") == "all")">ทั้งหมด</option>
                        @* ตัวเลือกรายการที่มีส่วนลดโปรโมชั่น *@
                        <option value="discounted" selected="@((ViewBag.PromoFilter ?? "all") == "discounted")">มีส่วนลด / โปรโมชั่น</option>
                        @* ตัวเลือกรายการราคาปกติ *@
                        <option value="regular" selected="@((ViewBag.PromoFilter ?? "all") == "regular")">ราคาปกติ (ไม่มีส่วนลด)</option>
                    </select>
                    @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                        @* ไอคอนกราฟิก SVG แทนการใช้สัญลักษณ์อีโมจิ *@
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                </div>
            </div>

            @* กลุ่มปุ่มดำเนินการสำหรับกรองและล้างค่าค้นหา *@
            <div class="lg:col-span-2 flex items-center gap-2">
                @* ปุ่มกดยืนยันส่งข้อมูลแบบฟอร์ม *@
                <button type="submit" class="flex-1 px-3.5 py-2 rounded-xl bg-[#2F39A9] hover:bg-[#3027FF] text-white text-[12px] font-bold transition cursor-pointer">กรอง</button>
                @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                <a asp-controller="Accountant" asp-action="Receipts" class="px-3 py-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-[12px] font-medium transition">ล้าง</a>
            </div>
        </div>
    </form>

    @* ตารางแสดงรายการประวัติใบเสร็จและธุรกรรมทั้งหมด *@
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden">
        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
        <div class="overflow-x-auto">
            @* ตารางแสดงรายการข้อมูลอย่างเป็นระเบียบพร้อมรองรับการเลื่อนแนวนอนบนจอเล็ก *@
            <table class="w-full text-left min-w-[720px]" id="receiptsTable">
                @* ส่วนหัวตารางกำหนดชื่อคอลัมน์ข้อมูล *@
                <thead>
                    @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                    <tr class="border-b border-slate-100 text-[10px] font-medium text-slate-400">
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="px-5 py-3.5 font-medium">วันที่/เวลา</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="px-4 py-3.5 font-medium">ลูกค้า</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="px-4 py-3.5 font-medium">รายการสินค้า</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="px-4 py-3.5 font-medium text-right">ยอดรวม</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="px-4 py-3.5 font-medium text-center">โปรโมชั่นที่ใช้</th>
                        @* เซลล์หัวตารางระบุชื่อหัวข้อคอลัมน์ *@
                        <th class="px-5 py-3.5 font-medium text-center">สถานะ</th>
                    </tr>
                </thead>
                @* ส่วนเนื้อหาตารางแสดงแถวข้อมูลแต่ละรายการ *@
                <tbody class="divide-y divide-slate-100/80 text-[11px] font-normal">
                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                    @if (hasDbReceipts) {
                        @* วนลูปแสดงผลรายการข้อมูลแต่ละชิ้นบนหน้าเว็บ *@
                        @foreach (var r in Model!) {
                            // สรุปรายการสินค้าและจำนวนในใบเสร็จ
                            var itemSummary = r.Receiptitems.Any() ? string.Join(", ", r.Receiptitems.Select(i => $"{i.ItemDescription} x{i.Quantity}")) : "สินค้าหน้าร้าน x1";
                            // ดึงชื่อลูกค้าหรือเบอร์โทรศัพท์
                            var customerName = r.Customer != null ? (r.Customer.FullName ?? r.Customer.Email) : (string.IsNullOrEmpty(r.CustomerPhone) ? "ลูกค้าทั่วไป" : "ลูกค้าสมาชิก");
                            // ดึงชื่อพนักงานผู้รับชำระเงิน
                            var staffName = r.CashierUser != null ? (r.CashierUser.FullName ?? r.CashierUser.Email) : "พนักงานหน้าร้าน";

                            @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                            <tr class="hover:bg-slate-50/60 transition-colors receipt-row cursor-pointer" data-no="@r.ReceiptNo" data-time="@r.IssuedAt.ToString("dd MMM yyyy HH:mm น.")" data-customer="@customerName" data-phone="@(string.IsNullOrEmpty(r.CustomerPhone) ? "ลูกค้าทั่วไป" : r.CustomerPhone)" data-items="@itemSummary" data-total="฿@r.NetTotalAmount.ToString("N0")" data-vat="฿@r.VatAmount.ToString("N2")" data-method="เงินสด / สแกน" data-staff="@staffName" data-promo="@(r.DiscountAmount > 0 ? $"ส่วนลด ฿{r.DiscountAmount:N0}" : "—")" onclick="previewReceiptFromRow(this)">
                                @* คอลัมน์วันที่และเวลาที่ออกใบเสร็จ *@
                                <td class="px-5 py-3.5 whitespace-nowrap">
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="text-[11px] text-[#050315]">@r.IssuedAt.ToString("dd MMM yyyy")</div>
                                    @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                    <div class="text-[10px] text-slate-400 mt-0.5">@r.IssuedAt.ToString("HH:mm น.")</div>
                                </td>

                                @* คอลัมน์ข้อมูลลูกค้าหรือเบอร์โทรศัพท์ *@
                                <td class="px-4 py-3.5 whitespace-nowrap">
                                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                    @if (!string.IsNullOrEmpty(r.CustomerPhone)) {
                                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                        <div class="text-[11px] text-[#050315] font-mono">@r.CustomerPhone</div>
                                        @* กล่องคอนเทนเนอร์จัดกลุ่มเนื้อหาและกำหนดสไตล์ด้วย Tailwind CSS *@
                                        <div class="mt-0.5"><span class="inline-block px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-600 text-[10px]">@(r.Customer != null ? "สมาชิก" : "ลูกค้า")</span></div>
                                    }
                                    @* กรณีเป็นลูกค้าทั่วไป *@
                                    else {
                                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                        <span class="text-[11px] text-[#050315]">ลูกค้าทั่วไป</span>
                                    }
                                </td>

                                @* คอลัมน์สรุปรายการสินค้าในใบเสร็จ *@
                                <td class="px-4 py-3.5 text-[11px] text-[#050315]">@itemSummary</td>

                                @* คอลัมน์ยอดเงินสุทธิรวมทั้งสิ้น *@
                                <td class="px-4 py-3.5 text-right whitespace-nowrap font-semibold text-[11px] text-[#050315]">฿@r.NetTotalAmount.ToString("N0")</td>

                                @* คอลัมน์โปรโมชั่นและส่วนลดที่ได้รับ *@
                                <td class="px-4 py-3.5 text-center whitespace-nowrap">
                                    @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                                    @if (r.DiscountAmount <= 0) {
                                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                        <span class="text-slate-400 text-[11px]">—</span>
                                    }
                                    @* กรณีมีส่วนลดโปรโมชั่น *@
                                    else {
                                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                        <span class="inline-block px-2.5 py-0.5 rounded-full bg-[#E0F2FE] text-[#0284C7] text-[10px] font-normal">ลด ฿@r.DiscountAmount.ToString("N0")</span>
                                    }
                                </td>

                                @* คอลัมน์สถานะความสำเร็จของธุรกรรม *@
                                <td class="px-5 py-3.5 text-center whitespace-nowrap">
                                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                                    <span class="inline-block px-2.5 py-0.5 rounded-full bg-[#ECFDF5] text-[#059669] text-[10px] font-normal">สำเร็จ</span>
                                </td>
                            </tr>
                        }
                    }
                    @* กรณีไม่มีข้อมูลใบเสร็จในระบบ *@
                    else {
                        @* แถวข้อมูลในตารางพร้อมเอฟเฟกต์เปลี่ยนสีพื้นหลังเมื่อชี้เมาส์ *@
                        <tr>
                            @* เซลล์แสดงค่าข้อมูลของแถวปัจจุบันในตาราง *@
                            <td colspan="6" class="px-5 py-8 text-center text-xs text-slate-400">ยังไม่มีประวัติใบเสร็จหรือรายการธุรกรรมในระบบ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* คำนวณข้อมูลสถิติสำหรับการแบ่งหน้าตารางประวัติใบเสร็จ *@
        @{
            // ดึงจำนวนใบเสร็จทั้งหมดในระบบ
            int totalReceipts = ViewBag.TotalReceiptCount ?? (hasDbReceipts ? Model!.Count() : 0);
            // ดึงหมายเลขหน้าปัจจุบัน
            int currentPage = ViewBag.CurrentPage ?? 1;
            // ดึงจำนวนหน้าทั้งหมด
            int totalPages = ViewBag.TotalPages ?? 1;
            // กำหนดขนาดรายการต่อหน้า
            int pageSize = ViewBag.PageSize ?? 10;
            // คำนวณลำดับแถวเริ่มต้น
            int startRow = totalReceipts == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
            // คำนวณลำดับแถวสิ้นสุด
            int endRow = Math.Min(currentPage * pageSize, totalReceipts);
        }
        @* แถบแบ่งหน้าประวัติใบเสร็จและธุรกรรม เชื่อมโยงกับ AccountantController.Receipts *@
        <div class="px-5 py-3.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-[11px] text-slate-500">
            @* กล่องแสดงจำนวนรายการใบเสร็จทั้งหมด *@
            <div>แสดง @startRow–@endRow จากทั้งหมด @totalReceipts รายการในฐานข้อมูล</div>
            @* กล่องจัดวางองค์ประกอบแบบ Flexbox เพื่อจัดเรียงแนวและระยะห่าง *@
            <div class="flex items-center gap-1 self-center sm:self-auto">
                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                @if (currentPage > 1) {
                    @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                    <a asp-controller="Accountant" asp-action="Receipts" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" asp-route-promoFilter="@ViewBag.PromoFilter" asp-route-page="@(currentPage - 1)" class="size-7 rounded-lg border border-slate-200 bg-white text-slate-600 flex items-center justify-center hover:bg-slate-50 cursor-pointer text-xs">‹</a>
                }
                @* กรณีอยู่ที่หน้าแรก ปิดการใช้งานปุ่มก่อนหน้า *@
                else {
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="size-7 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 flex items-center justify-center cursor-not-allowed text-xs">‹</span>
                }

                @* คำนวณช่วงหมายเลขหน้า 3 หมายเลข *@
                @{
                    // คำนวณช่วงหมายเลขหน้าแบบเลื่อนทีละ 3 หมายเลข (เช่น 1 2 3 -> 2 (3) 4 -> 3 (4) 5)
                    int startPage = Math.Clamp(currentPage - 1, 1, Math.Max(1, totalPages - 2));
                    // คำนวณหมายเลขหน้าสิ้นสุดไม่ให้เกินจำนวนหน้าทั้งหมด
                    int endPage = Math.Min(totalPages, startPage + 2);
                }
                @* วนลูปสร้างปุ่มตัวเลขหน้าแบบเลื่อนทีละ 3 หมายเลข *@
                @for (int p = startPage; p <= endPage; p++) {
                    @* ตรวจสอบว่าตรงกับหน้าปัจจุบันหรือไม่ *@
                    if (p == currentPage) {
                        @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                        <span class="size-7 rounded-lg bg-[#2F39A9] text-white font-medium flex items-center justify-center text-xs">@p</span>
                    }
                    @* กรณีเป็นหมายเลขหน้าอื่น *@
                    else {
                        @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                        <a asp-controller="Accountant" asp-action="Receipts" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" asp-route-promoFilter="@ViewBag.PromoFilter" asp-route-page="@p" class="size-7 rounded-lg border border-slate-200 bg-white text-slate-600 flex items-center justify-center hover:bg-slate-50 cursor-pointer text-xs">@p</a>
                    }
                }

                @* ตรวจสอบเงื่อนไขข้อมูลเพื่อเลือกแสดงผลส่วนติดต่อผู้ใช้ที่เหมาะสม *@
                @if (currentPage < totalPages) {
                    @* ลิงก์นำทางเชื่อมโยงไปยังหน้าเว็บหรือเส้นทางที่ระบุ *@
                    <a asp-controller="Accountant" asp-action="Receipts" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" asp-route-promoFilter="@ViewBag.PromoFilter" asp-route-page="@(currentPage + 1)" class="size-7 rounded-lg border border-slate-200 bg-white text-slate-600 flex items-center justify-center hover:bg-slate-50 cursor-pointer text-xs">›</a>
                }
                @* กรณีอยู่ที่หน้าสุดท้าย ปิดการใช้งานปุ่มถัดไป *@
                else {
                    @* ข้อความหรือป้ายกำกับสถานะ (Badge) แสดงข้อมูลย่อย *@
                    <span class="size-7 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 flex items-center justify-center cursor-not-allowed text-xs">›</span>
                }
            </div>
        </div>
    </div>
</div>

